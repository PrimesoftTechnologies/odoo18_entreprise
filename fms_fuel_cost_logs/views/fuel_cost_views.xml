<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fms_fuel_cost_view_list" model="ir.ui.view">
        <field name="name">fms.fuel.cost.list</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="total_quantity" sum="Total Liters"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="fms_fuel_cost_view_form" model="ir.ui.view">
        <field name="name">fms.fuel.cost.form</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fuel Details" name="fuel_details">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity" sum="Total Liters"/>
                                    <field name="unit_price"/>
                                    <field name="total_cost" sum="Total Cost"/>
                                    <field name="partner_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_quantity"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fms_fuel_cost_view_search" model="ir.ui.view">
        <field name="name">fms.fuel.cost.search</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fms_fuel_cost_action" model="ir.actions.act_window">
        <field name="name">Fuel Cost</field>
        <field name="res_model">fms.fuel.cost</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="fms_fuel_cost_menu"
              name="Fuel Cost"
              parent="fleet.menu_root"
              action="fms_fuel_cost_action"
              sequence="15"/>
</odoo>
