<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fms_fuel_cost_view_list" model="ir.ui.view">
        <field name="name">fms.fuel.cost.list</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="total_quantity" sum="Total Liters"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="fms_fuel_cost_view_form" model="ir.ui.view">
        <field name="name">fms.fuel.cost.form</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_vendor_bill" string="Create Vendor Bill" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fuel Details" name="fuel_details">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity" sum="Total Liters"/>
                                    <field name="unit_price"/>
                                    <field name="total_cost" sum="Total Cost"/>
                                    <field name="analytic_account_id"/>
                                    <field name="account_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_quantity"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Vendor Bills" name="vendor_bills">
                            <field name="bill_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fms_fuel_cost_view_search" model="ir.ui.view">
        <field name="name">fms.fuel.cost.search</field>
        <field name="model">fms.fuel.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Supplier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fms_fuel_cost_action" model="ir.actions.act_window">
        <field name="name">Fuel Cost</field>
        <field name="res_model">fms.fuel.cost</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="fms_fuel_cost_menu"
              name="Fuel Cost"
              parent="fleet.menu_root"
              action="fms_fuel_cost_action"
              sequence="15"/>
</odoo>
