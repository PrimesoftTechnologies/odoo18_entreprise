<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pos_discount_limit" model="ir.ui.view">
        <field name="name">product.template.form.pos.discount.limit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Directly after the Sales Price row (label + field), whatever the exact layout is -->
            <xpath expr="//field[@name='list_price']/ancestor::group[1]/*[descendant-or-self::field[@name='list_price']]"
                   position="after">
                <field name="pos_discount_limit"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
