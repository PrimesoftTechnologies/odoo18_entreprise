<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_restriction_quantity.DiscountPriceDialog">
        <Dialog title="props.title" size="'md'">
            <div class="d-flex flex-column gap-2">
                <div class="text-muted">
                    <t t-if="props.qtyLabel">Quantity: <b t-esc="props.qtyLabel"/><br/></t>
                    Line total: <b t-esc="props.originalLabel"/>
                    <t t-if="props.limitLabel">
                        <br/>Minimum allowed total: <b t-esc="props.limitLabel"/>
                        <t t-if="props.mode === 'discount'">
                            <br/>Maximum discount: <b t-esc="props.maxDiscountLabel"/>
                        </t>
                    </t>
                </div>
                <input t-ref="input"
                       type="number"
                       step="any"
                       inputmode="decimal"
                       class="form-control form-control-lg text-end"
                       t-att-placeholder="placeholder"
                       t-model="state.value"
                       t-on-keydown="onKeydown"/>
                <div t-if="state.error" class="alert alert-danger mb-0 py-2" t-esc="state.error"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirm">Ok</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>