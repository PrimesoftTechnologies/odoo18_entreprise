<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_external_logo_hill" model="ir.ui.view">
        <field name="name">res.company.form.external.logo.hill</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="External Logo" name="external_logo_hill_page">
                    <group>
                        <group string="Login Page Logo">
                            <field name="external_logo_hill" widget="image"
                                   options="{'size': [180, 180]}"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                The logo that will be used outside the system
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
