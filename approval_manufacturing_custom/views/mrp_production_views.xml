<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- WIZARD YA KUKATAA -->
    <record id="view_mrp_production_reject_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.reject.wizard.form</field>
        <field name="model">mrp.production.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Manufacturing Order">
                <sheet>
                    <group>
                        <field name="production_id" invisible="1"/>
                        <field name="reason" placeholder="Please type the reason for rejection here..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Reject" type="object" name="action_confirm_reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- INHERIT FORM -->
    <record id="mrp_production_view_form_inherit_approval"
            model="ir.ui.view">
        <field name="name">mrp.production.view.form.inherit.approval</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id"
               ref="mrp.mrp_production_form_view"/>
        <field name="arch"
               type="xml">

            <!-- Ficha Cancel Button -->
            <xpath expr="//header//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">
                    is_approval_flow_enabled and is_inspection_flow_enabled and (state not in ('draft', 'cancel')) and (requested_by != uid)
                </attribute>
            </xpath>

            <!-- Control Fields -->
            <xpath expr="//header" position="inside">
                <field name="is_approval_flow_enabled" invisible="1"/>
                <field name="is_inspection_flow_enabled" invisible="1"/>
                <field name="can_approve" invisible="1"/>
                <field name="can_send_for_inspection" invisible="1"/>
                <field name="can_inspect" invisible="1"/>
                <field name="can_request_approval" invisible="1"/>
                <field name="is_transfer_validated" invisible="1"/>
                <field name="requested_by" invisible="1"/>
            </xpath>

            <!-- Statusbar Management -->
            <xpath expr="//header/field[@name='state']" position="replace">
                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,confirmed,done"
                       invisible="is_approval_flow_enabled and is_inspection_flow_enabled"/>

                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,approved,confirmed,done"
                       invisible="not (is_approval_flow_enabled and is_inspection_flow_enabled)"/>
            </xpath>

            <!-- Standard Odoo Confirm Button -->
            <xpath expr="//header//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">
                    is_approval_flow_enabled and is_inspection_flow_enabled
                </attribute>
            </xpath>

            <!-- Ficha au Zuia vitufe vya Produce All / Mark as Done vionekane mpaka Transfer iwe Validated -->
            <xpath expr="//header//button[@name='button_mark_done']" position="attributes">
                <attribute name="invisible">
                    state != 'confirmed' or (is_approval_flow_enabled and is_inspection_flow_enabled and not is_transfer_validated)
                </attribute>
            </xpath>

            <xpath expr="//header//button[@name='action_assign']" position="attributes">
                <attribute name="invisible">
                    state != 'confirmed' or (is_approval_flow_enabled and is_inspection_flow_enabled and not is_transfer_validated)
                </attribute>
            </xpath>

            <!-- 1. Submit for Approval Button -->
            <xpath expr="//header" position="inside">
                <button name="action_request_approval"
                        string="Submit for Approval"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="not (is_approval_flow_enabled and is_inspection_flow_enabled) or state not in ('draft', 'reject', 'cancel') or not can_request_approval"/>
            </xpath>

            <!-- 2. Approve Button -->
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        data-hotkey="a"
                        invisible="state != 'wait_approval' or not can_approve or not (is_approval_flow_enabled and is_inspection_flow_enabled)"/>
            </xpath>

            <!-- 3. Custom Confirm Button -->
            <xpath expr="//header" position="inside">
                <button name="action_custom_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        data-hotkey="c"
                        invisible="state != 'approved' or not (is_approval_flow_enabled and is_inspection_flow_enabled) or requested_by != uid"/>
            </xpath>

            <!-- 4. Validate Production Button -->
            <xpath expr="//header" position="inside">
                <button name="action_validate_production"
                        string="Validate"
                        type="object"
                        class="btn-primary"
                        data-hotkey="v"
                        invisible="state != 'wait_validation' or not (can_send_for_inspection or can_inspect) or not (is_approval_flow_enabled and is_inspection_flow_enabled)"/>
            </xpath>

            <!-- Reject Button -->
            <xpath expr="//header" position="inside">
                <button name="action_open_reject_wizard"
                        string="Reject"
                        type="object"
                        class="btn-secondary"
                        data-hotkey="j"
                        invisible="not (is_approval_flow_enabled and is_inspection_flow_enabled) or not ((state == 'wait_approval' and can_approve) or (state == 'approved' and can_approve) or (state == 'wait_validation' and can_inspect))"/>
            </xpath>

        </field>
    </record>

</odoo>