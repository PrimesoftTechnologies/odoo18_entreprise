<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_request_list" model="ir.ui.view">
        <field name="name">asset.request.list</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="category_id"/>
                <field name="needed_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'fulfilled')"
                       decoration-warning="state in ('submitted', 'dept_approved')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_request_form" model="ir.ui.view">
        <field name="name">asset.request.form</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_dept_approve" string="Approve (Department)" type="object" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Final Approval" type="object" class="btn-primary"
                            invisible="state != 'dept_approved'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_create_asset" string="Create Asset" type="object" class="btn-primary"
                            invisible="state != 'approved'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'dept_approved')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('fulfilled', 'cancel')"/>
                    <button name="action_set_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,dept_approved,approved,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="title" placeholder="What do you need?" readonly="state != 'draft'"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="needed_date" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="estimated_cost" readonly="state != 'draft'"/>
                            <field name="asset_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="justification" nolabel="1" readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_request_search" model="ir.ui.view">
        <field name="name">asset.request.search</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="mine" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', 'in', ('submitted', 'dept_approved'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_request" model="ir.actions.act_window">
        <field name="name">Asset Requests</field>
        <field name="res_model">asset.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_request_search"/>
    </record>
</odoo>
