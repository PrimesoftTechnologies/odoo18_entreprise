<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_disposal_list" model="ir.ui.view">
        <field name="name">asset.disposal.list</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="date"/>
                <field name="disposal_type"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_value"/>
                <field name="book_value"/>
                <field name="gain_loss" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state == 'submitted'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_disposal_form" model="ir.ui.view">
        <field name="name">asset.disposal.form</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" groups="asset_management_prime.group_asset_manager" string="Submit for Approval" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" groups="asset_management_prime.group_asset_manager" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_done" groups="asset_management_prime.group_asset_manager" string="Confirm Disposal" type="object" class="btn-primary"
                            invisible="state != 'approved'" confirm="This will stop depreciation and close the asset. Continue?"/>
                    <button name="action_reject" groups="asset_management_prime.group_asset_manager" string="Reject" type="object" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_set_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="disposal_type" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state not in ('draft', 'submitted', 'approved')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_value" invisible="disposal_type != 'sale'"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="counterpart_account_id" invisible="disposal_type != 'sale'"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="book_value" invisible="state != 'done'"/>
                            <field name="gain_loss" invisible="state != 'done'"/>
                            <field name="approved_by_id"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <group string="Reason"><field name="reason" nolabel="1" readonly="state != 'draft'"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_disposal_search" model="ir.ui.view">
        <field name="name">asset.disposal.search</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <filter name="pending" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_type" string="Type" context="{'group_by': 'disposal_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_disposal" model="ir.actions.act_window">
        <field name="name">Disposals</field>
        <field name="res_model">asset.disposal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_disposal_search"/>
    </record>
</odoo>
