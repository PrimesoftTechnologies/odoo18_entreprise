<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_audit_list" model="ir.ui.view">
        <field name="name">asset.audit.list</field>
        <field name="model">asset.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="date"/>
                <field name="scope"/>
                <field name="auditor_id"/>
                <field name="total_count"/>
                <field name="found_count"/>
                <field name="missing_count"/>
                <field name="state" widget="badge" decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_audit_form" model="ir.ui.view">
        <field name="name">asset.audit.form</field>
        <field name="model">asset.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Audit" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Complete Audit" type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_apply_corrections" string="Apply Location Corrections" type="object"
                            invisible="state != 'done' or misplaced_count == 0"
                            groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('cancel',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h2><field name="name"/></h2>
                        <h1><field name="title" placeholder="e.g. Annual stock take - Head Office" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="auditor_id"/>
                            <field name="scope" readonly="state != 'draft'"/>
                            <field name="location_id" invisible="scope != 'location'"
                                   required="scope == 'location'" readonly="state != 'draft'"/>
                            <field name="department_id" invisible="scope != 'department'"
                                   required="scope == 'department'" readonly="state != 'draft'"/>
                            <field name="category_id" invisible="scope != 'category'"
                                   required="scope == 'category'" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Progress">
                            <field name="total_count"/>
                            <field name="found_count"/>
                            <field name="misplaced_count"/>
                            <field name="missing_count"/>
                            <field name="pending_count"/>
                        </group>
                    </group>
                    <group string="Scanning" invisible="state != 'in_progress'">
                        <group>
                            <field name="scan_location_id"/>
                            <field name="scan_input" placeholder="Scan or type barcode and press Enter..." 
                                  />
                        </group>
                    </group>
                    <field name="line_ids" readonly="state in ('done', 'cancel')">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="status == 'found'" decoration-warning="status == 'misplaced'"
                              decoration-danger="status == 'missing'">
                            <field name="asset_id" readonly="1"/>
                            <field name="category_id" optional="hide"/>
                            <field name="expected_location_id" readonly="1"/>
                            <field name="expected_holder_id" readonly="1" optional="show"/>
                            <field name="found_location_id"/>
                            <field name="condition"/>
                            <field name="status" widget="badge" readonly="1"/>
                            <field name="note"/>
                            <field name="scanned_at" optional="hide"/>
                            <button name="action_found" type="object" icon="fa-check" string="Found"
                                    invisible="status in ('found', 'misplaced')"/>
                            <button name="action_missing" type="object" icon="fa-times" string="Missing"
                                    invisible="status == 'missing'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_audit_line_list" model="ir.ui.view">
        <field name="name">asset.audit.line.list</field>
        <field name="model">asset.audit.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="status == 'missing'"
                  decoration-warning="status == 'misplaced'" decoration-success="status == 'found'">
                <field name="audit_id"/>
                <field name="asset_id"/>
                <field name="expected_location_id"/>
                <field name="found_location_id"/>
                <field name="condition"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_asset_audit_line_search" model="ir.ui.view">
        <field name="name">asset.audit.line.search</field>
        <field name="model">asset.audit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="audit_id"/>
                <filter name="missing" string="Missing" domain="[('status', '=', 'missing')]"/>
                <filter name="misplaced" string="Wrong Location" domain="[('status', '=', 'misplaced')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_audit" string="Audit" context="{'group_by': 'audit_id'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_audit" model="ir.actions.act_window">
        <field name="name">Audits</field>
        <field name="res_model">asset.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_asset_audit_exceptions" model="ir.actions.act_window">
        <field name="name">Audit Exceptions</field>
        <field name="res_model">asset.audit.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('status', 'in', ('missing', 'misplaced'))]</field>
        <field name="search_view_id" ref="view_asset_audit_line_search"/>
    </record>
</odoo>
