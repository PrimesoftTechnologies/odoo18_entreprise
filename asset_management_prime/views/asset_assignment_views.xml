<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_assignment_list" model="ir.ui.view">
        <field name="name">asset.assignment.list</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('returned', 'cancel')">
                <field name="is_overdue" column_invisible="1"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="assignment_type"/>
                <field name="date_from"/>
                <field name="expected_return_date"/>
                <field name="date_to" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_assignment_form" model="ir.ui.view">
        <field name="name">asset.assignment.form</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Check-out" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_return" string="Check-in (Return)" type="object" class="btn-primary"
                            invisible="state != 'active'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_print_handover" string="Print Handover Form" type="object"
                            invisible="state not in ('active', 'returned')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft',)" groups="asset_management_prime.group_asset_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,returned"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="assignment_type" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="expected_return_date"
                                   required="assignment_type == 'temporary'"
                                   readonly="state not in ('draft', 'active')"/>
                            <field name="date_to"/>
                            <field name="condition_out" readonly="state != 'draft'"/>
                            <field name="condition_in" invisible="state == 'draft'"
                                   required="state == 'active'" readonly="state == 'returned'"/>
                        </group>
                    </group>
                    <group string="Notes / Accessories handed over">
                        <field name="note" nolabel="1"/>
                    </group>
                    <group string="Employee Signature">
                        <field name="signature" widget="signature" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_assignment_search" model="ir.ui.view">
        <field name="name">asset.assignment.search</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="active_a" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="loans" string="Temporary Loans" domain="[('assignment_type', '=', 'temporary')]"/>
                <filter name="overdue" string="Overdue Returns"
                        domain="[('state', '=', 'active'), ('expected_return_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_assignment_search"/>
    </record>
</odoo>
