<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_depreciation_line_list" model="ir.ui.view">
        <field name="name">asset.depreciation.line.list</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'posted'" create="0" delete="0">
                <field name="asset_id"/>
                <field name="category_id" optional="show"/>
                <field name="sequence"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="remaining_value"/>
                <field name="move_id"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                <button name="action_post" type="object" string="Post" icon="fa-check"
                        invisible="state == 'posted'" groups="asset_management_prime.group_asset_manager"/>
            </list>
        </field>
    </record>

    <record id="view_asset_depreciation_line_search" model="ir.ui.view">
        <field name="name">asset.depreciation.line.search</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="category_id"/>
                <filter name="draft" string="To Post" domain="[('state', '=', 'draft')]"/>
                <filter name="due" string="Due" domain="[('state', '=', 'draft'), ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_asset_depreciation_line_pivot" model="ir.ui.view">
        <field name="name">asset.depreciation.line.pivot</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_asset_depreciation_line_graph" model="ir.ui.view">
        <field name="name">asset.depreciation.line.graph</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_asset_depreciation_line" model="ir.actions.act_window">
        <field name="name">Depreciation Entries</field>
        <field name="res_model">asset.depreciation.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_asset_depreciation_line_search"/>
        <field name="context">{'search_default_due': 1}</field>
    </record>
</odoo>
