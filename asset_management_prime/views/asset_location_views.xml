<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_location_list" model="ir.ui.view">
        <field name="name">asset.location.list</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="asset_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_asset_location_form" model="ir.ui.view">
        <field name="name">asset.location.form</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_location_search" model="ir.ui.view">
        <field name="name">asset.location.search</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_asset_location" model="ir.actions.act_window">
        <field name="name">Asset Locations</field>
        <field name="res_model">asset.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
