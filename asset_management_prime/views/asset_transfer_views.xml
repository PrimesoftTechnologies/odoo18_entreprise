<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_transfer_list" model="ir.ui.view">
        <field name="name">asset.transfer.list</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="date"/>
                <field name="from_employee_id" optional="show"/>
                <field name="to_employee_id"/>
                <field name="from_location_id" optional="hide"/>
                <field name="to_location_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state == 'submitted'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_transfer_form" model="ir.ui.view">
        <field name="name">asset.transfer.form</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'submitted'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_done" string="Complete Transfer" type="object" class="btn-primary"
                            invisible="state != 'approved'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'" groups="asset_management_prime.group_asset_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_set_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="approved_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="From">
                            <field name="from_employee_id" readonly="1"/>
                            <field name="from_department_id" readonly="1"/>
                            <field name="from_location_id" readonly="1"/>
                        </group>
                        <group string="To">
                            <field name="to_employee_id" readonly="state != 'draft'"/>
                            <field name="to_department_id" readonly="state != 'draft'"/>
                            <field name="to_location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Reason"><field name="reason" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_transfer_search" model="ir.ui.view">
        <field name="name">asset.transfer.search</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="to_employee_id"/>
                <filter name="pending" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">asset.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_transfer_search"/>
    </record>
</odoo>
