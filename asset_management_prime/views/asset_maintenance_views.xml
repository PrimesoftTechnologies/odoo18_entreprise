<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_maintenance_list" model="ir.ui.view">
        <field name="name">asset.maintenance.list</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('done', 'cancel')">
                <field name="is_overdue" column_invisible="1"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <field name="technician_id"/>
                <field name="scheduled_date"/>
                <field name="priority" widget="priority"/>
                <field name="total_cost" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_maintenance_kanban" model="ir.ui.view">
        <field name="name">asset.maintenance.kanban</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <strong><field name="name"/></strong>
                        <div><field name="asset_id"/></div>
                        <div class="text-muted"><field name="maintenance_type"/> · <field name="scheduled_date"/></div>
                        <div class="d-flex justify-content-between mt-1">
                            <field name="priority" widget="priority"/>
                            <field name="technician_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_maintenance_form" model="ir.ui.view">
        <field name="name">asset.maintenance.form</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Work" type="object" class="btn-primary"
                            invisible="state != 'new'" groups="asset_management_prime.group_asset_technician"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary"
                            invisible="state not in ('new', 'in_progress')"
                            groups="asset_management_prime.group_asset_technician"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')" groups="asset_management_prime.group_asset_technician"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="reference"/></h2>
                        <h1><field name="name" placeholder="e.g. Screen flickering"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'new'"/>
                            <field name="maintenance_type" readonly="state != 'new'"/>
                            <field name="priority" widget="priority"/>
                            <field name="requested_by_id"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="scheduled_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="downtime_hours" widget="float_time"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the problem or the service to do..."/>
                            <group string="Resolution Notes">
                                <field name="resolution" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Costs &amp; Parts" name="costs">
                            <field name="part_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="labor_cost"/>
                                <field name="parts_cost"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                            <group><field name="vendor_id"/></group>
                        </page>
                        <page string="Recurrence" name="recurrence"
                              invisible="maintenance_type != 'preventive'">
                            <group>
                                <field name="recurring"/>
                                <field name="interval_months" invisible="not recurring"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_maintenance_search" model="ir.ui.view">
        <field name="name">asset.maintenance.search</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="technician_id"/>
                <filter name="mine" string="My Tasks" domain="[('technician_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'in_progress'))]"/>
                <filter name="corrective" string="Corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <filter name="preventive" string="Preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'new'), ('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_tech" string="Technician" context="{'group_by': 'technician_id'}"/>
                    <filter name="g_month" string="Scheduled Month" context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_asset_maintenance_pivot" model="ir.ui.view">
        <field name="name">asset.maintenance.pivot</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="asset_id" type="row"/>
                <field name="maintenance_type" type="col"/>
                <field name="total_cost" type="measure"/>
                <field name="downtime_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_asset_maintenance_graph" model="ir.ui.view">
        <field name="name">asset.maintenance.graph</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="asset_id"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_asset_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">asset.maintenance</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_asset_maintenance_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_asset_maintenance_report" model="ir.actions.act_window">
        <field name="name">Maintenance Cost Analysis</field>
        <field name="res_model">asset.maintenance</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '=', 'done')]</field>
    </record>
</odoo>
