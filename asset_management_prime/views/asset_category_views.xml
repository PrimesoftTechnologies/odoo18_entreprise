<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_category_list" model="ir.ui.view">
        <field name="name">asset.category.list</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="method"/>
                <field name="useful_life"/>
                <field name="salvage_percent"/>
                <field name="asset_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">asset.category.form</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. IT Equipment"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Depreciation Defaults">
                            <field name="method"/>
                            <field name="useful_life" invisible="method == 'manual'"/>
                            <field name="salvage_percent" invisible="method == 'manual'"/>
                            <field name="degressive_factor" invisible="method != 'degressive'"/>
                            <field name="auto_post" invisible="method == 'manual'"/>
                        </group>
                    </group>
                    <group string="Accounting">
                        <group>
                            <field name="journal_id"/>
                            <field name="account_asset_id"/>
                        </group>
                        <group>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="account_gain_loss_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
