<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_prime" model="ir.module.category">
        <field name="name">Asset Management Prime</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_asset_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_asset_prime"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_asset_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_asset_prime"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
    </record>

    <record id="group_asset_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_asset_prime"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
    </record>

    <record id="group_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="category_id" ref="module_category_asset_prime"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_technician')), (4, ref('group_asset_auditor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
