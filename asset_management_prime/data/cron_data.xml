<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_post_depreciation" model="ir.cron">
        <field name="name">Asset: Post Due Depreciation Entries</field>
        <field name="model_id" ref="model_asset_depreciation_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_due_lines()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_asset_alerts" model="ir.cron">
        <field name="name">Asset: Warranty / Insurance / Maintenance / Loan Alerts</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_asset_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
