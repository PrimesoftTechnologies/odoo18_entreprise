<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lds_allocation_list" model="ir.ui.view">
        <field name="name">lds.allocation.list</field>
        <field name="model">lds.allocation</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-info="state == 'accrued'">
                <field name="date"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="principal_share" sum="Principal"/>
                <field name="interest_share" sum="Interest"/>
                <field name="markup_share" sum="Markup"/>
                <field name="total_share" sum="Total"/>
                <field name="balance_after"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_accrue" type="object" string="Accrue" icon="fa-calculator"
                        invisible="state != 'draft'"/>
                <button name="action_settle" type="object" string="Settle" icon="fa-money"
                        invisible="state != 'accrued'"/>
            </list>
        </field>
    </record>

    <record id="view_lds_allocation_form" model="ir.ui.view">
        <field name="name">lds.allocation.form</field>
        <field name="model">lds.allocation</field>
        <field name="arch" type="xml">
            <form string="Allocation">
                <header>
                    <button name="action_accrue" type="object" string="Accrue Interest" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_settle" type="object" string="Settle" class="btn-primary"
                            invisible="state != 'accrued'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="distribution_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="settle_date"/>
                        </group>
                        <group>
                            <field name="principal_share"/>
                            <field name="interest_share"/>
                            <field name="markup_share"/>
                            <field name="total_share"/>
                            <field name="balance_after"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Journal Entries">
                        <field name="accrue_move_id"/>
                        <field name="settle_move_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lds_allocation_search" model="ir.ui.view">
        <field name="name">lds.allocation.search</field>
        <field name="model">lds.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="To Accrue" domain="[('state', '=', 'draft')]"/>
                <filter name="accrued" string="Unpaid" domain="[('state', '=', 'accrued')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Discount Center" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_loan" string="Loan" context="{'group_by': 'loan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lds_allocation" model="ir.actions.act_window">
        <field name="name">Interest Allocations</field>
        <field name="res_model">lds.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
