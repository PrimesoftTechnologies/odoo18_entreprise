<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_lds" model="ir.ui.view">
        <field name="name">res.company.form.lds</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Loan Discount" name="lds">
                    <group>
                        <group string="All companies">
                            <field name="lds_journal_id"/>
                            <field name="lds_interest_expense_account_id"/>
                        </group>
                        <group string="Treasury company only">
                            <field name="lds_loan_account_id"/>
                            <field name="lds_receivable_account_id"/>
                            <field name="lds_interest_income_account_id"/>
                        </group>
                        <group string="Receiving (subsidiary) companies only">
                            <field name="lds_payable_account_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_lds_companies" model="ir.actions.act_window">
        <field name="name">Loan Discount Companies</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
