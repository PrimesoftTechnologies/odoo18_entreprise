<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lds_repayment_list" model="ir.ui.view">
        <field name="name">lds.bank.loan.repayment.list</field>
        <field name="model">lds.bank.loan.repayment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="loan_id"/>
                <field name="principal_amount" sum="Principal"/>
                <field name="interest_amount" sum="Interest"/>
                <field name="total_amount" sum="Total"/>
                <field name="balance_after"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_lds_repayment_form" model="ir.ui.view">
        <field name="name">lds.bank.loan.repayment.form</field>
        <field name="model">lds.bank.loan.repayment</field>
        <field name="arch" type="xml">
            <form string="Repayment">
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset to Draft" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="loan_id" readonly="state == 'posted'"/>
                            <field name="line_id" readonly="state == 'posted'"/>
                            <field name="date" readonly="state == 'posted'"/>
                        </group>
                        <group>
                            <field name="principal_amount" readonly="state == 'posted'"/>
                            <field name="interest_amount" readonly="state == 'posted'"/>
                            <field name="total_amount"/>
                            <field name="balance_after"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="move_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lds_repayment" model="ir.actions.act_window">
        <field name="name">Repayments</field>
        <field name="res_model">lds.bank.loan.repayment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
