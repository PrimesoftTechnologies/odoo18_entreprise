<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lds_distribution_list" model="ir.ui.view">
        <field name="name">lds.loan.distribution.list</field>
        <field name="model">lds.loan.distribution</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed' and outstanding == 0">
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount" sum="Total"/>
                <field name="markup_rate"/>
                <field name="total_payable" sum="Total to pay"/>
                <field name="outstanding" sum="Outstanding"/>
                <field name="interest_charged" sum="Interest"/>
                <field name="amount_due" sum="Due"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_lds_distribution_form" model="ir.ui.view">
        <field name="name">lds.loan.distribution.form</field>
        <field name="model">lds.loan.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribution">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_recompute" type="object" string="Recompute Schedule"
                            invisible="state != 'confirmed'"
                            confirm="Rebuild all months that are not yet accrued?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Distribution">
                            <field name="loan_id" readonly="state == 'confirmed'" options="{'no_create': True}"/>
                            <field name="loan_undistributed" invisible="state == 'confirmed'"/>
                            <field name="partner_id" readonly="state == 'confirmed'"/>
                            <field name="date" readonly="state == 'confirmed'"/>
                            <field name="amount" readonly="state == 'confirmed'"/>
                            <field name="markup_rate" readonly="state == 'confirmed'"/>
                            <field name="move_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="What this Discount Center must pay Treasury">
                            <field name="total_principal"/>
                            <field name="total_bank_interest"/>
                            <field name="total_markup"/>
                            <field name="total_payable" class="fw-bold"/>
                        </group>
                    </group>
                    <group string="Position today">
                        <group>
                            <field name="paid_principal"/>
                            <field name="outstanding" class="fw-bold"/>
                        </group>
                        <group>
                            <field name="interest_charged"/>
                            <field name="amount_due"/>
                        </group>
                    </group>
                    <separator string="Monthly repayment schedule (computed automatically on Confirm)"/>
                    <field name="allocation_ids" readonly="1">
                        <list decoration-success="state == 'paid'" decoration-info="state == 'accrued'">
                            <field name="date"/>
                            <field name="principal_share" sum="Principal"/>
                            <field name="interest_share" sum="Bank Interest"/>
                            <field name="markup_share" sum="Markup"/>
                            <field name="total_share" sum="Total to pay"/>
                            <field name="balance_after"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                            <button name="action_accrue" type="object" string="Accrue" icon="fa-calculator"
                                    invisible="state != 'draft'"/>
                            <button name="action_settle" type="object" string="Settle" icon="fa-money"
                                    invisible="state != 'accrued'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lds_distribution" model="ir.actions.act_window">
        <field name="name">Distributions</field>
        <field name="res_model">lds.loan.distribution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
