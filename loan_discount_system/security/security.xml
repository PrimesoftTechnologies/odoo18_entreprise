<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lds" model="ir.module.category">
        <field name="name">Loan Discount System</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_lds_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_lds"/>
    </record>

    <record id="group_lds_treasurer" model="res.groups">
        <field name="name">Treasurer</field>
        <field name="category_id" ref="module_category_lds"/>
        <field name="implied_ids" eval="[(4, ref('group_lds_user'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_lds_bank_loan_company" model="ir.rule">
        <field name="name">Bank Loan: multi-company</field>
        <field name="model_id" ref="model_lds_bank_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lds_bank_loan_line_company" model="ir.rule">
        <field name="name">Bank Loan Line: multi-company</field>
        <field name="model_id" ref="model_lds_bank_loan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lds_repayment_company" model="ir.rule">
        <field name="name">Repayment: multi-company</field>
        <field name="model_id" ref="model_lds_bank_loan_repayment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lds_distribution_company" model="ir.rule">
        <field name="name">Distribution: HQ or receiving company</field>
        <field name="model_id" ref="model_lds_loan_distribution"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('target_company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lds_allocation_company" model="ir.rule">
        <field name="name">Allocation: HQ or receiving company</field>
        <field name="model_id" ref="model_lds_allocation"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('target_company_id', 'in', company_ids)]</field>
    </record>
</odoo>
