<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lds" model="ir.module.category">
        <field name="name">Loan Discount System</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_lds_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_lds"/>
    </record>

    <record id="group_lds_treasurer" model="res.groups">
        <field name="name">Treasurer</field>
        <field name="category_id" ref="module_category_lds"/>
        <field name="implied_ids" eval="[(4, ref('group_lds_user'))]"/>
    </record>

    <record id="rule_lds_customer_loan_company" model="ir.rule">
        <field name="name">Customer Loan: multi-company</field>
        <field name="model_id" ref="model_lds_customer_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lds_customer_loan_line_company" model="ir.rule">
        <field name="name">Customer Loan Line: multi-company</field>
        <field name="model_id" ref="model_lds_customer_loan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
