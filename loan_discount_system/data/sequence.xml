<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_lds_bank_loan" model="ir.sequence">
        <field name="name">Bank Loan</field>
        <field name="code">lds.bank.loan</field>
        <field name="prefix">BL/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_lds_repayment" model="ir.sequence">
        <field name="name">Bank Loan Repayment</field>
        <field name="code">lds.bank.loan.repayment</field>
        <field name="prefix">BLR/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
