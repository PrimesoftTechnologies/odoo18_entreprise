<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PROJECT TASK FORM INHERITANCE
         ============================================================ -->
    <record id="view_task_form_project_manufacturer_request" model="ir.ui.view">
        <field name="name">project.task.form.project.manufacturer.request</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Weka Smart Button ndani ya button_box kwenye Form ya Task -->
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button
                    name="action_view_manufacturing_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="manufacturer_request_count == 0"
                >
                    <field name="manufacturer_request_count" widget="statinfo" string="Material Request"/>
                </button>
            </xpath>

            <!-- Vitufe kwenye Header ya Task -->
            <xpath expr="//header" position="inside">
                <!-- 1. Kitufe cha Submit -->
                <button
                    name="action_submit_manufacturing_request"
                    type="object"
                    string="Submit Material Request"
                    class="btn-primary"
                    icon="fa-industry"
                    invisible="manufacturer_request_state != 'draft'"
                />
                
                <!-- 2. Kitufe cha Muongozo (Info) -->
                <button
                    name="action_info_missing_products"
                    string="Add Products in Tab Below to Submit"
                    type="object"
                    class="btn btn-secondary text-muted"
                    icon="fa-info-circle"
                    invisible="manufacturer_request_state != 'draft'"
                />

                <!-- 3. Kitufe cha Reset to Draft -->
                <button
                    name="action_reset_task_manufacturing_request"
                    type="object"
                    string="Reset to Draft"
                    class="btn-secondary"
                    invisible="manufacturer_request_state not in ['wait_approval', 'submitted']"
                />
            </xpath>

            <!-- Product Request tab kwenye Task -->
            <xpath expr="//notebook" position="inside">
                <page
                    name="product_request"
                    string="Product Request"
                    icon="fa-cubes"
                >
                    <field
                        name="manufacturing_line_ids"
                        mode="list"
                        context="{'default_task_id': id}"
                        readonly="manufacturer_request_state != 'draft'"
                    >
                        <list editable="bottom">
                            <field name="product_id" readonly="parent.manufacturer_request_state != 'draft'"/>
                            <field name="quantity" readonly="parent.manufacturer_request_state != 'draft'"/>
                            <field name="uom_id" readonly="parent.manufacturer_request_state != 'draft'"/>
                            <field name="notes" optional="show" readonly="parent.manufacturer_request_state != 'draft'"/>
                        </list>
                    </field>

                    <div class="text-muted mt-2" invisible="manufacturer_request_state != 'draft'">
                        Add the products required for manufacturing, specify
                        the quantity and unit, then click
                        <strong>Submit Material Request</strong> above.
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         MANUFACTURING REQUEST FORM VIEW (Master-Detail)
         ============================================================ -->
    <record id="view_project_manufacturing_request_form" model="ir.ui.view">
        <field name="name">project.manufacturing.request.form</field>
        <field name="model">project.manufacturing.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <!-- Kitufe cha Approve Material Request -->
                    <button 
                        name="action_approve" 
                        type="object" 
                        string="Approve Material Request" 
                        class="btn-primary" 
                        invisible="state != 'wait_approval'"
                    />
                    
                    <!-- Vitufe vitatu vikiwa Submitted -->
                    <button 
                        name="action_issue_out" 
                        type="object" 
                        string="Issue Out" 
                        class="btn-primary" 
                        invisible="state != 'submitted'"
                    />
                    <button 
                        name="action_internal_transfer" 
                        type="object" 
                        string="Internal Transfer" 
                        class="btn-secondary" 
                        invisible="state != 'submitted'"
                    />
                    <button 
                        name="action_create_purchase_order" 
                        type="object" 
                        string="Create PO" 
                        class="btn-secondary" 
                        invisible="state != 'submitted'"
                    />

                    <!-- Statusbar yenye hatua zote 4 -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,wait_approval,submitted,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="partner_id" options="{'no_create': True}" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="submitted_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group class="mt-4">
                        <field name="notes" placeholder="Add notes..."/>
                    </group>
                </sheet>

                <!-- Chatter ya Odoo 18 -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         MANUFACTURING REQUEST LIST VIEW
         ============================================================ -->
    <record id="view_project_manufacturing_request_list" model="ir.ui.view">
        <field name="name">project.manufacturing.request.list</field>
        <field name="model">project.manufacturing.request</field>
        <field name="arch" type="xml">
            <list string="Material Requests">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="request_date"/>
                <field name="submitted_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_project_manufacturing_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">project.manufacturing.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Standalone App Menu Kuu yenye Web Icon -->
    <menuitem
        id="menu_manufacturing_request_root"
        name="Material Requests"
        web_icon="project_manufacturer_request,static/description/icon.png"
        sequence="50"/>

    <menuitem
        id="menu_manufacturing_request_sub"
        name="All Requests"
        parent="menu_manufacturing_request_root"
        action="action_project_manufacturing_request"
        sequence="10"/>

</odoo>