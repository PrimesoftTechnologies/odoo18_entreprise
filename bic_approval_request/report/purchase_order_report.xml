<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_bic_signature"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <!-- Tunatumia CSS ya kupachika chini ya page na simple box -->
            <div style="margin-top: 40px; page-break-inside: avoid; position: relative;">
                <table style="width:100%; border-collapse: collapse; font-size: 0.9em;">
                    <tr>
                        <!-- PREPARED BY: Kisanduku kidogo (simple box) -->
                        <td style="width:45%; vertical-align: top; padding: 5px;">
                            <div style="border: 1px solid #ccc; padding: 8px; border-radius: 4px; background-color: #fcfcfc;">
                                <strong style="font-size: 0.85em; color: #555;">Prepared By:</strong>
                                <div style="margin-top: 4px;">
                                    <span t-if="o.prepared_by_id" t-field="o.prepared_by_id.name" style="font-weight: bold;"/>
                                    <span t-else="" class="text-muted">N/A</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.8em; margin-top: 2px;">
                                    Date: <span t-if="o.prepared_date" t-field="o.prepared_date" t-options='{"widget": "date"}'/>
                                </div>
                            </div>
                        </td>
                        
                        <td style="width:10%;"/>

                        <!-- APPROVED BY (Finance & CEO) -->
                        <td style="width:45%; vertical-align: top; padding: 5px;">
                            <div style="border: 1px solid #ccc; padding: 8px; border-radius: 4px; background-color: #fcfcfc;">
                                <strong style="font-size: 0.85em; color: #555;">Approvals:</strong>
                                <div style="margin-top: 4px; font-size: 0.85em;">
                                    <div>
                                        <span t-if="o.finance_approver_id">Finance: <span t-field="o.finance_approver_id.name" style="font-weight: bold;"/></span>
                                        <span t-else="" class="text-muted">Finance: Pending</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.8em;">
                                        <span t-if="o.finance_approval_date" t-field="o.finance_approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                                <div style="margin-top: 6px; font-size: 0.85em; border-top: 1px dashed #ddd; padding-top: 4px;">
                                    <div>
                                        <span t-if="o.ceo_approver_id">CEO: <span t-field="o.ceo_approver_id.name" style="font-weight: bold;"/></span>
                                        <span t-else="" class="text-muted">CEO: Pending</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.8em;">
                                        <span t-if="o.ceo_approval_date" t-field="o.ceo_approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>