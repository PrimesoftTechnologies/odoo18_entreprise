<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_bic_signature"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="mt-5" style="page-break-inside: avoid;">
                <table style="width:100%; border-collapse: collapse;">
                    <tr>
                        <td style="width:45%; vertical-align: top; padding: 10px;">
                            <strong>Prepared by:</strong>
                            <div style="height: 60px;"/>
                            <div style="border-top: 1px solid #000; padding-top: 4px;">
                                <span t-if="o.prepared_by_id" t-field="o.prepared_by_id.name"/>
                                <span t-else="">Name:</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.85em;">
                                Date: <span t-if="o.prepared_date" t-field="o.prepared_date" t-options='{"widget": "date"}'/>
                            </div>
                        </td>
                        <td style="width:10%;"/>
                        <td style="width:45%; vertical-align: top; padding: 10px;">
                            <strong>Approved by:</strong>
                            <div style="height: 60px;"/>
                            <div style="border-top: 1px solid #000; padding-top: 4px;">
                                <span t-if="o.finance_approver_id"><span t-field="o.finance_approver_id.name"/> (Finance)</span>
                                <span t-else="">Finance:</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.85em;">
                                Date: <span t-if="o.finance_approval_date" t-field="o.finance_approval_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div style="height: 50px;"/>
                            <div style="border-top: 1px solid #000; padding-top: 4px;">
                                <span t-if="o.ceo_approver_id"><span t-field="o.ceo_approver_id.name"/> (CEO)</span>
                                <span t-else="">CEO:</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.85em;">
                                Date: <span t-if="o.ceo_approval_date" t-field="o.ceo_approval_date" t-options='{"widget": "date"}'/>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
