<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_footer_signature"
              inherit_id="web.external_layout">
        <xpath expr="//div[hasclass('footer')]" position="inside">
            <!-- Inaonekana tu kwenye Purchase Order na inakaa chini kabisa kama footer -->
            <div t-if="o and o._name == 'purchase.order'" style="width: 100%; font-size: 0.85em; border-top: 1px solid #ccc; padding-top: 6px; background-color: #fff;">
                <table style="width:100%; border-collapse: collapse;">
                    <tr>
                        <!-- PREPARED BY: Kisanduku kidogo upande wa kushoto -->
                        <td style="width:45%; vertical-align: top; padding: 4px;">
                            <div style="border: 1px solid #ddd; padding: 6px; border-radius: 4px; background-color: #fcfcfc;">
                                <strong style="font-size: 0.85em; color: #555;">Prepared By:</strong>
                                <div style="margin-top: 2px;">
                                    <span t-if="o.prepared_by_id" t-field="o.prepared_by_id.name" style="font-weight: bold;"/>
                                    <span t-else="" class="text-muted">N/A</span>
                                </div >
                                <div class="text-muted" style="font-size: 0.75em; margin-top: 1px;">
                                    Date: <span t-if="o.prepared_date" t-field="o.prepared_date" t-options='{"widget": "date"}'/>
                                </div>
                            </div>
                        </td>
                        
                        <td style="width:10%;"/>

                        <!-- APPROVALS (Finance & CEO): Kisanduku kidogo upande wa kulia -->
                        <td style="width:45%; vertical-align: top; padding: 4px;">
                            <div style="border: 1px solid #ddd; padding: 6px; border-radius: 4px; background-color: #fcfcfc;">
                                <strong style="font-size: 0.85em; color: #555;">Approvals:</strong>
                                <div style="margin-top: 2px; font-size: 0.8em;">
                                    <div>
                                        <span t-if="o.finance_approver_id">Finance: <span t-field="o.finance_approver_id.name" style="font-weight: bold;"/></span>
                                        <span t-else="" class="text-muted">Finance: Pending</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75em;">
                                        <span t-if="o.finance_approval_date" t-field="o.finance_approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                                <div style="margin-top: 4px; font-size: 0.8em; border-top: 1px dashed #ddd; padding-top: 3px;">
                                    <div>
                                        <span t-if="o.ceo_approver_id">CEO: <span t-field="o.ceo_approver_id.name" style="font-weight: bold;"/></span>
                                        <span t-else="" class="text-muted">CEO: Pending</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75em;">
                                        <span t-if="o.ceo_approval_date" t-field="o.ceo_approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>