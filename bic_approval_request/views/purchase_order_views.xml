<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW INHERITANCE -->
    <record id="purchase_order_form_bic_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.bic.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,finance_approval,ceo_approval,purchase</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <!-- Inaonekana finance ashapitisha lakini bado CEO hajapitisha au finance haja-approve kabisa -->
                <button name="action_finance_approve" string="Approve [Finance]"
                        type="object" class="btn-primary"
                        invisible="state != 'finance_approval'"
                        groups="bic_approval_request.group_finance_approver"/>
                
                <button name="action_bic_reject_wizard" string="Reject"
                        type="object" class="btn-secondary"
                        invisible="state not in ('finance_approval', 'ceo_approval')"
                        groups="bic_approval_request.group_finance_approver"/>

                <!-- CEO APPROVER BUTTONS -->
                <button name="action_ceo_approve" string="Approve [CEO]"
                        type="object" class="btn-primary"
                        invisible="state != 'ceo_approval'"
                        groups="bic_approval_request.group_ceo_approver"/>

                <button name="action_bic_reject_wizard" string="Reject"
                        type="object" class="btn-secondary"
                        invisible="state != 'ceo_approval'"
                        groups="bic_approval_request.group_ceo_approver"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approvals" name="bic_approvals">
                    <group>
                        <group string="Prepared">
                            <field name="prepared_by_id"/>
                            <field name="prepared_date"/>
                        </group>
                        <group string="Finance">
                            <field name="finance_approver_id"/>
                            <field name="finance_approval_date"/>
                        </group>
                        <group string="CEO">
                            <field name="ceo_approver_id"/>
                            <field name="ceo_approval_date"/>
                        </group>
                    </group>
                    <group string="Rejection Details" invisible="not reject_reason">
                        <field name="reject_reason"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- REJECTION WIZARD FORM VIEW -->
    <record id="view_purchase_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.reject.wizard.form</field>
        <field name="model">purchase.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason for Rejection">
                <group>
                    <field name="reject_reason" placeholder="Type the reason for rejection here..."/>
                </group>
                <footer>
                    <button string="Reject Order" name="action_confirm_rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>