<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_inherit_tuico" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.tuico</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="after">
                <field name="tuico" groups="bic_approval_request.group_tuico_visible"/>
            </xpath>
        </field>
    </record>
</odoo>
