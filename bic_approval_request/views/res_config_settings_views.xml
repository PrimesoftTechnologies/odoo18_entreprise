<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_tuico" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tuico</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="hr_payroll_settings" position="inside">
                <setting id="tuico_visibility"
                         string="TUICO"
                         help="Show the TUICO field on employee contracts">
                    <field name="group_tuico_visible"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
