<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bic_approval" model="ir.module.category">
        <field name="name">BIC Approval</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_finance_approver" model="res.groups">
        <field name="name">Purchase Finance Approver</field>
        <field name="category_id" ref="module_category_bic_approval"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_ceo_approver" model="res.groups">
        <field name="name">Purchase CEO Approver</field>
        <field name="category_id" ref="module_category_bic_approval"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
</odoo>
