<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Quotation -->
    <template id="report_purchaseorder_remove_discount_tax"
              inherit_id="purchase.report_purchaseorder_document">

                <!-- Add S/N column header before Description -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_serial_number" class="text-start">
                <strong>S/N</strong>
            </th>
        </xpath>

        <!-- Add S/N for each normal order line -->
        <xpath expr="//t[@t-if='not line.display_type']/td[@id='product']"
               position="before">
            <td class="text-start">
                <span t-esc="line_index + 1"/>
            </td>
        </xpath>

        <!-- Remove Discount header -->
        <xpath expr="//th[@name='th_discount']" position="replace"/>

        <!-- Remove Taxes header -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>

        <!-- Remove Discount column -->
        <xpath expr="//span[@t-field='line.discount']/ancestor::td[1]"
               position="replace"/>

        <!-- Remove Taxes column -->
        <xpath expr="//span[contains(@t-out, 'line.taxes_id')]/ancestor::td[1]"
               position="replace"/>




        <!-- Add Shipping Method -->
        <xpath expr="//div[@id='informations']/div[@t-if='o.user_id']"
               position="after">
            <div t-if="o.shipping_method" class="col">
                <strong>Shipping Method</strong>
                <div t-field="o.shipping_method"/>
            </div>
        </xpath>


    </template>

    </data>
</odoo>