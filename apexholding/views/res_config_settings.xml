<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase_terms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.terms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='purchase']" position="inside">

                <block title="Purchase Order Terms &amp; Conditions"
                       name="purchase_order_terms_conditions">

                    <setting
                        id="use_purchase_order_note"
                        string="Default Terms &amp; Conditions"
                        help="Automatically add default terms and conditions to new purchase orders.">

                        <field name="use_purchase_order_note"/>

                        <div class="content-group mt16"
                             invisible="not use_purchase_order_note">

                            <label for="purchase_order_note"
                                   string="Terms &amp; Conditions"
                                   class="o_form_label"/>

                            <field name="purchase_order_note"
                                   widget="html"
                                   class="oe_inline"
                                   placeholder="Enter your default purchase order terms and conditions..."/>

                        </div>

                    </setting>

                </block>

            </xpath>

        </field>
    </record>

</odoo>