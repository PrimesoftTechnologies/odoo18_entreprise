<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meals_employee_import_wizard_form" model="ir.ui.view">
        <field name="name">meals.employee.import.wizard.form</field>
        <field name="model">meals.employee.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Customer Employees">
                <field name="state" invisible="1"/>
                <div invisible="state != 'start'">
                    <div class="alert alert-info" role="alert">
                        File columns: <b>employee_no</b>, <b>name</b>, <b>department</b>, <b>job_title</b>
                        (first row = header; department and job_title are optional).
                        <a href="/meals_attendance_management/static/description/employee_import_template.csv"
                           target="_blank">Download template</a>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="create_departments"/>
                            <field name="update_existing"/>
                        </group>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <group>
                        <group>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                        </group>
                        <group>
                            <field name="skipped_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="result_log" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            invisible="state != 'start'"/>
                    <button name="action_view_employees" string="View Employees" type="object"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meals_employee_import" model="ir.actions.act_window">
        <field name="name">Import Employees</field>
        <field name="res_model">meals.employee.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
