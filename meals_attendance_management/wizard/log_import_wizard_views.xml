<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meals_log_import_wizard_form" model="ir.ui.view">
        <field name="name">meals.log.import.wizard.form</field>
        <field name="model">meals.log.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Attendance Machine Logs">
                <field name="state" invisible="1"/>
                <div invisible="state != 'start'">
                    <div class="alert alert-info" role="alert">
                        One row per scan. Required columns: <b>employee_no</b> and <b>datetime</b>
                        (or separate <b>date</b> and <b>time</b> columns). The meal is detected from the scan
                        time using the From/To times of the customer's meal types.
                        <a href="/meals_attendance_management/static/description/machine_logs_template.xlsx"
                           target="_blank">Download template</a>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="auto_confirm"/>
                        </group>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <group>
                        <group>
                            <field name="imported_count"/>
                            <field name="duplicate_count"/>
                        </group>
                        <group>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="sheet_ids" invisible="1"/>
                    <field name="result_log" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            invisible="state != 'start'"/>
                    <button name="action_view_sheets" string="View Sheets" type="object"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meals_log_import" model="ir.actions.act_window">
        <field name="name">Import Machine Logs</field>
        <field name="res_model">meals.log.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
