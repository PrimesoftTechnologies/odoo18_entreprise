<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meals_type_view_list" model="ir.ui.view">
        <field name="name">meals.type.list</field>
        <field name="model">meals.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="customer_id"/>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="meals_type_view_form" model="ir.ui.view">
        <field name="name">meals.type.form</field>
        <field name="model">meals.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Lunch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="meals_type_view_search" model="ir.ui.view">
        <field name="name">meals.type.search</field>
        <field name="model">meals.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meals_type" model="ir.actions.act_window">
        <field name="name">Meal Types</field>
        <field name="res_model">meals.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="meals_type_view_search"/>
        <field name="context">{'search_default_group_customer': 1}</field>
    </record>
</odoo>
