<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oscon_po_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.oscon.po.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Approvals" name="oscon_po_approval_block">
                    <setting id="oscon_po_approval_setting"
                             string="Purchase Order Approval"
                             help="Purchase orders must be approved by these users before they can be confirmed.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="oscon_po_approver_ids" string="Approvers"
                                       class="col-lg-3 o_light_label"/>
                                <field name="oscon_po_approver_ids" widget="many2many_tags"
                                       domain="[('share', '=', False)]"
                                       options="{'no_create': True}"
                                       placeholder="Add approvers..."/>
                            </div>
                            <div class="row mt8">
                                <label for="oscon_po_approval_mode" string="Approval Rule"
                                       class="col-lg-3 o_light_label"/>
                                <field name="oscon_po_approval_mode"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
