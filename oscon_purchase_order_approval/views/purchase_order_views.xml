<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_oscon_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.oscon.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide Confirm Order until approved -->
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or approval_state != 'approved'</attribute>
            </xpath>
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or approval_state != 'approved'</attribute>
            </xpath>

            <!-- New workflow buttons -->
            <xpath expr="//button[@id='draft_confirm']" position="before">
                <field name="can_approve" invisible="1"/>
                <field name="can_submit" invisible="1"/>
                <button name="action_submit_for_approval" type="object"
                        string="Submit for Approval" class="oe_highlight"
                        invisible="not can_submit"/>
                <button name="action_approve" type="object"
                        string="Approve" class="oe_highlight"
                        invisible="not can_approve"/>
                <button name="action_reject" type="object"
                        string="Reject"
                        invisible="not can_approve"/>
            </xpath>

            <!-- Status bar including approval status (the original one is hidden in Python) -->
            <xpath expr="//header" position="inside">
                <field name="oscon_status" widget="statusbar"
                       statusbar_visible="draft,submitted,approved,purchase"/>
            </xpath>

            <!-- Rejection banner -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger" role="alert"
                     invisible="approval_state != 'rejected'">
                    <strong>Rejected by <field name="rejected_by_id" class="oe_inline"/>.</strong>
                    Reason: <field name="rejection_reason" class="oe_inline"/>
                </div>
            </xpath>

            <!-- Approval tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Approval" name="oscon_approval">
                    <group>
                        <group>
                            <field name="approval_state" widget="badge"
                                   decoration-info="approval_state == 'submitted'"
                                   decoration-success="approval_state == 'approved'"
                                   decoration-danger="approval_state == 'rejected'"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="submitted_by_id"/>
                            <field name="approval_mode" invisible="approval_state == 'draft'"/>
                            <field name="rejected_by_id" invisible="approval_state != 'rejected'"/>
                            <field name="rejection_reason" invisible="approval_state != 'rejected'"/>
                        </group>
                    </group>
                    <field name="approval_line_ids">
                        <list create="0" delete="0" edit="0"
                              decoration-success="state == 'approved'"
                              decoration-danger="state == 'rejected'">
                            <field name="user_id"/>
                            <field name="state" widget="badge"/>
                            <field name="date"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
