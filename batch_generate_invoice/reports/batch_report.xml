<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- BATCH INVOICE REPORT ACTION -->
    <record id="action_report_batch_invoice" model="ir.actions.report">
        <field name="name">Batch Invoice</field>
        <field name="model">batch.invoice.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">batch_generate_invoice.report_batch_invoice_document</field>
        <field name="report_file">batch_generate_invoice.report_batch_invoice_document</field>
        <field name="binding_model_id" ref="model_batch_invoice_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWEB REPORT (DYNAMIC CURRENCY & BATCH NUMBER DESIGN) -->
    <template id="report_batch_invoice_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
                <main class="oe_structure">
                    <div class="page" style="font-size:13px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333333; padding: 10px;">

                        <!-- HEADER SECTION -->
                        <div style="width:100%; border-bottom: 2px solid #2c3e50; padding-bottom: 15px; margin-bottom: 25px;">
                            <table style="width:100%; border-collapse: collapse;">
                                <tr>
                                    <td style="vertical-align: middle;">
                                        <h2 style="font-weight: 700; color: #2c3e50; margin: 0; text-transform: uppercase; letter-spacing: 1px;">
                                            Batch Invoice
                                        </h2>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <span style="font-size: 14px; color: #2c3e50; font-weight: bold;">
                                            Batch No: <span t-esc="o.name"/>
                                        </span>
                                        <br/>
                                        <span style="font-size: 12px; color: #7f8c8d;">
                                            Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- FIRST INVOICE & DYNAMIC CURRENCY VARIABLE -->
                        <t t-set="first_inv" t-value="o.line_ids[:1].invoice_id"/>
                        <t t-set="curr_symbol" t-value="first_inv.currency_id.name or ''"/>

                        <!-- CUSTOMER INFORMATION BOX -->
                        <div style="width:100%; background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 6px; padding: 15px; margin-bottom: 30px;">
                            <table style="width:100%; border-collapse: collapse;">
                                <tr>
                                    <td style="vertical-align: top; width: 100%;">
                                        <span style="font-size: 11px; text-transform: uppercase; color: #7f8c8d; font-weight: bold; letter-spacing: 0.5px;">Billed To:</span>
                                        <div style="font-size: 15px; font-weight: bold; color: #2c3e50; margin-top: 4px; margin-bottom: 6px;">
                                            <span t-esc="first_inv.partner_id.name or 'N/A'"/>
                                        </div>
                                        <div style="font-size: 12px; color: #555555; line-height: 1.5;">
                                            <span t-if="first_inv.partner_id.street" t-esc="first_inv.partner_id.street"/><br/>
                                            <span t-if="first_inv.partner_id.city" t-esc="first_inv.partner_id.city"/>
                                            <span t-if="first_inv.partner_id.zip" t-esc="first_inv.partner_id.zip"/><br/>
                                            <span t-if="first_inv.partner_id.country_id" t-esc="first_inv.partner_id.country_id.name"/><br/>
                                            <span t-if="first_inv.partner_id.vat" style="font-weight: 600; color: #2c3e50;">
                                                TIN: <span t-esc="first_inv.partner_id.vat"/>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- INVOICE TABLE -->
                        <table style="width:100%; border-collapse: collapse; font-size: 12px; margin-bottom: 25px;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: #ffffff;">
                                    <th style="padding: 10px 8px; text-align: center; font-weight: 600; border-top-left-radius: 4px; border-bottom-left-radius: 4px; width: 15%;">Invoice Date</th>
                                    <th style="padding: 10px 8px; text-align: left; font-weight: 600; width: 25%;">Docket No. / Invoice</th>
                                    <th style="padding: 10px 8px; text-align: center; font-weight: 600; width: 25%;">SAS Reference</th>
                                    <th style="padding: 10px 8px; text-align: center; font-weight: 600; width: 20%;">Antrak Job No</th>
                                    <th style="padding: 10px 8px; text-align: right; font-weight: 600; border-top-right-radius: 4px; border-bottom-right-radius: 4px; width: 15%;">Amount (<span t-esc="curr_symbol"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_amount" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr style="border-bottom: 1px solid #e9ecef;">
                                        <td style="padding: 10px 8px; text-align: center; color: #555555;">
                                            <span t-esc="line.invoice_date and line.invoice_date.strftime('%d/%m/%Y') or '-'"/>
                                        </td>
                                        <td style="padding: 10px 8px; text-align: left; font-weight: 500; color: #2c3e50;">
                                            <span t-esc="line.invoice_number or '-'"/>
                                        </td>
                                        <td style="padding: 10px 8px; text-align: center; color: #555555;">
                                            <span t-esc="line.sas_reference or '-'"/>
                                        </td>
                                        <td style="padding: 10px 8px; text-align: center; color: #555555;">
                                            <span t-esc="line.antrak_job_no or '-'"/>
                                        </td>
                                        <td style="padding: 10px 8px; text-align: right; font-weight: 600; color: #2c3e50;">
                                            <span t-esc="line.currency_name"/> <span t-esc="'%.2f' % line.amount"/>
                                            <t t-set="total_amount" t-value="total_amount + line.amount"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS SECTION -->
                        <div style="width:100%; overflow:hidden; margin-top:10px;">
                            <div style="width:50%; float:left;">
                                <div style="font-size: 11px; color: #7f8c8d; line-height: 1.4;">
                                    <strong>Terms &amp; Conditions:</strong><br/>
                                    Payment is due as per agreed terms. Thank you for your business.
                                </div>
                            </div>
                            <div style="width:45%; float:right;">
                                <table style="width:100%; border-collapse: collapse; font-size: 12px; background-color: #f8f9fa; border-radius: 4px; border: 1px solid #e9ecef;">
                                    <tr>
                                        <td style="padding: 8px 12px; color: #555555;">TAXABLE (18%)</td>
                                        <td style="text-align: right; padding: 8px 12px; color: #555555;">
                                            <span t-esc="curr_symbol"/> 0.00
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 12px; color: #555555;">NON-TAXABLE</td>
                                        <td style="text-align: right; padding: 8px 12px; color: #555555;">
                                            <span t-esc="curr_symbol"/> <span t-esc="'%.2f' % total_amount"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 12px; color: #555555; border-bottom: 1px solid #dee2e6;">VAT 18%</td>
                                        <td style="text-align: right; padding: 8px 12px; color: #555555; border-bottom: 1px solid #dee2e6;">
                                            <span t-esc="curr_symbol"/> 0.00
                                        </td>
                                    </tr>
                                    <tr style="background-color: #e9ecef;">
                                        <td style="padding: 10px 12px; font-weight: bold; color: #2c3e50;">TOTAL <span t-esc="curr_symbol"/></td>
                                        <td style="text-align: right; padding: 10px 12px; font-weight: bold; color: #2c3e50; font-size: 14px;">
                                            <span t-esc="curr_symbol"/> <span t-esc="'%.2f' % total_amount"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </main>
            </t>
        </t>
    </template>

</odoo>