<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- BATCH INVOICE REPORT ACTION -->
    <record id="action_report_batch_invoice" model="ir.actions.report">
        <field name="name">Batch Invoice</field>
        <field name="model">batch.invoice.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">batch_generate_invoice.report_batch_invoice_document</field>
        <field name="report_file">batch_generate_invoice.report_batch_invoice_document</field>
        <field name="binding_model_id" ref="model_batch_invoice_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWEB REPORT (UNIFORM SILVER BORDERS) -->
    <template id="report_batch_invoice_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
                <main class="oe_structure">
                    <div class="page" style="font-size: 13px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333333; margin-top: 10px;">

                        <!-- FIRST INVOICE & DYNAMIC CURRENCY VARIABLE -->
                        <t t-set="first_inv" t-value="o.line_ids[:1].invoice_id"/>
                        <t t-set="curr_symbol" t-value="first_inv.currency_id.name or ''"/>

                        <!-- BATCH TITLE & DETAILS BAR -->
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #2c3e50; padding-bottom: 8px; margin-bottom: 20px;">
                            <div>
                                <h3 style="font-weight: 700; color: #2c3e50; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">
                                    Batch Invoice
                                </h3>
                            </div>
                            <div style="text-align: right;">
                                <span style="font-size: 13px; color: #2c3e50; font-weight: bold;">
                                    Batch No: <span t-esc="o.name"/>
                                </span>
                                <br/>
                                <span style="font-size: 11px; color: #666666;">
                                    Date: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </span>
                            </div>
                        </div>

                        <!-- CUSTOMER INFORMATION SECTION (CLEAN UNIFORM BOX) -->
                        <div style="margin-bottom: 25px; width: 100%;">
                            <table style="width: 100%; border-collapse: collapse; border: 1px solid #e9ecef; background-color: #f8f9fa; border-radius: 4px;">
                                <tr>
                                    <td style="width: 100%; vertical-align: top; padding: 12px; border: none;">
                                        <div style="font-size: 10px; text-transform: uppercase; color: #7f8c8d; font-weight: bold; margin-bottom: 4px; letter-spacing: 0.5px;">
                                            Billed To:
                                        </div>
                                        <div style="font-size: 14px; font-weight: bold; color: #2c3e50; margin-bottom: 4px;">
                                            <span t-esc="first_inv.partner_id.name or 'N/A'"/>
                                        </div>
                                        <div style="font-size: 11px; color: #555555; line-height: 1.4;">
                                            <t t-if="first_inv.partner_id.street">
                                                <span t-esc="first_inv.partner_id.street"/><br/>
                                            </t>
                                            <t t-if="first_inv.partner_id.city or first_inv.partner_id.zip">
                                                <span t-esc="first_inv.partner_id.city"/> <span t-esc="first_inv.partner_id.zip"/><br/>
                                            </t>
                                            <t t-if="first_inv.partner_id.country_id">
                                                <span t-esc="first_inv.partner_id.country_id.name"/><br/>
                                            </t>
                                            <t t-if="first_inv.partner_id.vat">
                                                <span style="font-weight: 600; color: #2c3e50;">TIN: <span t-esc="first_inv.partner_id.vat"/></span>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- INVOICE LINES TABLE -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 25px;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: #ffffff;">
                                    <th style="padding: 8px 6px; text-align: center; font-weight: 600; width: 15%; border: none;">Invoice Date</th>
                                    <th style="padding: 8px 6px; text-align: left; font-weight: 600; width: 25%; border: none;">Docket No. / Invoice</th>
                                    <th style="padding: 8px 6px; text-align: center; font-weight: 600; width: 25%; border: none;">SAS Reference</th>
                                    <th style="padding: 8px 6px; text-align: center; font-weight: 600; width: 20%; border: none;">Antrak Job No</th>
                                    <th style="padding: 8px 6px; text-align: right; font-weight: 600; width: 15%; border: none;">Amount (<span t-esc="curr_symbol"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_amount" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr style="border-bottom: 1px solid #e9ecef;">
                                        <td style="padding: 8px 6px; text-align: center; color: #555555; border: 1px solid #e9ecef;">
                                            <span t-esc="line.invoice_date and line.invoice_date.strftime('%d/%m/%Y') or '-'"/>
                                        </td>
                                        <td style="padding: 8px 6px; text-align: left; font-weight: 500; color: #2c3e50; border: 1px solid #e9ecef;">
                                            <span t-esc="line.invoice_number or '-'"/>
                                        </td>
                                        <td style="padding: 8px 6px; text-align: center; color: #555555; border: 1px solid #e9ecef;">
                                            <span t-esc="line.sas_reference or '-'"/>
                                        </td>
                                        <td style="padding: 8px 6px; text-align: center; color: #555555; border: 1px solid #e9ecef;">
                                            <span t-esc="line.antrak_job_no or '-'"/>
                                        </td>
                                        <td style="padding: 8px 6px; text-align: right; font-weight: 600; color: #2c3e50; border: 1px solid #e9ecef;">
                                            <span t-esc="curr_symbol"/> <span t-esc="'%.2f' % line.amount"/>
                                            <t t-set="total_amount" t-value="total_amount + line.amount"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS & TERMS SECTION -->
                        <div style="width: 100%; display: table; margin-top: 10px;">
                            <!-- Terms Left Column -->
                            <div style="display: table-cell; width: 55%; vertical-align: top; padding-right: 20px;">
                                <div style="font-size: 10px; color: #7f8c8d; line-height: 1.4;">
                                    <strong style="color: #2c3e50;">Terms &amp; Conditions:</strong><br/>
                                    Payment is due as per agreed terms. Thank you for your business.
                                </div>
                            </div>

                            <!-- Totals Right Column -->
                            <div style="display: table-cell; width: 45%; vertical-align: top;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px; background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 4px;">
                                    <tr>
                                        <td style="padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">TAXABLE (18%)</td>
                                        <td style="text-align: right; padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">
                                            <span t-esc="curr_symbol"/> 0.00
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">NON-TAXABLE</td>
                                        <td style="text-align: right; padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">
                                            <span t-esc="curr_symbol"/> <span t-esc="'%.2f' % total_amount"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">VAT 18%</td>
                                        <td style="text-align: right; padding: 6px 10px; color: #555555; border-bottom: 1px solid #e9ecef;">
                                            <span t-esc="curr_symbol"/> 0.00
                                        </td>
                                    </tr>
                                    <tr style="background-color: #e9ecef;">
                                        <td style="padding: 8px 10px; font-weight: bold; color: #2c3e50; border: none;">TOTAL <span t-esc="curr_symbol"/></td>
                                        <td style="text-align: right; padding: 8px 10px; font-weight: bold; color: #2c3e50; font-size: 12px; border: none;">
                                            <span t-esc="curr_symbol"/> <span t-esc="'%.2f' % total_amount"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </main>
            </t>
        </t>
    </template>

</odoo>