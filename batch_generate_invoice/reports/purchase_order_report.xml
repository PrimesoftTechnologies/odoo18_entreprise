<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CUSTOMIZE STANDARD PURCHASE ORDER / RFQ TO PLACE VENDOR ON THE RIGHT -->
    <template id="report_purchaseorder_document_inherit_batch_generate_invoice"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- SHOW A CLEAR "PURCHASE ORDER" HEADING WITH THE PO NUMBER -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="mt-4 mb-2">
                <h2 style="font-weight: 700; letter-spacing: 0.5px; margin-bottom: 4px;">
                    Purchase Order
                </h2>
                <div style="font-size: 14px; font-weight: bold;">
                    PO Number: <span t-field="o.name"/>
                </div>
            </div>
        </xpath>

        <!-- ONDOA ADDRESS YA KAWAIDA YA ODOO NA WEKA VENDOR UPANDE WA KULIA -->
        <xpath expr="//t[@t-call='web.address_layout']" position="replace">
            <div style="margin-top: 15px; margin-bottom: 25px; width: 100%;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <!-- UPANDE WA KUSHOTO UMEACHWA WAZI (HAKUNA SHIPPING ADDRESS) -->
                        <td style="width: 50%; vertical-align: top; padding: 0;">
                        </td>
                        
                        <td style="width: 2%;"></td>

                        <!-- VENDOR DETAILS ZIMEHAMISHIA UPANDE WA KULIA BILA BOKISI -->
                        <td style="width: 48%; vertical-align: top; padding: 0;">
                            <div style="font-size: 10px; text-transform: uppercase; color: #7f8c8d; font-weight: bold; margin-bottom: 2px; letter-spacing: 0.5px;">
                                Vendor:
                            </div>
                            <div style="font-size: 13px; font-weight: bold; color: #333333; margin-bottom: 2px;">
                                <span t-esc="o.partner_id.name or 'N/A'"/>
                            </div>
                            <div style="font-size: 11px; color: #555555; line-height: 1.4;">
                                <t t-if="o.partner_id.street">
                                    <span t-esc="o.partner_id.street"/><br/>
                                </t>
                                <t t-if="o.partner_id.city or o.partner_id.zip">
                                    <span t-esc="o.partner_id.city"/> <span t-esc="o.partner_id.zip"/><br/>
                                </t>
                                <t t-if="o.partner_id.country_id">
                                    <span t-esc="o.partner_id.country_id.name"/><br/>
                                </t>
                                <t t-if="o.partner_id.vat">
                                    <span style="font-weight: 600; color: #333333;">TIN: <span t-esc="o.partner_id.vat"/></span>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>

        <!-- RENAME "Buyer" TO "Created By" -->
        <xpath expr="//div[@id='informations']//div[@t-if='o.user_id']/strong" position="replace">
            <strong>Created By</strong>
        </xpath>

    </template>

</odoo>