<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         BATCH INVOICE TREE VIEW (HISTORY LIST - CREATE DISABLED)
         ========================================================== -->
    <record id="view_batch_invoice_tree" model="ir.ui.view">
        <field name="name">batch.invoice.tree</field>
        <field name="model">batch.invoice</field>
        <field name="arch" type="xml">
            <!-- Nimeongeza create="0" hapa ili kuondoa kitufe cha New -->
            <list string="Batch Invoices" create="0">
                <field name="name" string="Batch ID"/>
                <field name="create_date" string="Generated Date"/>
            </list>
        </field>
    </record>

    <!-- ==========================================================
         BATCH INVOICE FORM VIEW (DETAILS FOR EACH BATCH ID)
         ========================================================== -->
    <record id="view_batch_invoice_form" model="ir.ui.view">
        <field name="name">batch.invoice.form</field>
        <field name="model">batch.invoice</field>
        <field name="arch" type="xml">
            <form string="Batch Invoice Details">
                <header>
                    <button name="action_print_batch" string="Print / Preview PDF" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="invoice_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="invoice_date" string="Invoice Date" readonly="1"/>
                            <field name="invoice_number" string="Docket No. / Invoice" readonly="1"/>
                            <field name="sas_reference" string="SAS Reference"/>
                            <field name="antrak_job_no" string="Antrak Job No"/>
                            <field name="amount" string="Amount" readonly="1" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================================
         BATCH INVOICE WIZARD FORM
         ========================================================== -->
    <record id="view_batch_invoice_wizard_form" model="ir.ui.view">
        <field name="name">batch.invoice.wizard.form</field>
        <field name="model">batch.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Batch Invoice">
                <sheet>
                    <group>
                        <field name="name" readonly="1" invisible="name == 'New'"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="invoice_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="invoice_date" string="Invoice Date" readonly="1"/>
                            <field name="invoice_number" string="Docket No. / Invoice" readonly="1"/>
                            <field name="sas_reference" string="SAS Reference"/>
                            <field name="antrak_job_no" string="Antrak Job No"/>
                            <field name="amount" string="Amount" readonly="1" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_generate_batch" string="GENERATE" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==========================================================
         WINDOW ACTION FOR WIZARD
         ========================================================== -->
    <record id="action_open_batch_wizard_window" model="ir.actions.act_window">
        <field name="name">Generate Batch Invoice</field>
        <field name="res_model">batch.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_batch_invoice_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- ==========================================================
         WINDOW ACTION FOR BATCH HISTORY LIST
         ========================================================== -->
    <record id="action_batch_invoice_history" model="ir.actions.act_window">
        <field name="name">Batch Invoices</field>
        <field name="res_model">batch.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'name'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No batch invoices generated yet!
            </p>
        </field>
    </record>

    <!-- ==========================================================
         MENUITEM UNDER ACCOUNTING (CUSTOMERS SECTION)
         ========================================================== -->
    <menuitem id="menu_batch_invoice_customer"
              name="Batch Invoices"
              parent="account.menu_finance_receivables"
              action="action_batch_invoice_history"
              sequence="30"/>

    <!-- ==========================================================
         ACCOUNT MOVE TREE VIEW INHERIT
         ========================================================== -->
    <record id="view_move_tree_inherited_batch" model="ir.ui.view">
        <field name="name">account.move.tree.inherited.batch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_open_batch_wizard_window)d" string="Generate Batch" type="action" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="sas_reference" optional="show"/>
                <field name="antrak_job_no" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>