<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_batch_invoice_wizard_form" model="ir.ui.view">

        <field name="name">batch.invoice.wizard.form</field>

        <field name="model">batch.invoice.wizard</field>

        <field name="arch" type="xml">

            <form string="Generate Batch Invoice">

                <sheet>

                    <field name="line_ids" nolabel="1">

                        <list
                            editable="bottom"
                            create="0"
                            delete="0"
                        >

                            <field
                                name="invoice_id"
                                column_invisible="1"
                            />

                            <field
                                name="currency_id"
                                column_invisible="1"
                            />

                            <field
                                name="invoice_date"
                                string="Invoice Date"
                                readonly="1"
                            />

                            <field
                                name="invoice_number"
                                string="Docket No. / Invoice"
                                readonly="1"
                            />

                            <field
                                name="sas_reference"
                                string="SAS Reference"
                            />

                            <field
                                name="antrak_job_no"
                                string="Antrak Job No"
                            />

                            <field
                                name="amount"
                                string="Amount"
                                readonly="1"
                                sum="Total"
                            />

                        </list>

                    </field>

                </sheet>

                <footer>

                    <button
                        name="action_generate_batch"
                        string="GENERATE"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>

</odoo>