<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_reorder_alert_check" model="ir.cron">
        <field name="name">Reorder Alerts: check all reorder rules</field>
        <field name="model_id" ref="model_reorder_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_all()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
