<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_reorder_alert_receiver" model="res.groups">
        <field name="name">Reorder Alert Receiver</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Inventory Managers receive alerts by default -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('odoo_app_reorder_rule.group_reorder_alert_receiver'))]"/>
    </record>

    <record id="reorder_alert_company_rule" model="ir.rule">
        <field name="name">Reorder Alert: multi-company</field>
        <field name="model_id" ref="model_reorder_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
