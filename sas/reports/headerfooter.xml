<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_external_layout_folder" inherit_id="web.external_layout_folder">

        <!-- Replace Header -->
       <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout"
                style="margin: 0 !important;
                        padding: 0 !important;
                        width: 100% !important;
                        max-width: none !important;">

                <!-- Full Width Header Image -->
                <div style="margin-left: -20mm !important;
                            margin-right: -20mm !important;
                            padding: 0 !important;
                            width: calc(100% + 40mm) !important;">

                    <img src="/sas/static/src/img/header.png"
                        style="width: 100% !important;
                                max-width: 100% !important;
                                height: auto;
                                max-height: 200px;
                                display: block;
                                margin: 0 !important;
                                padding: 0 !important;
                                object-fit: cover;"
                        alt="Header Banner"/>
                </div>


            </div>
        </xpath>


        



        <!-- Replace Footer -->
        <xpath expr="//div[contains(@class, 'o_footer') or contains(@t-attf-class, 'footer o_company_')]" position="replace">
            <div t-attf-class="footer o_company_#{company.id}_layout mt-auto">

                <div class="text-center">
                    <img src="/sas/static/src/img/footer.png"
                         style="max-height: 60px; 
                                width: 100%; 
                                height: auto;"
                         alt="Footer"/>
                </div>

            </div>
        </xpath>

    </template>
</odoo>