<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">       

        <record id="seq_manifest" model="ir.sequence">
            <field name="name">Shipping Reference</field>
            <field name="code">shipping.order</field>
            <field name="prefix">SHP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_clearance_record" model="ir.sequence">
            <field name="name">Clearance Record Sequence</field>
            <field name="code">clearance.record</field>
            <field name="prefix">CLR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_transport_assignment" model="ir.sequence">
            <field name="name">Transport Sequence</field>
            <field name="code">transport.assignment</field>
            <field name="prefix">TRN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_clearance_reimbursement" model="ir.sequence">
            <field name="name">Clearance Reimbursement Note</field>
            <field name="code">clearance.reimbursement</field>
            <field name="prefix">RN.%(y)s/%(month)s/</field>
            <field name="padding">2</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">False</field>
        </record>

    </data>
</odoo>