<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="shipping_order_view_list" model="ir.ui.view">
        <field name="name">shipping.order.view.list</field>
        <field name="model">shipping.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state in ('clearing','arrived')"
                  decoration-success="state in ('cleared','received','delivered','done')"
                  decoration-muted="state == 'cancelled'"
                  sample="1">
                <field name="name" decoration-bf="1" readonly="1"/>
                <field name="create_date" widget="date"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="order_type" optional="hide"/>
                <field name="transport_mode"/>
                <field name="loading_port_id"/>
                <field name="discharging_port_id"/>
                <field name="bl_awb_number" optional="hide"/>
                <field name="eta" widget="remaining_days"/>
                <field name="is_overdue" widget="boolean" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted','clearing','arrived')"
                       decoration-success="state in ('confirmed','cleared','received','delivered','done')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>


    <record id="shipping_order_view_form" model="ir.ui.view">
        <field name="name">shipping.order.view.form</field>
        <field name="model">shipping.order</field>
        <field name="arch" type="xml">
            <form string="Shipping Order">
                <header>
                    <!-- State flow buttons -->
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'submitted'" groups="sas.group_sas_manager"/>
                    <button name="action_arrived" string="Mark Arrived" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_start_clearing" string="Customs Clearance" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_received_products" string="Receive Products (GRN)" type="object"
                            class="oe_highlight" invisible="state != 'cleared'" groups="sas.group_sas_manager"/>
                    <button name="action_open_transport_wizard" string="Create Trip" type="object"
                            class="oe_highlight" invisible="state != 'received'"/>
                    <button name="action_delivered" string="Mark Delivered" type="object"
                            class="oe_highlight" invisible="state != 'transported'"/>
                   
                    <button name="action_done" string="Mark Done" type="object"
                            class="oe_highlight" invisible="state != 'transported'"/>
                    <!-- Control buttons -->
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','submitted','confirmed','arrived')"
                            confirm="Are you sure you want to cancel this order?"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,done"
                           readonly="1"/>
                </header>

                <sheet>
                    <!-- ── Smart Buttons ── -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_clearances" icon="fa-id-card-o"
                                invisible="clearance_count == 0">
                            <field string="Clearances" name="clearance_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_pickings" icon="fa-inbox"
                                invisible="picking_count == 0">
                            <field string="GRNs" name="picking_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_transport" icon="fa-truck"
                                invisible="transport_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Transport</span>
                            </div>
                        </button>

                        <button class="oe_stat_button" type="object"
                                name="action_view_trips" icon="fa-truck"
                                invisible="trip_count == 0">
                            <field string="Trips" name="trip_count" widget="statinfo"/>
                        </button>

                    </div>

                    <!-- ── Overdue Alert ── -->
                    <div class="alert alert-warning mb-3" role="alert" invisible="not is_overdue">
                        <strong>⚠ Overdue:</strong> The ETA has passed and this order has not been cleared yet.
                    </div>

                    <!-- ── Title ── -->
                    <div class="oe_title">
                        <span class="o_form_label">Shipping Order</span>
                        <h1 class="mt0">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Core Fields ── -->
                    <group>
                        <group string="Parties">
                            <field name="shipper_id"/>
                            <field name="consignee_id" widget="res_partner_many2one"/>
                            <field name="agent_id"/>
                            <field name="customer_relation_user_id"/>
                        </group>
                        <group string="Order Info">
                            <field name="order_date"/>
                            <field name="order_type"/>
                            <field name="transport_mode"/>
                            <field name="sea_shipment_type"
                                   invisible="transport_mode != 'sea'"/>
                            <field name="air_shipment_type"
                                   invisible="transport_mode != 'air'"/>
                            <field name="land_shipment_type"
                                   invisible="transport_mode != 'land'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Routing">
                            <field name="loading_port_id"/>
                            <field name="discharging_port_id"/>
                            <field name="vessel_flight_name"/>
                            <field name="voyage_flight_number"/>
                        </group>
                        <group string="Dates">
                            <field name="etd"/>
                            <field name="atd"/>
                            <field name="eta"/>
                            <field name="ata"/>
                        </group>
                    </group>

                    <!-- ── Notebook ── -->
                    <notebook>
                        <page string="Summary">
                            <group>
                              <group>
                                <h1 class="oe_title">
                                  <label for="total_weight" string="Total Weight"/>
                                  <field name="total_weight" />
                                </h1>
                               </group>
                               <group>
                                <h1 class="oe_title">
                                  <label for="total_volume" string="Total Volume"/>
                                  <field name="total_volume" />
                                </h1>
                               </group>
                            </group>
                        </page>
                        <page string="Cargo Details" name="cargo_details">
                            <field name="line_ids">
                                <list string="Cargo Lines" editable="bottom">
                                    <field name="product_id" domain="[('is_transport_product', '=', True)]"/>
                                    <field name="cargo_description" optional="hide"/>
                                    <field name="hs_code" optional="hide"/>
                                    <field name="packages" optional="hide"/>
                                    <field name="package_type" optional="hide"/>
                                    <field name="container_number" optional="hide"/>
                                    <field name="container_type" optional="hide"/>
                                    <field name="seal_number" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                    <field name="unit_value" optional="hide"/>
                                    <field name="total_value" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 2: Documents & References -->
                        <page string="Documents &amp; References" name="documents">
                            <group>
                                <group string="Shipping Documents">
                                    <field name="bl_awb_number"/>
                                    <field name="bl_awb_date"/>
                                    <field name="do_number"/>
                                    <field name="do_date"/>
                                    <field name="do_expiry_date"/>
                                </group>
                                <group string="Reference Numbers">
                                    <field name="supplier_invoice_no"/>
                                    <field name="client_po_number"/>
                                    <field name="pad_number"/>
                                    <field name="pad_reg_number"/>
                                </group>
                            </group>
                        </page>


                        <!-- TAB 5: Remarks -->
                        <page string="Remarks" name="remarks">
                            <field name="remarks" placeholder="Add any notes or special instructions..."/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="shipping_order_search" model="ir.ui.view">
        <field name="name">shipping.order.search</field>
        <field name="model">shipping.order</field>
        <field name="arch" type="xml">
            <search string="Search Shipping Orders">
                <field name="name" string="Reference"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="bl_awb_number" string="B/L or AWB"/>
                <field name="vessel_flight_name"/>
                <separator/>
                <filter string="My Orders" name="my_orders"
                        domain="[('customer_relation_user_id', '=', uid)]"/>
                <filter string="Import" name="import" domain="[('order_type','=','import')]"/>
                <filter string="Export" name="export" domain="[('order_type','=','export')]"/>
                <separator/>
                <filter string="Sea" name="sea" domain="[('transport_mode','=','sea')]"/>
                <filter string="Air" name="air" domain="[('transport_mode','=','air')]"/>
                <filter string="Land" name="land" domain="[('transport_mode','=','land')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Clearing" name="clearing" domain="[('state','=','clearing')]"/>
                <filter string="Cleared" name="cleared" domain="[('state','=','cleared')]"/>
                <filter string="Delivered" name="delivered" domain="[('state','=','delivered')]"/>
                <group expand="1" string="Group By">
                    <filter string="State" name="groupby_state" context="{'group_by':'state'}"/>
                    <filter string="Order Type" name="groupby_type" context="{'group_by':'order_type'}"/>
                    <filter string="Transport Mode" name="groupby_mode" context="{'group_by':'transport_mode'}"/>
                    <filter string="Customer Relations Officer" name="groupby_user" context="{'group_by':'customer_relation_user_id'}"/>
                    <filter string="Shipper" name="groupby_shipper" context="{'group_by':'shipper_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sas.action_window" model="ir.actions.act_window">
        <field name="name">Shipping Orders</field>
        <field name="res_model">shipping.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shipping_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Shipping Order
            </p>
            <p>Manage import and export shipments, customs clearing, transport and delivery.</p>
        </field>
    </record>


    <record id="sas.action_window_draft" model="ir.actions.act_window">
        <field name="name">Shipping Orders</field>
        <field name="res_model">shipping.order</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="domain">[('state', '=', 'draft')]</field> -->
        <field name="search_view_id" ref="shipping_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Shipping Order
            </p>
            <p>Manage import and export shipments, customs clearing, transport and delivery.</p>
        </field>
    </record>

</odoo>