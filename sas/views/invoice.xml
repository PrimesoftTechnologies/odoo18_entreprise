<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_po_no" model="ir.ui.view">
        <field name="name">account.move.form.inherit.po.no</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add PO Number with custom label right under partner_id -->
            <xpath expr="//field[@name='partner_shipping_id']" position="after">

                <!-- The actual field -->
                <field name="po_no"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>

            </xpath>

            <!-- xpath  dn number before quantity-->
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="dn_number" optional="hide"/>
            </xpath>

                        <!-- Add fields after invoice_date -->
            <xpath expr="//field[@name='checked']" position="after">
                    <field name="awb_no"/>
                    <field name="po_no"/>
                    <field name="route_name"/>
                     <field name="terms_template_id" string="Bank Details For Payment"/>
            </xpath>

           

        </field>
    </record>
</odoo>