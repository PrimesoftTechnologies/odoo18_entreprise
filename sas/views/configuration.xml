<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="sas.list">
      <field name="name">Port list</field>
      <field name="model">freight.port</field>
      <field name="arch" type="xml">
        <list>
          <field name="code"/>
         
          <field name="name"/>
           <field name="type"/>
          <field name="country_id"/>
          
        </list>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="sas.ports">
      <field name="name">Ports</field>
      <field name="res_model">freight.port</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="sas.routes">
      <field name="name">Routes</field>
      <field name="res_model">transport.route</field>
      <field name="view_mode">list,form</field>
    </record>





  </data>
</odoo>
