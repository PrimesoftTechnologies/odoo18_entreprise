<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_estate_category" model="ir.module.category">
        <field name="name">Real Estate Management</field>
        <field name="description">Real Estate ERP Category</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_estate_user" model="res.groups">
        <field name="name">Real Estate Officer / User</field>
        <field name="category_id" ref="module_estate_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_estate_manager" model="res.groups">
        <field name="name">Real Estate Manager</field>
        <field name="category_id" ref="module_estate_category"/>
        <field name="implied_ids" eval="[(4, ref('group_estate_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
