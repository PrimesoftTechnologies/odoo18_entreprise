<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_unit_kanban" model="ir.ui.view">
        <field name="name">estate.unit.kanban</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="carpet_area"/>
                <field name="base_price"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="project_id"/> - <field name="building_id"/></div>
                                <div>Carpet: <field name="carpet_area"/> sq ft</div>
                                <div>Price: <field name="base_price" widget="monetary"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_estate_unit_tree" model="ir.ui.view">
        <field name="name">estate.unit.list</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <list string="Units">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_type_id"/>
                <field name="carpet_area"/>
                <field name="floor"/>
                <field name="pricing_mode"/>
                <field name="base_price"/>
                <field name="current_owner_id"/>
                <field name="current_tenant_id"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'reserved'" decoration-warning="state == 'sold'" decoration-danger="state == 'leased'"/>
            </list>
        </field>
    </record>

    <record id="view_estate_unit_form" model="ir.ui.view">
        <field name="name">estate.unit.form</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,sold,leased,handover_pending"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Flat 1204"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location &amp; Type">
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="unit_type_id"/>
                            <field name="floor"/>
                            <field name="facing"/>
                        </group>
                        <group string="Pricing &amp; Occupancy">
                            <field name="pricing_mode"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="base_price" invisible="pricing_mode == 'lease'"/>
                            <field name="security_deposit_amount" invisible="pricing_mode == 'sale'"/>
                            <field name="current_owner_id"/>
                            <field name="current_tenant_id"/>
                        </group>
                    </group>
                    <group string="Area Breakdown">
                        <group>
                            <field name="carpet_area"/>
                            <field name="builtup_area"/>
                        </group>
                        <group>
                            <field name="super_builtup_area"/>
                            <field name="fsi_area"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amenities" name="amenities">
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_estate_unit_search" model="ir.ui.view">
        <field name="name">estate.unit.search</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <search string="Search Units">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                <filter string="Leased" name="leased" domain="[('state', '=', 'leased')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Unit Type" name="group_type" context="{'group_by': 'unit_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_estate_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">estate.unit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_estate_unit_search"/>
    </record>

    <record id="action_estate_unit_type" model="ir.actions.act_window">
        <field name="name">Unit Types</field>
        <field name="res_model">estate.unit.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_estate_unit_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">estate.unit.amenity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
