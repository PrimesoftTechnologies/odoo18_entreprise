<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_project_kanban" model="ir.ui.view">
        <field name="name">estate.project.kanban</field>
        <field name="model">estate.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="project_type"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="code"/> | <field name="project_type"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_estate_project_tree" model="ir.ui.view">
        <field name="name">estate.project.list</field>
        <field name="model">estate.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="code"/>
                <field name="name"/>
                <field name="project_type"/>
                <field name="rera_reg_no"/>
                <field name="architect_id"/>
                <field name="building_count"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'sanctioned'" decoration-primary="state == 'construction'" decoration-success="state in ('handover', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_estate_project_form" model="ir.ui.view">
        <field name="name">estate.project.form</field>
        <field name="model">estate.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_set_sanctioned" type="object" string="Sanctioned" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_set_construction" type="object" string="Under Construction" invisible="state != 'sanctioned'" class="oe_highlight"/>
                    <button name="action_set_handover" type="object" string="Handover Phase" invisible="state != 'construction'" class="oe_highlight"/>
                    <button name="action_set_closed" type="object" string="Close Project" invisible="state != 'handover'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sanctioned,construction,handover,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-building">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_units_count"/></span>
                                <span class="o_stat_text">Units (<field name="available_units_count"/> Avail)</span>
                            </div>
                        </button>
                        <button name="action_view_boq" type="object" class="oe_stat_button" icon="fa-calculator">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="boq_count"/></span>
                                <span class="o_stat_text">BOQs</span>
                            </div>
                        </button>
                        <button name="action_view_sanctions" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="sanction_count"/></span>
                                <span class="o_stat_text">Permits</span>
                            </div>
                        </button>
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-key">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="active_leases_count"/></span>
                                <span class="o_stat_text">Active Leases</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Grand Horizon Towers"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="rera_reg_no"/>
                            <field name="project_type"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group>
                            <field name="architect_id"/>
                            <field name="site_engineer_ids" widget="many2many_tags"/>
                            <field name="oc_date"/>
                            <field name="occupancy_certificate" filename="oc_filename"/>
                            <field name="oc_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Buildings / Wings" name="buildings">
                            <field name="building_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="total_floors"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_estate_project_search" model="ir.ui.view">
        <field name="name">estate.project.search</field>
        <field name="model">estate.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name"/>
                <field name="code"/>
                <field name="rera_reg_no"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Under Construction" name="construction" domain="[('state', '=', 'construction')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project Type" name="group_project_type" context="{'group_by': 'project_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_estate_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">estate.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_estate_project_search"/>
    </record>
</odoo>
