<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="report_saleorder_document_company_approval"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[contains(@class, 'page')]"
               position="inside">
            <div t-if="doc.state == 'waiting_approval'"
                 class="mt-3 mb-3">
                <div class="alert alert-warning"
                     role="alert">
                    <strong>
                        WAIT FOR APPROVAL
                    </strong>
                    <br/>
                    This quotation is currently waiting
                    for approval.
                </div>
            </div>

            <div t-if="doc.approved_by"
                 class="mt-3 mb-3">

                <strong>
                    Approved By:
                </strong>

                <span t-field="doc.approved_by"/>

                <br/>

                <strong>
                    Approved Date:
                </strong>

                <span t-field="doc.approved_date"/>

            </div>


            <div t-if="doc.state == 'cancel'"
                 class="mt-3 mb-3">
                <div class="alert alert-danger"
                     role="alert">
                    <strong>
                        CANCELLED
                    </strong>
                    <br/>

                    This quotation / sales order has been cancelled.

                </div>

            </div>

        </xpath>

    </template>

</odoo>