<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_sale_order_line_delete_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.line.delete.wizard.form</field>
        <field name="model">sale.order.line.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason for Deletion">
                <group>
                    <field name="sale_order_line_id" invisible="1"/>
                    <field name="reason" placeholder="Reason for deletion..."/>
                </group>
                <footer>
                    <button string="Confirm Delete" type="object" name="action_confirm_delete" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Inherit Sale Order Form to add custom delete button -->
    <record id="view_order_form_inherit_apex_delete_btn" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.apex.delete.btn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Tunaongeza kitufe cha kufuta chenye kuleta Wizard kwenye kila mstari -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <button name="action_open_delete_wizard" type="object" icon="fa-trash text-danger" title="Delete with Reason"/>
            </xpath>
        </field>
    </record>
</odoo>