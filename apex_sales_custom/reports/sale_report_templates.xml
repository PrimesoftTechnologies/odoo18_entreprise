<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_revision" inherit_id="sale.report_saleorder_document">
        <!-- Badilisha sehemu inayoonyesha jina la document/order kwenye PDF iwe display_name yenye REV -->
        <xpath expr="//h2[hasclass('mt-4')]" position="replace">
            <h2 class="mt-4">
                <span t-if="doc.state == 'draft'">Quotation # </span>
                <span t-elif="doc.state == 'sent'">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.display_name"/>
            </h2>
        </xpath>
    </template>
</odoo>