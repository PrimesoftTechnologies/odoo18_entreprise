<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_non_resident" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.non_resident</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="hr_payroll_settings" position="inside">
                <setting id="non_resident_visibility"
                         string="Non-Resident"
                         help="Show the Non-Resident field on employee contracts">
                    <field name="group_non_resident_visible"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
