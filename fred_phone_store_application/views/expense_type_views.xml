<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fred_expense_type_list" model="ir.ui.view">
        <field name="name">fred.expense.type.list</field>
        <field name="model">fred.expense.type</field>
        <field name="arch" type="xml">
            <list string="Expense Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fred_expense_type_search" model="ir.ui.view">
        <field name="name">fred.expense.type.search</field>
        <field name="model">fred.expense.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fred_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">fred.expense.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first expense type</p>
            <p>Examples: Rent, Salaries, Electricity, Transport. They appear as a dropdown when you record an expense.</p>
        </field>
    </record>
</odoo>
