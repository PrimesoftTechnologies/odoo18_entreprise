<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST -->
    <record id="view_fred_pl_report_list" model="ir.ui.view">
        <field name="name">fred.pl.report.wizard.list</field>
        <field name="model">fred.pl.report.wizard</field>
        <field name="arch" type="xml">
            <list string="Profit and Loss" create="0">
                <header>
                    <button name="%(action_fred_pl_report_new)d" type="action"
                            string="Compute Profit" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="config_ids" widget="many2many_tags"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_sales" widget="monetary"/>
                <field name="total_cost" widget="monetary"/>
                <field name="gross_profit" widget="monetary"/>
                <field name="total_expenses" widget="monetary"/>
                <field name="net_profit" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_fred_pl_report_wizard_form" model="ir.ui.view">
        <field name="name">fred.pl.report.wizard.form</field>
        <field name="model">fred.pl.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Profit and Loss">
                <header>
                    <button name="action_generate" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print PDF"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="config_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="All shops"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <group>
                            <field name="total_sales" widget="monetary" readonly="1"/>
                            <field name="total_cost" widget="monetary" readonly="1"/>
                            <field name="gross_profit" widget="monetary" readonly="1" class="fw-bold"/>
                        </group>
                        <group>
                            <field name="total_expenses" widget="monetary" readonly="1"/>
                            <field name="net_profit" widget="monetary" readonly="1" class="fw-bold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="product_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name" string="Product"/>
                                    <field name="qty"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="sales" sum="Total" widget="monetary"/>
                                    <field name="cost" sum="Total" widget="monetary"/>
                                    <field name="profit" sum="Total" widget="monetary"/>
                                    <field name="margin" widget="float" digits="[16,1]"/>
                                </list>
                            </field>
                        </page>
                        <page string="Expenses" name="expenses">
                            <field name="expense_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name" string="Category"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="profit" string="Amount" sum="Total" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens a NEW empty form (used by the "Compute Profit" button) -->
    <record id="action_fred_pl_report_new" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">fred.pl.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'form', 'view_id': ref('view_fred_pl_report_wizard_form')})]"/>
        <field name="target">current</field>
    </record>

    <!-- Menu action: LIST of reports -->
    <record id="action_fred_pl_report_wizard" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">fred.pl.report.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Profit and Loss report yet</p>
            <p>Click <b>Compute Profit</b> to create your first report.</p>
        </field>
    </record>
</odoo>
