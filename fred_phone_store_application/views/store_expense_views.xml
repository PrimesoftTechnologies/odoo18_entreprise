<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fred_store_expense_list" model="ir.ui.view">
        <field name="name">fred.store.expense.list</field>
        <field name="model">fred.store.expense</field>
        <field name="arch" type="xml">
            <list string="Store Expenses" sample="1">
                <field name="date"/>
                <field name="name"/>
                <field name="expense_type_id"/>
                <field name="config_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_fred_store_expense_form" model="ir.ui.view">
        <field name="name">fred.store.expense.form</field>
        <field name="model">fred.store.expense</field>
        <field name="arch" type="xml">
            <form string="Store Expense">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expense_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="config_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fred_store_expense_search" model="ir.ui.view">
        <field name="name">fred.store.expense.search</field>
        <field name="model">fred.store.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="expense_type_id"/>
                <field name="config_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Expense Type" context="{'group_by': 'expense_type_id'}"/>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'config_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fred_store_expense" model="ir.actions.act_window">
        <field name="name">List of Expenses</field>
        <field name="res_model">fred.store.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first store expense</p>
            <p>Rent, salaries, electricity, transport... These are deducted from Profit to get Net Profit.</p>
        </field>
    </record>
</odoo>
