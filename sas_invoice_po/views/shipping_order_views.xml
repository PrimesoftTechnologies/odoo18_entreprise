<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Fomu ya kuweka Attachment chini ya B/L / AWB /RCN no -->
    <record id="view_shipping_order_form_inherit_attachment" model="ir.ui.view">
        <field name="name">shipping.order.form.inherit.attachment</field>
        <field name="model">shipping.order</field>
        <field name="inherit_id" ref="sas.view_shipping_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bl_awb_number']" position="after">
                <field name="attachment_file" filename="attachment_name" widget="binary" required="1"/>
                <field name="attachment_name" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Search View ya kutafutia na kupanga makundi -->
    <record id="view_shipping_order_search_inherit_po" model="ir.ui.view">
        <field name="name">shipping.order.search.inherit.po</field>
        <field name="model">shipping.order</field>
        <field name="inherit_id" ref="sas.view_shipping_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="client_po_number" string="Client PO No." filter_domain="[('client_po_number', 'ilike', self)]"/>
                <separator/>
                <filter string="Client PO No." name="group_by_client_po" domain="[]" context="{'group_by': 'client_po_number'}"/>
            </xpath>
        </field>
    </record>
</odoo>