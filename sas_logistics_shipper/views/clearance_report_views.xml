<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clearance_report_wizard_form_inherit_sas_shipper" model="ir.ui.view">
        <field name="name">shipping.clearance.report.form.inherit.sas.shipper</field>
        <field name="model">shipping.clearance.report</field>
        <!-- Tunarithi form view kutoka kwenye moduli ya 'sas' -->
        <field name="inherit_id" ref="sas.view_shipping_clearance_report_form"/> <!-- Hakikisha external ID ya view ya sas inaendana hapa -->
        <field name="arch" type="xml">
            <!-- Tunaweka sas_shipper baada ya consignee_id -->
            <xpath expr="//field[@name='consignee_id']" position="after">
                <field name="sas_shipper"/>
            </xpath>
        </field>
    </record>
</odoo>