<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         VAN LOAD OPERATION TYPE
         Warehouse -> Van
         ========================================================== -->

    <record id="picking_type_van_load" model="stock.picking.type">
        <field name="name">Van Sale Load</field>
        <field name="code">internal</field>
        <field name="sequence_code">VANLOAD</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="use_create_lots" eval="False"/>
        <field name="use_existing_lots" eval="False"/>
    </record>


    <!-- ==========================================================
         VAN UNLOAD OPERATION TYPE
         Van -> Warehouse
         ========================================================== -->

    <record id="picking_type_van_unload" model="stock.picking.type">
        <field name="name">Van Sale Unload</field>
        <field name="code">internal</field>
        <field name="sequence_code">VANUNLOAD</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="use_create_lots" eval="False"/>
        <field name="use_existing_lots" eval="False"/>
    </record>

</odoo>