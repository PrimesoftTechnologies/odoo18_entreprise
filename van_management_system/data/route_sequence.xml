<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_van_route" model="ir.sequence">
        <field name="name">Van Route</field>
        <field name="code">van.route</field>
        <field name="prefix">ROUTE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ONGEZA HII HAPA CHINI -->
    <record id="seq_van_retirement_route" model="ir.sequence">
        <field name="name">Van Route Retirement</field>
        <field name="code">van.retirement.route</field>
        <field name="prefix">VR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>