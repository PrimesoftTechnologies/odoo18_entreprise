<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_van_distribution" model="ir.module.category">
        <field name="name">Van Distribution</field>
        <field name="description">Van Distribution Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_van_salesman" model="res.groups">
        <field name="name">Van Salesman</field>
        <field name="category_id" ref="module_category_van_distribution"/>
    </record>

    <!-- Supervisor (Hasirithi Salesman moja kwa moja ili kuondoa mgongano wa ruhusa) -->
    <record id="group_van_supervisor" model="res.groups">
        <field name="name">Van Supervisor</field>
        <field name="category_id" ref="module_category_van_distribution"/>
    </record>

    <record id="group_van_manager" model="res.groups">
        <field name="name">Van Distribution Manager</field>
        <field name="category_id" ref="module_category_van_distribution"/>
        <field name="implied_ids" eval="[(4, ref('group_van_supervisor'))]"/>
    </record>

    <!-- ========================================================== -->
    <!-- RECORD RULES                                               -->
    <!-- ========================================================== -->

    <!-- Salesman: Own Van Transfers -->
    <record id="rule_van_transfer_salesman" model="ir.rule">
        <field name="name">Salesman: Own Van Transfers</field>
        <field name="model_id" ref="model_van_stock_transfer"/>
        <field name="groups" eval="[(4, ref('group_van_salesman'))]"/>
        <field name="domain_force">['|', ('salesman_id', '=', user.id), ('requested_by', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Van Transfer Approver: See All Company Transfers -->
    <record id="rule_van_transfer_approver" model="ir.rule">
        <field name="name">Van Transfer Approver: See All Company Transfers</field>
        <field name="model_id" ref="model_van_stock_transfer"/>
        <field name="groups" eval="[(4, ref('group_van_supervisor')), (4, ref('group_van_manager'))]"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Salesman: Own Van -->
    <record id="rule_van_vehicle_salesman" model="ir.rule">
        <field name="name">Salesman: Own Van</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('group_van_salesman'))]"/>
        <field name="domain_force">[('van_salesman_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Salesman: Own Van Routes (Retirement) -->
    <record id="rule_van_route_salesman" model="ir.rule">
        <field name="name">Salesman: Own Van Routes</field>
        <field name="model_id" ref="model_van_route"/>
        <field name="groups" eval="[(4, ref('group_van_salesman'))]"/>
        <field name="domain_force">['|', ('van_id.van_salesman_id', '=', user.id), ('van_id', '=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Supervisor & Manager: See All Van Routes (Retirement) -->
    <record id="rule_van_route_manager" model="ir.rule">
        <field name="name">Supervisor/Manager: All Van Routes</field>
        <field name="model_id" ref="model_van_route"/>
        <field name="groups" eval="[(4, ref('group_van_supervisor')), (4, ref('group_van_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>