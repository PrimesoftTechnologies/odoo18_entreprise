<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="engineering_dashboard_template">

        <div
            class="container-fluid o_engineering_dashboard my-4"
            style="font-family: Tahoma, Arial, sans-serif;"
        >

            <div class="row mb-4">
                <div class="col-12 text-center">

                    <h2
                        class="fw-bold"
                        style="
                            color: #333;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >
                        Engineering Site Survey Dashboard
                    </h2>

                    <hr
                        style="
                            width: 200px;
                            margin: 10px auto;
                            border-top: 3px solid #17a2b8;
                        "
                    />

                </div>
            </div>

            <div
                class="row bg-white p-3 mb-3 rounded shadow-sm align-items-end"
                style="font-family: Tahoma, Arial, sans-serif;"
            >

                <div class="col-md-3 mb-2">

                    <label class="form-label fw-bold text-muted small">
                        <i class="fa fa-calendar"/>
                        From Date
                    </label>

                    <input
                        type="date"
                        id="dash_from_date"
                        class="form-control"
                        t-model="state.from_date"
                    />

                </div>

                <div class="col-md-3 mb-2">

                    <label class="form-label fw-bold text-muted small">
                        <i class="fa fa-calendar"/>
                        To Date
                    </label>

                    <input
                        type="date"
                        id="dash_to_date"
                        class="form-control"
                        t-model="state.to_date"
                    />

                </div>

                <div class="col-md-3 mb-2">

                    <label class="form-label fw-bold text-muted small">
                        <i class="fa fa-filter"/>
                        Stage
                    </label>

                    <select
                        id="dash_stage"
                        class="form-select"
                        t-model="state.stage"
                    >

                        <option value="all">
                            All Stages
                        </option>

                        <option value="draft">
                            Draft
                        </option>

                        <option value="submitted">
                            Submitted
                        </option>

                        <option value="approved">
                            Approved
                        </option>

                        <option value="survey_done">
                            Survey Done
                        </option>

                        <option value="report_submitted">
                            Report Submitted
                        </option>

                        <option value="completed">
                            Completed
                        </option>

                    </select>

                </div>

                <div class="col-md-3 mb-2">

                    <button
                        type="button"
                        class="btn w-100 text-white fw-bold"
                        style="
                            background-color: #6f42c1;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                        t-on-click="onSearchClick"
                    >
                        <i class="fa fa-search"/>
                        Search
                    </button>

                </div>

            </div>

            <div class="row mb-4">

                <div class="col-12">

                    <div
                        class="d-flex align-items-center justify-content-between px-3 py-2 rounded shadow-sm"
                        style="
                            background-color: #ffffff;
                            border-left: 4px solid #17a2b8;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >

                        <div class="d-flex align-items-center">

                            <div
                                class="d-flex align-items-center justify-content-center rounded-circle me-2"
                                style="
                                    width: 32px;
                                    height: 32px;
                                    background-color: #17a2b8;
                                    color: #ffffff;
                                "
                            >
                                <i class="fa fa-money"/>
                            </div>

                            <span
                                class="fw-bold text-muted"
                                style="font-size: 13px;"
                            >
                                TOTAL AMOUNT REQUESTED
                            </span>

                        </div>

                        <span
                            class="fw-bold"
                            style="
                                color: #17a2b8;
                                font-size: 18px;
                            "
                        >
                            <t t-if="state.currency_code">
                                <t t-esc="state.currency_code"/>
                                <t t-esc="' '"/>
                            </t>

                            <t t-esc="formatAmount(state.total_amount)"/>
                        </span>

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-xl-3 col-md-6 mb-4">

                    <div
                        class="card text-white shadow border-0 h-100"
                        style="
                            background-color: #5c6873;
                            border-radius: 6px;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >

                        <div
                            class="card-body"
                            style="min-height: 120px;"
                        >

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h1
                                        class="display-5 fw-bold mb-0 text-white"
                                        t-esc="state.draft_count"
                                    />

                                    <p
                                        class="card-text mt-1 text-white"
                                        style="
                                            font-size: 15px;
                                            font-family: Tahoma, Arial, sans-serif;
                                        "
                                    >
                                        Draft Surveys
                                    </p>

                                </div>

                                <div>
                                    <i
                                        class="fa fa-file-text-o fa-3x text-white"
                                        style="opacity: 0.45;"
                                    />
                                </div>

                            </div>

                        </div>

                        <div
                            class="card-footer d-flex justify-content-between align-items-center py-2"
                            style="
                                background-color: #5c6873;
                                border-top: 1px solid rgba(255,255,255,0.15);
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                            "
                        >

                            <a
                                href="#"
                                class="text-decoration-none small fw-bold px-2 py-1 rounded"
                                style="
                                    color: #f5f5f5;
                                    background-color: rgba(0,0,0,0.18);
                                    font-family: Tahoma, Arial, sans-serif;
                                "
                                t-on-click.prevent="() => this.onViewDetails('draft')"
                            >
                                View Details
                            </a>

                            <i
                                class="fa fa-ellipsis-h"
                                style="color: #e6e6e6;"
                            />

                        </div>

                    </div>

                </div>

                <div class="col-xl-3 col-md-6 mb-4">

                    <div
                        class="card text-white shadow border-0 h-100"
                        style="
                            background-color: #ffc107;
                            border-radius: 6px;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >

                        <div
                            class="card-body"
                            style="min-height: 120px;"
                        >

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h1
                                        class="display-5 fw-bold mb-0 text-white"
                                        t-esc="state.pending_count"
                                    />

                                    <p
                                        class="card-text mt-1 text-white"
                                        style="
                                            font-size: 15px;
                                            font-family: Tahoma, Arial, sans-serif;
                                        "
                                    >
                                        To Approve &amp; Pending
                                    </p>

                                </div>

                                <div>
                                    <i
                                        class="fa fa-clock-o fa-3x text-white"
                                        style="opacity: 0.45;"
                                    />
                                </div>

                            </div>

                        </div>

                        <div
                            class="card-footer d-flex justify-content-between align-items-center py-2"
                            style="
                                background-color: #ffc107;
                                border-top: 1px solid rgba(255,255,255,0.25);
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                            "
                        >

                            <a
                                href="#"
                                class="text-decoration-none small fw-bold px-2 py-1 rounded"
                                style="
                                    color: #f5f5f5;
                                    background-color: rgba(0,0,0,0.18);
                                    font-family: Tahoma, Arial, sans-serif;
                                "
                                t-on-click.prevent="() => this.onViewDetails('pending')"
                            >
                                View Details
                            </a>

                            <i
                                class="fa fa-ellipsis-h"
                                style="color: #f5f5f5;"
                            />

                        </div>

                    </div>

                </div>

                <div class="col-xl-3 col-md-6 mb-4">

                    <div
                        class="card text-white shadow border-0 h-100"
                        style="
                            background-color: #28a745;
                            border-radius: 6px;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >

                        <div
                            class="card-body"
                            style="min-height: 120px;"
                        >

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h1
                                        class="display-5 fw-bold mb-0 text-white"
                                        t-esc="state.completed_count"
                                    />

                                    <p
                                        class="card-text mt-1 text-white"
                                        style="
                                            font-size: 15px;
                                            font-family: Tahoma, Arial, sans-serif;
                                        "
                                    >
                                        Completed
                                    </p>

                                </div>

                                <div>
                                    <i
                                        class="fa fa-check-circle fa-3x text-white"
                                        style="opacity: 0.45;"
                                    />
                                </div>

                            </div>

                        </div>

                        <div
                            class="card-footer d-flex justify-content-between align-items-center py-2"
                            style="
                                background-color: #28a745;
                                border-top: 1px solid rgba(255,255,255,0.15);
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                            "
                        >

                            <a
                                href="#"
                                class="text-decoration-none small fw-bold px-2 py-1 rounded"
                                style="
                                    color: #f5f5f5;
                                    background-color: rgba(0,0,0,0.18);
                                    font-family: Tahoma, Arial, sans-serif;
                                "
                                t-on-click.prevent="() => this.onViewDetails('completed')"
                            >
                                View Details
                            </a>

                            <i
                                class="fa fa-ellipsis-h"
                                style="color: #e6e6e6;"
                            />

                        </div>

                    </div>

                </div>

                <div class="col-xl-3 col-md-6 mb-4">

                    <div
                        class="card text-white shadow border-0 h-100"
                        style="
                            background-color: #17a2b8;
                            border-radius: 6px;
                            font-family: Tahoma, Arial, sans-serif;
                        "
                    >

                        <div
                            class="card-body"
                            style="min-height: 120px;"
                        >

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h1
                                        class="display-5 fw-bold mb-0 text-white"
                                        t-esc="state.total_count"
                                    />

                                    <p
                                        class="card-text mt-1 text-white"
                                        style="
                                            font-size: 15px;
                                            font-family: Tahoma, Arial, sans-serif;
                                        "
                                    >
                                        All Surveys
                                    </p>

                                </div>

                                <div>
                                    <i
                                        class="fa fa-users fa-3x text-white"
                                        style="opacity: 0.45;"
                                    />
                                </div>

                            </div>

                        </div>

                        <div
                            class="card-footer d-flex justify-content-between align-items-center py-2"
                            style="
                                background-color: #17a2b8;
                                border-top: 1px solid rgba(255,255,255,0.15);
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                            "
                        >

                            <a
                                href="#"
                                class="text-decoration-none small fw-bold px-2 py-1 rounded"
                                style="
                                    color: #f5f5f5;
                                    background-color: rgba(0,0,0,0.18);
                                    font-family: Tahoma, Arial, sans-serif;
                                "
                                t-on-click.prevent="() => this.onViewDetails('all')"
                            >
                                View Details
                            </a>

                            <i
                                class="fa fa-ellipsis-h"
                                style="color: #e6e6e6;"
                            />

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </t>

</templates>