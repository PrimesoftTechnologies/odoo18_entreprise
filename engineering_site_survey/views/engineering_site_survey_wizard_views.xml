<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_engineering_site_survey_reject_wizard_form" model="ir.ui.view">
        <field name="name">engineering.site.survey.reject.wizard.form</field>
        <field name="model">engineering.site.survey.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Site Survey">
                <group>
                    <field name="survey_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Reason for rejection..."/>
                </group>
                <footer>
                    <button string="Confirm Rejection" name="action_confirm_rejection" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>