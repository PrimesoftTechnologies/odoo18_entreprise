<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- EXPENSE TYPE LIST VIEW -->
    <record id="view_engineering_expense_type_list" model="ir.ui.view">
        <field name="name">engineering.expense.type.list</field>
        <field name="model">engineering.expense.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- SITE SURVEY LIST VIEW -->
    <record id="view_engineering_site_survey_list" model="ir.ui.view">
        <field name="name">engineering.site.survey.list</field>
        <field name="model">engineering.site.survey</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_project"/>
                <field name="location"/>
                <field name="responsible_engineer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="due_date"/>
                <field name="total_requested" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- SITE SURVEY FORM VIEW -->
    <record id="view_engineering_site_survey_form" model="ir.ui.view">
        <field name="name">engineering.site.survey.form</field>
        <field name="model">engineering.site.survey</field>
        <field name="arch" type="xml">
            <form string="Engineering Site Survey">
                <header>
                    <field name="is_approver" invisible="1"/>
                    <field name="is_responsible_engineer" invisible="1"/>
                    <field name="lead_created" invisible="1"/>
                    <field name="ticket_created" invisible="1"/>

                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted' or not is_approver"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'submitted' or not is_approver"/>
                    <button name="action_cancel_approval" type="object" string="Cancel Approval" class="btn-warning" invisible="state != 'approved' or not is_approver"/>

                    <button name="action_survey_done" type="object" string="Survey Done" class="btn-primary" invisible="state != 'approved' or not is_responsible_engineer"/>

                    <button name="action_submit_report" type="object" string="Submit Report" class="btn-primary" invisible="state != 'survey_done'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'report_submitted'"/>

                    <button name="action_continue_lead" type="object" string="Create Lead" class="btn-secondary" invisible="state != 'completed' or lead_created"/>
                    <button name="action_reset_lead" type="object" string="Reset Lead" class="btn-warning" invisible="state != 'completed' or not lead_created"/>
                    
                    <button name="action_help_desk" type="object" string="Create Complain" class="btn-secondary" invisible="state != 'completed' or ticket_created"/>
                    <button name="action_reset_help_desk" type="object" string="Reset Help Desk" class="btn-warning" invisible="state != 'completed' or not ticket_created"/>

                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed','cancelled','rejected','approved')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('cancelled','rejected')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,survey_done,report_submitted,completed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-star">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="ticket_count" widget="statinfo" string="Helpdesk"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money" style="pointer-events: none;">
                            <field name="total_requested" widget="statinfo" options="{'currency_field': 'currency_id'}" string="Total Request"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="alert alert-danger text-center" role="alert" invisible="state != 'rejected'">
                        <h4><i class="fa fa-exclamation-triangle"/> Survey Rejected</h4>
                        <field name="rejection_reason" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="site_project"/>
                            <field name="location"/>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                        </group>

                        <group>
                            <field name="responsible_engineer_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="due_date"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Survey Description">
                            <field name="survey_purpose" placeholder="Describe the purpose and scope..."/>
                        </page>
                        <page string="Expenses">
                            <group>
                                <group>
                                    <field name="expense_request_type"/>
                                    <field name="number_of_people" invisible="expense_request_type != 'group'"/>
                                </group>
                            </group>
                            <field name="expense_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="expense_type_id"/>
                                    <field name="cost"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="expense_total" string="Grand Total" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-5"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fuel Cost">
                            <field name="fuel_line_ids">
                                <list editable="bottom">
                                    <field name="vehicle_type"/>
                                    <field name="fuel_type"/>
                                    <field name="location_from"/>
                                    <field name="location_to"/>
                                    <field name="litres"/>
                                    <field name="price_per_litre"/>
                                    <field name="total_amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="fuel_total" string="Grand Total" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-5"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Site Survey Report">
                            <group>
                                <field name="actual_survey_date"/>
                                <field name="client_representative"/>
                            </group>
                            <group string="Inspection &amp; Findings">
                                <field name="areas_inspected"/>
                                <field name="site_conditions"/>
                                <field name="technical_findings"/>
                                <field name="existing_infrastructure"/>
                                <field name="issues_identified"/>
                            </group>
                            <group string="Requirements &amp; Engineering Recommendation">
                                <field name="client_requirements"/>
                                <field name="engineer_observations"/>
                                <field name="recommendations"/>
                                <field name="proposed_solution"/>
                                <field name="materials_required"/>
                                <field name="safety_observations"/>
                                <field name="additional_notes"/>
                                <field name="conclusion"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- CRM LEAD FORM INHERIT VIEW -->
    <record id="crm_lead_view_form_inherit_engineering" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.engineering</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_engineering_survey" 
                        string="New Site Survey" 
                        type="object" 
                        class="btn-primary" 
                        invisible="survey_id"/>
                <button name="action_reset_engineering_survey" 
                        string="Reset Site Survey" 
                        type="object" 
                        class="btn-warning" 
                        invisible="not survey_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_engineering_survey" type="object" class="oe_stat_button" icon="fa-clipboard" invisible="not survey_id">
                    <field name="survey_count" widget="statinfo" string="Site Survey"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_engineering_site_survey_search" model="ir.ui.view">
        <field name="name">engineering.site.survey.search</field>
        <field name="model">engineering.site.survey</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_project"/>
                <field name="responsible_engineer_id"/>
                <filter string="My Surveys" name="my_surveys" domain="[('responsible_engineer_id.user_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Engineer" name="group_engineer" context="{'group_by':'responsible_engineer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SETTINGS VIEW -->
    <record id="res_config_settings_view_form_engineering" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.engineering</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Engineering Survey" string="Engineering Survey" name="engineering_site_survey">
                    <block title="Approvals" name="engineering_approval_setting_container">
                        <setting id="survey_approver_setting" title="Default Approver" help="Set default user">
                            <field name="survey_approver_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_engineering_site_survey" model="ir.actions.act_window">
        <field name="name">Site Surveys</field>
        <field name="res_model">engineering.site.survey</field>
        <field name="view_mode">list,form,kanban,graph,pivot</field>
    </record>

    <record id="action_engineering_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">engineering.expense.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_engineering_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'engineering_site_survey'}</field>
    </record>

    <!-- CLIENT ACTION YA DASHBOARD -->
    <record id="action_client_engineering_dashboard" model="ir.actions.client">
        <field name="name">Engineering Dashboard</field>
        <field name="tag">engineering_dashboard_tag</field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_engineering_site_survey_root" name="Engineering Survey" web_icon="engineering_site_survey,static/description/icon.png" sequence="30"/>
    
    <menuitem id="menu_engineering_dashboard_root" 
              name="Dashboard" 
              parent="menu_engineering_site_survey_root" 
              action="action_client_engineering_dashboard"
              sequence="1"/>

    <menuitem id="menu_engineering_site_survey" name="Request Site Survey" parent="menu_engineering_site_survey_root" action="action_engineering_site_survey" sequence="10"/>

    <menuitem id="menu_engineering_config" name="Configuration" parent="menu_engineering_site_survey_root" sequence="100"/>
    <menuitem id="menu_engineering_config_settings" name="Settings" parent="menu_engineering_config" action="action_engineering_config_settings" sequence="1"/>
    <menuitem id="menu_engineering_expense_type" name="Expense Types" parent="menu_engineering_config" action="action_engineering_expense_type" sequence="10"/>

</odoo>