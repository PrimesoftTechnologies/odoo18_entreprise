<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_purchase_approval" model="ir.ui.view">
        <field name="name">res.company.form.purchase.approval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Purchase Approval">
                    <group>
                        <field name="purchase_approval_required"/>
                        <field name="procurement_manager_id" invisible="not purchase_approval_required" options="{'no_create': True}"/>
                        <field name="finance_manager_id" invisible="not purchase_approval_required" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>