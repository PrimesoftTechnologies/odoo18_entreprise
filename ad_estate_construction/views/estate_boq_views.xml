<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_boq_tree" model="ir.ui.view">
        <field name="name">estate.boq.list</field>
        <field name="model">estate.boq</field>
        <field name="arch" type="xml">
            <list string="BOQ Estimates">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="wbs_phase"/>
                <field name="subtotal_direct_cost"/>
                <field name="overhead_cost"/>
                <field name="margin_cost"/>
                <field name="total_estimated_cost"/>
            </list>
        </field>
    </record>

    <record id="view_estate_boq_form" model="ir.ui.view">
        <field name="name">estate.boq.form</field>
        <field name="model">estate.boq</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities (BOQ)">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Phase 1 Civil BOQ"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="building_id"/>
                            <field name="wbs_phase"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="overhead_pct"/>
                            <field name="margin_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Line Items" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="item_type"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_rate"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="consumed_qty"/>
                                    <field name="remaining_qty"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal_direct_cost" widget="monetary"/>
                                <field name="overhead_cost" widget="monetary"/>
                                <field name="margin_cost" widget="monetary"/>
                                <field name="total_estimated_cost" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_estate_boq" model="ir.actions.act_window">
        <field name="name">Bill of Quantities (BOQ)</field>
        <field name="res_model">estate.boq</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
