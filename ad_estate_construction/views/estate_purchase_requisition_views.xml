<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_purchase_requisition_tree" model="ir.ui.view">
        <field name="name">estate.purchase.requisition.list</field>
        <field name="model">estate.purchase.requisition</field>
        <field name="arch" type="xml">
            <list string="Purchase Requisitions">
                <field name="name"/>
                <field name="project_id"/>
                <field name="boq_id"/>
                <field name="requested_by_id"/>
                <field name="date_required"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'done')"/>
            </list>
        </field>
    </record>

    <record id="view_estate_purchase_requisition_form" model="ir.ui.view">
        <field name="name">estate.purchase.requisition.form</field>
        <field name="model">estate.purchase.requisition</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition">
                <header>
                    <button name="action_submit" type="object" string="Submit to Manager" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve Requisition" invisible="state != 'submitted'" class="oe_highlight" groups="estate_base.group_estate_manager"/>
                    <button name="action_create_po" type="object" string="Create Purchase Order" invisible="state != 'approved'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="boq_id"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="date_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="boq_line_id" domain="[('boq_id', '=', parent.boq_id)]"/>
                                    <field name="product_id"/>
                                    <field name="boq_remaining_qty"/>
                                    <field name="qty_requested"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_estate_purchase_requisition" model="ir.actions.act_window">
        <field name="name">Purchase Requisitions</field>
        <field name="res_model">estate.purchase.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
