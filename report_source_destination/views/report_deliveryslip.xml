<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherited_locations" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <div class="row mt-3" id="stock_locations_row">
                <div class="col-6" t-if="o.location_id" name="div_source_location">
                    <span class="text-muted">Source Location</span>
                    <p class="m-0" t-field="o.location_id.complete_name"/>
                </div>
                <div class="col-6" t-if="o.location_dest_id" name="div_dest_location">
                    <span class="text-muted">Destination Location</span>
                    <p class="m-0" t-field="o.location_dest_id.complete_name"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>