<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Kuongeza Helper kwenye Form View (Kama tulivyofanya mwanzo) -->
    <record id="view_order_form_inherit_sales_helper" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sales.helper</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="helper_id" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Kuongeza Helper kwenye Tree/List View ili iweze kuonekana kwenye hiyo menu ya kuchagua -->
    <record id="view_quotation_tree_inherit_sales_helper" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.sales.helper</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <!-- Tunaweka field ya helper_id kwenye list view, unaweza kuiweka baada ya user_id (Salesperson) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="helper_id" optional="show" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>
</odoo>