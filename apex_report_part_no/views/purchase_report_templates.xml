<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         SHOW PRODUCT NAME ONLY
         ============================================================ -->

    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         SHOW PRODUCT NAME ONLY
         ============================================================ -->

    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         RENAME CUSTOMER REFERENCE
         ============================================================ -->

    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">Purchase Order No.</attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER / QUOTATION REPORT
         REMOVE CURRENCY FROM LINE VALUES
         ============================================================ -->

    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <!-- AMOUNT HEADER -->

        <xpath expr="//th[@name='th_subtotal']"
               position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <!-- UNIT PRICE WITHOUT CURRENCY -->

        <xpath expr="//td[@name='td_priceunit']"
               position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{'widget': 'float', 'precision': 2}"/>

            </td>

        </xpath>


        <!-- AMOUNT WITHOUT CURRENCY -->

        <xpath expr="//td[@name='td_subtotal']"
               position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{'widget': 'float', 'precision': 2}"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         ============================================================ -->

    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <!-- DELIVERY DETAILS -->

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <!-- PRODUCT REMARK -->

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         ============================================================ -->

    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]"
               position="replace">

            <div class="page"
                 style="font-family: Arial, sans-serif; font-size: 11px; color: #000;">

                <style>

                    /* ==================================================
                       GENERAL
                       ================================================== */

                    * {
                        box-sizing: border-box;
                    }


                    /* ==================================================
                       EACH GENERATED PAGE
                       ================================================== */

                    .delivery-page {
                        display: table;
                        width: 100%;
                        height: 255mm;
                        min-height: 255mm;
                        table-layout: fixed;
                        page-break-after: always;
                        position: relative;
                    }


                    .delivery-page:last-child {
                        page-break-after: avoid;
                    }


                    /* ==================================================
                       PAGE CONTENT
                       ================================================== */

                    .delivery-page-content {
                        display: table-row;
                        height: 100%;
                    }


                    .delivery-page-inner {
                        display: table-cell;
                        vertical-align: top;
                        width: 100%;
                    }


                    /* ==================================================
                       FOOTER ROW
                       ================================================== */

                    .delivery-footer-row {
                        display: table-row;
                        height: 42mm;
                    }


                    .delivery-footer-cell {
                        display: table-cell;
                        vertical-align: bottom;
                        width: 100%;
                        padding: 0 0 2mm 0;
                        border: none !important;
                        background: transparent !important;
                        outline: none !important;
                        box-shadow: none !important;
                    }


                    /* ==================================================
                       FOOTER
                       ================================================== */

                    .delivery-footer {
                        width: 100%;
                        border: none !important;
                        background: transparent !important;
                        outline: none !important;
                        box-shadow: none !important;
                        font-size: 9px;
                        line-height: 1.35;
                    }


                    .delivery-footer-left {
                        width: 60%;
                        float: left;
                        border: none !important;
                        background: transparent !important;
                    }


                    .delivery-footer-right {
                        width: 40%;
                        float: right;
                        border: none !important;
                        background: transparent !important;
                    }


                    .delivery-footer-clear {
                        clear: both;
                        height: 0;
                        line-height: 0;
                        border: none !important;
                    }


                    .delivery-footer-stamp {
                        width: 100%;
                        margin-top: 5px;
                        padding: 0;
                        border: none !important;
                        background: transparent !important;
                        color: #555;
                        font-size: 9px;
                    }


                    /* ==================================================
                       REMOVE FOOTER BORDERS
                       ================================================== */

                    .delivery-footer,
                    .delivery-footer *,
                    .delivery-footer-cell,
                    .delivery-footer-cell * {
                        border-left: none !important;
                        border-right: none !important;
                        border-top: none !important;
                        border-bottom: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                    }


                    /* ==================================================
                       INFORMATION TABLE
                       ================================================== */

                    .delivery-info-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        margin-top: 5px;
                    }


                    .delivery-info-table td {
                        border: 1px solid #000;
                        padding: 6px;
                        vertical-align: middle;
                    }


                    /* ==================================================
                       PRODUCT TABLE
                       ================================================== */

                    .delivery-products-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        margin-top: 20px;
                    }


                    .delivery-products-table th,
                    .delivery-products-table td {
                        border: 1px solid #000;
                        padding: 4px;
                        vertical-align: middle;
                    }


                    .delivery-products-table th {
                        background-color: #e9ecef;
                        text-align: center;
                        font-weight: bold;
                        font-size: 10px;
                    }


                    .delivery-products-table td {
                        font-size: 10px;
                    }


                    /* ==================================================
                       KEEP PRODUCT ROW TOGETHER
                       ================================================== */

                    .delivery-products-table tr {
                        page-break-inside: avoid;
                    }

                </style>


                <!-- ====================================================
                     ALL DELIVERY LINES
                     ==================================================== -->

                <t t-set="lines" t-value="o.move_ids_without_package"/>


                <!-- ====================================================
                     EXACTLY 12 PRODUCTS PER PAGE
                     ==================================================== -->

                <t t-set="chunk_size" t-value="12"/>


                <t t-set="total_lines" t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGES
                     ==================================================== -->

                <t t-if="total_lines == 0">

                    <t t-set="pages" t-value="[[]]"/>

                </t>

                <t t-else="">

                    <t t-set="pages"
                       t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>

                </t>


                <!-- ====================================================
                     LOOP THROUGH PAGES
                     ==================================================== -->

                <t t-foreach="pages" t-as="page_lines">

                    <t t-set="page_index" t-value="pages.index(page_lines)"/>


                    <!-- =================================================
                         ONE COMPLETE PAGE
                         ================================================= -->

                    <div class="delivery-page">


                        <!-- =================================================
                             CONTENT
                             ================================================= -->

                        <div class="delivery-page-content">

                            <div class="delivery-page-inner">


                                <!-- =========================================
                                     DELIVERY NOTE HEADER
                                     PAGE 1 ONLY
                                     ========================================= -->

                                <t t-if="page_index == 0">


                                    <!-- TITLE -->

                                    <div style="text-align: center; font-weight: bold; font-size: 18px; margin-top: 5px; margin-bottom: 12px; text-transform: uppercase; color: #003366;">

                                        DELIVERY NOTE

                                    </div>


                                    <!-- =====================================
                                         INFORMATION TABLE
                                         ===================================== -->

                                    <table class="delivery-info-table">


                                        <!-- HEADER ROW -->

                                        <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">

                                            <td style="width: 50%; text-align: left; font-size: 9px;">

                                                Customer Details

                                            </td>


                                            <td style="width: 16.67%; font-size: 9px;">

                                                Purchase Order No.

                                            </td>


                                            <td style="width: 16.67%; font-size: 9px;">

                                                Document Dated

                                            </td>


                                            <td style="width: 16.66%; font-size: 9px;">

                                                Delivery Note No.

                                            </td>

                                        </tr>


                                        <!-- CUSTOMER / PO / DATE / DELIVERY NOTE -->

                                        <tr>


                                            <!-- CUSTOMER -->

                                            <td rowspan="3"
                                                style="width: 50%; vertical-align: top; padding: 8px; font-size: 10px;">

                                                <div t-field="o.partner_id"
                                                     t-options='{"widget": "contact", "fields": ["address", "name", "vat", "company_registry"], "no_marker": true}'/>

                                            </td>


                                            <!-- PURCHASE ORDER -->

                                            <td style="width: 16.67%; text-align: center; height: 30px; font-size: 10px;">

                                                <span t-esc="o.sale_id.client_order_ref or ''"/>

                                            </td>


                                            <!-- DOCUMENT DATE -->

                                            <td style="width: 16.67%; text-align: center; height: 30px; font-size: 10px;">

                                                <span t-field="o.scheduled_date"
                                                      t-options="{'widget': 'date'}"/>

                                            </td>


                                            <!-- DELIVERY NOTE -->

                                            <td style="width: 16.66%; text-align: center; height: 30px; font-size: 10px; font-weight: bold;">

                                                <span t-field="o.name"/>

                                            </td>

                                        </tr>


                                        <!-- SECOND HEADER -->

                                        <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">

                                            <td style="font-size: 9px;">

                                                Delivery Details

                                            </td>


                                            <td style="font-size: 9px;">

                                                Delivery Terms

                                            </td>


                                            <td style="font-size: 9px;">

                                                GRN No.

                                            </td>

                                        </tr>


                                        <!-- SECOND INFORMATION ROW -->

                                        <tr>

                                            <td style="text-align: center; height: 30px; min-height: 30px; font-size: 10px;">

                                                <span t-esc="o.delivery_details or ''"/>

                                            </td>


                                            <td style="text-align: center; height: 30px; min-height: 30px; font-size: 10px;">

                                                <span t-esc="o.delivery_terms or ''"/>

                                            </td>


                                            <td style="text-align: center; height: 30px; min-height: 30px; font-size: 10px;">

                                                <span t-esc="o.grn_no or ''"/>

                                            </td>

                                        </tr>

                                    </table>

                                </t>


                                <!-- =================================================
                                     PRODUCT TABLE
                                     ================================================= -->

                                <table class="delivery-products-table">


                                    <!-- =========================================
                                         TABLE HEADER
                                         ========================================= -->

                                    <thead>

                                        <tr>

                                            <th style="width: 12%;">
                                                Item Code
                                            </th>

                                            <th style="width: 42%;">
                                                Description of Goods &amp; Services
                                            </th>

                                            <th style="width: 14%;">
                                                Part Number
                                            </th>

                                            <th style="width: 7%;">
                                                Qty
                                            </th>

                                            <th style="width: 7%;">
                                                Units
                                            </th>

                                            <th style="width: 18%;">
                                                Remarks
                                            </th>

                                        </tr>

                                    </thead>


                                    <!-- =========================================
                                         PRODUCT ROWS
                                         MAXIMUM 12 PER PAGE
                                         ========================================= -->

                                    <tbody>

                                        <t t-foreach="page_lines" t-as="move">

                                            <tr>


                                                <!-- ITEM CODE -->

                                                <td style="text-align: center; height: 20px;">
                                                </td>


                                                <!-- DESCRIPTION -->

                                                <td>

                                                    <!-- PRODUCT NAME -->

                                                    <div>
                                                        <span t-field="move.product_id.name"/>
                                                    </div>


                                                    <!-- ADDITIONAL DESCRIPTION -->

                                                    <t t-if="move.sale_line_id and move.sale_line_id.name">

                                                        <t t-set="full_desc"
                                                           t-value="move.sale_line_id.name"/>


                                                        <t t-if="full_desc != move.product_id.name">

                                                            <div style="color: #333; font-size: 9px; margin-top: 2px;">

                                                                <span t-esc="full_desc.replace('[' + str(move.product_id.default_code or '') + ']', '').replace(move.product_id.name, '').strip()"/>

                                                            </div>

                                                        </t>

                                                    </t>

                                                </td>


                                                <!-- PART NUMBER -->

                                                <td style="text-align: center;">

                                                    <span t-field="move.product_id.default_code"/>

                                                </td>


                                                <!-- QUANTITY -->

                                                <td style="text-align: center;">

                                                    <span t-field="move.product_uom_qty"/>

                                                </td>


                                                <!-- UNITS -->

                                                <td style="text-align: center;">

                                                    <span t-field="move.product_uom.name"/>

                                                </td>


                                                <!-- REMARKS -->

                                                <td>

                                                    <span t-field="move.x_remark"/>

                                                </td>

                                            </tr>

                                        </t>

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- =================================================
                             FOOTER

                             EVERY PAGE HAS ITS OWN FOOTER
                             ================================================= -->

                        <div class="delivery-footer-row">

                            <div class="delivery-footer-cell">

                                <div class="delivery-footer">


                                    <!-- =====================================
                                         LEFT SIDE TERMS
                                         ===================================== -->

                                    <div class="delivery-footer-left">

                                        <div style="margin-bottom: 2px;">

                                            a) goods once sold cannot be returned

                                        </div>


                                        <div style="margin-bottom: 2px;">

                                            b) no responsibility can be accepted for shortage or damage in transit

                                        </div>


                                        <div>

                                            c) all the above goods received in good order and condition

                                        </div>

                                    </div>


                                    <!-- =====================================
                                         RIGHT SIDE RECEIVED BY
                                         ===================================== -->

                                    <div class="delivery-footer-right">

                                        <div style="font-weight: bold; margin-bottom: 3px;">

                                            Received By:

                                        </div>


                                        <div style="margin-bottom: 3px;">

                                            Name: ______________________

                                        </div>


                                        <div style="margin-bottom: 3px;">

                                            Date: ______________________

                                        </div>


                                        <div>

                                            Signature: __________________

                                        </div>

                                    </div>


                                    <!-- CLEAR FLOAT -->

                                    <div class="delivery-footer-clear">
                                    </div>


                                    <!-- STAMP -->

                                    <div class="delivery-footer-stamp">

                                        Please stamp upon acknowledgement of Goods &amp; Services

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>