<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Rename Customer Reference to Purchase Order No.
         ============================================================ -->

    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         Remove Currency From Unit Price and Amount
         Dynamic Currency Header
         ============================================================ -->

    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//th[@name='th_subtotal']" position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>

        <xpath expr="//td[@name='td_priceunit']" position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         Add Delivery Details / Terms / GRN / Remarks
         ============================================================ -->

    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         Dynamic Product Pagination
         Full Product Description
         ============================================================ -->

    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]" position="replace">

            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">

                <style>

                    /* =================================================
                       HIDE DEFAULT ODOO ADDRESS SECTIONS
                       ================================================= */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* =================================================
                       PAGE CONTAINER
                       ================================================= */

                    .page-box {
                        position: relative;
                        width: 100%;
                        min-height: 170mm;
                        box-sizing: border-box;
                    }


                    /*
                     * Every generated page after the first one
                     * starts on a new physical page.
                     */

                    .page-box + .page-box {
                        page-break-before: always;
                        break-before: page;
                    }


                    /* =================================================
                       CONTENT AREA
                       ================================================= */

                    .content-container {
                        width: 100%;
                        box-sizing: border-box;
                        padding-bottom: 135px;
                    }


                    /* =================================================
                       PRODUCT TABLE
                       ================================================= */

                    .products-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }


                    /*
                     * Do not split an individual product row
                     * between two pages.
                     */

                    .products-table tr {
                        page-break-inside: avoid !important;
                        break-inside: avoid !important;
                    }


                    .products-table td {
                        vertical-align: top;
                        word-wrap: break-word;
                        overflow-wrap: break-word;
                        white-space: normal;
                    }


                    /* =================================================
                       PRODUCT DESCRIPTION
                       FULL DESCRIPTION - NO HEIGHT LIMIT
                       ================================================= */

                    .product-description {
                        color: #333;
                        font-size: 9px;
                        line-height: 13px;
                        width: 100%;
                        word-wrap: break-word;
                        overflow-wrap: break-word;
                        white-space: normal;
                        height: auto !important;
                        max-height: none !important;
                        overflow: visible !important;
                    }


                    /* =================================================
                       FOOTER
                       ================================================= */

                    .footer-at-bottom {
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        width: 100%;
                        height: 210px;
                        padding: 0 0 5px 0;
                        box-sizing: border-box;

                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;

                        display: block;
                    }


                    .footer-at-bottom,
                    .footer-at-bottom div,
                    .footer-at-bottom span,
                    .footer-at-bottom p {
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;
                    }


                    /* =================================================
                       HIDE CONTACT INFORMATION
                       ================================================= */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }


                    /* =================================================
                       TABLE PAGE BREAK CONTROL
                       ================================================= */

                    .content-container table {
                        page-break-inside: auto;
                    }

                    .content-container tr {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }

                </style>


                <!-- =====================================================
                     ALL DELIVERY MOVES
                     ===================================================== -->

                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>


                <!-- =====================================================
                     FIRST PAGE HEADER HEIGHT ESTIMATE
                     ===================================================== -->

                <t t-set="first_page_header_space"
                   t-value="155"/>


                <!-- =====================================================
                     NORMAL PAGE AVAILABLE SPACE
                     ===================================================== -->

                <t t-set="normal_page_space"
                   t-value="420"/>


                <!-- =====================================================
                     NOTE

                     We intentionally do NOT use:

                         chunk_size = 10

                     because descriptions can have different heights.

                     Instead, products are rendered naturally and
                     individual rows are prevented from splitting.
                     ===================================================== -->


                <!-- =====================================================
                     PAGE 1
                     ===================================================== -->

                <div class="page-box">

                    <div class="content-container">


                        <!-- =============================================
                             DELIVERY NOTE TITLE
                             ============================================= -->

                        <div style="
                            text-align: center;
                            font-weight: bold;
                            font-size: 18px;
                            margin-top: 10px;
                            margin-bottom: 15px;
                            text-transform: uppercase;
                            color: #003366;
                        ">
                            DELIVERY NOTE
                        </div>


                        <!-- =============================================
                             CUSTOMER INFORMATION
                             ============================================= -->

                        <table style="
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            margin-top: 5px;
                        ">

                            <tr style="
                                background-color: #f2f2f2;
                                font-weight: bold;
                                text-align: center;
                            ">

                                <td style="
                                    width: 50%;
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                    text-align: left;
                                ">
                                    Customer Details
                                </td>

                                <td style="
                                    width: 16.67%;
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    Purchase Order No.
                                </td>

                                <td style="
                                    width: 16.67%;
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    Document Dated
                                </td>

                                <td style="
                                    width: 16.66%;
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    Delivery Note No.
                                </td>

                            </tr>


                            <tr>

                                <td rowspan="3"
                                    style="
                                        width: 50%;
                                        border: 1px solid #000;
                                        padding: 8px;
                                        vertical-align: top;
                                        font-size: 10px;
                                        box-sizing: border-box;
                                    ">

                                    <div t-field="o.partner_id"
                                         t-options='{
                                             "widget": "contact",
                                             "fields": [
                                                 "address",
                                                 "name",
                                                 "vat",
                                                 "company_registry"
                                             ],
                                             "no_marker": true
                                         }'/>

                                </td>


                                <td style="
                                    width: 16.67%;
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-esc="o.sale_id.client_order_ref or ''"/>
                                </td>


                                <td style="
                                    width: 16.67%;
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-field="o.scheduled_date"
                                          t-options="{'widget': 'date'}"/>
                                </td>


                                <td style="
                                    width: 16.66%;
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    font-weight: bold;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-field="o.name"/>
                                </td>

                            </tr>


                            <tr style="
                                background-color: #f2f2f2;
                                font-weight: bold;
                                text-align: center;
                            ">

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    Delivery Details
                                </td>

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    Delivery Terms
                                </td>

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    font-size: 9px;
                                ">
                                    GRN No.
                                </td>

                            </tr>


                            <tr>

                                <td style="
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-esc="o.delivery_details or ''"/>
                                </td>

                                <td style="
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-esc="o.delivery_terms or ''"/>
                                </td>

                                <td style="
                                    border: 1px solid #000;
                                    padding: 8px;
                                    text-align: center;
                                    font-size: 10px;
                                    vertical-align: middle;
                                    height: 30px;
                                ">
                                    <span t-esc="o.grn_no or ''"/>
                                </td>

                            </tr>

                        </table>


                        <!-- =============================================
                             PRODUCTS TABLE
                             ============================================= -->

                        <table class="products-table"
                               style="
                                   width: 100%;
                                   border-collapse: collapse;
                                   margin-top: 25px;
                                   table-layout: fixed;
                               ">

                            <thead>

                                <tr style="
                                    background-color: #e9ecef;
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 11px;
                                ">

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 12%;
                                    ">
                                        Item Code
                                    </td>

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 42%;
                                    ">
                                        Description of Goods &amp; Services
                                    </td>

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 14%;
                                    ">
                                        Part Number
                                    </td>

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 7%;
                                    ">
                                        Qty
                                    </td>

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 7%;
                                    ">
                                        Units
                                    </td>

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 5px;
                                        width: 18%;
                                    ">
                                        Remarks
                                    </td>

                                </tr>

                            </thead>


                            <tbody>

                                <t t-foreach="lines"
                                   t-as="move">

                                    <tr>

                                        <!-- ITEM CODE -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            text-align: center;
                                            vertical-align: top;
                                        ">
                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            vertical-align: top;
                                        ">

                                            <!-- PRODUCT NAME -->

                                            <div style="
                                                font-size: 10px;
                                                line-height: 13px;
                                                word-wrap: break-word;
                                                overflow-wrap: break-word;
                                                white-space: normal;
                                            ">

                                                <span t-field="move.product_id.name"/>

                                            </div>


                                            <!-- FULL SALES DESCRIPTION -->

                                            <t t-if="
                                                move.sale_line_id
                                                and move.sale_line_id.name
                                            ">

                                                <t t-set="full_desc"
                                                   t-value="move.sale_line_id.name"/>


                                                <t t-if="
                                                    full_desc
                                                    != move.product_id.name
                                                ">

                                                    <div class="product-description">

                                                        <span t-esc="
                                                            full_desc.replace(
                                                                '[' + str(
                                                                    move.product_id.default_code or ''
                                                                ) + ']',
                                                                ''
                                                            ).replace(
                                                                move.product_id.name,
                                                                ''
                                                            ).strip()
                                                        "/>

                                                    </div>

                                                </t>

                                            </t>

                                        </td>


                                        <!-- PART NUMBER -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            text-align: center;
                                            vertical-align: top;
                                        ">

                                            <span t-field="move.product_id.default_code"/>

                                        </td>


                                        <!-- QUANTITY -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            text-align: center;
                                            vertical-align: top;
                                        ">

                                            <span t-field="move.product_uom_qty"/>

                                        </td>


                                        <!-- UNITS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            text-align: center;
                                            vertical-align: top;
                                        ">

                                            <span t-field="move.product_uom.name"/>

                                        </td>


                                        <!-- REMARKS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 4px;
                                            vertical-align: top;
                                            word-wrap: break-word;
                                            overflow-wrap: break-word;
                                        ">

                                            <span t-field="move.x_remark"/>

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <div class="footer-at-bottom">

                        <div style="
                            width: 100%;
                            font-size: 10px;
                            line-height: 1.5;
                            border: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        ">


                            <!-- LEFT -->

                            <div style="
                                width: 60%;
                                float: left;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                                background: transparent !important;
                            ">

                                <div style="
                                    margin: 0 0 3px 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    a) goods once sold cannot be returned
                                </div>

                                <div style="
                                    margin: 0 0 3px 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    b) no responsibility can be accepted for shortage or damage in transit
                                </div>

                                <div style="
                                    margin: 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    c) all the above goods received in good order and condition
                                </div>

                            </div>


                            <!-- RIGHT -->

                            <div style="
                                width: 40%;
                                float: right;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                                background: transparent !important;
                                font-size: 10px;
                            ">

                                <div style="
                                    font-weight: bold;
                                    margin: 0 0 4px 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    Received By:
                                </div>

                                <div style="
                                    margin: 0 0 4px 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    Name: ______________________
                                </div>

                                <div style="
                                    margin: 0 0 4px 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    Date: ______________________
                                </div>

                                <div style="
                                    margin: 0;
                                    border: none !important;
                                    background: transparent !important;
                                    font-size: 10px;
                                ">
                                    Signature: __________________
                                </div>

                            </div>


                            <div style="
                                clear: both;
                                border: none !important;
                                background: transparent !important;
                            ">
                            </div>


                            <!-- STAMP MESSAGE -->

                            <div style="
                                width: 100%;
                                margin-top: 8px;
                                padding: 3px 5px;
                                font-size: 10px;
                                line-height: 1.4;
                                color: #555;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                                background: transparent !important;
                            ">
                                Please stamp upon acknowledgement of Goods &amp; Services
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </xpath>

    </template>

</odoo>