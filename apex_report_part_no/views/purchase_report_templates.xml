<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template ya Purchase Order -->
    <template id="report_purchaseorder_document_inherit_part_no" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <!-- Template ya Request for Quotation (RFQ) -->
    <template id="report_purchasequotation_document_inherit_part_no" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>
</odoo>