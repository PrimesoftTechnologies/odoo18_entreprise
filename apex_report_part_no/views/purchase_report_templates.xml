<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name only
         ============================================================ -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">

            <span t-field="line.product_id.name"/>

        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name only
         ============================================================ -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">

            <span t-field="order_line.product_id.name"/>

        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Change Customer Reference label to Purchase Order No.
         ============================================================ -->
    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>

        <field name="model">sale.order</field>

        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         
         Product line:
         - Unit Price = number only
         - Amount = number only
         
         Amount heading:
         - Amount (TZS)
         - Amount (USD)
         - Amount (EUR)
         - etc.
         
         Totals:
         - Keep currency
         ============================================================ -->
    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">


        <!-- ========================================================
             4.1 AMOUNT COLUMN HEADER
             
             Dynamic currency:
             
             TZS -> Amount (TZS)
             USD -> Amount (USD)
             EUR -> Amount (EUR)
             ======================================================== -->
        <xpath expr="//th[@name='th_subtotal']"
               position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <!-- ========================================================
             4.2 UNIT PRICE
             
             BEFORE:
             TZS 1,500,000.00
             
             AFTER:
             1,500,000.00
             ======================================================== -->
        <xpath expr="//td[@name='td_priceunit']"
               position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


        <!-- ========================================================
             4.3 LINE AMOUNT / SUBTOTAL
             
             BEFORE:
             TZS 3,000,000.00
             
             AFTER:
             3,000,000.00
             ======================================================== -->
        <xpath expr="//td[@name='td_subtotal']"
               position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         
         Add:
         - Delivery Details
         - Delivery Terms
         - GRN No.
         - Remarks
         ============================================================ -->
    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>

        <field name="model">stock.picking</field>

        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">


            <!-- ====================================================
                 DELIVERY INFORMATION
                 ==================================================== -->
            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <!-- ====================================================
                 REMARKS ON DELIVERY LINES
                 ==================================================== -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>


        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         ============================================================ -->
    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">


        <xpath expr="//div[hasclass('page')]"
               position="replace">


            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">


                <!-- ====================================================
                     PAGE / GENERAL STYLE
                     ==================================================== -->
                <style>

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* ==================================================
                       PAGE STRUCTURE
                       ================================================== */
                    .page-box {
                        position: relative;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        height: 100vh;
                        box-sizing: border-box;
                        page-break-after: always;
                    }


                    .page-box:last-child {
                        page-break-after: avoid;
                    }


                    /* ==================================================
                       MAIN CONTENT
                       ================================================== */
                    .content-container {
                        flex: 1;
                    }


                    /* ==================================================
                       FOOTER
                       ================================================== */
                    .footer-at-bottom {
                        width: 100%;
                        margin-top: auto;
                        padding-top: 10px;
                        padding-bottom: 0;
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                    }


                    /* ==================================================
                       REMOVE FOOTER BORDERS
                       ================================================== */
                    .footer-at-bottom table,
                    .footer-at-bottom tr,
                    .footer-at-bottom td,
                    .footer-at-bottom div {
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                    }


                    /* ==================================================
                       HIDE CONTACT INFORMATION
                       ================================================== */
                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }

                </style>


                <!-- ====================================================
                     DELIVERY LINES
                     ==================================================== -->
                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>


                <t t-set="chunk_size"
                   t-value="14"/>


                <t t-set="total_lines"
                   t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGES
                     ==================================================== -->
                <t t-if="total_lines == 0">

                    <t t-set="pages"
                       t-value="[[]]"/>

                </t>


                <t t-else="">

                    <t t-set="pages"
                       t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>

                </t>


                <!-- ====================================================
                     LOOP THROUGH PAGES
                     ==================================================== -->
                <t t-foreach="pages"
                   t-as="page_lines">


                    <t t-set="page_index"
                       t-value="pages.index(page_lines)"/>


                    <!-- ==================================================
                         PAGE CONTAINER
                         ================================================== -->
                    <div class="page-box">


                        <!-- ==================================================
                             MAIN CONTENT
                             ================================================== -->
                        <div class="content-container">


                            <!-- =================================================
                                 FIRST PAGE HEADER
                                 ================================================= -->
                            <t t-if="page_index == 0">


                                <!-- =============================================
                                     REPORT TITLE
                                     ============================================= -->
                                <div style="
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 18px;
                                    margin-top: 10px;
                                    margin-bottom: 15px;
                                    text-transform: uppercase;
                                    color: #003366;
                                ">

                                    DELIVERY NOTE

                                </div>


                                <!-- =================================================
                                     SINGLE INFORMATION TABLE
                                     ================================================= -->
                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    margin-top: 5px;
                                ">


                                    <!-- =================================================
                                         HEADER ROW
                                         ================================================= -->
                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <!-- CUSTOMER DETAILS -->
                                        <td style="
                                            width: 50%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                            text-align: left;
                                        ">

                                            Customer Details

                                        </td>


                                        <!-- PURCHASE ORDER -->
                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Purchase Order No.

                                        </td>


                                        <!-- DOCUMENT DATE -->
                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Document Dated

                                        </td>


                                        <!-- DELIVERY NOTE -->
                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Note No.

                                        </td>


                                    </tr>


                                    <!-- =================================================
                                         FIRST VALUE ROW
                                         ================================================= -->
                                    <tr>


                                        <!-- CUSTOMER DETAILS -->
                                        <td rowspan="3"
                                            style="
                                                width: 50%;
                                                border: 1px solid #000;
                                                padding: 8px;
                                                vertical-align: top;
                                                font-size: 10px;
                                                box-sizing: border-box;
                                            ">


                                            <div t-field="o.partner_id"
                                                 t-options='{
                                                     "widget": "contact",
                                                     "fields": [
                                                         "address",
                                                         "name",
                                                         "vat",
                                                         "company_registry"
                                                     ],
                                                     "no_marker": true
                                                 }'/>


                                        </td>


                                        <!-- PURCHASE ORDER NUMBER -->
                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">


                                            <span t-esc="o.sale_id.client_order_ref or ''"/>


                                        </td>


                                        <!-- DOCUMENT DATE -->
                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">


                                            <span t-field="o.scheduled_date"
                                                  t-options="{'widget': 'date'}"/>


                                        </td>


                                        <!-- DELIVERY NOTE NUMBER -->
                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            font-weight: bold;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">


                                            <span t-field="o.name"/>


                                        </td>


                                    </tr>


                                    <!-- =================================================
                                         SECOND HEADER ROW
                                         ================================================= -->
                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <!-- DELIVERY DETAILS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Details

                                        </td>


                                        <!-- DELIVERY TERMS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Terms

                                        </td>


                                        <!-- GRN -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            GRN No.

                                        </td>


                                    </tr>


                                    <!-- =================================================
                                         SECOND VALUE ROW
                                         ================================================= -->
                                    <tr>


                                        <!-- DELIVERY DETAILS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">


                                            <span t-esc="o.delivery_details or ''"/>


                                        </td>


                                        <!-- DELIVERY TERMS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">


                                            <span t-esc="o.delivery_terms or ''"/>


                                        </td>


                                        <!-- GRN NUMBER -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">


                                            <span t-esc="o.grn_no or ''"/>


                                        </td>


                                    </tr>


                                </table>


                            </t>


                            <!-- ====================================================
                                 PRODUCTS TABLE
                                 ==================================================== -->
                            <table style="
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 25px;
                                table-layout: fixed;
                            ">


                                <thead>


                                    <tr style="
                                        background-color: #e9ecef;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 11px;
                                    ">


                                        <!-- ITEM CODE -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 12%;
                                        ">

                                            Item Code

                                        </td>


                                        <!-- DESCRIPTION -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 42%;
                                        ">

                                            Description of Goods &amp; Services

                                        </td>


                                        <!-- PART NUMBER -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 14%;
                                        ">

                                            Part Number

                                        </td>


                                        <!-- QUANTITY -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Qty

                                        </td>


                                        <!-- UNITS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Units

                                        </td>


                                        <!-- REMARKS -->
                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 18%;
                                        ">

                                            Remarks

                                        </td>


                                    </tr>


                                </thead>


                                <tbody>


                                    <t t-foreach="page_lines"
                                       t-as="move">


                                        <tr>


                                            <!-- ITEM CODE -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                height: 18px;
                                            ">
                                            </td>


                                            <!-- DESCRIPTION -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">


                                                <div>

                                                    <span t-field="move.product_id.name"/>

                                                </div>


                                                <!-- SALE DESCRIPTION -->
                                                <t t-if="move.sale_line_id and move.sale_line_id.name">


                                                    <t t-set="full_desc"
                                                       t-value="move.sale_line_id.name"/>


                                                    <t t-if="full_desc != move.product_id.name">


                                                        <div style="
                                                            color: #333;
                                                            font-size: 9px;
                                                            margin-top: 2px;
                                                        ">


                                                            <span t-esc="
                                                                full_desc.replace(
                                                                    '[' + str(
                                                                        move.product_id.default_code or ''
                                                                    ) + ']',
                                                                    ''
                                                                ).replace(
                                                                    move.product_id.name,
                                                                    ''
                                                                ).strip()
                                                            "/>


                                                        </div>


                                                    </t>


                                                </t>


                                            </td>


                                            <!-- PART NUMBER -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">


                                                <span t-field="move.product_id.default_code"/>


                                            </td>


                                            <!-- QUANTITY -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">


                                                <span t-field="move.product_uom_qty"/>


                                            </td>


                                            <!-- UNITS -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">


                                                <span t-field="move.product_uom.name"/>


                                            </td>


                                            <!-- REMARKS -->
                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">


                                                <span t-field="move.x_remark"/>


                                            </td>


                                        </tr>


                                    </t>


                                </tbody>


                            </table>


                        </div>


                        <!-- ====================================================
                             FOOTER
                             PLAIN / NO BOX / BOTTOM OF EVERY PAGE
                             ==================================================== -->
                        <div class="footer-at-bottom"
                             style="
                                width: 100%;
                                margin-top: auto;
                                padding-top: 10px;
                                padding-bottom: 0;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                             ">


                            <!-- ==================================================
                                 FOOTER CONTENT
                                 ================================================== -->
                            <table style="
                                width: 100%;
                                border-collapse: collapse;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                            ">


                                <tr style="
                                    border: none !important;
                                ">


                                    <!-- LEFT SIDE - TERMS -->
                                    <td style="
                                        width: 60%;
                                        padding: 3px 5px;
                                        vertical-align: top;
                                        font-size: 9px;
                                        border: none !important;
                                        outline: none !important;
                                    ">


                                        <div style="
                                            margin: 0 0 2px 0;
                                            border: none !important;
                                        ">

                                            a) goods once sold cannot be returned

                                        </div>


                                        <div style="
                                            margin: 0 0 2px 0;
                                            border: none !important;
                                        ">

                                            b) no responsibility can be accepted for shortage or damage in transit

                                        </div>


                                        <div style="
                                            margin: 0;
                                            border: none !important;
                                        ">

                                            c) all the above goods received in good order and condition

                                        </div>


                                    </td>


                                    <!-- RIGHT SIDE - RECEIVED BY -->
                                    <td style="
                                        width: 40%;
                                        padding: 3px 5px;
                                        vertical-align: top;
                                        font-size: 9px;
                                        border: none !important;
                                        outline: none !important;
                                    ">


                                        <div style="
                                            font-weight: bold;
                                            margin: 0 0 3px 0;
                                            border: none !important;
                                        ">

                                            Received By:

                                        </div>


                                        <div style="
                                            margin: 0 0 3px 0;
                                            border: none !important;
                                        ">

                                            Name: ______________________

                                        </div>


                                        <div style="
                                            margin: 0 0 3px 0;
                                            border: none !important;
                                        ">

                                            Date: ______________________

                                        </div>


                                        <div style="
                                            margin: 0;
                                            border: none !important;
                                        ">

                                            Signature: __________________

                                        </div>


                                    </td>


                                </tr>


                            </table>


                            <!-- ==================================================
                                 STAMP MESSAGE
                                 ================================================== -->
                            <div style="
                                width: 100%;
                                margin-top: 4px;
                                padding: 3px 5px;
                                font-size: 9px;
                                color: #555;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                            ">

                                Please stamp upon acknowledgement of Goods &amp; Services

                            </div>


                        </div>


                    </div>


                </t>


            </div>


        </xpath>


    </template>


</odoo>