<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         SHOW PRODUCT NAME ONLY
         ============================================================ -->

    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         SHOW PRODUCT NAME ONLY
         ============================================================ -->

    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         RENAME CUSTOMER REFERENCE
         ============================================================ -->

    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         REMOVE CURRENCY FROM LINE VALUES
         DYNAMIC CURRENCY HEADER
         ============================================================ -->

    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">


        <!-- AMOUNT HEADER -->

        <xpath expr="//th[@name='th_subtotal']"
               position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <!-- UNIT PRICE WITHOUT CURRENCY -->

        <xpath expr="//td[@name='td_priceunit']"
               position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


        <!-- AMOUNT WITHOUT CURRENCY -->

        <xpath expr="//td[@name='td_subtotal']"
               position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         ============================================================ -->

    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">


            <!-- DELIVERY DETAILS -->

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <!-- PRODUCT REMARK -->

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         ============================================================ -->

    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">


        <xpath expr="//div[hasclass('page')]"
               position="replace">


            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">


                <style>

                    /* =================================================
                       HIDE DEFAULT ODOO DELIVERY INFORMATION
                       ================================================= */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* =================================================
                       PAGE CONTAINER

                       IMPORTANT:
                       We give EVERY generated page its own fixed
                       printable height.

                       This prevents page 2 / page 3 from becoming
                       only as tall as the product content.
                       ================================================= */

                    .page-box {
                        position: relative;

                        width: 100%;

                        /*
                         * A4 printable/content height.
                         * This works with the normal Odoo A4 report
                         * layout and keeps footer at page bottom.
                         */
                        height: 277mm;

                        min-height: 277mm;
                        max-height: 277mm;

                        box-sizing: border-box;

                        page-break-after: always;

                        overflow: hidden;
                    }


                    /*
                     * Last generated page should not force another
                     * blank page.
                     */

                    .page-box:last-child {
                        page-break-after: avoid;
                    }


                    /* =================================================
                       MAIN CONTENT

                       Reserve enough space for footer.
                       ================================================= */

                    .content-container {
                        width: 100%;

                        box-sizing: border-box;

                        padding-bottom: 48mm;
                    }


                    /* =================================================
                       FOOTER

                       This footer belongs to EACH page-box.

                       Because page-box has a fixed height of 277mm,
                       bottom: 0 always means the physical bottom of
                       THAT generated page.
                       ================================================= */

                    .footer-at-bottom {
                        position: absolute;

                        left: 0;
                        right: 0;
                        bottom: 0;

                        width: 100%;

                        min-height: 38mm;

                        padding-bottom: 2mm;

                        box-sizing: border-box;

                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       REMOVE ALL FOOTER BORDERS
                       ================================================= */

                    .footer-at-bottom,
                    .footer-at-bottom div,
                    .footer-at-bottom span,
                    .footer-at-bottom p {
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;
                    }


                    /* =================================================
                       ADDRESS CLEANUP
                       ================================================= */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }

                </style>


                <!-- ====================================================
                     DELIVERY LINES
                     ==================================================== -->

                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>


                <!-- ====================================================
                     PRODUCTS PER PAGE
                     ==================================================== -->

                <t t-set="chunk_size"
                   t-value="14"/>


                <t t-set="total_lines"
                   t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGE CHUNKS
                     ==================================================== -->

                <t t-if="total_lines == 0">

                    <t t-set="pages"
                       t-value="[[]]"/>

                </t>

                <t t-else="">

                    <t t-set="pages"
                       t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>

                </t>


                <!-- ====================================================
                     EVERY PAGE

                     FOOTER IS INSIDE THIS LOOP.
                     ==================================================== -->

                <t t-foreach="pages"
                   t-as="page_lines">


                    <t t-set="page_index"
                       t-value="pages.index(page_lines)"/>


                    <!-- =================================================
                         PAGE BOX
                         ================================================= -->

                    <div class="page-box">


                        <!-- =============================================
                             CONTENT
                             ============================================= -->

                        <div class="content-container">


                            <!-- =========================================
                                 DELIVERY NOTE HEADER
                                 FIRST PAGE ONLY
                                 ========================================= -->

                            <t t-if="page_index == 0">


                                <!-- DELIVERY NOTE TITLE -->

                                <div style="
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 18px;
                                    margin-top: 10px;
                                    margin-bottom: 15px;
                                    text-transform: uppercase;
                                    color: #003366;
                                ">

                                    DELIVERY NOTE

                                </div>


                                <!-- =====================================
                                     CUSTOMER INFORMATION
                                     ===================================== -->

                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    margin-top: 5px;
                                ">


                                    <!-- HEADER ROW -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <!-- CUSTOMER -->

                                        <td style="
                                            width: 50%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                            text-align: left;
                                        ">

                                            Customer Details

                                        </td>


                                        <!-- PO -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Purchase Order No.

                                        </td>


                                        <!-- DATE -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Document Dated

                                        </td>


                                        <!-- DELIVERY NOTE -->

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Note No.

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         CUSTOMER ROW
                                         ================================= -->

                                    <tr>


                                        <!-- CUSTOMER DETAILS -->

                                        <td rowspan="3"
                                            style="
                                                width: 50%;
                                                border: 1px solid #000;
                                                padding: 8px;
                                                vertical-align: top;
                                                font-size: 10px;
                                                box-sizing: border-box;
                                            ">

                                            <div t-field="o.partner_id"
                                                 t-options='{
                                                     "widget": "contact",
                                                     "fields": [
                                                         "address",
                                                         "name",
                                                         "vat",
                                                         "company_registry"
                                                     ],
                                                     "no_marker": true
                                                 }'/>

                                        </td>


                                        <!-- PURCHASE ORDER -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.sale_id.client_order_ref or ''"/>

                                        </td>


                                        <!-- DOCUMENT DATE -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.scheduled_date"
                                                  t-options="{'widget': 'date'}"/>

                                        </td>


                                        <!-- DELIVERY NOTE NUMBER -->

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            font-weight: bold;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.name"/>

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         SECOND HEADER
                                         ================================= -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Details

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Terms

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            GRN No.

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         INFORMATION ROW
                                         ================================= -->

                                    <tr>


                                        <!-- DELIVERY DETAILS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.delivery_details or ''"/>

                                        </td>


                                        <!-- DELIVERY TERMS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.delivery_terms or ''"/>

                                        </td>


                                        <!-- GRN -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.grn_no or ''"/>

                                        </td>

                                    </tr>

                                </table>

                            </t>


                            <!-- =================================================
                                 PRODUCTS TABLE
                                 ================================================= -->

                            <table style="
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 25px;
                                table-layout: fixed;
                            ">


                                <!-- =========================================
                                     TABLE HEADER
                                     ========================================= -->

                                <thead>

                                    <tr style="
                                        background-color: #e9ecef;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 11px;
                                    ">


                                        <!-- ITEM CODE -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 12%;
                                        ">

                                            Item Code

                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 42%;
                                        ">

                                            Description of Goods &amp; Services

                                        </td>


                                        <!-- PART NUMBER -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 14%;
                                        ">

                                            Part Number

                                        </td>


                                        <!-- QUANTITY -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Qty

                                        </td>


                                        <!-- UNITS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Units

                                        </td>


                                        <!-- REMARKS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 18%;
                                        ">

                                            Remarks

                                        </td>

                                    </tr>

                                </thead>


                                <!-- =========================================
                                     PRODUCT ROWS
                                     ========================================= -->

                                <tbody>


                                    <t t-foreach="page_lines"
                                       t-as="move">


                                        <tr>


                                            <!-- ITEM CODE -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                height: 18px;
                                            ">
                                            </td>


                                            <!-- DESCRIPTION -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">


                                                <!-- PRODUCT NAME -->

                                                <div>

                                                    <span t-field="move.product_id.name"/>

                                                </div>


                                                <!-- ADDITIONAL DESCRIPTION -->

                                                <t t-if="move.sale_line_id and move.sale_line_id.name">

                                                    <t t-set="full_desc"
                                                       t-value="move.sale_line_id.name"/>


                                                    <t t-if="full_desc != move.product_id.name">


                                                        <div style="
                                                            color: #333;
                                                            font-size: 9px;
                                                            margin-top: 2px;
                                                        ">

                                                            <span t-esc="
                                                                full_desc.replace(
                                                                    '[' + str(
                                                                        move.product_id.default_code or ''
                                                                    ) + ']',
                                                                    ''
                                                                ).replace(
                                                                    move.product_id.name,
                                                                    ''
                                                                ).strip()
                                                            "/>

                                                        </div>

                                                    </t>

                                                </t>

                                            </td>


                                            <!-- PART NUMBER -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_id.default_code"/>

                                            </td>


                                            <!-- QUANTITY -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom_qty"/>

                                            </td>


                                            <!-- UNITS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom.name"/>

                                            </td>


                                            <!-- REMARKS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">

                                                <span t-field="move.x_remark"/>

                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                            </table>

                        </div>


                        <!-- =================================================
                             FOOTER FOR THIS PAGE

                             IMPORTANT:
                             This is INSIDE page-box and INSIDE pages loop.

                             Therefore:
                             Page 1 = Footer
                             Page 2 = Footer
                             Page 3 = Footer
                             ================================================= -->

                        <div class="footer-at-bottom">


                            <div style="
                                width: 100%;
                                font-size: 9px;
                                line-height: 1.4;
                                border: none !important;
                                outline: none !important;
                                box-shadow: none !important;
                                background: transparent !important;
                            ">


                                <!-- =====================================
                                     LEFT SIDE TERMS
                                     ===================================== -->

                                <div style="
                                    width: 60%;
                                    float: left;
                                    border: none !important;
                                    outline: none !important;
                                    box-shadow: none !important;
                                    background: transparent !important;
                                ">


                                    <!-- TERM A -->

                                    <div style="
                                        margin: 0 0 2px 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        a) goods once sold cannot be returned

                                    </div>


                                    <!-- TERM B -->

                                    <div style="
                                        margin: 0 0 2px 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        b) no responsibility can be accepted for shortage or damage in transit

                                    </div>


                                    <!-- TERM C -->

                                    <div style="
                                        margin: 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        c) all the above goods received in good order and condition

                                    </div>

                                </div>


                                <!-- =====================================
                                     RIGHT SIDE RECEIVED BY
                                     ===================================== -->

                                <div style="
                                    width: 40%;
                                    float: right;
                                    border: none !important;
                                    outline: none !important;
                                    box-shadow: none !important;
                                    background: transparent !important;
                                ">


                                    <!-- RECEIVED BY -->

                                    <div style="
                                        font-weight: bold;
                                        margin: 0 0 3px 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        Received By:

                                    </div>


                                    <!-- NAME -->

                                    <div style="
                                        margin: 0 0 3px 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        Name: ______________________

                                    </div>


                                    <!-- DATE -->

                                    <div style="
                                        margin: 0 0 3px 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        Date: ______________________

                                    </div>


                                    <!-- SIGNATURE -->

                                    <div style="
                                        margin: 0;
                                        border: none !important;
                                        background: transparent !important;
                                    ">

                                        Signature: __________________

                                    </div>

                                </div>


                                <!-- =====================================
                                     CLEAR FLOAT
                                     ===================================== -->

                                <div style="
                                    clear: both;
                                    border: none !important;
                                    background: transparent !important;
                                "></div>


                                <!-- =====================================
                                     STAMP MESSAGE
                                     ===================================== -->

                                <div style="
                                    width: 100%;
                                    margin-top: 6px;
                                    padding: 3px 5px;
                                    font-size: 9px;
                                    color: #555;
                                    border: none !important;
                                    outline: none !important;
                                    box-shadow: none !important;
                                    background: transparent !important;
                                ">

                                    Please stamp upon acknowledgement of Goods &amp; Services

                                </div>


                            </div>

                        </div>


                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>