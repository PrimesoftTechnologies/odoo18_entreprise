<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Inherit ya Purchase Order -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <!-- 2. Inherit ya Purchase Quotation (RFQ) -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>
    </template>

    <!-- 3. Kubadilisha Label ya Customer Reference kuwa Purchase Order No. kwenye Sales Form -->
    <record id="view_order_form_inherit_client_order_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="string">Purchase Order No.</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. Muundo Kamili wa Apex Delivery Note Layout -->
    <template id="report_delivery_document_apex_custom" inherit_id="stock.report_delivery_document">
        
        <!-- Tunaficha au kuondoa anwani ya juu ya asili ili isijirudie -->
        <xpath expr="//div[hasclass('row')]//div[hasclass('col-auto')]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #000;">
                
                <!-- Header / Company Info & Reference Tables -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                    <tr>
                        <!-- Customer Name Box -->
                        <td style="width: 50%; border: 1px solid #000; padding: 8px; vertical-align: top;">
                            <div style="background-color: #d4edda; font-weight: bold; padding: 2px 5px; margin-bottom: 5px; font-size: 12px;">Delivery Note</div>
                            <div style="font-weight: bold; margin-bottom: 3px;">Customer Name</div>
                            <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                        </td>
                        <td style="width: 2%;"></td>
                        <!-- Reference Boxes -->
                        <td style="width: 48%; vertical-align: top; padding: 0;">
                            <table style="width: 100%; border-collapse: collapse; text-align: center;">
                                <tr style="background-color: #f2f2f2; font-weight: bold;">
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">Purchase Order No.</td>
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">Document Dated</td>
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">Delivery Note No.</td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #000; padding: 6px; font-size: 11px;">
                                        <span t-esc="o.sale_id.client_order_ref"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 6px; font-size: 11px;">
                                        <span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 6px; font-size: 11px; font-weight: bold;">
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                            </table>
                            <table style="width: 100%; border-collapse: collapse; text-align: center; margin-top: 5px;">
                                <tr style="background-color: #f2f2f2; font-weight: bold;">
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">Delivery Details</td>
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">Delivery Terms</td>
                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px;">GRN No.</td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #000; padding: 6px; height: 20px;"></td>
                                    <td style="border: 1px solid #000; padding: 6px;"></td>
                                    <td style="border: 1px solid #000; padding: 6px;"></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Jedwali la Bidhaa (Items Table) -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                    <thead>
                        <tr style="background-color: #e9ecef; text-align: center; font-weight: bold; font-size: 11px;">
                            <td style="border: 1px solid #000; padding: 6px; width: 15%;">Item Code</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 35%;">Description of Goods &amp; Services</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 8%;">Qty</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 8%;">Units</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 14%;">Product Code</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 20%;">Remarks</td>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.move_ids_without_package" t-as="move">
                            <tr>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center; height: 20px;"></td>
                                <td style="border: 1px solid #000; padding: 5px;">
                                    <span t-field="move.product_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <span t-field="move.product_uom_qty"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <span t-field="move.product_uom.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <span t-field="move.product_id.default_code"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px;"></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Sehemu ya Chini: Masharti na Saini -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 15px; vertical-align: top;">
                    <tr>
                        <td style="width: 60%; border: 1px solid #000; padding: 8px; vertical-align: top; font-size: 10px;">
                            <div style="margin-bottom: 3px;">a) goods once sold cannot be returned</div>
                            <div style="margin-bottom: 3px;">b) no responsibility can be accepted for shortage or damage in transit</div>
                            <div>c) all the above goods received in good order and condition</div>
                        </td>
                        <td style="width: 40%; border: 1px solid #000; padding: 8px; vertical-align: top; font-size: 10px;">
                            <div style="font-weight: bold; margin-bottom: 5px;">Received By:</div>
                            <div style="margin-bottom: 4px;">Name: ______________________</div>
                            <div style="margin-bottom: 4px;">Date: ______________________</div>
                            <div>Signature: __________________</div>
                        </td>
                    </tr>
                </table>

                <!-- Boksi la Muhuri (Please Stamp) -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 5px;">
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px; height: 45px; vertical-align: top; font-size: 10px; color: #555;">
                            Please stamp upon acknowledgement of Goods &amp; Services
                        </td>
                    </tr>
                </table>

            </div>
        </xpath>
    </template>

</odoo>