<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name Only
         ============================================================ -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name Only
         ============================================================ -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Rename Customer Reference to Purchase Order No.
         ============================================================ -->
    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         Remove Currency From Unit Price and Amount
         Dynamic Currency Header
         ============================================================ -->
    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//th[@name='th_subtotal']" position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <xpath expr="//td[@name='td_priceunit']" position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


        <xpath expr="//td[@name='td_subtotal']" position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         Add Delivery Details / Terms / GRN / Remarks
         ============================================================ -->
    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         12 PRODUCTS PER PAGE
         FOOTER ON EVERY PAGE
         ============================================================ -->
    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]" position="replace">

            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">

                <style>

                    /* =================================================
                       HIDE DEFAULT ODOO DELIVERY INFORMATION
                       ================================================= */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* =================================================
                       PAGE BOX
                       ================================================= */

                    .page-box {
                        position: relative;
                        width: 100%;
                        min-height: 250vh;
                        box-sizing: border-box;
                        page-break-after: always;
                        overflow: hidden;
                    }


                    /* =================================================
                       LAST PAGE
                       DO NOT CREATE EXTRA BLANK PAGE
                       ================================================= */

                    .page-box:last-child {
                        page-break-after: avoid !important;
                    }


                    /* =================================================
                       MAIN CONTENT
                       RESERVE SPACE FOR FOOTER
                       ================================================= */

                    .content-container {
                        width: 100%;
                        padding-bottom: 150px;
                        box-sizing: border-box;
                    }


                    /* =================================================
                       FOOTER
                       FOOTER IS INSIDE EVERY PAGE-BOX
                       ================================================= */

                    .footer-at-bottom {
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        width: 100%;
                        padding-bottom: 5px;
                        box-sizing: border-box;

                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;

                        font-family: Arial, sans-serif;
                        font-size: 10px;
                    }


                    /* =================================================
                       REMOVE ALL FOOTER BORDERS
                       ================================================= */

                    .footer-at-bottom,
                    .footer-at-bottom div,
                    .footer-at-bottom span,
                    .footer-at-bottom p {
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;
                    }


                    /* =================================================
                       HIDE PHONE / FAX / EMAIL
                       ================================================= */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }


                    /* =================================================
                       PREVENT TABLE ROW SPLITTING
                       ================================================= */

                    table tr {
                        page-break-inside: avoid !important;
                    }

                </style>


                <!-- ====================================================
                     DELIVERY LINES
                     ==================================================== -->

                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>

                <t t-set="chunk_size"
                   t-value="12"/>

                <t t-set="total_lines"
                   t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGE LIST
                     ==================================================== -->

                <t t-if="total_lines == 0">

                    <t t-set="pages"
                       t-value="[[]]"/>

                </t>

                <t t-else="">

                    <t t-set="pages"
                       t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>

                </t>


                <!-- ====================================================
                     EVERY PAGE
                     ==================================================== -->

                <t t-foreach="pages" t-as="page_lines">

                    <t t-set="page_index"
                       t-value="pages.index(page_lines)"/>


                    <!-- =================================================
                         PAGE BOX
                         ================================================= -->

                    <div class="page-box">


                        <!-- =============================================
                             MAIN CONTENT
                             ============================================= -->

                        <div class="content-container">


                            <!-- =========================================
                                 HEADER
                                 FIRST PAGE ONLY
                                 ========================================= -->

                            <t t-if="page_index == 0">


                                <!-- DELIVERY NOTE TITLE -->

                                <div style="
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 18px;
                                    margin-top: 10px;
                                    margin-bottom: 15px;
                                    text-transform: uppercase;
                                    color: #003366;
                                ">

                                    DELIVERY NOTE

                                </div>


                                <!-- =====================================
                                     CUSTOMER INFORMATION
                                     ===================================== -->

                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    margin-top: 5px;
                                ">


                                    <!-- HEADER -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <td style="
                                            width: 50%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                            text-align: left;
                                        ">

                                            Customer Details

                                        </td>


                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Purchase Order No.

                                        </td>


                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Document Dated

                                        </td>


                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Note No.

                                        </td>

                                    </tr>


                                    <!-- CUSTOMER DETAILS -->

                                    <tr>

                                        <td rowspan="3"
                                            style="
                                                width: 50%;
                                                border: 1px solid #000;
                                                padding: 8px;
                                                vertical-align: top;
                                                font-size: 10px;
                                                box-sizing: border-box;
                                            ">

                                            <div t-field="o.partner_id"
                                                 t-options='{
                                                     "widget": "contact",
                                                     "fields": [
                                                         "address",
                                                         "name",
                                                         "vat",
                                                         "company_registry"
                                                     ],
                                                     "no_marker": true
                                                 }'/>

                                        </td>


                                        <!-- PO NUMBER -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.sale_id.client_order_ref or ''"/>

                                        </td>


                                        <!-- DOCUMENT DATE -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.scheduled_date"
                                                  t-options="{'widget': 'date'}"/>

                                        </td>


                                        <!-- DELIVERY NOTE NUMBER -->

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            font-weight: bold;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.name"/>

                                        </td>

                                    </tr>


                                    <!-- SECOND HEADER -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Details

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Terms

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            GRN No.

                                        </td>

                                    </tr>


                                    <!-- SECOND INFORMATION -->

                                    <tr>

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.delivery_details or ''"/>

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.delivery_terms or ''"/>

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.grn_no or ''"/>

                                        </td>

                                    </tr>

                                </table>

                            </t>


                            <!-- =================================================
                                 PRODUCTS TABLE
                                 ================================================= -->

                            <table style="
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 25px;
                                table-layout: fixed;
                            ">


                                <thead>

                                    <tr style="
                                        background-color: #e9ecef;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 11px;
                                    ">


                                        <!-- ITEM CODE -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 12%;
                                        ">

                                            Item Code

                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 42%;
                                        ">

                                            Description of Goods &amp; Services

                                        </td>


                                        <!-- PART NUMBER -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 14%;
                                        ">

                                            Part Number

                                        </td>


                                        <!-- QTY -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Qty

                                        </td>


                                        <!-- UNITS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Units

                                        </td>


                                        <!-- REMARKS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 18%;
                                        ">

                                            Remarks

                                        </td>

                                    </tr>

                                </thead>


                                <tbody>

                                    <t t-foreach="page_lines"
                                       t-as="move">

                                        <tr style="
                                            page-break-inside: avoid !important;
                                        ">


                                            <!-- ITEM CODE -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                height: 18px;
                                            ">
                                            </td>


                                            <!-- DESCRIPTION -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                vertical-align: top;
                                            ">

                                                <div>

                                                    <span t-field="move.product_id.name"/>

                                                </div>


                                                <!-- ADDITIONAL SALES DESCRIPTION -->

                                                <t t-if="move.sale_line_id and move.sale_line_id.name">

                                                    <t t-set="full_desc"
                                                       t-value="move.sale_line_id.name"/>

                                                    <t t-if="full_desc != move.product_id.name">

                                                        <div style="
                                                            color: #333;
                                                            font-size: 9px;
                                                            margin-top: 2px;
                                                        ">

                                                            <span t-esc="
                                                                full_desc.replace(
                                                                    '[' + str(
                                                                        move.product_id.default_code or ''
                                                                    ) + ']',
                                                                    ''
                                                                ).replace(
                                                                    move.product_id.name,
                                                                    ''
                                                                ).strip()
                                                            "/>

                                                        </div>

                                                    </t>

                                                </t>

                                            </td>


                                            <!-- PART NUMBER -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                vertical-align: top;
                                            ">

                                                <span t-field="move.product_id.default_code"/>

                                            </td>


                                            <!-- QUANTITY -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                vertical-align: top;
                                            ">

                                                <span t-field="move.product_uom_qty"/>

                                            </td>


                                            <!-- UNITS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                vertical-align: top;
                                            ">

                                                <span t-field="move.product_uom.name"/>

                                            </td>


                                            <!-- REMARKS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                vertical-align: top;
                                            ">

                                                <span t-field="move.x_remark"/>

                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                            </table>

                        </div>


                        <!-- =================================================
                             FOOTER
                             IMPORTANT:
                             THIS IS INSIDE t-foreach="pages"
                             SO IT APPEARS ON EVERY PAGE.
                             ================================================= -->

                        <div class="footer-at-bottom">


                            <!-- =========================================
                                 TERMS
                                 ========================================= -->

                            <div style="
                                width: 100%;
                                font-size: 10px;
                                line-height: 1.45;
                            ">

                                <div>
                                    a) goods once sold cannot be returned
                                </div>

                                <div>
                                    b) no responsibility can be accepted for shortage or damage in transit
                                </div>

                                <div>
                                    c) all the above goods received in good order and condition
                                </div>

                            </div>


                            <!-- =========================================
                                 RECEIVED BY
                                 ========================================= -->

                            <div style="
                                margin-top: 7px;
                                font-size: 10px;
                                line-height: 1.5;
                            ">

                                <strong>Received By:</strong>

                                <br/>

                                Name: ______________________

                                <br/>

                                Date: ______________________

                                <br/>

                                Signature: __________________

                            </div>


                            <!-- =========================================
                                 STAMP MESSAGE
                                 ========================================= -->

                            <div style="
                                margin-top: 7px;
                                font-size: 10px;
                                font-weight: bold;
                                text-align: center;
                            ">

                                Please stamp upon acknowledgement of Goods &amp; Services

                            </div>


                        </div>


                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>

