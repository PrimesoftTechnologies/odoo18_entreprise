<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Inherit ya Purchase Order -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <!-- 2. Inherit ya Purchase Quotation (RFQ) -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>
    </template>

    <!-- 3. Kubadilisha Label ya Customer Reference kuwa Purchase Order No. kwenye Sales Form -->
    <record id="view_order_form_inherit_client_order_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="string">Purchase Order No.</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. Kuongeza Fields kwenye Fomu ya Odoo (UI) chini ya Destination Location -->
    <record id="view_picking_form_inherit_apex_details" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']" position="after">
                <field name="x_remark"/>
            </xpath>
        </field>
    </record>

    <!-- 5. Muundo wa Apex Delivery Note Layout (PDF Report) -->
    <template id="report_delivery_document_apex_custom" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; color: #000;">
                
                <style>
                    .row.mt-3.mb-3, div[name="right_box"], div[name="div_outgoing_address"], div[name="div_incoming_address"], div[name="div_partner_invoice"] {
                        display: none !important;
                    }
                    .page-box {
                        position: relative;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        height: 100vh;
                        box-sizing: border-box;
                        page-break-after: always;
                    }
                    .page-box:last-child {
                        page-break-after: avoid;
                    }
                    .content-container {
                        flex: 1;
                    }
                    .footer-at-bottom {
                        width: 100%;
                        margin-top: auto;
                        padding-top: 15px;
                        padding-bottom: 5px;
                    }
                    .footer-at-bottom table, .footer-at-bottom td {
                        border: none !important;
                        box-shadow: none !important;
                    }
                    .o_address_format span[itemprop="telephone"], .o_address_format span[itemprop="fax"] {
                        display: none !important;
                    }
                </style>

                <t t-set="lines" t-value="o.move_ids_without_package"/>
                <t t-set="chunk_size" t-value="14"/>
                <t t-set="total_lines" t-value="len(lines)"/>
                
                <t t-if="total_lines == 0">
                    <t t-set="pages" t-value="[[]]"/>
                </t>
                <t t-else="">
                    <t t-set="pages" t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>
                </t>

                <t t-foreach="pages" t-as="page_lines">
                    <t t-set="page_index" t-value="pages.index(page_lines)"/>
                    
                    <div class="page-box">
                        <div class="content-container">
                            
                            <t t-if="page_index == 0">
                                <div style="text-align: center; font-weight: bold; font-size: 18px; margin-top: 10px; margin-bottom: 15px; text-transform: uppercase; color: #003366;">
                                    Delivery Note
                                </div>

                                <table style="width: 100%; border-collapse: collapse; margin-top: 5px;">
                                    <tr>
                                        <!-- Customer Details (Upande wa Kushoto) - Amewekwa na Urefu Sawia -->
                                        <td style="width: 50%; vertical-align: top; padding: 0;">
                                            <div style="border: 1px solid #000; padding: 6px; height: 95px; box-sizing: border-box;">
                                                <div style="font-weight: bold; margin-bottom: 3px;">Customer Details</div>
                                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "vat", "company_registry"], "no_marker": True}'/>
                                            </div>
                                        </td>
                                        <td style="width: 2%; border: none;"></td>
                                        <!-- Purchase Order & Delivery Extra Details (Upande wa Kulia) -->
                                        <td style="width: 48%; vertical-align: top; padding: 0; border: none;">
                                            <table style="width: 100%; border-collapse: collapse; text-align: center; margin-bottom: 4px;">
                                                <tr style="background-color: #f2f2f2; font-weight: bold;">
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 33%;">Purchase Order No.</td>
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 33%;">Document Dated</td>
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 34%;">Delivery Note No.</td>
                                                </tr>
                                                <tr>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; height: 22px; vertical-align: middle;">
                                                        <span t-esc="o.sale_id.client_order_ref"/>
                                                    </td>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; vertical-align: middle;">
                                                        <span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                                    </td>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; font-weight: bold; vertical-align: middle;">
                                                        <span t-field="o.name"/>
                                                    </td>
                                                </tr>
                                            </table>
                                            <table style="width: 100%; border-collapse: collapse;">
                                                <tr style="background-color: #f2f2f2; font-weight: bold;">
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 33%;">Delivery Details</td>
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 33%;">Delivery Terms</td>
                                                    <td style="border: 1px solid #000; padding: 3px; font-size: 9px; width: 34%;">GRN No.</td>
                                                </tr>
                                                <tr>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; height: 22px; vertical-align: middle;">
                                                        <span t-field="o.delivery_details"/>
                                                    </td>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; vertical-align: middle;">
                                                        <span t-field="o.delivery_terms"/>
                                                    </td>
                                                    <td style="border: 1px solid #000; padding: 4px; font-size: 10px; vertical-align: middle;">
                                                        <span t-field="o.grn_no"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <!-- JEDWALI LA BIDHAA -->
                            <table style="width: 100%; border-collapse: collapse; margin-top: 25px;">
                                <thead>
                                    <tr style="background-color: #e9ecef; text-align: center; font-weight: bold; font-size: 11px;">
                                        <td style="border: 1px solid #000; padding: 5px; width: 12%;">Item Code</td>
                                        <td style="border: 1px solid #000; padding: 5px; width: 42%;">Description of Goods &amp; Services</td>
                                        <td style="border: 1px solid #000; padding: 5px; width: 14%;">Part Number</td>
                                        <td style="border: 1px solid #000; padding: 5px; width: 7%;">Qty</td>
                                        <td style="border: 1px solid #000; padding: 5px; width: 7%;">Units</td>
                                        <td style="border: 1px solid #000; padding: 5px; width: 18%;">Remarks</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="page_lines" t-as="move">
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 4px; text-align: center; height: 18px;"></td>
                                            <td style="border: 1px solid #000; padding: 4px;">
                                                <div>
                                                    <span t-field="move.product_id.name"/>
                                                </div>
                                                <t t-if="move.sale_line_id and move.sale_line_id.name">
                                                    <t t-set="full_desc" t-value="move.sale_line_id.name"/>
                                                    <t t-if="full_desc != move.product_id.name">
                                                        <div style="color: #333; font-size: 9px; margin-top: 2px;">
                                                            <span t-esc="full_desc.replace('[' + str(move.product_id.default_code or '') + ']', '').replace(move.product_id.name, '').strip()"/>
                                                        </div>
                                                    </t>
                                                </t>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                <span t-field="move.product_id.default_code"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                <span t-field="move.product_uom_qty"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                <span t-field="move.product_uom.name"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px;">
                                                <span t-field="move.x_remark"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>

                        <!-- FOOTER SECTION (Bila Box Wala Border Yoyote Kabisa) -->
                        <div class="footer-at-bottom">
                            <table style="width: 100%; border-collapse: collapse; vertical-align: top; border: none !important;">
                                <tr style="border: none !important;">
                                    <td style="width: 60%; padding: 4px; vertical-align: top; font-size: 9px; border: none !important;">
                                        <div style="margin-bottom: 2px;">a) goods once sold cannot be returned</div>
                                        <div style="margin-bottom: 2px;">b) no responsibility can be accepted for shortage or damage in transit</div>
                                        <div>c) all the above goods received in good order and condition</div>
                                    </td>
                                    <td style="width: 40%; padding: 4px; vertical-align: top; font-size: 9px; border: none !important;">
                                        <div style="font-weight: bold; margin-bottom: 3px;">Received By:</div>
                                        <div style="margin-bottom: 3px;">Name: ______________________</div>
                                        <div style="margin-bottom: 3px;">Date: ______________________</div>
                                        <div>Signature: __________________</div>
                                    </td>
                                </tr>
                            </table>

                            <table style="width: 100%; border-collapse: collapse; margin-top: 3px; border: none !important;">
                                <tr style="border: none !important;">
                                    <td style="padding: 4px; height: 25px; vertical-align: top; font-size: 9px; color: #555; border: none !important;">
                                        Please stamp upon acknowledgement of Goods &amp; Services
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>

            </div>
        </xpath>
    </template>

</odoo>