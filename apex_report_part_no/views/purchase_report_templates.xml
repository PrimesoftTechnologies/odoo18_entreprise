<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Rename Customer Reference to Purchase Order No.
         ============================================================ -->

    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">Purchase Order No.</attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         ============================================================ -->

    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//th[@name='th_subtotal']" position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <xpath expr="//td[@name='td_priceunit']" position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{'widget': 'float', 'precision': 2}"/>

            </td>

        </xpath>


        <xpath expr="//td[@name='td_subtotal']" position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{'widget': 'float', 'precision': 2}"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         ============================================================ -->

    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         ============================================================ -->

    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]" position="replace">

            <div class="page"
                 style="font-family: Arial, sans-serif;
                        font-size: 11px;
                        color: #000;
                        padding: 0;
                        margin: 0;">

                <style type="text/css">

                    /* ==================================================
                       HIDE DEFAULT ODOO DELIVERY INFORMATION
                       ================================================== */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* ==================================================
                       PAGE

                       Reserve enough space for footer.
                       ================================================== */

                    .page-box {
                        position: relative !important;

                        width: 100% !important;

                        height: 250mm !important;

                        min-height: 250mm !important;

                        max-height: 250mm !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 !important;

                        overflow: hidden !important;

                        page-break-after: always !important;

                        page-break-inside: avoid !important;

                        break-inside: avoid !important;
                    }


                    .page-box:last-child {
                        page-break-after: auto !important;
                    }


                    /* ==================================================
                       CONTENT AREA

                       Footer occupies 40mm.
                       ================================================== */

                    .content-container {
                        position: relative !important;

                        width: 100% !important;

                        height: 205mm !important;

                        max-height: 205mm !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 !important;

                        overflow: hidden !important;
                    }


                    /* ==================================================
                       FOOTER

                       40mm high and raised 8mm from bottom.
                       ================================================== */

                    .footer-at-bottom {
                        position: absolute !important;

                        left: 0 !important;

                        right: 0 !important;

                        bottom: 8mm !important;

                        width: 100% !important;

                        height: 40mm !important;

                        min-height: 40mm !important;

                        max-height: 40mm !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 !important;

                        display: block !important;

                        visibility: visible !important;

                        opacity: 1 !important;

                        background: #ffffff !important;

                        z-index: 9999 !important;

                        overflow: hidden !important;

                        page-break-inside: avoid !important;

                        break-inside: avoid !important;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;
                    }


                    /* ==================================================
                       FOOTER CONTENT
                       ================================================== */

                    .footer-content {
                        position: relative !important;

                        width: 100% !important;

                        height: 40mm !important;

                        min-height: 40mm !important;

                        max-height: 40mm !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 !important;

                        display: block !important;

                        visibility: visible !important;

                        font-family: Arial, sans-serif !important;

                        font-size: 9px !important;

                        line-height: 12px !important;

                        color: #000 !important;

                        background: #fff !important;

                        overflow: hidden !important;
                    }


                    /* ==================================================
                       LEFT TERMS
                       ================================================== */

                    .footer-terms {
                        position: absolute !important;

                        top: 0 !important;

                        left: 0 !important;

                        width: 58% !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 10px 0 0 !important;

                        display: block !important;

                        visibility: visible !important;

                        background: transparent !important;
                    }


                    /* ==================================================
                       RIGHT RECEIVED BY
                       ================================================== */

                    .footer-received {
                        position: absolute !important;

                        top: 0 !important;

                        right: 0 !important;

                        width: 42% !important;

                        box-sizing: border-box !important;

                        margin: 0 !important;

                        padding: 0 0 0 10px !important;

                        display: block !important;

                        visibility: visible !important;

                        background: transparent !important;
                    }


                    /* ==================================================
                       TERMS
                       ================================================== */

                    .footer-term {
                        display: block !important;

                        visibility: visible !important;

                        margin: 0 0 3px 0 !important;

                        padding: 0 !important;

                        font-size: 9px !important;

                        line-height: 12px !important;

                        color: #000 !important;

                        background: transparent !important;

                        border: none !important;
                    }


                    /* ==================================================
                       RECEIVED TITLE
                       ================================================== */

                    .footer-received-title {
                        display: block !important;

                        visibility: visible !important;

                        font-weight: bold !important;

                        font-size: 9px !important;

                        line-height: 12px !important;

                        margin: 0 0 4px 0 !important;

                        padding: 0 !important;

                        color: #000 !important;
                    }


                    /* ==================================================
                       RECEIVED ROWS
                       ================================================== */

                    .footer-received-row {
                        display: block !important;

                        visibility: visible !important;

                        font-size: 9px !important;

                        line-height: 12px !important;

                        margin: 0 0 4px 0 !important;

                        padding: 0 !important;

                        color: #000 !important;
                    }


                    /* ==================================================
                       STAMP MESSAGE

                       IMPORTANT:
                       Positioned INSIDE the footer itself.
                       It cannot create another PDF page.
                       ================================================== */

                    .footer-stamp {
                        position: absolute !important;

                        left: 0 !important;

                        bottom: 0 !important;

                        width: 100% !important;

                        height: 12px !important;

                        margin: 0 !important;

                        padding: 0 !important;

                        display: block !important;

                        visibility: visible !important;

                        font-size: 9px !important;

                        line-height: 12px !important;

                        color: #555 !important;

                        text-align: left !important;

                        box-sizing: border-box !important;

                        background: transparent !important;

                        border: none !important;
                    }


                    /* ==================================================
                       PRODUCT TABLE
                       ================================================== */

                    .delivery-products-table {
                        width: 100% !important;

                        border-collapse: collapse !important;

                        table-layout: fixed !important;

                        page-break-inside: auto !important;

                        break-inside: auto !important;
                    }


                    .delivery-products-table thead {
                        display: table-header-group !important;
                    }


                    .delivery-products-table tbody {
                        display: table-row-group !important;

                        page-break-inside: auto !important;

                        break-inside: auto !important;
                    }


                    .delivery-products-table tr {
                        page-break-inside: avoid !important;

                        break-inside: avoid !important;
                    }


                    /* ==================================================
                       HIDE PHONE / FAX / EMAIL
                       ================================================== */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }


                    /* ==================================================
                       FORCE FOOTER VISIBILITY
                       ================================================== */

                    .footer-at-bottom,
                    .footer-at-bottom *,
                    .footer-content,
                    .footer-content * {
                        visibility: visible !important;
                    }


                    /* ==================================================
                       REMOVE UNWANTED FOOTER STYLING
                       ================================================== */

                    .footer-at-bottom,
                    .footer-at-bottom *,
                    .footer-content,
                    .footer-content * {
                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;
                    }

                </style>


                <!-- ====================================================
                     DELIVERY LINES
                     ==================================================== -->

                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>


                <!-- ====================================================
                     PRODUCTS PER PAGE
                     ==================================================== -->

                <t t-set="chunk_size"
                   t-value="14"/>

                <t t-set="total_lines"
                   t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGES
                     ==================================================== -->

                <t t-if="total_lines == 0">

                    <t t-set="pages"
                       t-value="[[]]"/>

                </t>

                <t t-else="">

                    <t t-set="pages"
                       t-value="[lines[i:i + chunk_size] for i in range(0, total_lines, chunk_size)]"/>

                </t>


                <!-- ====================================================
                     PAGE LOOP
                     ==================================================== -->

                <t t-foreach="pages"
                   t-as="page_lines">

                    <div class="page-box">


                        <!-- =================================================
                             CONTENT
                             ================================================= -->

                        <div class="content-container">


                            <!-- =================================================
                                 FIRST PAGE INFORMATION
                                 ================================================= -->

                            <t t-if="page_lines == pages[0]">

                                <div style="
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 18px;
                                    margin-top: 10px;
                                    margin-bottom: 15px;
                                    text-transform: uppercase;
                                    color: #003366;
                                ">
                                    DELIVERY NOTE
                                </div>


                                <!-- =================================================
                                     CUSTOMER INFORMATION
                                     ================================================= -->

                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    margin-top: 5px;
                                ">

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">

                                        <td style="
                                            width: 50%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                            text-align: left;
                                        ">
                                            Customer Details
                                        </td>

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            Purchase Order No.
                                        </td>

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            Document Dated
                                        </td>

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            Delivery Note No.
                                        </td>

                                    </tr>


                                    <tr>

                                        <td rowspan="3"
                                            style="
                                                width: 50%;
                                                border: 1px solid #000;
                                                padding: 8px;
                                                vertical-align: top;
                                                font-size: 10px;
                                                box-sizing: border-box;
                                            ">

                                            <div t-field="o.partner_id"
                                                 t-options='{
                                                     "widget": "contact",
                                                     "fields": [
                                                         "address",
                                                         "name",
                                                         "vat",
                                                         "company_registry"
                                                     ],
                                                     "no_marker": true
                                                 }'/>

                                        </td>


                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.sale_id.client_order_ref or ''"/>

                                        </td>


                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.scheduled_date"
                                                  t-options="{'widget': 'date'}"/>

                                        </td>


                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            font-weight: bold;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.name"/>

                                        </td>

                                    </tr>


                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            Delivery Details
                                        </td>

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            Delivery Terms
                                        </td>

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">
                                            GRN No.
                                        </td>

                                    </tr>


                                    <tr>

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.delivery_details or ''"/>

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.delivery_terms or ''"/>

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.grn_no or ''"/>

                                        </td>

                                    </tr>

                                </table>

                            </t>


                            <!-- =================================================
                                 PRODUCT TABLE
                                 ================================================= -->

                            <table class="delivery-products-table"
                                   style="
                                       width: 100%;
                                       margin-top: 25px;
                                       table-layout: fixed;
                                   ">

                                <thead>

                                    <tr style="
                                        background-color: #e9ecef;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 11px;
                                    ">

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 12%;
                                        ">
                                            Item Code
                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 42%;
                                        ">
                                            Description of Goods &amp; Services
                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 14%;
                                        ">
                                            Part Number
                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">
                                            Qty
                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">
                                            Units
                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 18%;
                                        ">
                                            Remarks
                                        </td>

                                    </tr>

                                </thead>


                                <tbody>

                                    <t t-foreach="page_lines"
                                       t-as="move">

                                        <tr>

                                            <!-- ITEM CODE -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                height: 18px;
                                            ">
                                            </td>


                                            <!-- DESCRIPTION -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">

                                                <div>
                                                    <span t-field="move.product_id.name"/>
                                                </div>


                                                <t t-if="move.sale_line_id and move.sale_line_id.name">

                                                    <t t-set="full_desc"
                                                       t-value="move.sale_line_id.name"/>

                                                    <t t-if="full_desc != move.product_id.name">

                                                        <div style="
                                                            color: #333;
                                                            font-size: 9px;
                                                            margin-top: 2px;
                                                        ">

                                                            <span t-esc="full_desc.replace('[' + str(move.product_id.default_code or '') + ']', '').replace(move.product_id.name, '').strip()"/>

                                                        </div>

                                                    </t>

                                                </t>

                                            </td>


                                            <!-- PART NUMBER -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_id.default_code"/>

                                            </td>


                                            <!-- QUANTITY -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom_qty"/>

                                            </td>


                                            <!-- UNITS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom.name"/>

                                            </td>


                                            <!-- REMARKS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">

                                                <span t-field="move.x_remark"/>

                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                            </table>

                        </div>


                        <!-- ==================================================
                             FOOTER
                             ================================================== -->

                        <div class="footer-at-bottom">

                            <div class="footer-content">


                                <!-- LEFT SIDE -->

                                <div class="footer-terms">

                                    <div class="footer-term">
                                        a) goods once sold cannot be returned
                                    </div>

                                    <div class="footer-term">
                                        b) no responsibility can be accepted for shortage or damage in transit
                                    </div>

                                    <div class="footer-term">
                                        c) all the above goods received in good order and condition
                                    </div>

                                </div>


                                <!-- RIGHT SIDE -->

                                <div class="footer-received">

                                    <div class="footer-received-title">
                                        Received By:
                                    </div>

                                    <div class="footer-received-row">
                                        Name: ______________________
                                    </div>

                                    <div class="footer-received-row">
                                        Date: ______________________
                                    </div>

                                    <div class="footer-received-row">
                                        Signature: __________________
                                    </div>

                                </div>


                                <!-- ==================================================
                                     STAMP MESSAGE
                                     ================================================== -->

                                <div class="footer-stamp">
                                    Please stamp upon acknowledgement of Goods &amp; Services
                                </div>

                            </div>

                        </div>

                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>