<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit ya Purchase Order -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <!-- Inherit ya Purchase Quotation (RFQ) -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>
    </template>

    <!-- Inherit ya Delivery Slip (Stock Move Table - Draft/Ready/Waiting) -->
    <template id="report_delivery_document_inherit_product_name"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//span[@t-field='move.product_id']" position="replace">
            <span t-field="move.product_id.name"/>
        </xpath>
        <xpath expr="//span[@t-field='bo_line.product_id']" position="replace">
            <span t-field="bo_line.product_id.name"/>
        </xpath>
    </template>

    <!-- Inherit ya Aggregated Move Lines kwa ajili ya Delivery zilizopo DONE -->
    <template id="stock_report_delivery_aggregated_move_lines_inherit_part_no"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//span[@t-esc=&quot;aggregated_lines[line]['name']&quot;]" position="replace">
            <span t-esc="aggregated_lines[line]['product_id'].name if 'product_id' in aggregated_lines[line] else aggregated_lines[line]['name'].split('] ')[-1] if '] ' in aggregated_lines[line]['name'] else aggregated_lines[line]['name']"/>
        </xpath>
    </template>

    <!-- Kubadilisha Label ya Customer Reference kuwa Purchase Order No. kwenye Sales Form -->
    <record id="view_order_form_inherit_client_order_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="string">Purchase Order No.</attribute>
            </xpath>
        </field>
    </record>

</odoo>