<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name Only
         ============================================================ -->

    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Rename Customer Reference to Purchase Order No.
         ============================================================ -->

    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">
            sale.order.form.inherit.client.order.ref
        </field>

        <field name="model">sale.order</field>

        <field name="inherit_id"
               ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         Remove Currency From Unit Price and Amount
         Dynamic Currency Header
         ============================================================ -->

    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <!-- Dynamic Amount Header -->

        <xpath expr="//th[@name='th_subtotal']"
               position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <!-- Unit Price Without Currency -->

        <xpath expr="//td[@name='td_priceunit']"
               position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


        <!-- Amount Without Currency -->

        <xpath expr="//td[@name='td_subtotal']"
               position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         Add Delivery Details / Terms / GRN / Remarks
         ============================================================ -->

    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">
            stock.picking.form.inherit.apex.details
        </field>

        <field name="model">stock.picking</field>

        <field name="inherit_id"
               ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <!-- Delivery Information -->

            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <!-- Product Remark -->

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. DELIVERY NOTE CONTENT
         
         IMPORTANT:
         - NO CHUNK
         - NO MANUAL PAGINATION
         - NO PAGE-BOX
         - NO PAGE-INDEX
         - NO ABSOLUTE FOOTER
         - ALL PRODUCT LINES RENDER NATURALLY
         ============================================================ -->

    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]"
               position="replace">

            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">


                <!-- =================================================
                     CUSTOM CSS
                     ================================================= -->

                <style>

                    /* =================================================
                       HIDE DEFAULT ODOO DELIVERY INFORMATION
                       ================================================= */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* =================================================
                       TABLE PAGINATION
                       ================================================= */

                    table {
                        page-break-inside: auto;
                    }


                    table thead {
                        display: table-header-group;
                    }


                    table tr {
                        page-break-inside: avoid !important;
                        page-break-after: auto;
                    }


                    /* =================================================
                       FOOTER SPACE
                       
                       This reserves space at the bottom of the
                       physical page for Odoo's external footer.
                       ================================================= */

                    .delivery-content {
                        padding-bottom: 10px;
                    }


                    /* =================================================
                       HIDE PHONE / FAX / EMAIL
                       ================================================= */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }

                </style>


                <!-- =================================================
                     DELIVERY CONTENT
                     ================================================= -->

                <div class="delivery-content">


                    <!-- =================================================
                         DELIVERY NOTE TITLE
                         ================================================= -->

                    <div style="
                        text-align: center;
                        font-weight: bold;
                        font-size: 18px;
                        margin-top: 10px;
                        margin-bottom: 15px;
                        text-transform: uppercase;
                        color: #003366;
                    ">

                        DELIVERY NOTE

                    </div>


                    <!-- =================================================
                         CUSTOMER INFORMATION TABLE
                         ================================================= -->

                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        margin-top: 5px;
                    ">


                        <!-- =================================================
                             HEADER ROW
                             ================================================= -->

                        <tr style="
                            background-color: #f2f2f2;
                            font-weight: bold;
                            text-align: center;
                        ">


                            <!-- CUSTOMER -->

                            <td style="
                                width: 50%;
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                                text-align: left;
                            ">

                                Customer Details

                            </td>


                            <!-- PURCHASE ORDER -->

                            <td style="
                                width: 16.67%;
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                Purchase Order No.

                            </td>


                            <!-- DOCUMENT DATE -->

                            <td style="
                                width: 16.67%;
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                Document Dated

                            </td>


                            <!-- DELIVERY NOTE -->

                            <td style="
                                width: 16.66%;
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                Delivery Note No.

                            </td>

                        </tr>


                        <!-- =================================================
                             CUSTOMER INFORMATION
                             ================================================= -->

                        <tr>


                            <!-- CUSTOMER DETAILS -->

                            <td rowspan="3"
                                style="
                                    width: 50%;
                                    border: 1px solid #000;
                                    padding: 8px;
                                    vertical-align: top;
                                    font-size: 10px;
                                    box-sizing: border-box;
                                ">

                                <div t-field="o.partner_id"
                                     t-options='{
                                         "widget": "contact",
                                         "fields": [
                                             "address",
                                             "name",
                                             "vat",
                                             "company_registry"
                                         ],
                                         "no_marker": true
                                     }'/>

                            </td>


                            <!-- PURCHASE ORDER NUMBER -->

                            <td style="
                                width: 16.67%;
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-esc="
                                    o.sale_id.client_order_ref or ''
                                "/>

                            </td>


                            <!-- DOCUMENT DATE -->

                            <td style="
                                width: 16.67%;
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-field="o.scheduled_date"
                                      t-options="{
                                          'widget': 'date'
                                      }"/>

                            </td>


                            <!-- DELIVERY NOTE NUMBER -->

                            <td style="
                                width: 16.66%;
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                font-weight: bold;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-field="o.name"/>

                            </td>

                        </tr>


                        <!-- =================================================
                             SECOND HEADER
                             ================================================= -->

                        <tr style="
                            background-color: #f2f2f2;
                            font-weight: bold;
                            text-align: center;
                        ">


                            <td style="
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                Delivery Details

                            </td>


                            <td style="
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                Delivery Terms

                            </td>


                            <td style="
                                border: 1px solid #000;
                                padding: 5px;
                                font-size: 9px;
                            ">

                                GRN No.

                            </td>

                        </tr>


                        <!-- =================================================
                             SECOND INFORMATION ROW
                             ================================================= -->

                        <tr>


                            <!-- DELIVERY DETAILS -->

                            <td style="
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-esc="
                                    o.delivery_details or ''
                                "/>

                            </td>


                            <!-- DELIVERY TERMS -->

                            <td style="
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-esc="
                                    o.delivery_terms or ''
                                "/>

                            </td>


                            <!-- GRN NUMBER -->

                            <td style="
                                border: 1px solid #000;
                                padding: 8px;
                                text-align: center;
                                font-size: 10px;
                                vertical-align: middle;
                                height: 30px;
                            ">

                                <span t-esc="
                                    o.grn_no or ''
                                "/>

                            </td>

                        </tr>

                    </table>


                    <!-- =================================================
                         PRODUCTS TABLE
                         
                         NO CHUNK
                         NO MANUAL PAGINATION
                         ================================================= -->

                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 25px;
                        table-layout: fixed;
                    ">


                        <!-- =================================================
                             PRODUCT TABLE HEADER
                             ================================================= -->

                        <thead>

                            <tr style="
                                background-color: #e9ecef;
                                text-align: center;
                                font-weight: bold;
                                font-size: 11px;
                            ">


                                <!-- ITEM CODE -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 12%;
                                ">

                                    Item Code

                                </td>


                                <!-- DESCRIPTION -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 42%;
                                ">

                                    Description of Goods &amp; Services

                                </td>


                                <!-- PART NUMBER -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 14%;
                                ">

                                    Part Number

                                </td>


                                <!-- QUANTITY -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 7%;
                                ">

                                    Qty

                                </td>


                                <!-- UNITS -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 7%;
                                ">

                                    Units

                                </td>


                                <!-- REMARKS -->

                                <td style="
                                    border: 1px solid #000;
                                    padding: 5px;
                                    width: 18%;
                                ">

                                    Remarks

                                </td>

                            </tr>

                        </thead>


                        <!-- =================================================
                             PRODUCT LINES
                             ================================================= -->

                        <tbody>

                            <t t-foreach="o.move_ids_without_package"
                               t-as="move">

                                <tr style="
                                    page-break-inside: avoid !important;
                                ">


                                    <!-- ITEM CODE -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        text-align: center;
                                        height: 18px;
                                        vertical-align: top;
                                    ">

                                    </td>


                                    <!-- DESCRIPTION -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        vertical-align: top;
                                    ">

                                        <!-- PRODUCT NAME -->

                                        <div>

                                            <span t-field="
                                                move.product_id.name
                                            "/>

                                        </div>


                                        <!-- ADDITIONAL SALES DESCRIPTION -->

                                        <t t-if="
                                            move.sale_line_id
                                            and move.sale_line_id.name
                                        ">

                                            <t t-set="full_desc"
                                               t-value="
                                                   move.sale_line_id.name
                                               "/>


                                            <t t-if="
                                                full_desc
                                                != move.product_id.name
                                            ">

                                                <div style="
                                                    color: #333;
                                                    font-size: 9px;
                                                    margin-top: 2px;
                                                ">

                                                    <span t-esc="
                                                        full_desc.replace(
                                                            '[' + str(
                                                                move.product_id.default_code
                                                                or ''
                                                            ) + ']',
                                                            ''
                                                        ).replace(
                                                            move.product_id.name,
                                                            ''
                                                        ).strip()
                                                    "/>

                                                </div>

                                            </t>

                                        </t>

                                    </td>


                                    <!-- PART NUMBER -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        text-align: center;
                                        vertical-align: top;
                                    ">

                                        <span t-field="
                                            move.product_id.default_code
                                        "/>

                                    </td>


                                    <!-- QUANTITY -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        text-align: center;
                                        vertical-align: top;
                                    ">

                                        <span t-field="
                                            move.product_uom_qty
                                        "/>

                                    </td>


                                    <!-- UNITS -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        text-align: center;
                                        vertical-align: top;
                                    ">

                                        <span t-field="
                                            move.product_uom.name
                                        "/>

                                    </td>


                                    <!-- REMARKS -->

                                    <td style="
                                        border: 1px solid #000;
                                        padding: 4px;
                                        vertical-align: top;
                                    ">

                                        <span t-field="
                                            move.x_remark
                                        "/>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>

                </div>

            </div>

        </xpath>

    </template>


    <!-- ============================================================
         7. DELIVERY NOTE DEFAULT ODOO FOOTER
         
         IMPORTANT:
         This modifies the actual Odoo external layout footer.
         
         The footer is NOT inside .page.
         Therefore it is independent from:
         - number of products
         - page breaks
         - product lines
         - chunking
         
         Odoo PDF report engine handles the footer as the
         physical-page footer.
         ============================================================ -->

    <template id="external_layout_delivery_note_footer"
              inherit_id="web.external_layout_standard">

        <xpath expr="//div[contains(@class, 'footer')]"
               position="replace">

            <!-- ========================================================
                 CUSTOM DELIVERY NOTE FOOTER
                 ======================================================== -->

            <div class="footer"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 9.5px;
                    color: #222;
                    width: 100%;
                    border: none !important;
                    background: transparent !important;
                 ">


                <!-- =================================================
                     TOP FOOTER LINE
                     ================================================= -->

                <div style="
                    width: 100%;
                    border-top: 1.5px solid #333 !important;
                    margin-bottom: 5px;
                "></div>


                <!-- =================================================
                     MAIN FOOTER TABLE
                     ================================================= -->

                <table style="
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin: 0;
                    padding: 0;
                ">

                    <tbody>

                        <tr>


                            <!-- =========================================
                                 LEFT SIDE
                                 TERMS & CONDITIONS
                                 ========================================= -->

                            <td style="
                                width: 62%;
                                vertical-align: top;
                                padding: 0 12px 0 0;
                                border: none !important;
                            ">


                                <div style="
                                    font-size: 9.5px;
                                    font-weight: bold;
                                    color: #003366;
                                    text-transform: uppercase;
                                    letter-spacing: 0.3px;
                                    margin-bottom: 3px;
                                ">

                                    Terms &amp; Conditions

                                </div>


                                <!-- TERM A -->

                                <div style="
                                    margin-bottom: 2px;
                                    line-height: 1.35;
                                ">

                                    <strong>a)</strong>
                                    goods once sold cannot be returned

                                </div>


                                <!-- TERM B -->

                                <div style="
                                    margin-bottom: 2px;
                                    line-height: 1.35;
                                ">

                                    <strong>b)</strong>
                                    no responsibility can be accepted for
                                    shortage or damage in transit

                                </div>


                                <!-- TERM C -->

                                <div style="
                                    line-height: 1.35;
                                ">

                                    <strong>c)</strong>
                                    all the above goods received in good order
                                    and condition

                                </div>

                            </td>


                            <!-- =========================================
                                 VERTICAL SEPARATOR
                                 ========================================= -->

                            <td style="
                                width: 1%;
                                padding: 0;
                                border-left: 1px solid #bbb !important;
                                border-right: none !important;
                                vertical-align: top;
                            ">

                            </td>


                            <!-- =========================================
                                 RIGHT SIDE
                                 RECEIVED BY
                                 ========================================= -->

                            <td style="
                                width: 37%;
                                vertical-align: top;
                                padding: 0 0 0 12px;
                                border: none !important;
                            ">


                                <div style="
                                    font-size: 9.5px;
                                    font-weight: bold;
                                    color: #003366;
                                    text-transform: uppercase;
                                    letter-spacing: 0.3px;
                                    margin-bottom: 3px;
                                ">

                                    Received By

                                </div>


                                <!-- NAME -->

                                <div style="
                                    line-height: 1.6;
                                    white-space: nowrap;
                                ">

                                    <strong>Name:</strong>

                                    <span style="
                                        display: inline-block;
                                        width: 145px;
                                        border-bottom: 1px solid #555 !important;
                                        height: 10px;
                                    "></span>

                                </div>


                                <!-- DATE -->

                                <div style="
                                    line-height: 1.6;
                                    white-space: nowrap;
                                ">

                                    <strong>Date:</strong>

                                    <span style="
                                        display: inline-block;
                                        width: 145px;
                                        border-bottom: 1px solid #555 !important;
                                        height: 10px;
                                    "></span>

                                </div>


                                <!-- SIGNATURE -->

                                <div style="
                                    line-height: 1.6;
                                    white-space: nowrap;
                                ">

                                    <strong>Signature:</strong>

                                    <span style="
                                        display: inline-block;
                                        width: 115px;
                                        border-bottom: 1px solid #555 !important;
                                        height: 10px;
                                    "></span>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>


                <!-- =================================================
                     STAMP MESSAGE
                     ================================================= -->

                <div style="
                    width: 100%;
                    border-top: 1px solid #bbb !important;
                    margin-top: 4px;
                    padding-top: 3px;
                    text-align: center;
                    font-size: 8.5px;
                    font-style: italic;
                    color: #444;
                ">

                    Please stamp upon acknowledgement of
                    Goods &amp; Services

                </div>

            </div>

        </xpath>

    </template>

</odoo>

