<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. PURCHASE ORDER
         Show Product Name Only
         ============================================================ -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         2. PURCHASE QUOTATION / RFQ
         Show Product Name Only
         ============================================================ -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>


    <!-- ============================================================
         3. SALES ORDER FORM
         Rename Customer Reference to Purchase Order No.
         ============================================================ -->
    <record id="view_order_form_inherit_client_order_ref"
            model="ir.ui.view">

        <field name="name">sale.order.form.inherit.client.order.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='client_order_ref']"
                   position="attributes">

                <attribute name="string">
                    Purchase Order No.
                </attribute>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         4. SALES ORDER + QUOTATION REPORT
         Remove Currency From Unit Price and Amount
         Dynamic Currency Header
         ============================================================ -->
    <template id="report_saleorder_document_remove_line_currency"
              inherit_id="sale.report_saleorder_document">

        <!-- Dynamic Amount Header -->
        <xpath expr="//th[@name='th_subtotal']" position="replace">

            <th name="th_subtotal"
                class="text-end text-nowrap">

                <span>
                    Amount
                    (<t t-esc="doc.currency_id.name"/>)
                </span>

            </th>

        </xpath>


        <!-- Unit Price Without Currency -->
        <xpath expr="//td[@name='td_priceunit']" position="replace">

            <td name="td_priceunit"
                class="text-end text-nowrap">

                <span t-esc="line.price_unit"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>


        <!-- Amount Without Currency -->
        <xpath expr="//td[@name='td_subtotal']" position="replace">

            <td name="td_subtotal"
                class="text-end o_price_total">

                <span t-esc="line.price_subtotal"
                      t-options="{
                          'widget': 'float',
                          'precision': 2
                      }"/>

            </td>

        </xpath>

    </template>


    <!-- ============================================================
         5. DELIVERY ORDER FORM
         Add Delivery Details / Terms / GRN / Remarks
         ============================================================ -->
    <record id="view_picking_form_inherit_apex_details"
            model="ir.ui.view">

        <field name="name">stock.picking.form.inherit.apex.details</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <!-- Delivery Information -->
            <xpath expr="//field[@name='location_dest_id']"
                   position="after">

                <field name="delivery_details"/>
                <field name="delivery_terms"/>
                <field name="grn_no"/>

            </xpath>


            <!-- Product Remark -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">

                <field name="x_remark"/>

            </xpath>

        </field>

    </record>


    <!-- ============================================================
         6. CUSTOM DELIVERY NOTE REPORT
         Footer At Bottom Of EVERY Printed Page
         ============================================================ -->
    <template id="report_delivery_document_apex_custom"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[hasclass('page')]" position="replace">

            <div class="page"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                    color: #000;
                 ">

                <style>

                    /* =================================================
                       HIDE DEFAULT ODOO DELIVERY INFORMATION
                       ================================================= */

                    .row.mt-3.mb-3,
                    div[name="right_box"],
                    div[name="div_outgoing_address"],
                    div[name="div_incoming_address"],
                    div[name="div_partner_invoice"] {
                        display: none !important;
                    }


                    /* =================================================
                       PAGE CONTAINER
                       =================================================
                       Each page is its own container.
                       Footer is positioned relative to this container.
                       ================================================= */

                    .page-box {
                        position: relative;

                        width: 100%;

                        min-height: 277mm;

                        box-sizing: border-box;

                        page-break-after: always;

                        overflow: hidden;
                    }


                    /* =================================================
                       LAST PAGE
                       ================================================= */

                    .page-box:last-child {
                        page-break-after: avoid;
                    }


                    /* =================================================
                       MAIN CONTENT AREA
                       =================================================
                       Reserve space for footer.
                       ================================================= */

                    .content-container {
                        width: 100%;

                        box-sizing: border-box;

                        /*
                         * Space reserved for footer.
                         * Product table cannot use this area.
                         */
                        padding-bottom: 35mm;
                    }


                    /* =================================================
                       FOOTER
                       =================================================
                       Always at the bottom of CURRENT page.
                       ================================================= */

                    .footer-at-bottom {
                        position: absolute;

                        left: 0;

                        right: 0;

                        bottom: 0;

                        width: 100%;

                        height: 32mm;

                        box-sizing: border-box;

                        margin: 0;

                        padding: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: #fff !important;

                        overflow: hidden;
                    }


                    /* =================================================
                       FOOTER CONTENT
                       ================================================= */

                    .footer-content {
                        width: 100%;

                        height: 100%;

                        box-sizing: border-box;

                        margin: 0;

                        padding: 0;

                        font-size: 9px;

                        line-height: 1.35;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: #fff !important;
                    }


                    /* =================================================
                       LEFT SIDE TERMS
                       ================================================= */

                    .footer-terms {
                        width: 58%;

                        float: left;

                        box-sizing: border-box;

                        padding-right: 10px;

                        margin: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       RIGHT SIDE RECEIVED BY
                       ================================================= */

                    .footer-received {
                        width: 42%;

                        float: right;

                        box-sizing: border-box;

                        padding-left: 10px;

                        margin: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       TERMS
                       ================================================= */

                    .footer-term {
                        margin: 0 0 2px 0;

                        padding: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       RECEIVED BY TITLE
                       ================================================= */

                    .footer-received-title {
                        font-weight: bold;

                        margin: 0 0 3px 0;

                        padding: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       RECEIVED BY ROW
                       ================================================= */

                    .footer-received-row {
                        margin: 0 0 3px 0;

                        padding: 0;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       CLEAR FLOAT
                       ================================================= */

                    .footer-clear {
                        clear: both;

                        height: 0;

                        line-height: 0;

                        margin: 0;

                        padding: 0;

                        border: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       STAMP MESSAGE
                       =================================================
                       IMPORTANT:
                       This is INSIDE footer.
                       ================================================= */

                    .footer-stamp {
                        width: 100%;

                        margin: 5px 0 0 0;

                        padding: 0;

                        font-size: 9px;

                        line-height: 12px;

                        color: #555;

                        box-sizing: border-box;

                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;

                        background: transparent !important;
                    }


                    /* =================================================
                       FORCE FOOTER CHILDREN NO BORDER
                       ================================================= */

                    .footer-at-bottom,
                    .footer-at-bottom *,
                    .footer-content,
                    .footer-content * {
                        border: none !important;

                        outline: none !important;

                        box-shadow: none !important;
                    }


                    /* =================================================
                       HIDE PHONE / FAX / EMAIL
                       ================================================= */

                    .o_address_format span[itemprop="telephone"],
                    .o_address_format span[itemprop="fax"],
                    .o_address_format span[itemprop="email"] {
                        display: none !important;
                    }

                </style>


                <!-- ====================================================
                     DELIVERY LINES
                     ==================================================== -->

                <t t-set="lines"
                   t-value="o.move_ids_without_package"/>


                <!-- ====================================================
                     PRODUCT LINES PER PAGE
                     ==================================================== -->

                <t t-set="chunk_size"
                   t-value="14"/>


                <t t-set="total_lines"
                   t-value="len(lines)"/>


                <!-- ====================================================
                     CREATE PAGES
                     ==================================================== -->

                <t t-if="total_lines == 0">

                    <t t-set="pages"
                       t-value="[[]]"/>

                </t>

                <t t-else="">

                    <t t-set="pages"
                       t-value="
                           [lines[i:i + chunk_size]
                            for i in range(0, total_lines, chunk_size)]
                       "/>

                </t>


                <!-- ====================================================
                     LOOP THROUGH EVERY PAGE
                     ==================================================== -->

                <t t-foreach="pages"
                   t-as="page_lines">


                    <!-- =================================================
                         INDIVIDUAL PAGE
                         ================================================= -->

                    <div class="page-box">


                        <!-- =============================================
                             MAIN CONTENT
                             ============================================= -->

                        <div class="content-container">


                            <!-- =========================================
                                 DELIVERY NOTE HEADER
                                 FIRST PAGE ONLY
                                 ========================================= -->

                            <t t-if="page_lines == pages[0]">


                                <!-- =====================================
                                     DELIVERY NOTE TITLE
                                     ===================================== -->

                                <div style="
                                    text-align: center;
                                    font-weight: bold;
                                    font-size: 18px;
                                    margin-top: 10px;
                                    margin-bottom: 15px;
                                    text-transform: uppercase;
                                    color: #003366;
                                ">

                                    DELIVERY NOTE

                                </div>


                                <!-- =====================================
                                     CUSTOMER INFORMATION TABLE
                                     ===================================== -->

                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    table-layout: fixed;
                                    margin-top: 5px;
                                ">


                                    <!-- HEADER ROW -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <!-- CUSTOMER -->

                                        <td style="
                                            width: 50%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                            text-align: left;
                                        ">

                                            Customer Details

                                        </td>


                                        <!-- PO NUMBER -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Purchase Order No.

                                        </td>


                                        <!-- DOCUMENT DATE -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Document Dated

                                        </td>


                                        <!-- DELIVERY NOTE -->

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Note No.

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         CUSTOMER DETAILS ROW
                                         ================================= -->

                                    <tr>


                                        <!-- CUSTOMER DETAILS -->

                                        <td rowspan="3"
                                            style="
                                                width: 50%;
                                                border: 1px solid #000;
                                                padding: 8px;
                                                vertical-align: top;
                                                font-size: 10px;
                                                box-sizing: border-box;
                                            ">

                                            <div t-field="o.partner_id"
                                                 t-options='{
                                                     "widget": "contact",
                                                     "fields": [
                                                         "address",
                                                         "name",
                                                         "vat",
                                                         "company_registry"
                                                     ],
                                                     "no_marker": true
                                                 }'/>

                                        </td>


                                        <!-- PURCHASE ORDER NUMBER -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-esc="o.sale_id.client_order_ref or ''"/>

                                        </td>


                                        <!-- DOCUMENT DATE -->

                                        <td style="
                                            width: 16.67%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.scheduled_date"
                                                  t-options="{'widget': 'date'}"/>

                                        </td>


                                        <!-- DELIVERY NOTE NUMBER -->

                                        <td style="
                                            width: 16.66%;
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            font-weight: bold;
                                            vertical-align: middle;
                                            height: 30px;
                                        ">

                                            <span t-field="o.name"/>

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         SECOND HEADER
                                         ================================= -->

                                    <tr style="
                                        background-color: #f2f2f2;
                                        font-weight: bold;
                                        text-align: center;
                                    ">


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Details

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            Delivery Terms

                                        </td>


                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            font-size: 9px;
                                        ">

                                            GRN No.

                                        </td>

                                    </tr>


                                    <!-- =================================
                                         SECOND INFORMATION ROW
                                         ================================= -->

                                    <tr>


                                        <!-- DELIVERY DETAILS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.delivery_details or ''"/>

                                        </td>


                                        <!-- DELIVERY TERMS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.delivery_terms or ''"/>

                                        </td>


                                        <!-- GRN NUMBER -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 8px;
                                            text-align: center;
                                            font-size: 10px;
                                            vertical-align: middle;
                                            height: 30px;
                                            min-height: 30px;
                                        ">

                                            <span t-esc="o.grn_no or ''"/>

                                        </td>

                                    </tr>

                                </table>

                            </t>


                            <!-- =================================================
                                 PRODUCTS TABLE
                                 ================================================= -->

                            <table style="
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 25px;
                                table-layout: fixed;
                            ">


                                <!-- =========================================
                                     TABLE HEADER
                                     ========================================= -->

                                <thead>

                                    <tr style="
                                        background-color: #e9ecef;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 11px;
                                    ">


                                        <!-- ITEM CODE -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 12%;
                                        ">

                                            Item Code

                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 42%;
                                        ">

                                            Description of Goods &amp; Services

                                        </td>


                                        <!-- PART NUMBER -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 14%;
                                        ">

                                            Part Number

                                        </td>


                                        <!-- QTY -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Qty

                                        </td>


                                        <!-- UNITS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 7%;
                                        ">

                                            Units

                                        </td>


                                        <!-- REMARKS -->

                                        <td style="
                                            border: 1px solid #000;
                                            padding: 5px;
                                            width: 18%;
                                        ">

                                            Remarks

                                        </td>

                                    </tr>

                                </thead>


                                <!-- =========================================
                                     PRODUCT ROWS
                                     ========================================= -->

                                <tbody>

                                    <t t-foreach="page_lines"
                                       t-as="move">


                                        <tr>


                                            <!-- ITEM CODE -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                                height: 18px;
                                            ">

                                            </td>


                                            <!-- DESCRIPTION -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">

                                                <!-- PRODUCT NAME -->

                                                <div>

                                                    <span t-field="move.product_id.name"/>

                                                </div>


                                                <!-- ADDITIONAL SALES DESCRIPTION -->

                                                <t t-if="move.sale_line_id and move.sale_line_id.name">

                                                    <t t-set="full_desc"
                                                       t-value="move.sale_line_id.name"/>


                                                    <t t-if="full_desc != move.product_id.name">

                                                        <div style="
                                                            color: #333;
                                                            font-size: 9px;
                                                            margin-top: 2px;
                                                        ">

                                                            <span t-esc="
                                                                full_desc.replace(
                                                                    '[' + str(
                                                                        move.product_id.default_code or ''
                                                                    ) + ']',
                                                                    ''
                                                                ).replace(
                                                                    move.product_id.name,
                                                                    ''
                                                                ).strip()
                                                            "/>

                                                        </div>

                                                    </t>

                                                </t>

                                            </td>


                                            <!-- PART NUMBER -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_id.default_code"/>

                                            </td>


                                            <!-- QUANTITY -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom_qty"/>

                                            </td>


                                            <!-- UNITS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                                text-align: center;
                                            ">

                                                <span t-field="move.product_uom.name"/>

                                            </td>


                                            <!-- REMARKS -->

                                            <td style="
                                                border: 1px solid #000;
                                                padding: 4px;
                                            ">

                                                <span t-field="move.x_remark"/>

                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                            </table>

                        </div>


                        <!-- =================================================
                             FOOTER
                             =================================================
                             THIS FOOTER IS INSIDE page-box.

                             Therefore EVERY PAGE gets:

                             1. Terms
                             2. Received By
                             3. Name
                             4. Date
                             5. Signature
                             6. Stamp message

                             The footer is positioned at bottom: 0.
                             ================================================= -->

                        <div class="footer-at-bottom">


                            <div class="footer-content">


                                <!-- =====================================
                                     LEFT SIDE TERMS
                                     ===================================== -->

                                <div class="footer-terms">


                                    <!-- TERM A -->

                                    <div class="footer-term">

                                        a) goods once sold cannot be returned

                                    </div>


                                    <!-- TERM B -->

                                    <div class="footer-term">

                                        b) no responsibility can be accepted for shortage or damage in transit

                                    </div>


                                    <!-- TERM C -->

                                    <div class="footer-term">

                                        c) all the above goods received in good order and condition

                                    </div>

                                </div>


                                <!-- =====================================
                                     RIGHT SIDE RECEIVED BY
                                     ===================================== -->

                                <div class="footer-received">


                                    <!-- RECEIVED BY -->

                                    <div class="footer-received-title">

                                        Received By:

                                    </div>


                                    <!-- NAME -->

                                    <div class="footer-received-row">

                                        Name: ______________________

                                    </div>


                                    <!-- DATE -->

                                    <div class="footer-received-row">

                                        Date: ______________________

                                    </div>


                                    <!-- SIGNATURE -->

                                    <div class="footer-received-row">

                                        Signature: __________________

                                    </div>

                                </div>


                                <!-- =====================================
                                     CLEAR FLOAT
                                     ===================================== -->

                                <div class="footer-clear"></div>


                                <!-- =====================================
                                     STAMP MESSAGE
                                     ===================================== -->

                                <div class="footer-stamp">

                                    Please stamp upon acknowledgement of Goods &amp; Services

                                </div>


                            </div>

                        </div>


                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>