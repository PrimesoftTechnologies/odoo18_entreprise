<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit ya Purchase Order -->
    <template id="report_purchaseorder_document_inherit_part_no"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <!-- Inherit ya Purchase Quotation (RFQ) -->
    <template id="report_purchasequotation_document_inherit_part_no"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>
    </template>

    <!-- Delivery Slip: Jedwali kuu (Draft/Waiting/Ready) -->
    <template id="report_delivery_document_inherit_product_name"
              inherit_id="stock.report_delivery_document">
        <!-- Jedwali Kuu la Moves -->
        <xpath expr="//table[@name='stock_move_table']//span[@t-field='move.product_id']" position="replace">
            <span t-field="move.product_id.name"/>
        </xpath>
        
        <!-- Jedwali la Backorder kama lipo -->
        <xpath expr="//table[@name='stock_backorder_table']//span[@t-field='bo_line.product_id']" position="replace">
            <span t-field="bo_line.product_id.name"/>
        </xpath>

        <!-- Jedwali la Done (stock_move_line_table) kama lipo kwenye document kuu -->
        <xpath expr="//table[@name='stock_move_line_table']//span[@t-field='move_line.product_id']" position="replace">
            <span t-field="move_line.product_id.name"/>
        </xpath>
    </template>

</odoo>