<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_part_no"
              inherit_id="sale.report_saleorder_document">

        <!-- Product Name and Description Headers -->
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_product_name" class="text-start">
                Product Name
            </th>
            <th name="th_product_description" class="text-start">
                Description
            </th>
        </xpath>

        <!-- Separate Product Name and Description -->
        <xpath expr="//td[@name='td_name']" position="replace">

            <!-- Product Name: Limit to approximately 2 lines -->
            <td name="td_product_name"
                class="text-start"
                style="vertical-align: top;">

                <div style="
                    max-height: 2.8em;
                    line-height: 1.4em;
                    overflow: hidden;
                    word-wrap: break-word;
                    overflow-wrap: anywhere;
                ">
                    <span t-field="line.product_id.name"/>
                </div>

            </td>

            <!-- Description: Show extra description or product name -->
            <td name="td_product_description"
                class="text-start"
                style="vertical-align: top;">

                <t t-set="full_desc"
                   t-value="(line.name or '').strip()"/>

                <t t-set="product_name"
                   t-value="(line.product_id.name or '').strip()"/>

                <t t-set="part_no"
                   t-value="(line.product_id.default_code or '').strip()"/>

                <!-- Remove product reference from the beginning -->
                <t t-set="clean_desc"
                   t-value="full_desc.replace('[' + part_no + ']', '', 1).strip() if part_no else full_desc"/>

                <!-- Remove product name if it starts the description -->
                <t t-set="extra_desc"
                   t-value="clean_desc[len(product_name):].strip() if product_name and clean_desc.startswith(product_name) else clean_desc"/>

                <!-- Fallback: show product name if no extra description -->
                <span t-esc="extra_desc or product_name"/>

            </td>

        </xpath>

    </template>

</odoo>
