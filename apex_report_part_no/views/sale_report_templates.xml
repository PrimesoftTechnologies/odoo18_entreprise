<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SALES ORDER / QUOTATION REPORT
         Separate columns:  Product Name  |  Description
           Product Name = product name only
           Description  = the line text (internal reference "[CODE]" hidden)
         priority 99 = applied after apexholding, so the S/N column that
         apexholding adds stays first.
         ============================================================ -->

    <template id="report_saleorder_document_inherit_part_no"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <!-- Header: new "Product Name" column before Description -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_product_name" class="text-start">
                <strong>Product Name</strong>
            </th>
        </xpath>

        <!-- Row: Product Name cell before the Description cell -->
        <xpath expr="//span[@t-field='line.name']/ancestor::td[1]" position="before">
            <td name="td_product_name">
                <span t-if="line.product_id" t-field="line.product_id.name"/>
            </td>
        </xpath>

        <!-- Description cell = line text without the [CODE] prefix -->
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <t t-if="line.product_id">
                <t t-set="ln_code" t-value="'[%s] ' % (line.product_id.default_code or '')"/>
                <span style="white-space: pre-line;"
                      t-esc="(line.name or '')[len(ln_code):] if (line.product_id.default_code and (line.name or '').startswith(ln_code)) else (line.name or '')"/>
            </t>
            <t t-else="">
                <span t-field="line.name"/>
            </t>
        </xpath>

    </template>


    <!-- ============================================================
         DOCUMENT REFERENCE (top right) - APEX style
         "Quotation No." / "Sales Order No." on line 1, number on line 2
         Bold, navy, right aligned, Arial (size set in apex_report_format.css)
         Appended at the end of the t-call body, so it overrides any
         earlier layout_document_title.
         ============================================================ -->

    <template id="report_saleorder_document_apex_reference"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <xpath expr="//t[@t-call='web.external_layout']" position="inside">

            <t t-set="layout_document_title">
                <span class="apex-reference"
                      style="display: block; text-align: right; font-weight: bold;">
                    <span style="display: block;">
                        <t t-if="doc.state in ('draft', 'sent')">Quotation No.</t>
                        <t t-else="">Sales Order No.</t>
                    </span>
                    <span style="display: block;" t-esc="doc.name"/>
                </span>
            </t>

        </xpath>

    </template>

</odoo>
