<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SALES ORDER / QUOTATION REPORT
         Layout is NOT changed (SN | Description | Brand | Part No |
         Item Code | Availability | Quantity | Unit Price | Line Value).
         Description cell = the description only; when no description is
         filled it shows the product name. Note / section lines are untouched.
         ============================================================ -->

    <template id="report_saleorder_document_inherit_part_no"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <!-- Description cell = line text without the [CODE] prefix -->
        <xpath expr="//span[@t-field='line.name']" position="replace">
            <t t-if="line.product_id">
                <!-- Description column = description only.
                     1) Remove the leading product name ("[CODE] Name" / "Name"),
                        but only when it is followed by a new line or nothing
                        (Odoo's automatic text). Text typed manually on the
                        same line is kept as is.
                     2) If nothing is left (no description filled), show the
                        product name instead. -->
                <t t-set="ln_txt" t-value="line.name or ''"/>
                <t t-set="ln_cands"
                   t-value="[line.product_id.display_name or '', '[%s] %s' % (line.product_id.default_code or '', line.product_id.name or ''), line.product_id.name or '']"/>
                <t t-set="ln_match"
                   t-value="[c for c in ln_cands if c and (ln_txt == c or ln_txt.startswith(c + '\n'))]"/>
                <t t-set="ln_desc"
                   t-value="ln_txt[len((ln_match + [''])[0]):].strip()"/>
                <span style="white-space: pre-line;"
                      t-esc="ln_desc or line.product_id.name"/>
            </t>
            <t t-else="">
                <span t-field="line.name"/>
            </t>
        </xpath>

    </template>


    <!-- ============================================================
         DOCUMENT REFERENCE (top right) - APEX style
         "Quotation No." / "Sales Order No." on line 1, number on line 2
         Bold, navy, right aligned, Arial (size set in apex_report_format.css)
         Appended at the end of the t-call body, so it overrides any
         earlier layout_document_title.
         ============================================================ -->

    <template id="report_saleorder_document_apex_reference"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <xpath expr="//t[@t-call='web.external_layout']" position="inside">

            <t t-set="layout_document_title">
                <span class="apex-reference"
                      style="display: block; text-align: right; font-weight: bold;">
                    <span style="display: block;">
                        <t t-if="doc.state in ('draft', 'sent')">Quotation No.</t>
                        <t t-else="">Sales Order No.</t>
                    </span>
                    <span style="display: block;" t-esc="doc.name"/>
                </span>
            </t>

        </xpath>

    </template>

</odoo>
