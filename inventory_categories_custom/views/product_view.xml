<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Hii inafanya Category iwe na Column ya Company kwenye List View -->
    <record id="view_category_list_inherit_company" model="ir.ui.view">
        <field name="name">product.category.list.inherit.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- 2. Hii inafanya iwe na field ya Company kwenye Fomu ya Category -->
    <record id="view_category_form_inherit_company" model="ir.ui.view">
        <field name="name">product.category.form.inherit.company</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>

    <!-- 3. Tunabaki na domain tu kwa ajili ya kuchuja categories -->
    <record id="view_product_template_form_inherit_company_cat" model="ir.ui.view">
        <field name="name">product.template.form.inherit.company.cat</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="domain">['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. Kulazimisha company_id isome kampuni ya sasa na isiweze kubadilishwa holela -->
    <record id="view_product_template_form_inherit_company_default" model="ir.ui.view">
        <field name="name">product.template.form.inherit.company.default</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 5. Kuzuia company_id isome makampuni yasiyohusika kwenye session (kama My Company) -->
    <record id="view_product_template_form_inherit_company_filter" model="ir.ui.view">
        <field name="name">product.template.form.inherit.company.filter</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_company_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>