<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apex_purchase_reject_wizard_form" model="ir.ui.view">
        <field name="name">apex.purchase.reject.wizard.form</field>
        <field name="model">apex.purchase.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this order rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
