<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_production_form_helper_approval" model="ir.ui.view">
        <field name="name">mrp.production.form.helper.approval</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- "Confirm" becomes "Submit for Approval" -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="name">action_submit_for_approval</attribute>
                <attribute name="string">Submit for Approval</attribute>
                <attribute name="invisible">state != 'draft' or approval_state == 'prod_pending'</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <!-- Level 1: Production Manager -->
                <button name="action_approve_production" type="object" string="Approve" class="oe_highlight"
                        groups="helper_sales.group_mo_production_manager"
                        invisible="state != 'draft' or approval_state != 'prod_pending'"/>
                <button name="action_open_reject_wizard" type="object" string="Reject"
                        groups="helper_sales.group_mo_production_manager"
                        invisible="state != 'draft' or approval_state != 'prod_pending'"/>

                <!-- Level 2: Cost Shared Manager (approves by clicking Produce All) -->
                <button name="action_open_reject_wizard" type="object" string="Reject"
                        groups="helper_sales.group_mo_cost_share_manager"
                        invisible="approval_state != 'cost_pending'"/>
                <button name="action_wait_cost_approval" type="object" string="Wait for Cost Shared Approval"
                        class="btn-warning"
                        groups="!helper_sales.group_mo_cost_share_manager"
                        invisible="approval_state != 'cost_pending'"/>

                <!-- Partial production: only the Production Manager decides Backorder / No Backorder -->
                <button name="action_wait_backorder_decision" type="object"
                        string="Wait for Production Manager (Backorder)"
                        class="btn-warning"
                        groups="!helper_sales.group_mo_production_manager"
                        invisible="approval_state != 'backorder_pending'"/>
            </xpath>

            <xpath expr="//header" position="after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not reject_reason">
                    <strong>Rejected: </strong>
                    <field name="reject_reason" readonly="1" nolabel="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'draft' or approval_state != 'prod_pending'">
                    This Manufacturing Order is waiting for the Production Manager's approval.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="approval_state != 'cost_pending'"
                     groups="!helper_sales.group_mo_cost_share_manager">
                    Waiting for the Cost Shared Manager's approval.
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="approval_state != 'cost_pending'"
                     groups="helper_sales.group_mo_cost_share_manager">
                    Please check the Cost Share (%) in the By-Products tab, then click <strong>Produce All</strong>
                    to approve, or <strong>Reject</strong>.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="approval_state != 'backorder_pending'"
                     groups="!helper_sales.group_mo_production_manager">
                    Cost Shared is approved. Waiting for the Production Manager to decide Backorder / No Backorder.
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="approval_state != 'backorder_pending'"
                     groups="helper_sales.group_mo_production_manager">
                    Cost Shared is approved. Click <strong>Produce All / Mark as Done</strong> and choose
                    <strong>Create Backorder</strong> or <strong>No Backorder</strong> to finish.
                </div>
            </xpath>

            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="approval_state" widget="badge"
                       decoration-info="approval_state in ('prod_pending', 'cost_pending', 'backorder_pending')"
                       decoration-success="approval_state in ('prod_approved', 'cost_approved')"
                       decoration-danger="approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <!-- Reject pop-up -->
    <record id="view_mrp_production_reject_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.reject.wizard.form</field>
        <field name="model">mrp.production.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Manufacturing Order">
                <group>
                    <field name="production_id" invisible="1"/>
                    <field name="level" invisible="1"/>
                    <field name="reason" placeholder="Please write the reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
