<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_helper" model="ir.ui.view">
        <field name="name">sale.order.form.helper</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Tunalenga field ya user_id moja kwa moja bila kuhitaji jina la group -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="helper_id" widget="many2one_avatar_employee"/>
            </xpath>
        </field>
    </record>
</odoo>