<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_order_form_helper" model="ir.ui.view">
        <field name="name">sale.order.form.helper</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='other_information']//group[@name='sales_person']/field[@name='user_id']" position="after">
                <field name="helper_id"/>
            </xpath>

        </field>
    </record>

</odoo>