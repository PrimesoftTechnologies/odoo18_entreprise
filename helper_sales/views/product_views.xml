<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 1. Form na Tree view ya Reference Categories -->
    <record id="view_product_ref_category_tree" model="ir.ui.view">
        <field name="name">product.ref.category.tree</field>
        <field name="model">product.ref.category</field>
        <field name="arch" type="xml">
            <list string="Reference Categories" editable="bottom">
                <field name="name"/>
                <field name="prefix"/>
            </list>
        </field>
    </record>

    <record id="action_product_ref_category" model="ir.actions.act_window">
        <field name="name">Reference Categories</field>
        <field name="res_model">product.ref.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Kuweka Menu chini ya Inventory -> Configuration -> Products -->
    <menuitem id="menu_product_ref_category" 
              name="Reference Categories" 
              parent="stock.menu_product_in_config_stock"
              action="action_product_ref_category" 
              sequence="15"/>

    <!-- 2. Kuongeza uwanja kwenye fomu ya Product Template -->
    <record id="view_product_template_form_inherit_ref_category" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ref.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="ref_category_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>