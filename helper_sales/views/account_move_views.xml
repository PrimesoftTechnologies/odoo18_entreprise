<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_helper_logistic" model="ir.ui.view">
        <field name="name">account.move.form.inherit.helper.logistic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Kuweka fields za logistics kwenye Invoice na kuwa read-only ikiwa haiko draft -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="driver_id" widget="many2one_avatar_employee" readonly="state != 'draft'"/>
                <field name="helper_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                <field name="car_number" readonly="state != 'draft'"/>
                <field name="region_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>