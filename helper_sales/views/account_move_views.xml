<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_helper_logistic" model="ir.ui.view">
        <field name="name">account.move.form.inherit.helper.logistic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="driver_name" readonly="state != 'draft'"/>
                <field name="helper_name" readonly="state != 'draft'"/>
                <field name="car_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                <field name="region_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
