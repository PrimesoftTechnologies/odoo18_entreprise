<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_helper_logistic" model="ir.ui.view">
        <field name="name">account.move.form.inherit.helper.logistic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- 1. Kitufe cha Review kionekane kikiwa posted na hakijawa reviewed -->
            <xpath expr="//header" position="inside">
                <button name="action_review" string="Review" type="object" class="oe_highlight" invisible="state != 'posted'"/>
            </xpath>

            <!-- 2. Kuruhusu vifungo vya Reverse Entry na Reset to Draft vionekane hata kikiwa Reviewed -->
            <xpath expr="//header//button[@name='action_reverse']" position="attributes">
                <attribute name="invisible">state not in ('posted', 'reviewed')</attribute>
            </xpath>
            <xpath expr="//header//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">state not in ('posted', 'reviewed')</attribute>
            </xpath>

            <!-- 3. Rekebisha statusbar ya asili ionyeshe Draft, Posted, Reviewed katika mstari mmoja -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,posted,reviewed</attribute>
            </xpath>

            <!-- 4. Ujumbe wa chini ya Header kulingana na state -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="state == 'reviewed'">
                    <strong>This entry contains a manual operation made in the bank reconciliation. It must be reviewed.</strong>
                </div>
                <div class="alert alert-success mb-0" role="alert" invisible="state != 'reviewed'">
                    <strong>Reviewed</strong>
                </div>
            </xpath>

            <!-- 5. Sehemu ya ziada ya Logistics fields -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="driver_ids" widget="many2many_tags" domain="[('is_external', '=', False)]" options="{'no_create_edit': True}" readonly="state != 'draft'"/>
                <field name="sale_helper_ids" widget="many2many_tags" domain="[('is_external', '=', False)]" options="{'no_create_edit': True}" readonly="state != 'draft'"/>
                <field name="car_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                <field name="region_id" readonly="state != 'draft'"/>
            </xpath>
            
        </field>
    </record>
</odoo>