<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Logistics Managers can register vehicles in Fleet -->
    <record id="group_logistics_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
    </record>

    <!-- Everybody can pick a vehicle (Car Number) on orders, invoices and transfers -->
    <record id="access_fleet_vehicle_helper_sales_user" model="ir.model.access">
        <field name="name">fleet.vehicle.helper.sales.user</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
