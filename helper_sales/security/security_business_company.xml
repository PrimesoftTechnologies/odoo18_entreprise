<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Company X selected: only X's Business Models. All companies selected: all of them. -->
    <record id="sale_business_model_company_rule" model="ir.rule">
        <field name="name">Business Model: multi-company</field>
        <field name="model_id" ref="model_sale_business_model"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
