<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Helper Sales: Logistics Manager (Cars, Drivers, Helpers)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_stock_count_approver" model="res.groups">
        <field name="name">Helper Sales: Physical Count Approver</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_update_quantity" model="res.groups">
        <field name="name">Helper Sales: Can Update Quantity</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrators can always manage cars / drivers / helpers -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('helper_sales.group_logistics_manager'))]"/>
    </record>

    <!-- Manufacturing approvals -->
    <record id="group_mo_production_manager" model="res.groups">
        <field name="name">Helper Sales: MO Approval - Production Manager</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mo_cost_share_manager" model="res.groups">
        <field name="name">Helper Sales: MO Approval - Cost Shared Manager</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
</odoo>
