<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Report Action ya Gate Pass -->
    <record id="action_report_gate_pass" model="ir.actions.report">
        <field name="name">Gate Pass</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">helper_sales.report_gate_pass_document</field>
        <field name="report_file">helper_sales.report_gate_pass_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template safi kabisa ya Gate Pass -->
    <template id="report_gate_pass_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="o">
                <main>
                    <div class="page" style="font-size: 13px;">
                        
                        <!-- Sehemu ya Anwani ya Mteja -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <span t-field="o.partner_id.commercial_partner_id"
                                      t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'vat'], 'no_marker': True}"/>
                            </div>
                        </div>

                        <!-- Kichwa: GATE PASS na Namba ya Invoice -->
                        <div class="row mt-4 mb-3">
                            <div class="col-12">
                                <h3 style="font-weight: bold; color: #333; margin-bottom: 5px;">GATE PASS</h3>
                                <h2 style="font-weight: bold; color: #008784; margin-top: 0;">
                                    <span t-field="o.name"/>
                                </h2>
                            </div>
                        </div>

                        <!-- Orodha ya Bidhaa -->
                        <table class="table table-sm o_main_table" style="margin-top: 20px;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th name="th_description"><span>Description</span></th>
                                    <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                    <th name="th_priceunit" class="text-end"><span>Unit Price</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Sehemu ya Driver & Truck Name Saini -->
                        <div style="margin-top: 25px;">
                            <table style="width: 100%; border-collapse: collapse !important; border: 1px solid #dee2e6;">
                                <tr style="background-color: #f8f9fa;">
                                    <td style="width: 50%; padding: 10px; border-right: 1px solid #dee2e6;">
                                        <strong>Driver name &amp; Signature:</strong>
                                        <div style="margin-top: 35px; border-bottom: 1px solid black; width: 90%;"></div>
                                    </td>
                                    <td style="width: 50%; padding: 10px;">
                                        <strong>Truck name:</strong>
                                        <div style="margin-top: 35px; border-bottom: 1px solid black; width: 90%;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Sehemu ya Saini za Chini (Zimeondolewa Manager na Auditor) -->
                        <div style="margin-top: 30px; page-break-inside: avoid;">
                            <table style="width: 100%; border-collapse: collapse !important; border: 1px solid #dee2e6;">
                                <tr style="background-color: #f8f9fa;">
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>Prepared By:</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>Supervisor I</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>StoreKeeper</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>Approved BY</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                </tr>
                                <tr>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>Supervisor II</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"><strong>Security</strong><div style="margin-top: 25px; border-bottom: 1px solid black; width: 90%;"></div></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"></td>
                                    <td style="width: 25%; padding: 8px; border: 1px solid #dee2e6;"></td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </main>
            </t>
        </t>
    </template>
</odoo>