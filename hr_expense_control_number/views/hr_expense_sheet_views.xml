<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_sheet_form_inherit_control_number" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.inherit.control.number</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="control_number" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="hr_expense_sheet_view_search_inherit_control_number" model="ir.ui.view">
        <field name="name">hr.expense.sheet.view.search.inherit.control.number</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_sheet_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('control_number', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="control_number"/>
            </field>
        </field>
    </record>

</odoo>
