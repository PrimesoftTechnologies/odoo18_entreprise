<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_meals_bic" model="ir.ui.view">
        <field name="name">hr.contract.form.meals.bic</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <label for="meals_amount"/>
                <div class="o_row" name="meals_amount">
                    <field name="meals_amount" nolabel="1" class="oe_inline o_hr_narrow_field"/>
                    <field name="meals_period_label" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
