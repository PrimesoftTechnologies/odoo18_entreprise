<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_meals_bic" model="ir.ui.view">
        <field name="name">hr.contract.form.meals.bic</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <label for="meals_amount"/>
                <div class="o_row" name="meals_amount">
                    <field name="meals_amount" nolabel="1"/>
                    <span>/ month</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
