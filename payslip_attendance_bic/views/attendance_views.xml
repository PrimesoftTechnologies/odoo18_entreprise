<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payslip_attendance_bic_view_list" model="ir.ui.view">
        <field name="name">payslip.attendance.bic.list</field>
        <field name="model">payslip.attendance.bic</field>
        <field name="arch" type="xml">
            <list string="Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="time" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="payslip_attendance_bic_view_form" model="ir.ui.view">
        <field name="name">payslip.attendance.bic.form</field>
        <field name="model">payslip.attendance.bic</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="time" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="payslip_attendance_bic_view_search" model="ir.ui.view">
        <field name="name">payslip.attendance.bic.search</field>
        <field name="model">payslip.attendance.bic</field>
        <field name="arch" type="xml">
            <search string="Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="payslip_attendance_bic_action" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">payslip.attendance.bic</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record the first attendance</p>
        </field>
    </record>

    <menuitem id="menu_payslip_attendance_bic"
              name="Attendance"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="payslip_attendance_bic_action"
              sequence="50"
              groups="hr_payroll.group_hr_payroll_user"/>
</odoo>
