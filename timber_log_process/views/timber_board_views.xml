<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Board Form View -->
    <record id="view_timber_board_form" model="ir.ui.view">
        <field name="name">timber.board.form</field>
        <field name="model">timber.board</field>
        <field name="arch" type="xml">
            <form string="Timber Board">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="processing_id" readonly="1"/>
                            <field name="log_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="width" readonly="1"/>
                            <field name="thickness" readonly="1"/>
                            <field name="length" readonly="1"/>
                            <field name="cbm" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Board List View -->
    <record id="view_timber_board_tree" model="ir.ui.view">
        <field name="name">timber.board.list</field>
        <field name="model">timber.board</field>
        <field name="arch" type="xml">
            <list string="Timber Boards">
                <field name="name"/>
                <field name="processing_id"/>
                <field name="log_id"/>
                <field name="width"/>
                <field name="thickness"/>
                <field name="length"/>
                <field name="cbm" sum="Total Board CBM"/>
                <field name="warehouse_id"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-muted="status == 'sold'"/>
            </list>
        </field>
    </record>

    <!-- Board Action -->
    <record id="action_timber_board" model="ir.actions.act_window">
        <field name="name">Timber Boards</field>
        <field name="res_model">timber.board</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Individual timber boards produced from sawing.</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- FINISHED GOOD STOCK REPORT VIEWS           -->
    <!-- ========================================== -->
    <record id="view_timber_board_report_pivot" model="ir.ui.view">
        <field name="name">timber.board.report.pivot</field>
        <field name="model">timber.board</field>
        <field name="arch" type="xml">
            <pivot string="Finished Good Stock Report">
                <field name="warehouse_id" type="row"/>
                <field name="status" type="col"/>
                <field name="cbm" type="measure" string="Total CBM"/>
            </pivot>
        </field>
    </record>

    <record id="view_timber_board_report_tree" model="ir.ui.view">
        <field name="name">timber.board.report.list</field>
        <field name="model">timber.board</field>
        <field name="arch" type="xml">
            <list string="Finished Good Stock" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="processing_id"/>
                <field name="width"/>
                <field name="thickness"/>
                <field name="length"/>
                <field name="cbm" sum="Total CBM"/>
                <field name="warehouse_id"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-muted="status == 'sold'"/>
            </list>
        </field>
    </record>

    <record id="action_timber_finished_stock_report" model="ir.actions.act_window">
        <field name="name">Finished Good Stock</field>
        <field name="res_model">timber.board</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('status', '=', 'available')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_timber_board_report_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_timber_board_report_pivot')})]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">No finished good stock available yet.</p>
        </field>
    </record>
</odoo>