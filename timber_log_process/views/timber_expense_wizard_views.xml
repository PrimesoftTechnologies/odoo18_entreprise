<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_timber_expense_report_wizard_form" model="ir.ui.view">
        <field name="name">timber.expense.report.wizard.form</field>
        <field name="model">timber.expense.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Expense Report Options">
                <group>
                    <field name="target_type" widget="radio"/>
                    <field name="log_id" invisible="target_type == 'all'" required="target_type == 'specific'"/>
                </group>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print Financial Summary" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action Window -->
    <record id="action_timber_expense_report_wizard" model="ir.actions.act_window">
        <field name="name">Expense Report Options</field>
        <field name="res_model">timber.expense.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>