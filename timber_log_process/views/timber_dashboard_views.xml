<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timber_dashboard_form" model="ir.ui.view">
        <field name="name">timber.dashboard.form</field>
        <field name="model">timber.dashboard</field>
        <field name="arch" type="xml">
            <form string="Timber Dashboard">
                <sheet>
                    <field name="currency_id" invisible="1"/>

                    <!-- Header + date filters -->
                    <div class="d-flex flex-wrap align-items-end gap-3 mb-4 pb-3 border-bottom">
                        <h3 class="flex-grow-1 mb-0">
                            <i class="fa fa-dashboard me-2 text-primary"/>Timber Dashboard
                        </h3>
                        <div>
                            <label for="filter_from_date" class="text-muted small text-uppercase d-block">From Date</label>
                            <field name="filter_from_date"/>
                        </div>
                        <div>
                            <label for="filter_to_date" class="text-muted small text-uppercase d-block">To Date</label>
                            <field name="filter_to_date"/>
                        </div>
                    </div>

                    <!-- Operations -->
                    <h5 class="text-muted text-uppercase small fw-bold mb-3">Operations Summary</h5>
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#795548;"><field name="total_logs"/></div>
                                    <div class="text-muted small">Total Logs</div>
                                </div>
                                <i class="fa fa-tree fa-2x" style="color:#795548;"/>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center small text-muted">
                                <span>Registered Lots</span>
                                <button name="action_view_logs" type="object" class="btn btn-link p-0 small" style="color:#795548;">View</button>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#f59e0b;"><field name="total_sawing_orders"/></div>
                                    <div class="text-muted small">Sawing Orders</div>
                                </div>
                                <i class="fa fa-cogs fa-2x" style="color:#f59e0b;"/>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center small text-muted">
                                <span>Manufacturing Orders</span>
                                <button name="action_view_sawing" type="object" class="btn btn-link p-0 small" style="color:#f59e0b;">View</button>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#16a34a;"><field name="total_board_cbm"/></div>
                                    <div class="text-muted small">Output Timber CBM</div>
                                </div>
                                <i class="fa fa-cubes fa-2x" style="color:#16a34a;"/>
                            </div>
                            <div class="card-footer bg-white small text-muted">
                                <field name="board_ratio_label"/>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#dc2626;"><field name="total_waste_cbm"/></div>
                                    <div class="text-muted small">Total Waste CBM</div>
                                </div>
                                <i class="fa fa-trash fa-2x" style="color:#dc2626;"/>
                            </div>
                            <div class="card-footer bg-white small text-muted">
                                <field name="waste_ratio_label"/>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#0891b2;"><field name="total_log_cbm"/></div>
                                    <div class="text-muted small">Overall Log CBM</div>
                                </div>
                                <i class="fa fa-bar-chart fa-2x" style="color:#0891b2;"/>
                            </div>
                            <div class="card-footer bg-white small text-muted">
                                <span>Total Input</span>
                            </div>
                        </div>
                    </div>

                    <!-- Financials -->
                    <h5 class="text-muted text-uppercase small fw-bold mb-3">Financials &amp; Expenses Summary</h5>
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#2563eb;"><field name="total_purchase_amount" widget="monetary"/></div>
                                    <div class="text-muted small">Total Purchase Amount</div>
                                </div>
                                <i class="fa fa-shopping-cart fa-2x" style="color:#2563eb;"/>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center small text-muted">
                                <span>Logs Procurement</span>
                                <button name="action_view_purchases" type="object" class="btn btn-link p-0 small" style="color:#2563eb;">View</button>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#7c3aed;"><field name="total_operational_expense" widget="monetary"/></div>
                                    <div class="text-muted small">Operational Expenses</div>
                                </div>
                                <i class="fa fa-money fa-2x" style="color:#7c3aed;"/>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between align-items-center small text-muted">
                                <span>Landed Costs</span>
                                <button name="action_view_expenses" type="object" class="btn btn-link p-0 small" style="color:#7c3aed;">View</button>
                            </div>
                        </div>

                        <div class="card flex-fill shadow-sm" style="min-width:200px; border:1px solid #e5e7eb; border-radius:8px;">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fs-3 fw-bold" style="color:#334155;"><field name="grand_total_operations_cost" widget="monetary"/></div>
                                    <div class="text-muted small">Grand Total Investment</div>
                                </div>
                                <i class="fa fa-calculator fa-2x" style="color:#334155;"/>
                            </div>
                            <div class="card-footer bg-white small text-muted">
                                <span>Purchase + Expenses</span>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted small">
                        Live numbers from standard Odoo (Lots, Manufacturing, Purchase and Landed Costs).
                        Change the dates above and the cards update. Ratios come from the Sawing Ratios (Bill of Materials).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_timber_dashboard" model="ir.actions.act_window">
        <field name="name">Timber Dashboard</field>
        <field name="res_model">timber.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_timber_dashboard_form"/>
        <field name="target">current</field>
    </record>
</odoo>