<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings Form View Inheritance -->
    <record id="res_config_settings_view_form_timber" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.timber</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Timber Management" string="Timber Management" name="timber_log_process">
                    <block title="Production Ratios" name="timber_ratio_setting_container">
                        <setting id="timber_percentage_setting" title="Default Ratios" help="Weka uwiano wa asilimia za mbao na taka wakati wa uzalishaji">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" string="Board Percentage (%)" for="timber_board_percentage"/>
                                    <field name="timber_board_percentage"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" string="Waste Percentage (%)" for="timber_waste_percentage"/>
                                    <field name="timber_waste_percentage"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="action_timber_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'timber_log_process'}</field>
    </record>

    <!-- Configuration Menu Items -->
    <menuitem id="menu_timber_config" name="Configuration" parent="menu_timber_root" sequence="100"/>
    <menuitem id="menu_timber_settings" name="Settings" parent="menu_timber_config" action="action_timber_config_settings" sequence="10"/>
</odoo>