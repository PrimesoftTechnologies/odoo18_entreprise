<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log measurements report -->
    <record id="view_timber_measurement_list" model="ir.ui.view">
        <field name="name">timber.measurement.list</field>
        <field name="model">timber.measurement</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="kind"/>
                <field name="picking_id" optional="show"/>
                <field name="production_id" optional="show"/>
                <field name="circumference" optional="hide"/>
                <field name="length" optional="hide"/>
                <field name="width" optional="hide"/>
                <field name="thickness" optional="hide"/>
                <field name="board_length" optional="hide"/>
                <field name="cbm" sum="Total CBM"/>
                <field name="lot_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_timber_measurement_pivot" model="ir.ui.view">
        <field name="name">timber.measurement.pivot</field>
        <field name="model">timber.measurement</field>
        <field name="arch" type="xml">
            <pivot string="Measurements">
                <field name="create_date" interval="month" type="col"/>
                <field name="picking_id" type="row"/>
                <field name="cbm" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_timber_measurement_graph" model="ir.ui.view">
        <field name="name">timber.measurement.graph</field>
        <field name="model">timber.measurement</field>
        <field name="arch" type="xml">
            <graph string="Measurements" type="bar">
                <field name="create_date" interval="month"/>
                <field name="cbm" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_timber_measurement_search" model="ir.ui.view">
        <field name="name">timber.measurement.search</field>
        <field name="model">timber.measurement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="production_id"/>
                <filter name="logs" string="Logs" domain="[('kind', '=', 'log')]"/>
                <filter name="boards" string="Boards" domain="[('kind', '=', 'board')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_picking" string="Receipt" context="{'group_by': 'picking_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'production_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_timber_measurement_report" model="ir.actions.act_window">
        <field name="name">Log Intake Report</field>
        <field name="res_model">timber.measurement</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('kind', '=', 'log')]</field>
    </record>

    <!-- Production (sawing) report on standard Manufacturing Orders -->
    <record id="view_mrp_production_timber_list" model="ir.ui.view">
        <field name="name">mrp.production.timber.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="date_start"/>
                <field name="product_id"/>
                <field name="timber_input_cbm" sum="Logs Used"/>
                <field name="timber_board_cbm" sum="Boards"/>
                <field name="timber_waste_cbm" sum="Waste"/>
                <field name="timber_yield_pct"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_production_timber_pivot" model="ir.ui.view">
        <field name="name">mrp.production.timber.pivot</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Production Report">
                <field name="create_date" interval="month" type="col"/>
                <field name="product_id" type="row"/>
                <field name="product_qty" type="measure"/>
                <field name="timber_board_cbm" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mrp_production_timber_graph" model="ir.ui.view">
        <field name="name">mrp.production.timber.graph</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <graph string="Production Report" type="bar">
                <field name="create_date" interval="month"/>
                <field name="timber_board_cbm" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_timber_production_report" model="ir.actions.act_window">
        <field name="name">Production Report</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('product_id.timber_type', '=', 'board')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mrp_production_timber_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_mrp_production_timber_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_mrp_production_timber_graph')})]"/>
    </record>

    <!-- Stock report on standard stock.quant -->
    <record id="view_stock_quant_timber_list" model="ir.ui.view">
        <field name="name">stock.quant.timber.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="quantity" sum="Total CBM"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="view_stock_quant_timber_pivot" model="ir.ui.view">
        <field name="name">stock.quant.timber.pivot</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <pivot string="Timber Stock">
                <field name="location_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_timber_stock_report" model="ir.actions.act_window">
        <field name="name">Timber Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('location_id.usage', '=', 'internal'), ('product_id.timber_type', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_stock_quant_timber_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_stock_quant_timber_pivot')})]"/>
    </record>

    <!-- Log lots -->
    <record id="view_stock_lot_timber_list" model="ir.ui.view">
        <field name="name">stock.lot.timber.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="timber_circumference"/>
                <field name="timber_log_length"/>
                <field name="timber_cbm" sum="Total Log CBM"/>
                <field name="product_qty" string="On Hand (CBM)"/>
            </list>
        </field>
    </record>

    <record id="action_timber_lots" model="ir.actions.act_window">
        <field name="name">Log Lots</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_id.timber_type', '=', 'log')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_stock_lot_timber_list')})]"/>
    </record>

    <!-- Operational actions on standard models -->
    <record id="action_timber_purchase" model="ir.actions.act_window">
        <field name="name">Log Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_line.product_id.timber_type', '=', 'log')]</field>
    </record>

    <record id="action_timber_receipts" model="ir.actions.act_window">
        <field name="name">Log Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming'), ('move_ids.product_id.timber_type', '=', 'log')]</field>
    </record>

    <record id="action_timber_mrp" model="ir.actions.act_window">
        <field name="name">Sawing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_id.timber_type', '=', 'board')]</field>
    </record>

    <record id="action_timber_sale" model="ir.actions.act_window">
        <field name="name">Timber Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_line.product_id.timber_type', '=', 'board')]</field>
    </record>

    <record id="action_timber_landed_cost" model="ir.actions.act_window">
        <field name="name">Expenses (Landed Costs)</field>
        <field name="res_model">stock.landed.cost</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_timber_products" model="ir.actions.act_window">
        <field name="name">Timber Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('timber_type', '!=', False)]</field>
    </record>

    <record id="action_timber_cost_products" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('landed_cost_ok', '=', True)]</field>
    </record>

    <record id="action_timber_bom" model="ir.actions.act_window">
        <field name="name">Sawing Ratios (Bill of Materials)</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_tmpl_id.timber_type', '=', 'board')]</field>
    </record>
</odoo>
