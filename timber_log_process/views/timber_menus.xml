<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu with Custom App Icon -->
    <menuitem id="menu_timber_root" name="Timber Management" sequence="10" web_icon="timber_log_process,static/description/icon.png"/>

    <!-- Submenus -->
    <menuitem id="menu_timber_dashboard" name="Dashboard" parent="menu_timber_root" action="action_timber_dashboard" sequence="10"/>
    <menuitem id="menu_timber_logs" name="Log Intake" parent="menu_timber_root" action="action_timber_log" sequence="20"/>
    
    <menuitem id="menu_timber_processing" name="Sawing &amp; Production" parent="menu_timber_root" action="action_timber_processing" sequence="30"/>
    
    <menuitem id="menu_timber_boards" name="Timber Boards" parent="menu_timber_root" action="action_timber_board" sequence="40"/>

    <!-- Reports Menu -->
    <menuitem id="menu_timber_reports" name="Reports" parent="menu_timber_root" sequence="60"/>
    
    <!-- Log Report (Sahihi) -->
    <menuitem id="menu_timber_report_logs" name="Log Report" parent="menu_timber_reports" action="action_timber_log_report" sequence="10"/>
    
    <!-- Production Report (Imerekebishwa ikaelekezwa kwenye action_timber_production_report) -->
    <menuitem id="menu_timber_report_production" name="Production Report" parent="menu_timber_reports" action="action_timber_production_report" sequence="20"/>
    
    <!-- Timber Stock Report (Imerekebishwa ikaelekezwa kwenye action_timber_finished_stock_report) -->
    <menuitem id="menu_timber_report_boards" name="Timber Stock Report" parent="menu_timber_reports" action="action_timber_finished_stock_report" sequence="30"/>
    
    <!-- Expense Report -->
    <menuitem id="menu_timber_report_expense" name="Expense Report" parent="menu_timber_reports" action="action_timber_expense_report_wizard" sequence="40"/>
</odoo>