<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_reimbursement_expense" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.reimbursement.expense</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="hr_payroll_settings" position="inside">
                <setting id="reimbursement_expense_visibility"
                         string="Reimbursement Expense"
                         help="Show the Reimbursement Expense field on employee contracts">
                    <field name="group_reimbursement_expense_visible"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
