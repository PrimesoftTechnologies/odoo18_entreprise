    <!-- SELECTED EMPLOYEE COMMISSION REPORT                      -->
    <!-- ========================================================= -->

    <record id="action_employee_commission_selected_report"
            model="ir.actions.report">
        <field name="name">Employee Commission</field>
        <field name="model">pos.order.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">salon_pos_custom.report_employee_commission_selected</field>
