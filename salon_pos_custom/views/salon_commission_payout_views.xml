<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="view_salon_commission_payout_tree" model="ir.ui.view">
        <field name="name">salon.commission.payout.list</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <list string="Commission Payouts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_commission" sum="Total Gross"/>
                <field name="advance_deduction" sum="Total Deductions"/>
                <field name="net_commission" sum="Total Net"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_salon_commission_payout_form" model="ir.ui.view">
        <field name="name">salon.commission.payout.form</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <form string="Commission Payout">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" class="btn-primary" invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="gross_commission" readonly="1"/>
                            <field name="advance_deduction"/>
                            <field name="net_commission" readonly="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action na Menu -->
    <record id="action_salon_commission_payout" model="ir.actions.act_window">
        <field name="name">Commission Payouts</field>
        <field name="res_model">salon.commission.payout</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_salon_commission_payout" 
              name="Advance Commission Payouts" 
              parent="point_of_sale.menu_point_of_sale" 
              action="action_salon_commission_payout" 
              sequence="50"/>
</odoo>