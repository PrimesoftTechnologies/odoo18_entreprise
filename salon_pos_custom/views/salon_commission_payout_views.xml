<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         PAYOUT LIST & FORM
         ========================================================= -->
    <record id="view_salon_commission_payout_tree" model="ir.ui.view">
        <field name="name">salon.commission.payout.list</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <list string="Commission Payouts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="gross_commission" sum="Total Gross Commission"/>
                <field name="advance_deduction" sum="Total Deduction"/>
                <field name="net_commission" sum="Total Net Commission"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_salon_commission_payout_form" model="ir.ui.view">
        <field name="name">salon.commission.payout.form</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <form string="Commission Payout">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state != 'paid'" confirm="Are you sure?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="gross_commission" readonly="state != 'draft'"/>
                            <field name="advance_deduction" readonly="state != 'draft'"/>
                            <field name="net_commission" readonly="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_commission_payout" model="ir.actions.act_window">
        <field name="name">Commission Payouts</field>
        <field name="res_model">salon.commission.payout</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_salon_commission_payout"
        name="Advance Commission Payouts"
        parent="point_of_sale.menu_point_of_sale"
        action="action_salon_commission_payout"
        sequence="50"
    />


    <!-- =========================================================
         SALES & EXPENSES SUMMARY (LIST & FORM)
         ========================================================= -->
    <record id="view_salon_pos_summary_tree" model="ir.ui.view">
        <field name="name">salon.pos.report.summary.list</field>
        <field name="model">salon.pos.report.summary</field>
        <field name="arch" type="xml">
            <list string="Sales &amp; Expenses Summary">
                <field name="date"/>
                <field name="shop_mode"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <field name="gross_sales" sum="Total Gross Sales" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_expenses" sum="Total Expenses" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="net_cash_in_hand" sum="Total Net Cash" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_salon_pos_summary_form" model="ir.ui.view">
        <field name="name">salon.pos.report.summary.form</field>
        <field name="model">salon.pos.report.summary</field>
        <field name="arch" type="xml">
            <form string="Sales &amp; Expenses Summary">
                <header>
                    <button name="action_close_expense" string="Close Expense" type="object" class="btn-warning" invisible="state == 'closed'" confirm="Are you sure you want to close the accounts for this day?"/>
                    <!-- Kitufe kipya cha kurudisha kwenye draft iwapo fomu imefungwa -->
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'closed'" confirm="Are you sure you want to reopen this summary for updates?"/>
                    <button name="action_print_summary_report" string="Print Closing Report" type="object" class="btn-primary" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <!-- Dropdown ya kuchagua mode -->
                            <field name="shop_mode" readonly="state == 'closed'"/>
                            <field name="config_id" options="{'no_create': True}" invisible="shop_mode != 'specific'" required="shop_mode == 'specific'" readonly="state == 'closed'"/>
                            <field name="date" readonly="state == 'closed'"/>
                            <field name="user_id" readonly="state == 'closed'"/>
                        </group>
                        <group>
                            <field name="opening_cash"/>
                            <field name="gross_sales"/>
                            <field name="total_expenses"/>
                            <field name="net_cash_in_hand" class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Daily Expenses">
                            <field name="expense_line_ids" readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="total_expense" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_pos_summary" model="ir.actions.act_window">
        <field name="name">Sales &amp; Expense Summary</field>
        <field name="res_model">salon.pos.report.summary</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_salon_pos_summary"
        name="Sales &amp; Expense Summary"
        parent="point_of_sale.menu_point_of_sale"
        action="action_salon_pos_summary"
        sequence="51"
    />


    <!-- =========================================================
         QWEB PDF REPORT DEFINITION & TEMPLATE
         ========================================================= -->
    <record id="action_report_salon_pos_summary" model="ir.actions.report">
        <field name="name">Daily Closing Report</field>
        <field name="model">salon.pos.report.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">salon_pos_custom.report_salon_pos_summary_template</field>
        <field name="report_file">salon_pos_custom.report_salon_pos_summary_template</field>
        <field name="binding_model_id" ref="model_salon_pos_report_summary"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_salon_pos_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Daily Sales &amp; Expense Closing Report</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Scope:</strong> 
                                <span t-if="doc.shop_mode == 'all'">All POS Shops Combined</span>
                                <span t-else="">Specific POS Shop (<span t-field="doc.config_id.name"/>)</span><br/>
                                <strong>Date:</strong> <span t-field="doc.date"/><br/>
                                <strong>Cashier:</strong> <span t-field="doc.user_id.name"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <table class="table table-sm mt48">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Opening Cash</strong></td>
                                    <td class="text-end"><span t-field="doc.opening_cash"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Gross Sales</strong></td>
                                    <td class="text-end"><span t-field="doc.gross_sales"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total Expenses</strong></td>
                                    <td class="text-end">- <span t-field="doc.total_expenses"/></td>
                                </tr>
                                <tr class="border-black">
                                    <td><strong>Net Cash in Hand</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.net_cash_in_hand"/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3 class="mt32">Expense Breakdown</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Expense Details</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.expense_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.total_expense"/></td>
                                    </tr>
                                </t>
                                <tr class="border-black">
                                    <td><strong>Grand Total Expenses</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.total_expenses"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>