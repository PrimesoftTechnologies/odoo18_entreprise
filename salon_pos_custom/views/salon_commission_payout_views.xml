<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         PAYOUT LIST & FORM
         ========================================================= -->
    <record id="view_salon_commission_payout_tree" model="ir.ui.view">
        <field name="name">salon.commission.payout.list</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <list string="Commission Payouts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="gross_commission" sum="Total Gross Commission"/>
                <field name="advance_deduction" sum="Total Deduction"/>
                <field name="net_commission" sum="Total Net Commission"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_salon_commission_payout_form" model="ir.ui.view">
        <field name="name">salon.commission.payout.form</field>
        <field name="model">salon.commission.payout</field>
        <field name="arch" type="xml">
            <form string="Commission Payout">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state != 'paid'" confirm="Are you sure?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="gross_commission" readonly="state != 'draft'"/>
                            <field name="advance_deduction" readonly="state != 'draft'"/>
                            <field name="net_commission" readonly="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_commission_payout" model="ir.actions.act_window">
        <field name="name">Commission Payouts</field>
        <field name="res_model">salon.commission.payout</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_salon_commission_payout"
        name="Advance Commission Payouts"
        parent="point_of_sale.menu_point_of_sale"
        action="action_salon_commission_payout"
        sequence="50"
    />


    <!-- =========================================================
         SALES & EXPENSES SUMMARY (MENU MOJA YA MAUZO NA MATUMIZI)
         ========================================================= -->
    <record id="view_salon_pos_summary_tree" model="ir.ui.view">
        <field name="name">salon.pos.report.summary.list</field>
        <field name="model">salon.pos.report.summary</field>
        <field name="arch" type="xml">
            <list string="Sales &amp; Expenses Summary">
                <field name="date"/>
                <field name="user_id"/>
                <field name="gross_sales" sum="Total Gross Sales"/>
                <field name="total_expenses" sum="Total Expenses"/>
                <field name="net_cash_in_hand" sum="Total Net Cash"/>
            </list>
        </field>
    </record>

    <record id="view_salon_pos_summary_form" model="ir.ui.view">
        <field name="name">salon.pos.report.summary.form</field>
        <field name="model">salon.pos.report.summary</field>
        <field name="arch" type="xml">
            <form string="Sales &amp; Expenses Summary">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="gross_sales"/>
                            <field name="total_expenses"/>
                            <field name="net_cash_in_hand" class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- TAB YA KUWEKA MATUMIZI HAPA HAPA -->
                    <notebook>
                        <page string="Daily Expenses">
                            <field name="expense_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="total_expense" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_pos_summary" model="ir.actions.act_window">
        <field name="name">Sales &amp; Expense Summary</field>
        <field name="res_model">salon.pos.report.summary</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_salon_pos_summary"
        name="Sales &amp; Expense Summary"
        parent="point_of_sale.menu_point_of_sale"
        action="action_salon_pos_summary"
        sequence="51"
    />

</odoo>