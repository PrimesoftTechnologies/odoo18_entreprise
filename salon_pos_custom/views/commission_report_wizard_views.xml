<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- WIZARD FORM -->
    <!-- ========================================================= -->
    <record id="view_commission_report_wizard_form"
            model="ir.ui.view">
        <field name="name">commission.report.wizard.form</field>
        <field name="model">commission.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Commission Report">
                <sheet>
                    <!-- ================================================= -->
                    <!-- REPORT FILTERS -->
                    <!-- ================================================= -->

                    <group string="Report Filters">

                        <!-- EMPLOYEE -->
                        <field name="employee_selection"
                               string="Employee"
                               required="1"/>

                        <!-- SPECIFIC EMPLOYEE -->
                        <field name="employee_id"
                               string="Select Employee"
                               required="1"
                               invisible="employee_selection != 'employee'"/>

                        <!-- POINT OF SALE -->
                        <field name="pos_config_id"
                               string="Point of Sale"
                               options="{'no_create': True, 'no_open': True}"/>

                        <!-- FROM DATE -->
                        <field name="date_from"
                               string="From Date"
                               required="1"/>

                        <!-- TO DATE -->
                        <field name="date_to"
                               string="To Date"
                               required="1"/>

                    </group>


                    <!-- ================================================= -->
                    <!-- ALL EMPLOYEES INFORMATION -->
                    <!-- ================================================= -->

                    <div class="alert alert-info"
                         role="alert"
                         invisible="employee_selection != 'all'">

                        <strong>All Employees</strong>

                        <br/>

                        The report will include commission data
                        for all employees within the selected date range.

                    </div>


                    <!-- ================================================= -->
                    <!-- SPECIFIC EMPLOYEE INFORMATION -->
                    <!-- ================================================= -->

                    <div class="alert alert-info"
                         role="alert"
                         invisible="employee_selection != 'employee'">

                        <strong>Specific Employee</strong>

                        <br/>

                        The report will include commission data
                        only for the selected employee.

                    </div>

                </sheet>


                <!-- ===================================================== -->
                <!-- FOOTER -->
                <!-- ===================================================== -->

                <footer>

                    <!-- PRINT PDF -->
                    <button
                        name="action_print_report"
                        string="Print PDF"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-pdf-o"/>

                    <!-- EXPORT EXCEL -->
                    <button
                        name="action_export_excel"
                        string="Export Excel"
                        type="object"
                        class="btn-success"
                        icon="fa-file-excel-o"/>

                    <!-- CANCEL -->
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- WINDOW ACTION -->
    <!-- ========================================================= -->
    <record id="action_commission_report_wizard"
            model="ir.actions.act_window">
        <field name="name">Employee Commission Report</field>
        <field name="res_model">commission.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="salon_pos_custom.view_commission_report_wizard_form"/>
        <field name="target">new</field>
    </record>


    <!-- ========================================================= -->
    <!-- REPORTING MENU -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_employee_commission_report"
        name="Employee Commission Report"
        parent="point_of_sale.menu_point_rep"
        action="salon_pos_custom.action_commission_report_wizard"
        sequence="10"/>

</odoo>