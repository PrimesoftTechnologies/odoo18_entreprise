<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_apex_level" model="ir.ui.view">
        <field name="name">purchase.order.form.apex.level</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Receive Products button in header: only after In-Transit -->
            <xpath expr="//header/button[@name='action_view_picking']"
                   position="attributes">
                <attribute name="invisible">state != 'purchase' or apex_level != 'in_transit'</attribute>
            </xpath>

            <!-- Receipt smart button in button_box: hidden until In-Transit (or Received) -->
            <xpath expr="//div[@name='button_box']/button[@name='action_view_picking']"
                   position="attributes">
                <attribute name="invisible">incoming_picking_count == 0 or apex_level not in ('in_transit', 'received')</attribute>
            </xpath>

            <!-- New buttons -->
            <xpath expr="//header/button[@name='button_confirm']" position="before">
                <button name="action_apex_collected" type="object"
                        string="Collected Order" class="oe_highlight"
                        invisible="state != 'purchase' or apex_level"/>
                <button name="action_apex_in_transit" type="object"
                        string="In-Transit" class="oe_highlight"
                        invisible="state != 'purchase' or apex_level != 'collected'"/>
            </xpath>

            <!-- Hide Odoo's original statusbar; one merged statusbar replaces it -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="apex_level" invisible="1"/>
                <field name="apex_status" widget="statusbar"
                       statusbar_visible="draft,sent,purchase"
                       invisible="apex_status in ('collected', 'in_transit', 'received')"/>
                <field name="apex_status" widget="statusbar"
                       statusbar_visible="draft,sent,purchase,collected"
                       invisible="apex_status != 'collected'"/>
                <field name="apex_status" widget="statusbar"
                       statusbar_visible="draft,sent,purchase,collected,in_transit"
                       invisible="apex_status != 'in_transit'"/>
                <field name="apex_status" widget="statusbar"
                       statusbar_visible="draft,sent,purchase,collected,in_transit,received"
                       invisible="apex_status != 'received'"/>
            </xpath>
        </field>
    </record>

    <!-- 1. List view (RFQ menu yenye KPI Dashboard juu) -->
    <record id="purchase_order_kpis_tree_apex_level" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.apex.level</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="apex_status" string="Status" widget="badge"
                       decoration-info="apex_status in ('draft', 'sent')"
                       decoration-warning="apex_status in ('to approve', 'collected', 'in_transit')"
                       decoration-success="apex_status in ('purchase', 'received', 'done')"
                       decoration-danger="apex_status == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <!-- 2. List view (Base RFQ tree) -->
    <record id="purchase_order_view_tree_apex_level" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.apex.level</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="apex_status" string="Status" widget="badge"
                       decoration-info="apex_status in ('draft', 'sent')"
                       decoration-warning="apex_status in ('to approve', 'collected', 'in_transit')"
                       decoration-success="apex_status in ('purchase', 'received', 'done')"
                       decoration-danger="apex_status == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <!-- 3. List view (Purchase Orders menu) -->
    <record id="purchase_order_tree_apex_level" model="ir.ui.view">
        <field name="name">purchase.order.tree.apex.level</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="apex_status" string="Status" widget="badge"
                       decoration-info="apex_status in ('draft', 'sent')"
                       decoration-warning="apex_status in ('to approve', 'collected', 'in_transit')"
                       decoration-success="apex_status in ('purchase', 'received', 'done')"
                       decoration-danger="apex_status == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>