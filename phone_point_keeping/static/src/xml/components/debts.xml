<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.DebtsView">

        <div class="card border-0 shadow-sm">

            <!-- =================================================
                 HEADER
            ================================================== -->
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Debt &amp; Installments</h5>
                        <p class="text-muted small mb-0">
                            Manage customer debts, installment plans and payments.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary"
                            t-on-click="openAddDebtModal">
                        <i class="fa fa-plus me-2"></i> New Debt
                    </button>
                </div>
            </div>


            <!-- =================================================
                 SUMMARY CARDS
            ================================================== -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    TOTAL DEBTS
                                </div>
                                <h5 class="fw-bold mb-0">
                                    <t t-esc="totalDebtsCount || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    ACTIVE
                                </div>
                                <h5 class="fw-bold text-warning mb-0">
                                    <t t-esc="activeDebtsCount || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    PAID
                                </div>
                                <h5 class="fw-bold text-success mb-0">
                                    <t t-esc="paidDebtsCount || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    TOTAL BALANCE
                                </div>
                                <h5 class="fw-bold text-danger mb-0">
                                    TSh <t t-esc="totalDebtsBalance || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <!-- =================================================
                 SEARCH & FILTER
            ================================================== -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search reference, customer or phone..."
                                   t-att-value="state.debtFilters.search"
                                   t-on-input="onDebtSearchChange"/>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select"
                                t-on-change="onDebtStateFilterChange">
                            <option value=""
                                    t-att-selected="state.debtFilters.state == ''">
                                All Status
                            </option>
                            <option value="draft"
                                    t-att-selected="state.debtFilters.state == 'draft'">
                                Draft
                            </option>
                            <option value="active"
                                    t-att-selected="state.debtFilters.state == 'active'">
                                Active
                            </option>
                            <option value="paid"
                                    t-att-selected="state.debtFilters.state == 'paid'">
                                Fully Paid
                            </option>
                            <option value="overdue"
                                    t-att-selected="state.debtFilters.state == 'overdue'">
                                Overdue
                            </option>
                            <option value="cancelled"
                                    t-att-selected="state.debtFilters.state == 'cancelled'">
                                Cancelled
                            </option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">
                        Showing
                        <strong><t t-esc="filteredDebts.length"/></strong>
                        of
                        <strong><t t-esc="allFilteredDebts.length"/></strong>
                        debts
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="resetDebtFilters">
                        <i class="fa fa-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>


            <!-- =================================================
                 DEBTS TABLE
            ================================================== -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Paid</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Installments</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredDebts.length">
                                <t t-foreach="filteredDebts"
                                   t-as="debt"
                                   t-key="debt.id">
                                    <tr>
                                        <td>
                                            <strong><t t-esc="debt.name"/></strong>
                                        </td>
                                        <td>
                                            <t t-esc="debt.customer_id ? debt.customer_id[1] : ''"/>
                                        </td>
                                        <td>
                                            <t t-esc="debt.phone_description || '-'"/>
                                        </td>
                                        <td class="text-end">
                                            TSh <t t-esc="debt.total_amount"/>
                                        </td>
                                        <td class="text-end">
                                            TSh <t t-esc="debt.paid_amount"/>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-danger">
                                                TSh <t t-esc="debt.balance"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-primary">
                                                <t t-esc="debt.paid_installments || 0"/>
                                                /
                                                <t t-esc="debt.installment_count || 0"/>
                                            </span>
                                        </td>
                                        <td>
                                            <span t-att-class="
                                                debt.state == 'draft' ? 'badge bg-secondary'
                                                : debt.state == 'active' ? 'badge bg-warning text-dark'
                                                : debt.state == 'paid' ? 'badge bg-success'
                                                : debt.state == 'overdue' ? 'badge bg-danger'
                                                : 'badge bg-secondary'">
                                                <t t-if="debt.state == 'draft'">Draft</t>
                                                <t t-elif="debt.state == 'active'">Active</t>
                                                <t t-elif="debt.state == 'paid'">Paid</t>
                                                <t t-elif="debt.state == 'overdue'">Overdue</t>
                                                <t t-else="">Cancelled</t>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-1"
                                                    t-att-data-id="debt.id"
                                                    t-on-click="_onViewDebt"
                                                    title="View Installments">
                                                <i class="fa fa-list"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    t-att-data-id="debt.id"
                                                    t-on-click="_onDeleteDebt"
                                                    title="Delete Debt">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <t t-else="">
                                <tr>
                                    <td colspan="9" class="text-center py-5">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-money text-muted fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Debts Found</h6>
                                        <p class="text-muted small mb-3">
                                            No debts match your current search or filters.
                                        </p>
                                        <button type="button" class="btn btn-primary"
                                                t-on-click="openAddDebtModal">
                                            <i class="fa fa-plus me-2"></i> Create Debt
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->
                <div class="pagination-bar" t-if="allFilteredDebts.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.debtCurrentPage || 1"/></strong>
                        of <strong><t t-esc="debtTotalPages"/></strong>
                        —
                        Showing <strong><t t-esc="debtShowingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredDebts.length"/></strong> debts
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.debtCurrentPage || 1) &lt;= 1"
                                t-on-click="onDebtPrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.debtCurrentPage || 1"/>
                            /
                            <t t-esc="debtTotalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.debtCurrentPage || 1) &gt;= debtTotalPages"
                                t-on-click="onDebtNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>