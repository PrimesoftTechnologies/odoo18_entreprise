<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.TradeInView">

        <div class="card border-0 shadow-sm">

            <!-- HEADER -->
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Trade-In / Exchange</h5>
                        <p class="text-muted small mb-0">
                            Manage customer phone trade-ins, valuations, exchanges and payments.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary" t-on-click="openTradeInModal">
                        <i class="fa fa-plus me-2"></i> New Trade-In
                    </button>
                </div>
            </div>


            <!-- SUMMARY -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">TOTAL TRADE-INS</div>
                                <h5 class="fw-bold mb-0"><t t-esc="totalTradeIns"/></h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">PENDING</div>
                                <h5 class="fw-bold text-warning mb-0"><t t-esc="pendingTradeIns"/></h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">COMPLETED</div>
                                <h5 class="fw-bold text-success mb-0"><t t-esc="completedTradeIns"/></h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">TOTAL TRADE-IN VALUE</div>
                                <h5 class="fw-bold text-primary mb-0">
                                    TSh <t t-esc="totalTradeInValue"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <!-- SEARCH / FILTER -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search reference, customer, phone model or IMEI..."
                                   t-att-value="state.tradeInFilters.search"
                                   t-on-input="onTradeInSearchChange"/>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" t-on-change="onTradeInStateFilterChange">
                            <option value="">All Status</option>
                            <option value="draft"
                                    t-att-selected="state.tradeInFilters.state == 'draft'">Draft</option>
                            <option value="completed"
                                    t-att-selected="state.tradeInFilters.state == 'completed'">Completed</option>
                            <option value="cancelled"
                                    t-att-selected="state.tradeInFilters.state == 'cancelled'">Cancelled</option>
                        </select>
                    </div>

                </div>
            </div>


            <!-- TRADE-IN TABLE -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Customer</th>
                                <th>Old Phone</th>
                                <th>Old IMEI</th>
                                <th>New Phone</th>
                                <th>Trade-In Value</th>
                                <th>New Phone Price</th>
                                <th>Amount to Pay</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredTradeIns.length">
                                <t t-foreach="filteredTradeIns" t-as="trade" t-key="trade.id">
                                    <tr>
                                        <td><strong><t t-esc="trade.name"/></strong></td>
                                        <td><t t-esc="trade.customer_id ? trade.customer_id[1] : ''"/></td>
                                        <td><t t-esc="trade.old_phone_model"/></td>
                                        <td><code><t t-esc="trade.old_phone_imei_1"/></code></td>
                                        <td><t t-esc="trade.new_phone_id ? trade.new_phone_id[1] : ''"/></td>
                                        <td><strong>TSh <t t-esc="trade.trade_in_value"/></strong></td>
                                        <td>TSh <t t-esc="trade.new_phone_price"/></td>
                                        <td><strong class="text-primary">TSh <t t-esc="trade.amount_to_pay"/></strong></td>
                                        <td>
                                            <span t-att-class="
                                                trade.state == 'draft' ? 'badge bg-secondary'
                                                : trade.state == 'completed' ? 'badge bg-success'
                                                : 'badge bg-danger'">
                                                <t t-if="trade.state == 'draft'">Draft</t>
                                                <t t-elif="trade.state == 'completed'">Completed</t>
                                                <t t-else="">Cancelled</t>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <t t-if="trade.state == 'draft'">
                                                <button type="button" class="btn btn-sm btn-outline-success me-1"
                                                        t-att-data-id="trade.id"
                                                        t-on-click="_onCompleteTradeIn"
                                                        title="Complete Trade-In">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        t-att-data-id="trade.id"
                                                        t-on-click="_onCancelTradeIn"
                                                        title="Cancel Trade-In">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </t>
                                            <t t-elif="trade.state == 'completed'">
                                                <span class="text-success small">
                                                    <i class="fa fa-check-circle me-1"></i> Completed
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger small">
                                                    <i class="fa fa-times-circle me-1"></i> Cancelled
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="10" class="text-center py-5">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-refresh text-muted fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Trade-In Transactions</h6>
                                        <p class="text-muted small mb-3">
                                            No trade-in or exchange transactions match your search.
                                        </p>
                                        <button type="button" class="btn btn-primary" t-on-click="openTradeInModal">
                                            <i class="fa fa-plus me-2"></i> Create Trade-In
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- TRADE-IN PAGINATION -->
                <div class="pagination-bar" t-if="allFilteredTradeIns.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.tradeInCurrentPage || 1"/></strong>
                        of <strong><t t-esc="tradeInTotalPages"/></strong>
                        — Showing <strong><t t-esc="tradeInShowingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredTradeIns.length"/></strong> trade-ins
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.tradeInCurrentPage || 1) &lt;= 1"
                                t-on-click="onTradeInPrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.tradeInCurrentPage || 1"/> / <t t-esc="tradeInTotalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.tradeInCurrentPage || 1) &gt;= tradeInTotalPages"
                                t-on-click="onTradeInNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>