<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================
         SETTINGS VIEW (MAIN)
    ============================================================ -->
    <t t-name="phone_point_keeping.SettingsView">

        <div class="row g-3">

            <!-- BRAND MANAGEMENT -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0">Brand Management</h5>
                    </div>
                    <div class="card-body">
                        <label class="form-label">Brand Name</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control"
                                   placeholder="e.g. Apple"
                                   t-model="state.newBrandName"/>
                            <button type="button" class="btn btn-primary" t-on-click="_onSaveBrand">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>

                        <h6 class="fw-bold">Existing Brands</h6>
                        <div class="list-group config-list-scroll">
                            <t t-if="state.brands.length">
                                <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><t t-esc="brand.name"/></span>
                                        <span class="badge bg-secondary">Brand</span>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="config-list-empty">No brands found.</div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CATEGORY MANAGEMENT -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0">Category Management</h5>
                    </div>
                    <div class="card-body">
                        <label class="form-label">Select Brand</label>
                        <select class="form-select mb-3" t-model="state.selectedBrandForCategory">
                            <option value="">Select Brand</option>
                            <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                <option t-att-value="brand.id"><t t-esc="brand.name"/></option>
                            </t>
                        </select>

                        <label class="form-label">Category Name</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control"
                                   placeholder="e.g. Galaxy S Series"
                                   t-model="state.newCategoryName"/>
                            <button type="button" class="btn btn-primary" t-on-click="_onSaveCategory">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>

                        <h6 class="fw-bold">Existing Categories</h6>
                        <div class="list-group config-list-scroll">
                            <t t-if="filteredCategoriesForSettings.length">
                                <t t-foreach="filteredCategoriesForSettings" t-as="category" t-key="category.id">
                                    <div class="list-group-item">
                                        <div class="fw-bold"><t t-esc="category.name"/></div>
                                        <small class="text-muted">
                                            <t t-esc="category.brand_id ? category.brand_id[1] : ''"/>
                                        </small>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="config-list-empty">No categories found.</div>
                            </t>
                        </div>

                        <!-- CATEGORY PAGINATION -->
                        <div class="pagination-bar mt-2" t-if="allFilteredCategoriesForSettings.length">
                            <div class="page-info">
                                 <strong><t t-esc="state.categoryCurrentPage || 1"/></strong>
                                of <strong><t t-esc="categoryTotalPages"/></strong>
                                —  <strong><t t-esc="categoryShowingUpTo"/></strong>
                                of <strong><t t-esc="allFilteredCategoriesForSettings.length"/></strong>
                            </div>
                            <div class="page-controls">
                                <button type="button" class="page-btn"
                                        t-att-disabled="(state.categoryCurrentPage || 1) &lt;= 1"
                                        t-on-click="onCategoryPrevPage">
                                    <i class="fa fa-chevron-left me-1"></i> Prev
                                </button>
                                <span class="page-number">
                                    <t t-esc="state.categoryCurrentPage || 1"/>
                                    /
                                    <t t-esc="categoryTotalPages"/>
                                </span>
                                <button type="button" class="page-btn"
                                        t-att-disabled="(state.categoryCurrentPage || 1) &gt;= categoryTotalPages"
                                        t-on-click="onCategoryNextPage">
                                    Next <i class="fa fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CONDITION MANAGEMENT -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0">Condition Management</h5>
                    </div>
                    <div class="card-body">
                        <label class="form-label">Condition Name</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control"
                                   placeholder="e.g. Brand New"
                                   t-model="state.newConditionName"/>
                            <button type="button" class="btn btn-primary" t-on-click="_onSaveCondition">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>

                        <h6 class="fw-bold">Existing Conditions</h6>
                        <div class="list-group config-list-scroll">
                            <t t-if="state.conditions.length">
                                <t t-foreach="state.conditions" t-as="condition" t-key="condition.id">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><t t-esc="condition.name"/></span>
                                        <span class="badge bg-secondary">Condition</span>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="config-list-empty">No conditions found.</div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- USER ACCESS RIGHTS -->
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    <i class="fa fa-lock text-primary me-2"></i>
                                    User Access Rights
                                </h5>
                                <p class="text-muted small mb-0">
                                    Unda user mpya, weka username/password na uchague menus atakazoona kwenye dashboard.
                                </p>
                            </div>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="openAddUserAccessModal">
                                <i class="fa fa-plus me-2"></i> Add User
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table phone-stock-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Allowed Menus</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.userAccesses.length">
                                        <t t-foreach="state.userAccesses" t-as="access" t-key="access.id">
                                            <tr>
                                                <td>
                                                    <strong><t t-esc="access.user_id ? access.user_id[1] : ''"/></strong>
                                                </td>
                                                <td>
                                                    <code><t t-esc="access.user_login"/></code>
                                                </td>
                                                <td>
                                                    <t t-esc="access.user_email || '-'"/>
                                                </td>
                                                <td>
                                                    <span t-if="access.allow_dashboard" class="badge bg-primary me-1">Dashboard</span>
                                                    <span t-if="access.allow_pos" class="badge bg-success me-1">POS</span>
                                                    <span t-if="access.allow_phones" class="badge bg-info me-1">Phones</span>
                                                    <span t-if="access.allow_trade_in" class="badge bg-warning text-dark me-1">Trade-In</span>
                                                    <span t-if="access.allow_debts" class="badge bg-danger me-1">Debts</span>
                                                    <span t-if="access.allow_suppliers" class="badge bg-secondary me-1">Suppliers</span>
                                                    <span t-if="access.allow_staff" class="badge bg-dark me-1">Staff</span>
                                                    <span t-if="access.allow_reports" class="badge bg-primary me-1">Reports</span>
                                                    <span t-if="access.allow_settings" class="badge bg-dark me-1">Settings</span>
                                                </td>

                                                <!-- STATUS BADGE (MPYA) -->
                                                <td>
                                                    <span t-att-class="access.active ? 'badge bg-success' : 'badge bg-danger'">
                                                        <t t-if="access.active">
                                                            <i class="fa fa-check-circle me-1"></i> Active
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-times-circle me-1"></i> Inactive
                                                        </t>
                                                    </span>
                                                </td>

                                                <!-- ACTIONS (MPYA) -->
                                                <td class="text-end">

                                                    <!-- TOGGLE ACTIVE / INACTIVE -->
                                                    <button type="button"
                                                            t-att-class="access.active ? 'btn btn-sm btn-outline-warning me-1' : 'btn btn-sm btn-danger me-1'"
                                                            t-att-data-id="access.id"
                                                            t-on-click="_onToggleUserAccessActive"
                                                            t-att-title="access.active ? 'Set Inactive' : 'Set Active'">
                                                        <i t-att-class="access.active ? 'fa fa-toggle-on me-1' : 'fa fa-toggle-off me-1'"></i>
                                                        <t t-if="access.active">Deactivate</t>
                                                        <t t-else="">Activate</t>
                                                    </button>

                                                    <!-- EDIT -->
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            t-att-data-id="access.id"
                                                            t-on-click="_onEditUserAccess"
                                                            title="Edit">
                                                        <i class="fa fa-pencil"></i>
                                                    </button>

                                                    <!-- DELETE -->
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            t-att-data-id="access.id"
                                                            t-on-click="_onDeleteUserAccess"
                                                            title="Delete">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="fa fa-info-circle me-1"></i>
                                                No users configured yet. Click "Add User" to create one.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </t>

    <!-- ============================================================
         ADD USER ACCESS MODAL
    ============================================================ -->
    <t t-name="phone_point_keeping.AddUserAccessModal">

        <t t-if="state.showUserAccessModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

                    <div class="modal-content">

                        <!-- MODAL HEADER -->
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">
                                    Add New User
                                </h5>
                                <small class="text-muted">
                                    Unda user mpya na uchague menus atakazoona kwenye dashboard.
                                </small>
                            </div>
                            <button type="button" class="btn-close"
                                    t-on-click="closeUserAccessModal"></button>
                        </div>

                        <!-- MODAL BODY -->
                        <div class="modal-body">

                            <!-- USER INFORMATION -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-user me-2"></i>
                                        User Information
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Full Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. Juma Hamisi"
                                               t-model="state.newUserAccess.name"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Username (Login) <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. juma"
                                               t-model="state.newUserAccess.login"/>
                                        <small class="text-muted">
                                            Hili ndilo atakalotumia kuingia (username).
                                        </small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Password <span class="text-danger">*</span>
                                        </label>
                                        <input type="password" class="form-control"
                                               placeholder="Enter password"
                                               t-model="state.newUserAccess.password"/>
                                        <small class="text-muted">
                                            Password atakayotumia kulogin.
                                        </small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email</label>
                                        <input type="email" class="form-control"
                                               placeholder="e.g. juma@shop.co.tz"
                                               t-model="state.newUserAccess.email"/>
                                    </div>

                                </div>
                            </div>

                            <!-- MENU PERMISSIONS -->
                            <div class="mb-2">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-success mb-0">
                                        <i class="fa fa-list me-2"></i>
                                        Allowed Menus
                                    </h6>
                                    <small class="text-muted">
                                        Chagua menus ambazo user huyu ataziona kwenye sidebar.
                                    </small>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_dashboard"
                                                   t-model="state.newUserAccess.allow_dashboard"/>
                                            <label class="form-check-label" for="acc_dashboard">
                                                <i class="fa fa-th-large me-1 text-primary"></i>
                                                Dashboard
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_pos"
                                                   t-model="state.newUserAccess.allow_pos"/>
                                            <label class="form-check-label" for="acc_pos">
                                                <i class="fa fa-shopping-cart me-1 text-success"></i>
                                                POS / Sell
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_phones"
                                                   t-model="state.newUserAccess.allow_phones"/>
                                            <label class="form-check-label" for="acc_phones">
                                                <i class="fa fa-mobile-phone me-1 text-info"></i>
                                                Phones &amp; Stock
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_trade_in"
                                                   t-model="state.newUserAccess.allow_trade_in"/>
                                            <label class="form-check-label" for="acc_trade_in">
                                                <i class="fa fa-refresh me-1 text-warning"></i>
                                                Trade-In / Exchange
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_debts"
                                                   t-model="state.newUserAccess.allow_debts"/>
                                            <label class="form-check-label" for="acc_debts">
                                                <i class="fa fa-money me-1 text-danger"></i>
                                                Debt &amp; Installments
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_suppliers"
                                                   t-model="state.newUserAccess.allow_suppliers"/>
                                            <label class="form-check-label" for="acc_suppliers">
                                                <i class="fa fa-truck me-1 text-secondary"></i>
                                                Suppliers
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_staff"
                                                   t-model="state.newUserAccess.allow_staff"/>
                                            <label class="form-check-label" for="acc_staff">
                                                <i class="fa fa-users me-1 text-dark"></i>
                                                Staff / Users
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_reports"
                                                   t-model="state.newUserAccess.allow_reports"/>
                                            <label class="form-check-label" for="acc_reports">
                                                <i class="fa fa-bar-chart me-1 text-primary"></i>
                                                Reports
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="acc_settings"
                                                   t-model="state.newUserAccess.allow_settings"/>
                                            <label class="form-check-label" for="acc_settings">
                                                <i class="fa fa-cog me-1 text-dark"></i>
                                                Configuration
                                            </label>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- MODAL FOOTER -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeUserAccessModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onSaveUserAccess">
                                <i class="fa fa-save me-2"></i>
                                Create User
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>


    <!-- ============================================================
         EDIT USER ACCESS MODAL (MPYA)
    ============================================================ -->
    <t t-name="phone_point_keeping.EditUserAccessModal">

        <t t-if="state.showEditUserAccessModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

                    <div class="modal-content">

                        <!-- MODAL HEADER -->
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">
                                    Edit User Access
                                </h5>
                                <small class="text-muted">
                                    Badilisha menus, username, au email ya user.
                                </small>
                            </div>
                            <button type="button" class="btn-close"
                                    t-on-click="closeEditUserAccessModal"></button>
                        </div>

                        <!-- MODAL BODY -->
                        <div class="modal-body">

                            <!-- USER INFORMATION -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-user me-2"></i>
                                        User Information
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Full Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. Juma Hamisi"
                                               t-model="state.editUserAccess.name"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Username (Login)
                                        </label>
                                        <input type="text" class="form-control"
                                               t-model="state.editUserAccess.login"
                                               readonly="readonly"/>
                                        <small class="text-muted">
                                            Username hawezi kubadilishwa.
                                        </small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            New Password
                                        </label>
                                        <input type="password" class="form-control"
                                               placeholder="Acha wazi kama hutaki kubadilisha"
                                               t-model="state.editUserAccess.password"/>
                                        <small class="text-muted">
                                            Acha wazi kama hutaki kubadilisha password.
                                        </small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email</label>
                                        <input type="email" class="form-control"
                                               placeholder="e.g. juma@shop.co.tz"
                                               t-model="state.editUserAccess.email"/>
                                    </div>

                                </div>
                            </div>

                            <!-- MENU PERMISSIONS -->
                            <div class="mb-2">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-success mb-0">
                                        <i class="fa fa-list me-2"></i>
                                        Allowed Menus
                                    </h6>
                                    <small class="text-muted">
                                        Chagua menus ambazo user huyu ataziona kwenye sidebar.
                                    </small>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_dashboard"
                                                   t-model="state.editUserAccess.allow_dashboard"/>
                                            <label class="form-check-label" for="edit_acc_dashboard">
                                                <i class="fa fa-th-large me-1 text-primary"></i>
                                                Dashboard
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_pos"
                                                   t-model="state.editUserAccess.allow_pos"/>
                                            <label class="form-check-label" for="edit_acc_pos">
                                                <i class="fa fa-shopping-cart me-1 text-success"></i>
                                                POS / Sell
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_phones"
                                                   t-model="state.editUserAccess.allow_phones"/>
                                            <label class="form-check-label" for="edit_acc_phones">
                                                <i class="fa fa-mobile-phone me-1 text-info"></i>
                                                Phones &amp; Stock
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_trade_in"
                                                   t-model="state.editUserAccess.allow_trade_in"/>
                                            <label class="form-check-label" for="edit_acc_trade_in">
                                                <i class="fa fa-refresh me-1 text-warning"></i>
                                                Trade-In / Exchange
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_debts"
                                                   t-model="state.editUserAccess.allow_debts"/>
                                            <label class="form-check-label" for="edit_acc_debts">
                                                <i class="fa fa-money me-1 text-danger"></i>
                                                Debt &amp; Installments
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="edit_acc_suppliers"
                                                   t-model="state.editUserAccess.allow_suppliers"/>
