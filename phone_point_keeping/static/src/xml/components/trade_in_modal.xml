<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.TradeInModal">

        <t t-if="state.showTradeInModal">

            <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">

                        <!-- MODAL HEADER -->
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">New Trade-In / Exchange</h5>
                                <small class="text-muted">
                                    Record customer exchange, old phone valuation, new phone and payment details.
                                </small>
                            </div>
                            <button type="button" class="btn-close" t-on-click="closeTradeInModal"></button>
                        </div>


                        <!-- MODAL BODY -->
                        <div class="modal-body">

                            <!-- CUSTOMER INFORMATION -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-user me-2"></i> Customer Information
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Customer <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select" t-on-change="onTradeInCustomerChange">
                                            <option value="">Select Customer</option>
                                            <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                                                <option t-att-value="customer.id"
                                                        t-att-selected="state.newTradeIn.customer_id == customer.id">
                                                    <t t-esc="customer.name"/>
                                                    <t t-if="customer.phone"> - <t t-esc="customer.phone"/></t>
                                                </option>
                                            </t>
                                        </select>
                                        <small class="text-muted">Select customer from Contacts.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Customer Phone</label>
                                        <input type="text" class="form-control"
                                               placeholder="Customer phone number"
                                               t-model="state.newTradeIn.customer_phone"/>
                                    </div>

                                </div>
                            </div>


                            <!-- OLD PHONE INFORMATION -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-danger mb-0">
                                        <i class="fa fa-mobile-phone me-2"></i> Old Phone / Customer Phone
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Old Phone Brand <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select" t-on-change="onTradeInBrandChange">
                                            <option value="">Select Brand</option>
                                            <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                                <option t-att-value="brand.id"
                                                        t-att-selected="state.newTradeIn.old_phone_brand_id == brand.id">
                                                    <t t-esc="brand.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Old Phone Model <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. iPhone 11 Pro"
                                               t-model="state.newTradeIn.old_phone_model"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Storage</label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. 128GB"
                                               t-model="state.newTradeIn.old_phone_storage"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            IMEI 1 <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               placeholder="Enter IMEI 1"
                                               t-model="state.newTradeIn.old_phone_imei_1"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">IMEI 2</label>
                                        <input type="text" class="form-control"
                                               placeholder="Optional"
                                               t-model="state.newTradeIn.old_phone_imei_2"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Serial Number</label>
                                        <input type="text" class="form-control"
                                               placeholder="Optional"
                                               t-model="state.newTradeIn.old_phone_serial_number"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Phone Condition <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select" t-on-change="onTradeInConditionChange">
                                            <option value="">Select Condition</option>
                                            <t t-foreach="state.conditions" t-as="condition" t-key="condition.id">
                                                <option t-att-value="condition.id"
                                                        t-att-selected="state.newTradeIn.old_phone_condition_id == condition.id">
                                                    <t t-esc="condition.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Battery Health</label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. 85%"
                                               t-model="state.newTradeIn.old_phone_battery_health"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Accessories</label>
                                        <input type="text" class="form-control"
                                               placeholder="Box, charger, cable..."
                                               t-model="state.newTradeIn.old_phone_accessories"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Physical Condition</label>
                                        <textarea class="form-control" rows="2"
                                                  placeholder="Describe scratches, cracks, screen condition, body condition..."
                                                  t-model="state.newTradeIn.old_phone_physical_condition"></textarea>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Old Phone Notes</label>
                                        <textarea class="form-control" rows="2"
                                                  placeholder="Additional information about the old phone..."
                                                  t-model="state.newTradeIn.old_phone_notes"></textarea>
                                    </div>

                                </div>
                            </div>


                            <!-- VALUATION -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-warning mb-0">
                                        <i class="fa fa-calculator me-2"></i> Trade-In Valuation
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Estimated Value (TSh)</label>
                                        <input type="number" class="form-control" min="0"
                                               t-model.number="state.newTradeIn.estimated_value"/>
                                        <small class="text-muted">Initial estimated value.</small>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Adjustment / Discount (TSh)</label>
                                        <input type="number" class="form-control"
                                               t-model.number="state.newTradeIn.adjustment_amount"/>
                                        <small class="text-muted">Add or deduct adjustment based on condition.</small>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Final Trade-In Value (TSh) <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" class="form-control" min="0"
                                               t-model.number="state.newTradeIn.trade_in_value"/>
                                        <small class="text-muted">Final value credited to customer.</small>
                                    </div>

                                </div>
                            </div>


                            <!-- NEW PHONE -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-success mb-0">
                                        <i class="fa fa-mobile me-2"></i> New Phone / Exchange Phone
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            New Phone <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select" t-on-change="onNewTradeInPhoneChange">
                                            <option value="">Select Phone from Stock</option>
                                            <t t-foreach="state.phones" t-as="phone" t-key="phone.id">
                                                <t t-if="phone.status == 'in_stock'">
                                                    <option t-att-value="phone.id"
                                                            t-att-selected="state.newTradeIn.new_phone_id == phone.id">
                                                        <t t-esc="phone.model_name"/> -
                                                        <t t-esc="phone.brand_id ? phone.brand_id[1] : ''"/> -
                                                        TSh <t t-esc="phone.selling_price"/>
                                                    </option>
                                                </t>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">New Phone Model</label>
                                        <input type="text" class="form-control" readonly="readonly"
                                               t-att-value="selectedTradeInPhoneModel"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">New Phone IMEI 1</label>
                                        <input type="text" class="form-control" readonly="readonly"
                                               t-att-value="selectedTradeInPhoneIMEI1"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">New Phone IMEI 2</label>
                                        <input type="text" class="form-control" readonly="readonly"
                                               t-att-value="selectedTradeInPhoneIMEI2"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">New Phone Price (TSh)</label>
                                        <input type="number" class="form-control" readonly="readonly"
                                               t-att-value="selectedTradeInPhonePrice"/>
                                    </div>

                                </div>
                            </div>


                            <!-- PAYMENT -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-money me-2"></i> Exchange Payment
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Top-Up / Amount to Pay (TSh)</label>
                                        <input type="number" class="form-control" readonly="readonly"
                                               t-att-value="state.newTradeIn.amount_to_pay || 0"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Amount Paid (TSh)</label>
                                        <input type="number" class="form-control" min="0"
                                               t-model.number="state.newTradeIn.amount_paid"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Balance (TSh)</label>
                                        <input type="number" class="form-control" readonly="readonly"
                                               t-att-value="state.newTradeIn.balance || 0"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Payment Method</label>
                                        <select class="form-select" t-model="state.newTradeIn.payment_method">
                                            <option value="">Select Payment Method</option>
                                            <option value="cash">Cash</option>
                                            <option value="mpesa">M-Pesa</option>
                                            <option value="tigopesa">Tigo Pesa</option>
                                            <option value="airtel_money">Airtel Money</option>
                                            <option value="bank">Bank</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Payment Reference</label>
                                        <input type="text" class="form-control"
                                               placeholder="Transaction/reference number"
                                               t-model="state.newTradeIn.payment_reference"/>
                                    </div>

                                </div>
                            </div>


                            <!-- NOTES -->
                            <div class="mb-2">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-secondary mb-0">
                                        <i class="fa fa-sticky-note me-2"></i> Additional Information
                                    </h6>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Trade-In Notes</label>
                                        <textarea class="form-control" rows="3"
                                                  placeholder="Additional notes about this trade-in or exchange..."
                                                  t-model="state.newTradeIn.notes"></textarea>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <!-- MODAL FOOTER -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="closeTradeInModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary" t-on-click="_onSaveTradeIn">
                                <i class="fa fa-save me-2"></i> Save Trade-In
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </t>

    </t>

</templates>