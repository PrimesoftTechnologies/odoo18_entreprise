<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.PosView">

        <div class="pos-container">

            <!-- =================================================
                 LEFT PANEL - PRODUCTS
            ================================================== -->
            <div class="pos-left-panel">

                <!-- SEARCH BAR -->
                <div class="pos-search-bar">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fa fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search products..."
                               t-att-value="state.posFilters.search"
                               t-on-input="onPosSearchChange"/>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                t-on-click="resetPosFilters"
                                title="Clear filters">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                </div>


                <!-- FILTER CHIPS -->
                <div class="pos-filter-chips">

                    <button type="button"
                            t-att-class="state.posFilters.brand_id === null ? 'pos-chip active' : 'pos-chip'"
                            t-on-click="() => this.onPosBrandFilter(null)">
                        All
                    </button>

                    <t t-foreach="state.brands"
                       t-as="brand"
                       t-key="brand.id">

                        <button type="button"
                                t-att-class="state.posFilters.brand_id === brand.id ? 'pos-chip active' : 'pos-chip'"
                                t-on-click="() => this.onPosBrandFilter(brand.id)">
                            <t t-esc="brand.name"/>
                        </button>

                    </t>

                </div>


                <!-- PRODUCTS GRID -->
                <div class="pos-products-scroll">

                    <t t-if="posProducts.length">

                        <div class="pos-products-grid">

                            <t t-foreach="posProducts"
                               t-as="phone"
                               t-key="phone.id">

                                <div t-att-class="phone.quantity > 0 ? 'pos-product-card' : 'pos-product-card out-of-stock'"
                                     t-on-click="() => this.onAddToCart(phone)">

                                    <div class="pos-product-image">

                                        <img t-if="phone.primary_image"
                                             t-att-src="'data:image/png;base64,' + phone.primary_image"
                                             t-att-alt="phone.model_name"/>

                                        <div t-else=""
                                             class="pos-product-no-image">
                                            <i class="fa fa-mobile"></i>
                                        </div>

                                    </div>

                                    <div class="pos-product-info">

                                        <div class="pos-product-brand">
                                            <t t-esc="phone.brand_id ? phone.brand_id[1] : ''"/>
                                        </div>

                                        <div class="pos-product-name">
                                            <t t-esc="phone.model_name"/>
                                        </div>

                                        <div class="pos-product-price">
                                            TZS <t t-esc="formatNumber(phone.selling_price)"/>
                                        </div>

                                        <div class="pos-product-stock">
                                            <span class="badge bg-success">
                                                <t t-esc="phone.image_count || 0"/>
                                                img
                                            </span>
                                            <span class="badge bg-info ms-1">
                                                <t t-esc="phone.imei_1 ? phone.imei_1.slice(-4) : ''"/>
                                            </span>

                                            <!-- ✅ QTY BADGE (inaonyesha quantity iliyobaki) -->
                                            <span t-if="phone.quantity > 0"
                                                  class="badge bg-warning text-dark ms-1">
                                                Qty: <t t-esc="phone.quantity"/>
                                            </span>

                                            <!-- ✅ OUT OF STOCK BADGE (kama quantity = 0) -->
                                            <span t-else=""
                                                  class="badge bg-danger ms-1">
                                                <i class="fa fa-exclamation-triangle me-1"></i>
                                                Out of Stock
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </t>

                        </div>

                    </t>

                    <t t-else="">

                        <div class="pos-empty-state">
                            <i class="fa fa-search text-muted fs-1 mb-3"></i>
                            <h6 class="fw-bold text-dark">No products found</h6>
                            <p class="text-muted small mb-0">
                                No phones match your search or filter.
                            </p>
                        </div>

                    </t>

                </div>

            </div>


            <!-- =================================================
                 RIGHT PANEL - CART
            ================================================== -->
            <div class="pos-right-panel">

                <div class="pos-cart-header">
                    <h5 class="fw-bold mb-0">
                        <i class="fa fa-shopping-cart me-2"></i>
                        Sale Cart
                    </h5>
                    <span class="badge bg-primary">
                        <t t-esc="state.posCart.length"/>
                    </span>
                </div>


                <div class="pos-payment-toggle">

                    <button type="button"
                            t-att-class="state.posData.payment_type === 'cash' ? 'pos-pay-btn active' : 'pos-pay-btn'"
                            t-on-click="() => this.onPosPaymentTypeChange('cash')">
                        <i class="fa fa-money me-1"></i>
                        Cash
                    </button>

                    <button type="button"
                            t-att-class="state.posData.payment_type === 'credit' ? 'pos-pay-btn active' : 'pos-pay-btn'"
                            t-on-click="() => this.onPosPaymentTypeChange('credit')">
                        <i class="fa fa-credit-card me-1"></i>
                        Credit
                    </button>

                </div>


                <div class="pos-customer-section">

                    <label class="pos-label">Select Customer</label>

                    <select class="form-select form-select-sm"
                            t-on-change="onPosCustomerChange">

                        <option value="">
                            Walk-in Customer
                        </option>

                        <t t-foreach="state.customers"
                           t-as="customer"
                           t-key="customer.id">

                            <option t-att-value="customer.id"
                                    t-att-selected="state.posData.customer_id == customer.id">
                                <t t-esc="customer.name"/>
                                <t t-if="customer.phone"> - <t t-esc="customer.phone"/></t>
                            </option>

                        </t>

                    </select>

                </div>


                <div class="pos-payment-method">

                    <label class="pos-label">Payment Method</label>

                    <select class="form-select form-select-sm"
                            t-model="state.posData.payment_method">

                        <option value="cash">Cash (Physical)</option>
                        <option value="mpesa">M-Pesa</option>
                        <option value="tigopesa">Tigo Pesa</option>
                        <option value="airtel_money">Airtel Money</option>
                        <option value="halopesa">HaloPesa</option>
                        <option value="bank">Bank</option>
                        <option value="other">Other</option>

                    </select>

                </div>


                <!-- CART ITEMS -->
                <div class="pos-cart-items-scroll">

                    <t t-if="state.posCart.length">

                        <t t-foreach="state.posCart"
                           t-as="item"
                           t-key="item.temp_id">

                            <div class="pos-cart-item">

                                <div class="pos-cart-item-info">

                                    <div class="pos-cart-item-name">
                                        <t t-esc="item.model_name"/>
                                    </div>

                                    <div class="pos-cart-item-meta">
                                        <t t-esc="item.brand_name"/>
                                        <span class="text-muted"> - IMEI: </span>
                                        <t t-esc="item.imei_1 ? item.imei_1.slice(-4) : ''"/>
                                    </div>

                                    <!-- QTY CONTROLS -->
                                    <div class="pos-cart-item-qty">
                                        <button type="button"
                                                class="pos-qty-btn"
                                                t-on-click="() => this.onDecrementCart(item.temp_id)"
                                                title="Reduce quantity">
                                            <i class="fa fa-minus"></i>
                                        </button>

                                        <input type="number"
                                               class="pos-qty-input"
                                               min="1"
                                               t-att-max="item.max_qty"
                                               t-att-value="item.quantity"
                                               t-on-input="(ev) => this.onChangeCartQuantity(item.temp_id, ev)"/>

                                        <button type="button"
                                                class="pos-qty-btn"
                                                t-on-click="() => this.onIncrementCart(item.temp_id)"
                                                title="Increase quantity">
                                            <i class="fa fa-plus"></i>
                                        </button>

                                        <span class="text-muted small ms-2">
                                            / <t t-esc="item.max_qty"/> available
                                        </span>
                                    </div>

                                </div>

                                <div class="pos-cart-item-right">

                                    <div class="pos-cart-item-price">
                                        TZS <t t-esc="formatNumber(item.price_unit * item.quantity)"/>
                                    </div>

                                    <button type="button"
                                            class="pos-cart-item-remove"
                                            t-on-click="() => this.onRemoveFromCart(item.temp_id)"
                                            title="Remove">
                                        <i class="fa fa-times"></i>
                                    </button>

                                </div>

                            </div>

                        </t>

                    </t>

                    <t t-else="">

                        <div class="pos-cart-empty">
                            <i class="fa fa-shopping-cart text-muted fs-1 mb-3"></i>
                            <p class="text-muted small mb-0">
                                Cart is empty
                            </p>
                        </div>

                    </t>

                </div>


                <!-- TOTALS -->
                <div class="pos-totals-section">

                    <div class="pos-total-row">
                        <span>Items:</span>
                        <strong><t t-esc="state.posCart.length"/></strong>
                    </div>

                    <div class="pos-total-row">
                        <span>Total Qty:</span>
                        <strong>
                            <t t-esc="posCartTotalQty"/>
                        </strong>
                    </div>

                    <div class="pos-total-row pos-total-main">
                        <span>Total:</span>
                        <strong class="text-primary">
                            TZS <t t-esc="formatNumber(posCartTotal)"/>
                        </strong>
                    </div>

                    <div class="pos-total-row" t-if="state.posData.payment_type === 'credit'">
                        <span>Amount Paid:</span>
                        <input type="number"
                               class="form-control form-control-sm pos-amount-input"
                               min="0"
                               t-att-value="state.posData.amount_paid"
                               t-on-input="(ev) => this.onPosAmountPaidChange(ev)"/>
                    </div>

                    <div class="pos-total-row"
                         t-if="state.posData.payment_type === 'credit' &amp;&amp; posCartBalance > 0">
                        <span>Balance:</span>
                        <strong class="text-danger">
                            TZS <t t-esc="formatNumber(posCartBalance)"/>
                        </strong>
                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="pos-actions">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            t-on-click="clearPosCart"
                            t-att-disabled="!state.posCart.length">

                        <i class="fa fa-trash me-1"></i>
                        Clear

                    </button>

                    <button type="button"
                            class="btn btn-primary pos-save-btn"
                            t-on-click="_onSaveSaleOrder"
                            t-att-disabled="!state.posCart.length">

                        <i class="fa fa-check me-1"></i>
                        Complete Sale

                    </button>

                </div>

            </div>

        </div>

    </t>

</templates>