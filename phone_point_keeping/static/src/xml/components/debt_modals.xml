<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================
         ADD DEBT MODAL
    ============================================================ -->

    <t t-name="phone_point_keeping.AddDebtModal">

        <t t-if="state.showDebtModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

                    <div class="modal-content">

                        <!-- MODAL HEADER -->
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">
                                    New Debt / Installment Plan
                                </h5>
                                <small class="text-muted">
                                    Record customer debt with installment schedule.
                                </small>
                            </div>
                            <button type="button" class="btn-close"
                                    t-on-click="closeDebtModal"></button>
                        </div>


                        <!-- MODAL BODY -->
                        <div class="modal-body">

                            <!-- CUSTOMER & PHONE -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-user me-2"></i>
                                        Customer &amp; Phone
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            Customer <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select"
                                                t-on-change="onNewDebtCustomerChange">
                                            <option value="">Select Customer</option>
                                            <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                                                <option t-att-value="customer.id"
                                                        t-att-selected="state.newDebt.customer_id == customer.id">
                                                    <t t-esc="customer.name"/>
                                                    <t t-if="customer.phone"> - <t t-esc="customer.phone"/></t>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Phone (from Stock)</label>
                                        <select class="form-select"
                                                t-on-change="onNewDebtPhoneChange">
                                            <option value="">Select Phone (Optional)</option>
                                            <t t-foreach="state.phones" t-as="phone" t-key="phone.id">
                                                <option t-att-value="phone.id"
                                                        t-att-selected="state.newDebt.phone_id == phone.id">
                                                    <t t-esc="phone.model_name"/> -
                                                    TSh <t t-esc="phone.selling_price"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold">Phone Description</label>
                                        <input type="text" class="form-control"
                                               placeholder="e.g. iPhone 13 Pro 128GB"
                                               t-att-value="state.newDebt.phone_description"
                                               t-on-input="(ev) => this.onNewDebtChange('phone_description', ev)"/>
                                    </div>

                                </div>
                            </div>


                            <!-- FINANCIAL DETAILS -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-warning mb-0">
                                        <i class="fa fa-calculator me-2"></i>
                                        Financial Details
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Total Amount (TSh) <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" class="form-control" min="0"
                                               placeholder="e.g. 2000000"
                                               t-att-value="state.newDebt.total_amount"
                                               t-on-input="(ev) => this.onNewDebtChange('total_amount', ev)"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Down Payment (TSh)</label>
                                        <input type="number" class="form-control" min="0"
                                               placeholder="e.g. 500000"
                                               t-att-value="state.newDebt.down_payment"
                                               t-on-input="(ev) => this.onNewDebtChange('down_payment', ev)"/>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Interest Rate (%)</label>
                                        <input type="number" class="form-control" min="0" step="0.1"
                                               placeholder="e.g. 5"
                                               t-att-value="state.newDebt.interest_rate"
                                               t-on-input="(ev) => this.onNewDebtChange('interest_rate', ev)"/>
                                    </div>

                                </div>
                            </div>


                            <!-- INSTALLMENT PLAN -->
                            <div class="mb-4">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-success mb-0">
                                        <i class="fa fa-calendar me-2"></i>
                                        Installment Plan
                                    </h6>
                                </div>
                                <div class="row g-3">

                                    <!-- NUMBER OF INSTALLMENTS -->
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">
                                            # Installments <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" class="form-control" min="1"
                                               placeholder="e.g. 5"
                                               t-att-value="state.newDebt.num_installments"
                                               t-on-input="(ev) => this.onNewDebtChange('num_installments', ev)"/>
                                    </div>

                                    <!-- INTERVAL TYPE (MPYA) -->
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">
                                            Interval <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select"
                                                t-on-change="(ev) => this.onNewDebtChange('interval_type', ev)">
                                            <option value="daily"
                                                    t-att-selected="state.newDebt.interval_type == 'daily'">
                                                Daily
                                            </option>
                                            <option value="weekly"
                                                    t-att-selected="state.newDebt.interval_type == 'weekly'">
                                                Weekly
                                            </option>
                                            <option value="monthly"
                                                    t-att-selected="state.newDebt.interval_type == 'monthly'">
                                                Monthly
                                            </option>
                                        </select>
                                    </div>

                                    <!-- FIRST DUE DATE -->
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">
                                            First Due Date <span class="text-danger">*</span>
                                        </label>
                                        <input type="date" class="form-control"
                                               t-att-value="state.newDebt.first_due_date"
                                               t-on-input="(ev) => this.onNewDebtChange('first_due_date', ev)"/>
                                    </div>

                                    <!-- PAYMENT METHOD -->
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">Payment Method</label>
                                        <select class="form-select"
                                                t-on-change="(ev) => this.onNewDebtChange('payment_method', ev)">
                                            <option value="">Select Method</option>
                                            <option value="cash"
                                                    t-att-selected="state.newDebt.payment_method == 'cash'">
                                                Cash
                                            </option>
                                            <option value="mpesa"
                                                    t-att-selected="state.newDebt.payment_method == 'mpesa'">
                                                M-Pesa
                                            </option>
                                            <option value="tigopesa"
                                                    t-att-selected="state.newDebt.payment_method == 'tigopesa'">
                                                Tigo Pesa
                                            </option>
                                            <option value="airtel_money"
                                                    t-att-selected="state.newDebt.payment_method == 'airtel_money'">
                                                Airtel Money
                                            </option>
                                            <option value="halopesa"
                                                    t-att-selected="state.newDebt.payment_method == 'halopesa'">
                                                HaloPesa
                                            </option>
                                            <option value="bank"
                                                    t-att-selected="state.newDebt.payment_method == 'bank'">
                                                Bank
                                            </option>
                                            <option value="other"
                                                    t-att-selected="state.newDebt.payment_method == 'other'">
                                                Other
                                            </option>
                                        </select>
                                    </div>

                                </div>
                            </div>


                            <!-- COMPUTATION PREVIEW (MPYA) -->
                            <div class="mb-4" t-if="state.newDebt.total_amount > 0">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa fa-calculator me-2"></i>
                                        Computation Preview
                                    </h6>
                                </div>
                                <div class="alert alert-info mb-0">
                                    <div class="row text-center">
                                        <div class="col-md-3">
                                            <div class="text-muted small">Financed Amount</div>
                                            <div class="fw-bold">
                                                TSh <t t-esc="formatNumber(Math.max((state.newDebt.total_amount || 0) - (state.newDebt.down_payment || 0), 0))"/>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-muted small">Interest Amount</div>
                                            <div class="fw-bold text-warning">
                                                TSh <t t-esc="formatNumber((Math.max((state.newDebt.total_amount || 0) - (state.newDebt.down_payment || 0), 0)) * ((state.newDebt.interest_rate || 0) / 100))"/>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-muted small">Total Financed</div>
                                            <div class="fw-bold text-primary">
                                                TSh <t t-esc="formatNumber((Math.max((state.newDebt.total_amount || 0) - (state.newDebt.down_payment || 0), 0)) * (1 + ((state.newDebt.interest_rate || 0) / 100)))"/>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-muted small">Per Installment</div>
                                            <div class="fw-bold text-success">
                                                TSh <t t-esc="state.newDebt.num_installments > 0 ? formatNumber(((Math.max((state.newDebt.total_amount || 0) - (state.newDebt.down_payment || 0), 0)) * (1 + ((state.newDebt.interest_rate || 0) / 100))) / state.newDebt.num_installments) : 0"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <!-- NOTES -->
                            <div class="mb-2">
                                <div class="border-bottom pb-2 mb-3">
                                    <h6 class="fw-bold text-secondary mb-0">
                                        <i class="fa fa-sticky-note me-2"></i>
                                        Additional Information
                                    </h6>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Notes</label>
                                        <textarea class="form-control" rows="3"
                                                  placeholder="Additional notes about this debt..."
                                                  t-att-value="state.newDebt.notes"
                                                  t-on-input="(ev) => this.onNewDebtChange('notes', ev)"></textarea>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <!-- MODAL FOOTER -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeDebtModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onSaveDebt">
                                <i class="fa fa-save me-2"></i>
                                Save Debt &amp; Generate Installments
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>


    <!-- ============================================================
         VIEW INSTALLMENTS MODAL (HAKUNA MABADILIKO)
    ============================================================ -->

    <t t-name="phone_point_keeping.ViewInstallmentsModal">

        <t t-if="state.showInstallmentsModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

                    <div class="modal-content">

                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">
                                    Installments — <t t-esc="selectedDebt ? selectedDebt.name : ''"/>
                                </h5>
                                <small class="text-muted">
                                    <t t-if="selectedDebt">
                                        Customer: <t t-esc="selectedDebt.customer_id ? selectedDebt.customer_id[1] : ''"/>
                                        —
                                        Balance: TSh <t t-esc="selectedDebt.balance"/>
                                    </t>
                                </small>
                            </div>
                            <button type="button" class="btn-close"
                                    t-on-click="closeInstallmentsModal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="table-responsive">
                                <table class="table phone-stock-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Due Date</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Paid</th>
                                            <th class="text-end">Balance</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="selectedDebtInstallments.length">
                                            <t t-foreach="selectedDebtInstallments"
                                               t-as="inst"
                                               t-key="inst.id">
                                                <tr>
                                                    <td><strong>#<t t-esc="inst.sequence"/></strong></td>
                                                    <td><t t-esc="inst.due_date"/></td>
                                                    <td class="text-end">TSh <t t-esc="inst.amount"/></td>
                                                    <td class="text-end">TSh <t t-esc="inst.paid_amount"/></td>
                                                    <td class="text-end">
                                                        <strong class="text-danger">
                                                            TSh <t t-esc="inst.balance"/>
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <span t-att-class="
                                                            inst.state == 'paid' ? 'badge bg-success'
                                                            : inst.state == 'partial' ? 'badge bg-info'
                                                            : inst.state == 'overdue' ? 'badge bg-danger'
                                                            : 'badge bg-warning text-dark'">
                                                            <t t-if="inst.state == 'paid'">Paid</t>
                                                            <t t-elif="inst.state == 'partial'">Partial</t>
                                                            <t t-elif="inst.state == 'overdue'">Overdue</t>
                                                            <t t-else="">Pending</t>
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="inst.state != 'paid'">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-success me-1"
                                                                    t-att-data-id="inst.id"
                                                                    t-on-click="_onMarkInstallmentPaid"
                                                                    title="Mark as Fully Paid">
                                                                <i class="fa fa-check"></i>
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    t-att-data-id="inst.id"
                                                                    t-on-click="_onOpenPaymentModal"
                                                                    title="Add Payment">
                                                                <i class="fa fa-money"></i>
                                                            </button>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-success small">
                                                                <i class="fa fa-check-circle me-1"></i>
                                                                Paid
                                                            </span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">
                                                    <i class="fa fa-info-circle me-1"></i>
                                                    No installments found.
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeInstallmentsModal">
                                Close
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>


    <!-- ============================================================
         PAYMENT MODAL (HAKUNA MABADILIKO)
    ============================================================ -->

    <t t-name="phone_point_keeping.PaymentModal">

        <t t-if="state.showPaymentModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-lg modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold mb-1">
                                    <i class="fa fa-money text-success me-2"></i>
                                    Add Payment
                                </h5>
                                <small class="text-muted">
                                    <t t-if="selectedInstallment">
                                        Installment #<t t-esc="selectedInstallment.sequence"/>
                                        —
                                        Balance: TSh <t t-esc="selectedInstallment.balance"/>
                                    </t>
                                </small>
                            </div>
                            <button type="button" class="btn-close"
                                    t-on-click="closePaymentModal"></button>
                        </div>

                        <div class="modal-body">

                            <div class="alert alert-info mb-4" t-if="selectedInstallment">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="text-muted small">Amount Due</div>
                                        <div class="fw-bold">
                                            TSh <t t-esc="selectedInstallment.amount"/>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small">Already Paid</div>
                                        <div class="fw-bold">
                                            TSh <t t-esc="selectedInstallment.paid_amount"/>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small">Balance</div>
                                        <div class="fw-bold text-danger">
                                            TSh <t t-esc="selectedInstallment.balance"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Paid Amount (TSh) <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control" min="0" step="0.01"
                                           placeholder="e.g. 200000"
                                           t-att-value="state.paymentData.paid_amount"
                                           t-on-input="(ev) => this.onPaymentChange('paid_amount', ev)"/>
                                    <small class="text-muted">
                                        Balance: TSh
                                        <t t-esc="selectedInstallment ? selectedInstallment.balance : 0"/>
                                    </small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Payment Date</label>
                                    <input type="date" class="form-control"
                                           t-att-value="state.paymentData.payment_date"
                                           t-on-input="(ev) => this.onPaymentChange('payment_date', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Payment Method</label>
                                    <select class="form-select"
                                            t-on-change="(ev) => this.onPaymentChange('payment_method', ev)">
                                        <option value="">Select Method</option>
                                        <option value="cash"
                                                t-att-selected="state.paymentData.payment_method == 'cash'">
                                            Cash
                                        </option>
                                        <option value="mpesa"
                                                t-att-selected="state.paymentData.payment_method == 'mpesa'">
                                            M-Pesa
                                        </option>
                                        <option value="tigopesa"
                                                t-att-selected="state.paymentData.payment_method == 'tigopesa'">
                                            Tigo Pesa
                                        </option>
                                        <option value="airtel_money"
                                                t-att-selected="state.paymentData.payment_method == 'airtel_money'">
                                            Airtel Money
                                        </option>
                                        <option value="halopesa"
                                                t-att-selected="state.paymentData.payment_method == 'halopesa'">
                                            HaloPesa
                                        </option>
                                        <option value="bank"
                                                t-att-selected="state.paymentData.payment_method == 'bank'">
                                            Bank
                                        </option>
                                        <option value="other"
                                                t-att-selected="state.paymentData.payment_method == 'other'">
                                            Other
                                        </option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Payment Reference</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. Transaction number"
                                           t-att-value="state.paymentData.payment_reference"
                                           t-on-input="(ev) => this.onPaymentChange('payment_reference', ev)"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold">Notes</label>
                                    <textarea class="form-control" rows="2"
                                              placeholder="Additional notes about this payment..."
                                              t-att-value="state.paymentData.notes"
                                              t-on-input="(ev) => this.onPaymentChange('notes', ev)"></textarea>
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closePaymentModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onSavePayment">
                                <i class="fa fa-save me-2"></i>
                                Save Payment
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>

</templates>