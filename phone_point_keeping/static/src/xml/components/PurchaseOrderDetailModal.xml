<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.PurchaseOrderDetailModal">

        <t t-if="state.showPurchaseDetailModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.55); z-index: 1050;">

                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
                     style="max-width: 1100px;">

                    <div class="modal-content">

                        <!-- ==========================================
                             MODAL HEADER
                        =========================================== -->
                        <div class="modal-header bg-light border-bottom">

                            <div class="d-flex align-items-center gap-3 flex-grow-1">

                                <div>
                                    <h5 class="modal-title fw-bold mb-0">
                                        <i class="fa fa-shopping-bag text-primary me-2"></i>
                                        <t t-esc="state.currentPurchaseDetail?.name || 'Purchase Order'"/>
                                    </h5>
                                    <small class="text-muted">
                                        <t t-esc="state.currentPurchaseDetail?.supplier_id ? state.currentPurchaseDetail.supplier_id[1] : ''"/>
                                    </small>
                                </div>

                            </div>

                            <button type="button" class="btn-close"
                                    t-on-click="closePurchaseDetail"></button>
                        </div>


                        <!-- ==========================================
                             STATUS BAR
                        =========================================== -->
                        <div class="px-4 py-3 border-bottom bg-white">
                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <t t-set="currentState"
                                   t-value="state.currentPurchaseDetail?.state || 'draft'"/>

                                <!-- Step 1: RFQ -->
                                <div t-att-class="
                                    currentState == 'draft'
                                    ? 'badge bg-primary px-3 py-2'
                                    : 'badge bg-light text-muted px-3 py-2 border'">
                                    <i class="fa fa-file-text-o me-1"></i> RFQ
                                </div>

                                <i class="fa fa-chevron-right text-muted"></i>

                                <!-- Step 2: Confirmed -->
                                <div t-att-class="
                                    currentState == 'confirmed'
                                    ? 'badge bg-primary px-3 py-2'
                                    : 'badge bg-light text-muted px-3 py-2 border'">
                                    <i class="fa fa-check me-1"></i> Confirmed
                                </div>

                                <i class="fa fa-chevron-right text-muted"></i>

                                <!-- Step 3: Partial -->
                                <div t-att-class="
                                    currentState == 'partial'
                                    ? 'badge bg-warning text-dark px-3 py-2'
                                    : ((currentState == 'received' || currentState == 'invoiced' || currentState == 'paid')
                                        ? 'badge bg-light text-muted px-3 py-2 border'
                                        : 'badge bg-light text-muted px-3 py-2 border')">
                                    <i class="fa fa-hourglass-half me-1"></i> Partial
                                </div>

                                <i class="fa fa-chevron-right text-muted"></i>

                                <!-- Step 4: Received -->
                                <div t-att-class="
                                    currentState == 'received'
                                    ? 'badge bg-info px-3 py-2'
                                    : ((currentState == 'invoiced' || currentState == 'paid')
                                        ? 'badge bg-light text-muted px-3 py-2 border'
                                        : 'badge bg-light text-muted px-3 py-2 border')">
                                    <i class="fa fa-truck me-1"></i> Received
                                </div>

                                <i class="fa fa-chevron-right text-muted"></i>

                                <!-- Step 5: Invoiced -->
                                <div t-att-class="
                                    currentState == 'invoiced'
                                    ? 'badge bg-warning text-dark px-3 py-2'
                                    : (currentState == 'paid'
                                        ? 'badge bg-light text-muted px-3 py-2 border'
                                        : 'badge bg-light text-muted px-3 py-2 border')">
                                    <i class="fa fa-file-text me-1"></i> Invoiced
                                </div>

                                <i class="fa fa-chevron-right text-muted"></i>

                                <!-- Step 6: Paid -->
                                <div t-att-class="
                                    currentState == 'paid'
                                    ? 'badge bg-success px-3 py-2'
                                    : 'badge bg-light text-muted px-3 py-2 border'">
                                    <i class="fa fa-money me-1"></i> Paid
                                </div>

                                <!-- Cancelled -->
                                <t t-if="currentState == 'cancelled'">
                                    <div class="badge bg-danger px-3 py-2 ms-3">
                                        <i class="fa fa-times me-1"></i> Cancelled
                                    </div>
                                </t>

                            </div>

                            <!-- ✅ PENDING ALERT -->
                            <t t-if="state.currentPurchaseDetail?.total_pending > 0 and currentState != 'cancelled'">
                                <div class="alert alert-warning mt-3 mb-0 py-2 small">
                                    <i class="fa fa-exclamation-triangle me-1"></i>
                                    <strong>Pending:</strong>
                                    <t t-esc="state.currentPurchaseDetail.total_pending"/>
                                    phone(s) hazijapokelewa bado.
                                    <strong>
                                        Received <t t-esc="state.currentPurchaseDetail.total_received"/> /
                                        Ordered <t t-esc="state.currentPurchaseDetail.total_ordered"/>
                                    </strong>
                                </div>
                            </t>

                        </div>


                        <!-- ==========================================
                             MODAL BODY
                        =========================================== -->
                        <div class="modal-body" style="background: #f8fafc;">

                            <!-- SUPPLIER & ORDER INFO -->
                            <div class="row g-3 mb-4">

                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body">
                                            <h6 class="fw-bold text-primary mb-3">
                                                <i class="fa fa-truck me-2"></i>
                                                Supplier Information
                                            </h6>
                                            <div class="mb-2">
                                                <strong>
                                                    <t t-esc="state.currentPurchaseDetail?.supplier_id ? state.currentPurchaseDetail.supplier_id[1] : '-'"/>
                                                </strong>
                                            </div>
                                            <div class="text-muted small" t-if="state.currentPurchaseDetail?.supplier_phone">
                                                <i class="fa fa-phone me-1"></i>
                                                <t t-esc="state.currentPurchaseDetail.supplier_phone"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body">
                                            <h6 class="fw-bold text-primary mb-3">
                                                <i class="fa fa-info-circle me-2"></i>
                                                Order Information
                                            </h6>
                                            <div class="row small">
                                                <div class="col-6 text-muted">Order Date:</div>
                                                <div class="col-6 fw-semibold">
                                                    <t t-esc="state.currentPurchaseDetail?.date_order || '-'"/>
                                                </div>

                                                <div class="col-6 text-muted mt-2">Expected:</div>
                                                <div class="col-6 fw-semibold mt-2">
                                                    <t t-esc="state.currentPurchaseDetail?.date_expected || '-'"/>
                                                </div>

                                                <div class="col-6 text-muted mt-2">Payment:</div>
                                                <div class="col-6 fw-semibold mt-2">
                                                    <t t-esc="state.currentPurchaseDetail?.payment_method || '-'"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>


                            <!-- LINES TABLE -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white border-0 py-3">
                                    <h6 class="fw-bold mb-0">
                                        <i class="fa fa-list me-2 text-success"></i>
                                        Purchase Lines
                                        <span class="badge bg-success ms-2">
                                            <t t-esc="(state.currentPurchaseLines || []).length"/>
                                        </span>
                                    </h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table phone-stock-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Phone Model</th>
                                                    <th>Brand</th>
                                                    <th>Condition</th>
                                                    <th class="text-end">Ordered</th>
                                                    <th class="text-end">Received</th>
                                                    <th class="text-end">Pending</th>
                                                    <th class="text-end">Unit Cost</th>
                                                    <th class="text-end">Subtotal</th>
                                                    <th class="text-center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.currentPurchaseLines?.length">
                                                    <t t-foreach="state.currentPurchaseLines"
                                                       t-as="line"
                                                       t-key="line.id">
                                                        <tr>
                                                            <td><t t-esc="line.id"/></td>
                                                            <td><strong><t t-esc="line.phone_model"/></strong></td>
                                                            <td><t t-esc="line.brand_id ? line.brand_id[1] : '-'"/></td>
                                                            <td><t t-esc="line.condition_id ? line.condition_id[1] : '-'"/></td>
                                                            <td class="text-end">
                                                                <span class="badge bg-secondary">
                                                                    <t t-esc="line.quantity"/>
                                                                </span>
                                                            </td>
                                                            <td class="text-end">
                                                                <span class="badge bg-success">
                                                                    <t t-esc="line.qty_received"/>
                                                                </span>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-att-class="
                                                                    line.qty_pending > 0
                                                                    ? 'badge bg-warning text-dark'
                                                                    : 'badge bg-light text-muted'">
                                                                    <t t-esc="line.qty_pending"/>
                                                                </span>
                                                            </td>
                                                            <td class="text-end">
                                                                TSh <t t-esc="formatNumber(line.price_unit)"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <strong>TSh <t t-esc="formatNumber(line.subtotal)"/></strong>
                                                            </td>
                                                            <td class="text-center">
                                                                <span t-att-class="
                                                                    line.receive_status == 'done'
                                                                    ? 'badge bg-success'
                                                                    : (line.receive_status == 'partial'
                                                                        ? 'badge bg-warning text-dark'
                                                                        : 'badge bg-secondary')">
                                                                    <t t-if="line.receive_status == 'done'">
                                                                        <i class="fa fa-check me-1"></i> Done
                                                                    </t>
                                                                    <t t-elif="line.receive_status == 'partial'">
                                                                        <i class="fa fa-hourglass-half me-1"></i> Partial
                                                                    </t>
                                                                    <t t-else="">
                                                                        Pending
                                                                    </t>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="10" class="text-center py-4 text-muted">
                                                            <i class="fa fa-info-circle me-1"></i>
                                                            No lines.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>


                            <!-- TOTALS -->
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body">
                                            <h6 class="fw-bold text-secondary mb-3">
                                                <i class="fa fa-sticky-note me-2"></i>
                                                Notes
                                            </h6>
                                            <div class="text-muted small" style="white-space: pre-line;">
                                                <t t-esc="state.currentPurchaseDetail?.notes || 'No notes.'"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body">

                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">Total (Ordered):</span>
                                                <strong>
                                                    TSh <t t-esc="formatNumber(state.currentPurchaseDetail?.total || 0)"/>
                                                </strong>
                                            </div>

                                            <div class="d-flex justify-content-between mb-2 border-top pt-2">
                                                <span class="fw-bold text-info">Received Amount:</span>
                                                <strong class="text-info fs-5">
                                                    TSh <t t-esc="formatNumber(state.currentPurchaseDetail?.received_amount || 0)"/>
                                                </strong>
                                            </div>

                                            <div class="d-flex justify-content-between mb-2 border-top pt-2">
                                                <span class="text-muted">Amount Paid:</span>
                                                <strong class="text-success">
                                                    TSh <t t-esc="formatNumber(state.currentPurchaseDetail?.amount_paid || 0)"/>
                                                </strong>
                                            </div>

                                            <div class="d-flex justify-content-between border-top pt-2">
                                                <span class="fw-bold text-danger">Balance:</span>
                                                <strong class="text-danger">
                                                    TSh <t t-esc="formatNumber(state.currentPurchaseDetail?.balance || 0)"/>
                                                </strong>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- ==========================================
                             MODAL FOOTER
                        =========================================== -->
                        <div class="modal-footer bg-light border-top d-flex justify-content-between flex-wrap gap-2">

                            <div>
                                <button type="button" class="btn btn-secondary"
                                        t-on-click="closePurchaseDetail">
                                    <i class="fa fa-times me-1"></i> Close
                                </button>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">

                                <!-- PRINT -->
                                <button type="button"
                                        class="btn btn-outline-dark"
                                        t-att-data-id="state.currentPurchaseDetail?.id"
                                        t-on-click="_onPrintPurchaseReport">
                                    <i class="fa fa-print me-1"></i>
                                    <t t-if="state.currentPurchaseDetail?.state == 'draft'">
                                        Print RFQ
                                    </t>
                                    <t t-else="">
                                        Print Purchase Order
                                    </t>
                                </button>

                                <!-- CONFIRM ORDER -->
                                <button t-if="state.currentPurchaseDetail?.state == 'draft'"
                                        type="button"
                                        class="btn btn-primary"
                                        t-att-data-id="state.currentPurchaseDetail?.id"
                                        t-on-click="_onConfirmFromDetail">
                                    <i class="fa fa-check me-1"></i> Confirm Order
                                </button>

                                <!-- RECEIVE (kama kuna pending) -->
                                <button t-if="state.currentPurchaseDetail?.total_pending > 0 and state.currentPurchaseDetail?.state != 'draft' and state.currentPurchaseDetail?.state != 'cancelled'"
                                        type="button"
                                        class="btn btn-info text-white"
                                        t-att-data-id="state.currentPurchaseDetail?.id"
                                        t-on-click="openReceivePurchaseModal">
                                    <i class="fa fa-truck me-1"></i>
                                    <t t-if="state.currentPurchaseDetail?.total_received > 0">
                                        Receive Remaining (<t t-esc="state.currentPurchaseDetail.total_pending"/>)
                                    </t>
                                    <t t-else="">
                                        Receive Phones
                                    </t>
                                </button>

                                <!-- MARK PAID (can_be_paid) -->
                                <button t-if="state.currentPurchaseDetail?.can_be_paid and state.currentPurchaseDetail?.state != 'paid' and state.currentPurchaseDetail?.state != 'cancelled'"
                                        type="button"
                                        class="btn btn-success"
                                        t-att-data-id="state.currentPurchaseDetail?.id"
                                        t-on-click="_onMarkPaidFromDetail">
                                    <i class="fa fa-money me-1"></i>
                                    Mark Paid (TSh <t t-esc="formatNumber(state.currentPurchaseDetail?.received_amount || 0)"/>)
                                </button>

                                <!-- CANCEL -->
                                <button t-if="state.currentPurchaseDetail?.state != 'paid' and state.currentPurchaseDetail?.state != 'cancelled'"
                                        type="button"
                                        class="btn btn-outline-danger"
                                        t-att-data-id="state.currentPurchaseDetail?.id"
                                        t-on-click="_onCancelFromDetail">
                                    <i class="fa fa-times me-1"></i> Cancel
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>

</templates>