<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.PurchaseView">

        <div class="card border-0 shadow-sm">

            <!-- HEADER -->
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Purchases</h5>
                        <p class="text-muted small mb-0">
                            Manage purchase orders, receive phones and track supplier payments.
                            <span class="text-primary">Click a row to view details.</span>
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary"
                            t-on-click="openAddPurchaseModal">
                        <i class="fa fa-plus me-2"></i> New Purchase (RFQ)
                    </button>
                </div>
            </div>


            <!-- SUMMARY CARDS -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3">

                    <div class="col-xl col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    TOTAL PURCHASES
                                </div>
                                <h5 class="fw-bold mb-0">
                                    <t t-esc="totalPurchases || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    DRAFT (RFQ)
                                </div>
                                <h5 class="fw-bold text-secondary mb-0">
                                    <t t-esc="draftPurchases || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    CONFIRMED (PO)
                                </div>
                                <h5 class="fw-bold text-primary mb-0">
                                    <t t-esc="confirmedPurchases || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    PARTIALLY RECEIVED
                                </div>
                                <h5 class="fw-bold text-warning mb-0">
                                    <t t-esc="partialPurchases || 0"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body py-3">
                                <div class="text-muted small fw-semibold mb-2">
                                    BALANCE TO PAY
                                </div>
                                <h5 class="fw-bold text-danger mb-0">
                                    TSh <t t-esc="formatNumber(totalPurchasesBalance)"/>
                                </h5>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <!-- SEARCH & FILTER -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search reference or supplier..."
                                   t-att-value="state.purchaseFilters.search"
                                   t-on-input="onPurchaseSearchChange"/>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select"
                                t-on-change="onPurchaseStateFilterChange">
                            <option value=""
                                    t-att-selected="state.purchaseFilters.state == ''">
                                All Status
                            </option>
                            <option value="draft"
                                    t-att-selected="state.purchaseFilters.state == 'draft'">
                                RFQ
                            </option>
                            <option value="confirmed"
                                    t-att-selected="state.purchaseFilters.state == 'confirmed'">
                                Confirmed PO
                            </option>
                            <option value="partial"
                                    t-att-selected="state.purchaseFilters.state == 'partial'">
                                Partially Received
                            </option>
                            <option value="received"
                                    t-att-selected="state.purchaseFilters.state == 'received'">
                                Received
                            </option>
                            <option value="invoiced"
                                    t-att-selected="state.purchaseFilters.state == 'invoiced'">
                                Invoiced
                            </option>
                            <option value="paid"
                                    t-att-selected="state.purchaseFilters.state == 'paid'">
                                Paid
                            </option>
                            <option value="cancelled"
                                    t-att-selected="state.purchaseFilters.state == 'cancelled'">
                                Cancelled
                            </option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">
                        Showing
                        <strong><t t-esc="filteredPurchases.length"/></strong>
                        of
                        <strong><t t-esc="allFilteredPurchases.length"/></strong>
                        purchases
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="resetPurchaseFilters">
                        <i class="fa fa-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>


            <!-- PURCHASES TABLE -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Supplier</th>
                                <th>Order Date</th>
                                <th class="text-end">Lines</th>
                                <th class="text-center">Received</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Received Amt</th>
                                <th class="text-end">Paid</th>
                                <th class="text-end">Balance</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 110px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredPurchases.length">
                                <t t-foreach="filteredPurchases"
                                   t-as="po"
                                   t-key="po.id">
                                    <tr t-att-data-id="po.id"
                                        t-on-click="_onOpenPurchaseDetail"
                                        style="cursor: pointer;">
                                        <td>
                                            <strong class="text-primary">
                                                <t t-esc="po.name"/>
                                            </strong>
                                        </td>
                                        <td>
                                            <t t-esc="po.supplier_id ? po.supplier_id[1] : ''"/>
                                        </td>
                                        <td>
                                            <t t-esc="po.date_order"/>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-secondary">
                                                <t t-esc="po.line_count || 0"/>
                                            </span>
                                        </td>

                                        <!-- RECEIVED -->
                                        <td class="text-center">
                                            <t t-if="po.total_ordered and po.total_ordered > 0">
                                                <span t-att-class="
                                                    po.total_pending == 0
                                                    ? 'badge bg-success'
                                                    : (po.total_received > 0
                                                        ? 'badge bg-warning text-dark'
                                                        : 'badge bg-light text-muted border')">
                                                    <t t-esc="po.total_received || 0"/>
                                                    /
                                                    <t t-esc="po.total_ordered || 0"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">-</span>
                                            </t>
                                        </td>

                                        <td class="text-end">
                                            TSh <t t-esc="formatNumber(po.total)"/>
                                        </td>

                                        <!-- RECEIVED AMOUNT -->
                                        <td class="text-end">
                                            <t t-if="po.received_amount and po.received_amount > 0">
                                                <strong class="text-info">
                                                    TSh <t t-esc="formatNumber(po.received_amount)"/>
                                                </strong>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">-</span>
                                            </t>
                                        </td>

                                        <!-- PAID / RECEIVED_AMOUNT -->
                                        <td class="text-end">
                                            <t t-if="po.received_amount and po.received_amount > 0">
                                                TSh <t t-esc="formatNumber(po.amount_paid)"/>
                                                <div class="text-muted small" style="font-size: 0.7rem;">
                                                    / <t t-esc="formatNumber(po.received_amount)"/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                TSh <t t-esc="formatNumber(po.amount_paid)"/>
                                            </t>
                                        </td>

                                        <td class="text-end">
                                            <strong class="text-danger">
                                                TSh <t t-esc="formatNumber(po.balance)"/>
                                            </strong>
                                        </td>

                                        <td>
                                            <span t-att-class="
                                                po.state == 'draft' ? 'badge bg-secondary'
                                                : po.state == 'confirmed' ? 'badge bg-primary'
                                                : po.state == 'partial' ? 'badge bg-warning text-dark'
                                                : po.state == 'received' ? 'badge bg-info'
                                                : po.state == 'invoiced' ? 'badge bg-warning text-dark'
                                                : po.state == 'paid' ? 'badge bg-success'
                                                : 'badge bg-danger'">
                                                <t t-if="po.state == 'draft'">RFQ</t>
                                                <t t-elif="po.state == 'confirmed'">Confirmed</t>
                                                <t t-elif="po.state == 'partial'">Partial</t>
                                                <t t-elif="po.state == 'received'">Received</t>
                                                <t t-elif="po.state == 'invoiced'">Invoiced</t>
                                                <t t-elif="po.state == 'paid'">Paid</t>
                                                <t t-else="">Cancelled</t>
                                            </span>
                                        </td>

                                        <!-- ACTIONS -->
                                        <td class="text-end" style="white-space: nowrap;">
                                            <div class="d-inline-flex gap-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        t-att-data-id="po.id"
                                                        t-on-click.stop="_onOpenPurchaseDetail"
                                                        title="View Details">
                                                    <i class="fa fa-eye"></i>
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        t-att-data-id="po.id"
                                                        t-on-click.stop="_onDeletePurchase"
                                                        title="Delete Purchase">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <t t-else="">
                                <tr>
                                    <td colspan="11" class="text-center py-5">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-shopping-bag text-muted fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Purchases Found</h6>
                                        <p class="text-muted small mb-3">
                                            No purchase orders match your current search or filters.
                                        </p>
                                        <button type="button" class="btn btn-primary"
                                                t-on-click="openAddPurchaseModal">
                                            <i class="fa fa-plus me-2"></i> Create Purchase (RFQ)
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- PAGINATION -->
                <div class="pagination-bar" t-if="allFilteredPurchases.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.purchaseCurrentPage || 1"/></strong>
                        of <strong><t t-esc="purchaseTotalPages"/></strong>
                        —
                        Showing <strong><t t-esc="purchaseShowingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredPurchases.length"/></strong> purchases
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.purchaseCurrentPage || 1) &lt;= 1"
                                t-on-click="onPurchasePrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.purchaseCurrentPage || 1"/>
                            /
                            <t t-esc="purchaseTotalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.purchaseCurrentPage || 1) &gt;= purchaseTotalPages"
                                t-on-click="onPurchaseNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>