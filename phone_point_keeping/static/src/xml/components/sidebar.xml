<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.Sidebar">

        <div t-att-class="state.sidebarCollapsed ? 'phone-sidebar collapsed' : 'phone-sidebar'">

            <!-- TOGGLE BUTTON -->
            <button type="button"
                    class="sidebar-toggle-btn"
                    t-on-click="toggleSidebar"
                    t-att-title="state.sidebarCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar'">
                <i t-att-class="state.sidebarCollapsed ? 'fa fa-angle-double-right' : 'fa fa-angle-double-left'"></i>
            </button>


            <!-- BRAND HEADER -->
            <div class="sidebar-brand text-center py-4">

                <div class="brand-logo-circle mb-2">
                    <img
                        src="/phone_point_keeping/static/description/icon.png"
                        alt="Mobile Shop"
                        class="brand-logo-img"
                    />
                </div>

                <h6 class="fw-bold sidebar-brand-title">
                    Mobile Shop
                </h6>

                <small class="sidebar-brand-subtitle">
                    Management System
                </small>

            </div>


            <!-- MAIN MENU HEADER -->
            <div class="sidebar-menu-header">
                Main Menu
            </div>


            <!-- MENU ITEMS -->
            <ul class="sidebar-menu list-unstyled">

                <!-- DASHBOARD -->
                <li t-if="hasTabAccess('dashboard')"
                    t-att-class="state.activeTab == 'dashboard' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuDashboard" t-att-title="state.sidebarCollapsed ? 'Dashboard' : ''">
                        <i class="fa fa-th-large"></i>
                        <span>Dashboard</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- POS / SELL -->
                <li t-if="hasTabAccess('pos')"
                    t-att-class="state.activeTab == 'pos' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuPos" t-att-title="state.sidebarCollapsed ? 'POS / Sell' : ''">
                        <i class="fa fa-shopping-cart"></i>
                        <span>POS / Sell</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- PHONES & STOCK -->
                <li t-if="hasTabAccess('phones')"
                    t-att-class="state.activeTab == 'phones' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuPhones" t-att-title="state.sidebarCollapsed ? 'Phones &amp; Stock' : ''">
                        <i class="fa fa-mobile-phone"></i>
                        <span>Phones &amp; Stock</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- TRADE-IN / EXCHANGE -->
                <li t-if="hasTabAccess('trade_in')"
                    t-att-class="state.activeTab == 'trade_in' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuTradeIn" t-att-title="state.sidebarCollapsed ? 'Trade-In / Exchange' : ''">
                        <i class="fa fa-refresh"></i>
                        <span>Trade-In / Exchange</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- DEBT & INSTALLMENTS -->
                <li t-if="hasTabAccess('debts')"
                    t-att-class="state.activeTab == 'debts' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuDebts" t-att-title="state.sidebarCollapsed ? 'Debt &amp; Installments' : ''">
                        <i class="fa fa-money"></i>
                        <span>Debt &amp; Installments</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- PURCHASES -->
                <li t-if="hasTabAccess('purchases')"
                    t-att-class="state.activeTab == 'purchases' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuPurchases" t-att-title="state.sidebarCollapsed ? 'Purchases' : ''">
                        <i class="fa fa-shopping-bag"></i>
                        <span>Purchases</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- SUPPLIERS -->
                <li t-if="hasTabAccess('suppliers')"
                    t-att-class="state.activeTab == 'suppliers' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuSuppliers" t-att-title="state.sidebarCollapsed ? 'Suppliers' : ''">
                        <i class="fa fa-truck"></i>
                        <span>Suppliers</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- STAFF / USERS -->
                <li t-if="hasTabAccess('staff')"
                    t-att-class="state.activeTab == 'staff' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuStaff" t-att-title="state.sidebarCollapsed ? 'Staff / Users' : ''">
                        <i class="fa fa-users"></i>
                        <span>Staff / Users</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- REPORTS -->
                <li t-if="hasTabAccess('reports')"
                    t-att-class="state.activeTab == 'reports' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuReports" t-att-title="state.sidebarCollapsed ? 'Reports' : ''">
                        <i class="fa fa-bar-chart"></i>
                        <span>Reports</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

                <!-- CONFIGURATION -->
                <li t-if="hasTabAccess('settings')"
                    t-att-class="state.activeTab == 'settings' ? 'active' : ''">
                    <a href="#" t-on-click="_onMenuSettings" t-att-title="state.sidebarCollapsed ? 'Configuration' : ''">
                        <i class="fa fa-cog"></i>
                        <span>Configuration</span>
                        <i class="fa fa-angle-right menu-arrow"></i>
                    </a>
                </li>

            </ul>


            <!-- SOCIAL MEDIA ICONS -->
            <div class="sidebar-social">

                <div class="sidebar-social-title">
                    Follow Us
                </div>

                <div class="social-icons-wrapper">

                    <!-- FACEBOOK -->
                    <a href="https://facebook.com/yourpage"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-icon facebook"
                       title="Facebook">
                        <i class="fa fa-facebook"></i>
                    </a>

                    <!-- INSTAGRAM -->
                    <a href="https://instagram.com/yourpage"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-icon instagram"
                       title="Instagram">
                        <i class="fa fa-instagram"></i>
                    </a>

                    <!-- TIKTOK -->
                    <a href="https://tiktok.com/@yourpage"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-icon tiktok"
                       title="TikTok">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                        </svg>
                    </a>

                    <!-- LINKEDIN -->
                    <a href="https://linkedin.com/company/yourpage"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="social-icon linkedin"
                       title="LinkedIn">
                        <i class="fa fa-linkedin"></i>
                    </a>

                </div>

            </div>

        </div>

    </t>

</templates>