                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Work Email</label>
                                    <input type="email" class="form-control"
                                           t-att-value="state.editStaff.work_email"
                                           t-on-input="(ev) => this.onEditStaffChange('work_email', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Salary (TSh)</label>
                                    <input type="number" class="form-control" min="0"
                                           t-att-value="state.editStaff.salary_amount"
                                           t-on-input="(ev) => this.onEditStaffChange('salary_amount', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Commission Rate (%)</label>
                                    <input type="number" class="form-control" min="0" max="100"
                                           t-att-value="state.editStaff.commission_rate"
                                           t-on-input="(ev) => this.onEditStaffChange('commission_rate', ev)"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold">Notes</label>
                                    <textarea class="form-control" rows="2"
                                              t-att-value="state.editStaff.notes"
                                              t-on-input="(ev) => this.onEditStaffChange('notes', ev)"></textarea>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeEditStaffModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onUpdateStaff">
                                <i class="fa fa-save me-2"></i> Update Staff
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>

</templates>