<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.StaffView">

        <div class="card border-0 shadow-sm">

            <!-- =================================================
                 HEADER
            ================================================== -->
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Staff / Users</h5>
                        <p class="text-muted small mb-0">
                            Manage your staff (Employees) from Odoo HR module.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary"
                            t-on-click="openAddStaffModal">
                        <i class="fa fa-plus me-2"></i> Add New Staff
                    </button>
                </div>
            </div>


            <!-- =================================================
                 SEARCH & FILTER
            ================================================== -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search staff name, job title, phone or email..."
                                   t-att-value="state.staffFilters.search"
                                   t-on-input="onStaffSearchChange"/>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select"
                                t-on-change="onStaffStatusFilterChange">
                            <option value="all"
                                    t-att-selected="state.staffFilters.status == 'all'">
                                All Staff
                            </option>
                            <option value="active"
                                    t-att-selected="state.staffFilters.status == 'active'">
                                Active Only
                            </option>
                            <option value="archived"
                                    t-att-selected="state.staffFilters.status == 'archived'">
                                Archived Only
                            </option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">
                        Showing
                        <strong><t t-esc="filteredStaff.length"/></strong>
                        of
                        <strong><t t-esc="allFilteredStaff.length"/></strong>
                        staff
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="resetStaffFilters">
                        <i class="fa fa-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>


            <!-- =================================================
                 STAFF TABLE
            ================================================== -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Staff Name</th>
                                <th>Job Title</th>
                                <th>Department</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredStaff.length">
                                <t t-foreach="filteredStaff"
                                   t-as="staff"
                                   t-key="staff.id">
                                    <tr>
                                        <td>
                                            <strong><t t-esc="staff.name"/></strong>
                                        </td>
                                        <td>
                                            <t t-esc="staff.job_title || '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="staff.department_id ? staff.department_id[1] : '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="staff.work_phone || staff.mobile_phone || '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="staff.work_email || '-'"/>
                                        </td>
                                        <td>
                                            <span t-att-class="
                                                staff.active
                                                ? 'badge bg-success'
                                                : 'badge bg-secondary'">
                                                <t t-if="staff.active">Active</t>
                                                <t t-else="">Archived</t>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-1"
                                                    t-att-data-id="staff.id"
                                                    t-on-click="_onEditStaff"
                                                    title="Edit Staff">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    t-att-data-id="staff.id"
                                                    t-on-click="_onDeleteStaff"
                                                    title="Delete Staff">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <t t-else="">
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-users text-muted fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Staff Found</h6>
                                        <p class="text-muted small mb-3">
                                            No staff match your current search or filters.
                                        </p>
                                        <button type="button" class="btn btn-primary"
                                                t-on-click="openAddStaffModal">
                                            <i class="fa fa-plus me-2"></i> Add New Staff
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->
                <div class="pagination-bar" t-if="allFilteredStaff.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.staffCurrentPage || 1"/></strong>
                        of <strong><t t-esc="staffTotalPages"/></strong>
                        —
                        Showing <strong><t t-esc="staffShowingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredStaff.length"/></strong> staff
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.staffCurrentPage || 1) &lt;= 1"
                                t-on-click="onStaffPrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.staffCurrentPage || 1"/>
                            /
                            <t t-esc="staffTotalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.staffCurrentPage || 1) &gt;= staffTotalPages"
                                t-on-click="onStaffNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>