<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================
         ADD SUPPLIER MODAL
    ============================================================ -->

    <t t-name="phone_point_keeping.AddSupplierModal">

        <t t-if="state.showSupplierModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-lg modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">
                                Add New Supplier
                            </h5>
                            <button type="button" class="btn-close"
                                    t-on-click="closeSupplierModal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Supplier Name <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. TechLink Tanzania"
                                           t-att-value="state.newSupplier.name"
                                           t-on-input="(ev) => this.onNewSupplierChange('name', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Contact Person
                                    </label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. John Doe"
                                           t-att-value="state.newSupplier.contact_person"
                                           t-on-input="(ev) => this.onNewSupplierChange('contact_person', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Phone</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. +255 712 345 678"
                                           t-att-value="state.newSupplier.phone"
                                           t-on-input="(ev) => this.onNewSupplierChange('phone', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control"
                                           placeholder="e.g. info@techlink.co.tz"
                                           t-att-value="state.newSupplier.email"
                                           t-on-input="(ev) => this.onNewSupplierChange('email', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Street</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. Kariakoo, Msimbazi Street"
                                           t-att-value="state.newSupplier.street"
                                           t-on-input="(ev) => this.onNewSupplierChange('street', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">City</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. Dar es Salaam"
                                           t-att-value="state.newSupplier.city"
                                           t-on-input="(ev) => this.onNewSupplierChange('city', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">TIN Number</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. 123-456-789"
                                           t-att-value="state.newSupplier.vat"
                                           t-on-input="(ev) => this.onNewSupplierChange('vat', ev)"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold">Notes</label>
                                    <textarea class="form-control" rows="2"
                                              placeholder="Additional notes about this supplier..."
                                              t-att-value="state.newSupplier.comment"
                                              t-on-input="(ev) => this.onNewSupplierChange('comment', ev)"></textarea>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeSupplierModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onSaveSupplier">
                                <i class="fa fa-save me-2"></i> Save Supplier
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>


    <!-- ============================================================
         EDIT SUPPLIER MODAL
    ============================================================ -->

    <t t-name="phone_point_keeping.EditSupplierModal">

        <t t-if="state.showEditSupplierModal">

            <div class="modal d-block" tabindex="-1"
                 style="background-color: rgba(0,0,0,0.5);">

                <div class="modal-dialog modal-lg modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">
                                Edit Supplier
                            </h5>
                            <button type="button" class="btn-close"
                                    t-on-click="closeEditSupplierModal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Supplier Name <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.name"
                                           t-on-input="(ev) => this.onEditSupplierChange('name', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Contact Person
                                    </label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.contact_person"
                                           t-on-input="(ev) => this.onEditSupplierChange('contact_person', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Phone</label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.phone"
                                           t-on-input="(ev) => this.onEditSupplierChange('phone', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control"
                                           t-att-value="state.editSupplier.email"
                                           t-on-input="(ev) => this.onEditSupplierChange('email', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Street</label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.street"
                                           t-on-input="(ev) => this.onEditSupplierChange('street', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">City</label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.city"
                                           t-on-input="(ev) => this.onEditSupplierChange('city', ev)"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">TIN Number</label>
                                    <input type="text" class="form-control"
                                           t-att-value="state.editSupplier.vat"
                                           t-on-input="(ev) => this.onEditSupplierChange('vat', ev)"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold">Notes</label>
                                    <textarea class="form-control" rows="2"
                                              t-att-value="state.editSupplier.comment"
                                              t-on-input="(ev) => this.onEditSupplierChange('comment', ev)"></textarea>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    t-on-click="closeEditSupplierModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary"
                                    t-on-click="_onUpdateSupplier">
                                <i class="fa fa-save me-2"></i> Update Supplier
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </t>

    </t>

</templates>