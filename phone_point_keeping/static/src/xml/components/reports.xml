<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.ReportsView">

        <div class="reports-wrapper">

            <!-- HEADER -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-1">
                                <i class="fa fa-bar-chart me-2 text-primary"></i>
                                Reports &amp; Analytics
                            </h5>
                            <p class="text-muted small mb-0">
                                Business performance overview and insights.
                            </p>
                        </div>

                        <!-- PERIOD FILTER (Only All Reports) -->
                        <div t-if="state.reportTab == 'all'"
                             class="d-flex align-items-center gap-2">
                            <label class="form-label fw-semibold mb-0 small">
                                Period:
                            </label>
                            <select class="form-select form-select-sm"
                                    style="width: 160px;"
                                    t-on-change="onReportPeriodChange">
                                <option value="all"
                                        t-att-selected="state.reportFilters.period == 'all'">
                                    All Time
                                </option>
                                <option value="today"
                                        t-att-selected="state.reportFilters.period == 'today'">
                                    Today
                                </option>
                                <option value="week"
                                        t-att-selected="state.reportFilters.period == 'week'">
                                    This Week
                                </option>
                                <option value="month"
                                        t-att-selected="state.reportFilters.period == 'month'">
                                    This Month
                                </option>
                                <option value="year"
                                        t-att-selected="state.reportFilters.period == 'year'">
                                    This Year
                                </option>
                            </select>

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    t-on-click="refreshReports"
                                    title="Refresh">
                                <i class="fa fa-refresh"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- TABS -->
                <div class="card-body py-0 border-top">
                    <ul class="nav nav-tabs border-0" style="margin-bottom: -1px;">
                        <li class="nav-item">
                            <a class="nav-link"
                               t-att-class="state.reportTab == 'all' ? 'nav-link active fw-bold' : 'nav-link'"
                               t-on-click="() => this.onReportTabChange('all')"
                               href="#">
                                <i class="fa fa-bar-chart me-1"></i>
                                All Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               t-att-class="state.reportTab == 'daily' ? 'nav-link active fw-bold' : 'nav-link'"
                               t-on-click="() => this.onReportTabChange('daily')"
                               href="#">
                                <i class="fa fa-calendar-check-o me-1"></i>
                                Daily Report
                            </a>
                        </li>
                    </ul>
                </div>
            </div>


            <!-- TAB CONTENT -->
            <t t-if="state.reportTab == 'all'">
                <t t-call="phone_point_keeping.ReportsCards"/>
            </t>
            <t t-else="">
                <t t-call="phone_point_keeping.DailyReportView"/>
            </t>

        </div>

    </t>

</templates>