<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.ReportsCards">

        <div>

            <!-- =================================================
                 KPI CARDS (6)
            ================================================== -->
            <div class="row g-3 mb-4">

                <!-- 1. TOTAL SALES -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL SALES
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        TSh <t t-esc="formatNumber(state.reportTotalSales)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-shopping-cart me-1"></i>
                                        POS Sales + Trade-Ins
                                    </div>
                                </div>
                                <div class="rounded-3 bg-primary d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-shopping-cart"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-primary small fw-semibold">
                                    <i class="fa fa-arrow-up me-1"></i>
                                    Sales Performance
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 2. TOTAL PROFIT -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL PROFIT
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        TSh <t t-esc="formatNumber(state.reportTotalProfit)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-line-chart me-1"></i>
                                        Gross profit from sales
                                    </div>
                                </div>
                                <div class="rounded-3 bg-success d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-line-chart"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-success small fw-semibold">
                                    <i class="fa fa-bar-chart me-1"></i>
                                    Profit Overview
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 3. PHONES SOLD -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        PHONES SOLD
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        <t t-esc="state.reportPhonesSold || 0"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-check-circle me-1"></i>
                                        POS + Trade-In units
                                    </div>
                                </div>
                                <div class="rounded-3 bg-info d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-info small fw-semibold">
                                    <i class="fa fa-database me-1"></i>
                                    Sales Count
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 4. PHONES IN STOCK -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        PHONES IN STOCK
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        <t t-esc="state.reportPhonesInStock || 0"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-mobile-phone me-1"></i>
                                        Available in inventory
                                    </div>
                                </div>
                                <div class="rounded-3 bg-primary d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-mobile-phone"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-primary small fw-semibold">
                                    <i class="fa fa-cube me-1"></i>
                                    Inventory
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 5. TOTAL TRADE-INS -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL TRADE-INS
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        <t t-esc="state.reportTotalTradeIns || 0"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-refresh me-1"></i>
                                        Completed trade-in transactions
                                    </div>
                                </div>
                                <div class="rounded-3 bg-warning d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-refresh"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-warning small fw-semibold">
                                    <i class="fa fa-exchange me-1"></i>
                                    Exchange Activity
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 6. TOTAL DEBTS -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL DEBTS
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        TSh <t t-esc="formatNumber(state.reportTotalDebts)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-money me-1"></i>
                                        Outstanding balances
                                    </div>
                                </div>
                                <div class="rounded-3 bg-danger d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-money"></i>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <span class="text-danger small fw-semibold">
                                    <i class="fa fa-exclamation-circle me-1"></i>
                                    Requires Collection
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>


            <!-- =================================================
                 TABLES ROW
            ================================================== -->
            <div class="row g-3 mb-3">

                <!-- TOP 5 SELLING PHONES -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0">
                                        <i class="fa fa-trophy text-warning me-2"></i>
                                        Top 5 Selling Phones
                                    </h6>
                                </div>
                                <span class="badge bg-warning text-dark">
                                    <t t-esc="(state.topSellingPhones || []).length"/>
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <table class="table phone-stock-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Phone Model</th>
                                        <th>Brand</th>
                                        <th class="text-end">Sold</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.topSellingPhones and state.topSellingPhones.length">
                                        <t t-foreach="state.topSellingPhones"
                                           t-as="item"
                                           t-key="item.id">
                                            <tr>
                                                <td>
                                                    <strong><t t-esc="item.model_name"/></strong>
                                                </td>
                                                <td>
                                                    <t t-esc="item.brand_name || '-'"/>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge bg-primary">
                                                        <t t-esc="item.sold_count"/>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <strong>
                                                        TSh <t t-esc="formatNumber(item.revenue)"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="fa fa-info-circle me-1"></i>
                                                No sales data available for this period.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


                <!-- TOP 5 CUSTOMERS -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0">
                                        <i class="fa fa-users text-primary me-2"></i>
                                        Top 5 Customers
                                    </h6>
                                </div>
                                <span class="badge bg-primary">
                                    <t t-esc="(state.topCustomers || []).length"/>
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <table class="table phone-stock-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Phone</th>
                                        <th class="text-end">Purchases</th>
                                        <th class="text-end">Total Spent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.topCustomers and state.topCustomers.length">
                                        <t t-foreach="state.topCustomers"
                                           t-as="item"
                                           t-key="item.id">
                                            <tr>
                                                <td>
                                                    <strong><t t-esc="item.name"/></strong>
                                                </td>
                                                <td>
                                                    <t t-esc="item.phone or '-'"/>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge bg-primary">
                                                        <t t-esc="item.purchases"/>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <strong>
                                                        TSh <t t-esc="formatNumber(item.total_spent)"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="fa fa-info-circle me-1"></i>
                                                No customer data available for this period.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>


            <!-- =================================================
                 SALES BY BRAND (FULL WIDTH)
            ================================================== -->
            <div class="row g-3">

                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-0">
                                        <i class="fa fa-tag text-success me-2"></i>
                                        Sales by Brand
                                    </h6>
                                </div>
                                <span class="badge bg-success">
                                    <t t-esc="(state.salesByBrand || []).length"/>
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <table class="table phone-stock-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Brand</th>
                                        <th class="text-end">Phones Sold</th>
                                        <th class="text-end">Revenue</th>
                                        <th class="text-end">Profit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.salesByBrand and state.salesByBrand.length">
                                        <t t-foreach="state.salesByBrand"
                                           t-as="item"
                                           t-key="item.id">
                                            <tr>
                                                <td>
                                                    <strong><t t-esc="item.brand_name"/></strong>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge bg-primary">
                                                        <t t-esc="item.sold_count"/>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <strong>
                                                        TSh <t t-esc="formatNumber(item.revenue)"/>
                                                    </strong>
                                                </td>
                                                <td class="text-end">
                                                    <strong class="text-success">
                                                        TSh <t t-esc="formatNumber(item.profit)"/>
                                                    </strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="fa fa-info-circle me-1"></i>
                                                No brand sales data available for this period.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>