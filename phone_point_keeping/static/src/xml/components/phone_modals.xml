<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================
         ADD PHONE MODAL
    ============================================================ -->

    <t t-name="phone_point_keeping.AddPhoneModal">

        <t t-if="state.showModal">

            <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Add New Phone to Stock</h5>
                            <button type="button" class="btn-close" t-on-click="closeModal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">Phone Model</label>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. iPhone 13 Pro"
                                           t-model="state.newPhone.model_name"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Brand</label>
                                    <select class="form-select" t-on-change="onBrandChange">
                                        <option value="">Select Brand</option>
                                        <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                            <option t-att-value="brand.id"
                                                    t-att-selected="state.newPhone.brand_id == brand.id">
                                                <t t-esc="brand.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Category</label>
                                    <select class="form-select" t-on-change="onCategoryChange">
                                        <option value="">Select Category</option>
                                        <t t-foreach="filteredCategories" t-as="category" t-key="category.id">
                                            <option t-att-value="category.id"
                                                    t-att-selected="state.newPhone.category_id == category.id">
                                                <t t-esc="category.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Condition</label>
                                    <select class="form-select" t-on-change="onConditionChange">
                                        <option value="">Select Condition</option>
                                        <t t-foreach="state.conditions" t-as="condition" t-key="condition.id">
                                            <option t-att-value="condition.id"
                                                    t-att-selected="state.newPhone.condition_id == condition.id">
                                                <t t-esc="condition.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">IMEI 1</label>
                                    <input type="text" class="form-control"
                                           placeholder="Enter 15-digit IMEI number"
                                           t-model="state.newPhone.imei_1"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">IMEI 2</label>
                                    <input type="text" class="form-control"
                                           placeholder="Optional"
                                           t-model="state.newPhone.imei_2"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Quantity <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control" min="1"
                                           placeholder="e.g. 7"
                                           t-model.number="state.newPhone.quantity"/>
                                    <small class="text-muted">Idadi ya phones</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Stock Status</label>
                                    <select class="form-select"
                                            t-model="state.newPhone.status"
                                            t-on-change="onStatusChange">
                                        <option value="in_stock">In Stock</option>
                                        <option value="out_of_stock">Out of Stock</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Buying Price per Piece (TSh)</label>
                                    <input type="number" class="form-control" min="0"
                                           t-model.number="state.newPhone.buying_price"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Selling Price per Piece (TSh)</label>
                                    <input type="number" class="form-control" min="0"
                                           t-model.number="state.newPhone.selling_price"/>
                                </div>

                                <!-- =================================================
                                     TOTAL PREVIEW
                                ================================================== -->
                                <div class="col-12">
                                    <div class="alert alert-info mb-0">
                                        <div class="row text-center">
                                            <div class="col-md-3">
                                                <div class="text-muted small">Quantity</div>
                                                <div class="fw-bold fs-5">
                                                    <t t-esc="state.newPhone.quantity || 1"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Buying</div>
                                                <div class="fw-bold fs-5 text-primary">
                                                    TSh <t t-esc="formatNumber((state.newPhone.quantity || 1) * (state.newPhone.buying_price || 0))"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Selling</div>
                                                <div class="fw-bold fs-5 text-success">
                                                    TSh <t t-esc="formatNumber((state.newPhone.quantity || 1) * (state.newPhone.selling_price || 0))"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Profit</div>
                                                <div class="fw-bold fs-5 text-warning">
                                                    TSh <t t-esc="formatNumber((state.newPhone.quantity || 1) * ((state.newPhone.selling_price || 0) - (state.newPhone.buying_price || 0)))"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- =================================================
                                     PHONE IMAGES SECTION
                                ================================================== -->
                                <div class="col-12 mt-3">

                                    <div class="phone-images-section">

                                        <div class="phone-images-header">
                                            <h6 class="fw-bold mb-0">
                                                <i class="fa fa-image me-2 text-primary"></i>
                                                Phone Images
                                            </h6>
                                            <small class="text-muted">
                                                Upload up to 5 images
                                            </small>
                                        </div>

                                        <div class="mb-3">
                                            <input type="file"
                                                   class="form-control"
                                                   accept="image/*"
                                                   multiple="multiple"
                                                   t-on-change="onImageUpload"/>
                                            <small class="text-muted d-block mt-1">
                                                <i class="fa fa-info-circle me-1"></i>
                                                Select one or more images (JPEG, PNG, WebP)
                                            </small>
                                        </div>

                                        <t t-if="state.newPhoneImages.length">
                                            <div class="phone-images-grid">

                                                <t t-foreach="state.newPhoneImages"
                                                   t-as="img"
                                                   t-key="img.temp_id">

                                                    <div class="phone-image-item">
                                                        <img t-att-src="img.data_url"
                                                             t-att-alt="img.filename || 'Phone image'"/>
                                                        <button type="button"
                                                                class="phone-image-delete"
                                                                t-on-click="() => this.onRemoveNewImage(img.temp_id)"
                                                                title="Remove image">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                    </div>

                                                </t>

                                            </div>
                                        </t>

                                        <t t-else="">
                                            <div class="phone-images-empty">
                                                <i class="fa fa-camera text-muted fs-2 mb-2"></i>
                                                <p class="text-muted small mb-0">
                                                    No images uploaded yet.
                                                </p>
                                            </div>
                                        </t>

                                    </div>

                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="closeModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary" t-on-click="_onSavePhone">
                                <i class="fa fa-save me-2"></i> Save Phone
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </t>

    </t>


    <!-- ============================================================
         EDIT PHONE MODAL
    ============================================================ -->

    <t t-name="phone_point_keeping.EditPhoneModal">

        <t t-if="state.showEditModal">

            <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Edit Phone Details</h5>
                            <button type="button" class="btn-close" t-on-click="closeEditModal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">Phone Model</label>
                                    <input type="text" class="form-control"
                                           t-model="state.editPhone.model_name"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Brand</label>
                                    <select class="form-select" t-on-change="onEditBrandChange">
                                        <option value="">Select Brand</option>
                                        <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                            <option t-att-value="brand.id"
                                                    t-att-selected="state.editPhone.brand_id == brand.id">
                                                <t t-esc="brand.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Category</label>
                                    <select class="form-select" t-on-change="onEditCategoryChange">
                                        <option value="">Select Category</option>
                                        <t t-foreach="editFilteredCategories" t-as="category" t-key="category.id">
                                            <option t-att-value="category.id"
                                                    t-att-selected="state.editPhone.category_id == category.id">
                                                <t t-esc="category.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Condition</label>
                                    <select class="form-select" t-on-change="onEditConditionChange">
                                        <option value="">Select Condition</option>
                                        <t t-foreach="state.conditions" t-as="condition" t-key="condition.id">
                                            <option t-att-value="condition.id"
                                                    t-att-selected="state.editPhone.condition_id == condition.id">
                                                <t t-esc="condition.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">IMEI 1</label>
                                    <input type="text" class="form-control"
                                           t-model="state.editPhone.imei_1"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">IMEI 2</label>
                                    <input type="text" class="form-control"
                                           t-model="state.editPhone.imei_2"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Quantity</label>
                                    <input type="number" class="form-control" min="1"
                                           t-model.number="state.editPhone.quantity"/>
                                    <small class="text-muted">Idadi ya phones</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Stock Status</label>
                                    <select class="form-select"
                                            t-model="state.editPhone.status"
                                            t-on-change="onEditStatusChange">
                                        <option value="in_stock">In Stock</option>
                                        <option value="out_of_stock">Out of Stock</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Buying Price per Piece (TSh)</label>
                                    <input type="number" class="form-control" min="0"
                                           t-model.number="state.editPhone.buying_price"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Selling Price per Piece (TSh)</label>
                                    <input type="number" class="form-control" min="0"
                                           t-model.number="state.editPhone.selling_price"/>
                                </div>

                                <!-- TOTAL PREVIEW -->
                                <div class="col-12">
                                    <div class="alert alert-info mb-0">
                                        <div class="row text-center">
                                            <div class="col-md-3">
                                                <div class="text-muted small">Quantity</div>
                                                <div class="fw-bold fs-5">
                                                    <t t-esc="state.editPhone.quantity || 1"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Buying</div>
                                                <div class="fw-bold fs-5 text-primary">
                                                    TSh <t t-esc="formatNumber((state.editPhone.quantity || 1) * (state.editPhone.buying_price || 0))"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Selling</div>
                                                <div class="fw-bold fs-5 text-success">
                                                    TSh <t t-esc="formatNumber((state.editPhone.quantity || 1) * (state.editPhone.selling_price || 0))"/>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-muted small">Total Profit</div>
                                                <div class="fw-bold fs-5 text-warning">
                                                    TSh <t t-esc="formatNumber((state.editPhone.quantity || 1) * ((state.editPhone.selling_price || 0) - (state.editPhone.buying_price || 0)))"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- EXISTING IMAGES -->
                                <div class="col-12 mt-3">
                                    <div class="phone-images-section">
                                        <div class="phone-images-header">
                                            <h6 class="fw-bold mb-0">
                                                <i class="fa fa-image me-2 text-primary"></i>
                                                Existing Images
                                            </h6>
                                            <small class="text-muted">
                                                <t t-esc="state.editPhoneExistingImages.length"/>
                                                image(s)
                                            </small>
                                        </div>

                                        <t t-if="state.editPhoneExistingImages.length">
                                            <div class="phone-images-grid">
                                                <t t-foreach="state.editPhoneExistingImages"
                                                   t-as="img"
                                                   t-key="img.id">
                                                    <div class="phone-image-item">
                                                        <img t-att-src="'/web/image/phone.stock.image/' + img.id + '/image'"
                                                             t-att-alt="img.name || 'Phone image'"/>
                                                        <button type="button"
                                                                class="phone-image-delete"
                                                                t-att-data-id="img.id"
                                                                t-on-click="_onDeleteExistingImage"
                                                                title="Delete image">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                        <t t-if="img.is_primary">
                                                            <div class="phone-image-primary-badge">
                                                                <i class="fa fa-star"></i>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>

                                        <t t-else="">
                                            <div class="phone-images-empty">
                                                <i class="fa fa-camera text-muted fs-2 mb-2"></i>
                                                <p class="text-muted small mb-0">No existing images.</p>
                                            </div>
                                        </t>
                                    </div>
                                </div>


                                <!-- UPLOAD NEW IMAGES -->
                                <div class="col-12 mt-3">
                                    <div class="phone-images-section">
                                        <div class="phone-images-header">
                                            <h6 class="fw-bold mb-0">
                                                <i class="fa fa-plus-circle me-2 text-success"></i>
                                                Add New Images
                                            </h6>
                                            <small class="text-muted">Upload more images</small>
                                        </div>

                                        <div class="mb-3">
                                            <input type="file"
                                                   class="form-control"
                                                   accept="image/*"
                                                   multiple="multiple"
                                                   t-on-change="onEditImageUpload"/>
                                            <small class="text-muted d-block mt-1">
                                                <i class="fa fa-info-circle me-1"></i>
                                                Select one or more images
                                            </small>
                                        </div>

                                        <t t-if="state.editPhoneNewImages.length">
                                            <div class="phone-images-grid">
                                                <t t-foreach="state.editPhoneNewImages"
                                                   t-as="img"
                                                   t-key="img.temp_id">
                                                    <div class="phone-image-item">
                                                        <img t-att-src="img.data_url"
                                                             t-att-alt="img.filename || 'New image'"/>
                                                        <button type="button"
                                                                class="phone-image-delete"
                                                                t-on-click="() => this.onRemoveEditNewImage(img.temp_id)"
                                                                title="Remove image">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="closeEditModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary" t-on-click="_onUpdatePhone">
                                <i class="fa fa-save me-2"></i> Update Phone
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </t>

    </t>

</templates>