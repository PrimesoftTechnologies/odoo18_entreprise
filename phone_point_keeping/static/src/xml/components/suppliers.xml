<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.SuppliersView">

        <div class="card border-0 shadow-sm">

            <!-- =================================================
                 HEADER
            ================================================== -->
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Suppliers</h5>
                        <p class="text-muted small mb-0">
                            Manage your phone suppliers from Contacts.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary"
                            t-on-click="openAddSupplierModal">
                        <i class="fa fa-plus me-2"></i> Add New Supplier
                    </button>
                </div>
            </div>


            <!-- =================================================
                 SEARCH & FILTER
            ================================================== -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search supplier name, phone, email or city..."
                                   t-att-value="state.supplierFilters.search"
                                   t-on-input="onSupplierSearchChange"/>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select"
                                t-on-change="onSupplierStatusFilterChange">
                            <option value="all"
                                    t-att-selected="state.supplierFilters.status == 'all'">
                                All Suppliers
                            </option>
                            <option value="active"
                                    t-att-selected="state.supplierFilters.status == 'active'">
                                Active Only
                            </option>
                            <option value="archived"
                                    t-att-selected="state.supplierFilters.status == 'archived'">
                                Archived Only
                            </option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">
                        Showing
                        <strong><t t-esc="filteredSuppliers.length"/></strong>
                        of
                        <strong><t t-esc="allFilteredSuppliers.length"/></strong>
                        suppliers
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="resetSupplierFilters">
                        <i class="fa fa-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>


            <!-- =================================================
                 SUPPLIERS TABLE
            ================================================== -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Supplier Name</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>City</th>
                                <th>TIN</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredSuppliers.length">
                                <t t-foreach="filteredSuppliers"
                                   t-as="supplier"
                                   t-key="supplier.id">
                                    <tr>
                                        <td>
                                            <strong><t t-esc="supplier.name"/></strong>
                                        </td>
                                        <td>
                                            <t t-esc="supplier.phone || '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="supplier.email || '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="supplier.city || '-'"/>
                                        </td>
                                        <td>
                                            <code t-if="supplier.vat">
                                                <t t-esc="supplier.vat"/>
                                            </code>
                                            <span t-else="" class="text-muted">-</span>
                                        </td>
                                        <td>
                                            <span t-att-class="
                                                supplier.active
                                                ? 'badge bg-success'
                                                : 'badge bg-secondary'">
                                                <t t-if="supplier.active">Active</t>
                                                <t t-else="">Archived</t>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary me-1"
                                                    t-att-data-id="supplier.id"
                                                    t-on-click="_onEditSupplier"
                                                    title="Edit Supplier">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    t-att-data-id="supplier.id"
                                                    t-on-click="_onDeleteSupplier"
                                                    title="Delete Supplier">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <t t-else="">
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-truck text-muted fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Suppliers Found</h6>
                                        <p class="text-muted small mb-3">
                                            No suppliers match your current search or filters.
                                        </p>
                                        <button type="button" class="btn btn-primary"
                                                t-on-click="openAddSupplierModal">
                                            <i class="fa fa-plus me-2"></i> Add New Supplier
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->
                <div class="pagination-bar" t-if="allFilteredSuppliers.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.supplierCurrentPage || 1"/></strong>
                        of <strong><t t-esc="supplierTotalPages"/></strong>
                        —
                        Showing <strong><t t-esc="supplierShowingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredSuppliers.length"/></strong> suppliers
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.supplierCurrentPage || 1) &lt;= 1"
                                t-on-click="onSupplierPrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.supplierCurrentPage || 1"/>
                            /
                            <t t-esc="supplierTotalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.supplierCurrentPage || 1) &gt;= supplierTotalPages"
                                t-on-click="onSupplierNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>