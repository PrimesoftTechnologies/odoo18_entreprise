<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.DailyReportView">

        <div>

            <!-- =================================================
                 HEADER + DATE FILTER
            ================================================== -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>
                            <h5 class="fw-bold mb-1">
                                <i class="fa fa-calendar-check-o me-2 text-primary"></i>
                                Daily Sales Report
                            </h5>
                            <p class="text-muted small mb-0">
                                Track your daily sales — each day starts fresh, but past records are kept.
                            </p>
                        </div>

                        <!-- DATE FILTER -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">

                            <label class="form-label fw-semibold mb-0 small">From:</label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   style="width: 150px;"
                                   t-att-value="state.dailyReportFilters.from_date"
                                   t-on-change="onDailyReportFromChange"/>

                            <label class="form-label fw-semibold mb-0 small">To:</label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   style="width: 150px;"
                                   t-att-value="state.dailyReportFilters.to_date"
                                   t-on-change="onDailyReportToChange"/>

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    t-on-click="resetDailyReportFilters"
                                    title="Reset to Today">
                                <i class="fa fa-refresh"></i>
                            </button>

                        </div>

                    </div>
                </div>
            </div>


            <!-- =================================================
                 SUMMARY CARDS
            ================================================== -->
            <div class="row g-3 mb-3">

                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL SALES
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        TSh <t t-esc="formatNumber(dailyReportTotalSales)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-shopping-cart me-1"></i>
                                        Sales for the period
                                    </div>
                                </div>
                                <div class="rounded-3 bg-primary d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-shopping-cart"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        TOTAL PROFIT
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        TSh <t t-esc="formatNumber(dailyReportTotalProfit)"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-line-chart me-1"></i>
                                        Profit for the period
                                    </div>
                                </div>
                                <div class="rounded-3 bg-success d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-line-chart"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100 kpi-card dashboard-kpi-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-muted small fw-semibold mb-1">
                                        PHONES SOLD
                                    </div>
                                    <h3 class="fw-bold mb-1 text-dark">
                                        <t t-esc="dailyReportTotalQty"/>
                                    </h3>
                                    <div class="text-muted small">
                                        <i class="fa fa-mobile-phone me-1"></i>
                                        Phones sold
                                    </div>
                                </div>
                                <div class="rounded-3 bg-info d-flex align-items-center justify-content-center"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa fa-mobile-phone"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>


            <!-- =================================================
                 DAILY SALES TABLE
            ================================================== -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0">
                            <i class="fa fa-list me-2 text-success"></i>
                            Daily Sales
                        </h6>
                        <span class="badge bg-success">
                            <t t-esc="(dailyReportLines || []).length"/>
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table phone-stock-table mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Product</th>
                                    <th>Brand</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total Sales</th>
                                    <th class="text-end">Profit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="dailyReportLines?.length">
                                    <t t-foreach="dailyReportLines"
                                       t-as="line"
                                       t-key="line.id">
                                        <tr>
                                            <td>
                                                <strong class="text-primary">
                                                    <t t-esc="line.date"/>
                                                </strong>
                                            </td>
                                            <td>
                                                <strong><t t-esc="line.product_name"/></strong>
                                            </td>
                                            <td>
                                                <t t-esc="line.brand_name || '-'"/>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary">
                                                    <t t-esc="line.qty"/>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                TSh <t t-esc="formatNumber(line.unit_price)"/>
                                            </td>
                                            <td class="text-end">
                                                <strong>
                                                    TSh <t t-esc="formatNumber(line.total_sales)"/>
                                                </strong>
                                            </td>
                                            <td class="text-end">
                                                <strong class="text-success">
                                                    TSh <t t-esc="formatNumber(line.profit)"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                                 style="width: 72px; height: 72px;">
                                                <i class="fa fa-calendar-o text-muted fs-2"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark">No Sales</h6>
                                            <p class="text-muted small mb-0">
                                                No sales for the selected period.
                                            </p>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot t-if="dailyReportLines?.length">
                                <tr class="table-active">
                                    <td colspan="3">
                                        <strong>TOTAL</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong><t t-esc="dailyReportTotalQty"/></strong>
                                    </td>
                                    <td class="text-end"></td>
                                    <td class="text-end">
                                        <strong class="text-primary fs-6">
                                            TSh <t t-esc="formatNumber(dailyReportTotalSales)"/>
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-success fs-6">
                                            TSh <t t-esc="formatNumber(dailyReportTotalProfit)"/>
                                        </strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </t>

</templates>