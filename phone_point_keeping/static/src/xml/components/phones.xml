<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="phone_point_keeping.PhonesView">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Phone &amp; IMEI Stock List</h5>
                        <p class="text-muted small mb-0">
                            Manage phone inventory, IMEI numbers, pricing and stock status.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary" t-on-click="openAddPhoneModal">
                        <i class="fa fa-plus me-2"></i> Add New Phone
                    </button>
                </div>
            </div>


            <!-- SEARCH & FILTER -->
            <div class="card-body border-bottom bg-light">
                <div class="row g-3 align-items-end">

                    <div class="col-xl-4 col-lg-6">
                        <label class="form-label fw-semibold">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control"
                                   placeholder="Search phone model or IMEI..."
                                   t-att-value="state.stockFilters.search"
                                   t-on-input="onStockSearchChange"/>
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">Brand</label>
                        <select class="form-select" t-on-change="onStockBrandFilterChange">
                            <option value="">All Brands</option>
                            <t t-foreach="state.brands" t-as="brand" t-key="brand.id">
                                <option t-att-value="brand.id"
                                        t-att-selected="state.stockFilters.brand_id == brand.id">
                                    <t t-esc="brand.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">Category</label>
                        <select class="form-select" t-on-change="onStockCategoryFilterChange">
                            <option value="">All Categories</option>
                            <t t-foreach="filteredStockCategories" t-as="category" t-key="category.id">
                                <option t-att-value="category.id"
                                        t-att-selected="state.stockFilters.category_id == category.id">
                                    <t t-esc="category.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">Condition</label>
                        <select class="form-select" t-on-change="onStockConditionFilterChange">
                            <option value="">All Conditions</option>
                            <t t-foreach="state.conditions" t-as="condition" t-key="condition.id">
                                <option t-att-value="condition.id"
                                        t-att-selected="state.stockFilters.condition_id == condition.id">
                                    <t t-esc="condition.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">Stock Status</label>
                        <select class="form-select" t-on-change="onStockStatusFilterChange">
                            <option value="">All Status</option>
                            <option value="in_stock"
                                    t-att-selected="state.stockFilters.status == 'in_stock'">In Stock</option>
                            <option value="out_of_stock"
                                    t-att-selected="state.stockFilters.status == 'out_of_stock'">Out of Stock</option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted small">
                        Showing
                        <strong><t t-esc="filteredPhones.length"/></strong>
                        of
                        <strong><t t-esc="allFilteredPhones.length"/></strong>
                        phones
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="resetStockFilters">
                        <i class="fa fa-refresh me-1"></i> Reset Filters
                    </button>
                </div>
            </div>


            <!-- STOCK TABLE -->
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table phone-stock-table mb-0">
                        <thead>
                            <tr>
                                <th>Phone Model</th>
                                <th>Brand</th>
                                <th>Category</th>
                                <th>IMEI 1</th>
                                <th>Condition</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Buying (per piece)</th>
                                <th class="text-end">Selling (per piece)</th>
                                <th class="text-end">Total Selling</th>
                                <th class="text-end">Total Profit</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredPhones.length">
                                <t t-foreach="filteredPhones" t-as="phone" t-key="phone.id">
                                    <tr>
                                        <td><strong><t t-esc="phone.model_name"/></strong></td>
                                        <td><t t-esc="phone.brand_id ? phone.brand_id[1] : ''"/></td>
                                        <td><t t-esc="phone.category_id ? phone.category_id[1] : ''"/></td>
                                        <td><code><t t-esc="phone.imei_1"/></code></td>
                                        <td><t t-esc="phone.condition_id ? phone.condition_id[1] : ''"/></td>
                                        <td class="text-end">
                                            <span class="badge bg-primary">
                                                <t t-esc="phone.quantity || 0"/>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            TSh <t t-esc="formatNumber(phone.buying_price)"/>
                                        </td>
                                        <td class="text-end">
                                            TSh <t t-esc="formatNumber(phone.selling_price)"/>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-primary">
                                                TSh <t t-esc="formatNumber((phone.quantity || 0) * (phone.selling_price || 0))"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-success">
                                                TSh <t t-esc="formatNumber((phone.quantity || 0) * ((phone.selling_price || 0) - (phone.buying_price || 0)))"/>
                                            </strong>
                                        </td>
                                        <td>
                                            <span t-att-class="
                                                phone.status == 'in_stock' ? 'badge bg-success'
                                                : 'badge bg-danger'">
                                                <t t-if="phone.status == 'in_stock'">In Stock</t>
                                                <t t-else="">Out of Stock</t>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                    t-att-data-id="phone.id"
                                                    t-on-click="_onEditPhone"
                                                    title="Edit Phone">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    t-att-data-id="phone.id"
                                                    t-on-click="_onDeletePhone"
                                                    title="Delete Phone">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="12" class="text-center py-5">
                                        <i class="fa fa-search text-muted fs-1 mb-3"></i>
                                        <h6 class="text-muted">No phones found.</h6>
                                        <p class="text-muted small mb-3">
                                            No phone matches the current search or filters.
                                        </p>
                                        <button type="button" class="btn btn-outline-secondary"
                                                t-on-click="resetStockFilters">
                                            <i class="fa fa-refresh me-2"></i> Clear Filters
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <!-- PHONES PAGINATION -->
                <div class="pagination-bar" t-if="allFilteredPhones.length">
                    <div class="page-info">
                        Page <strong><t t-esc="state.currentPage || 1"/></strong>
                        of <strong><t t-esc="totalPages"/></strong>
                        — Showing <strong><t t-esc="showingUpTo"/></strong>
                        of <strong><t t-esc="allFilteredPhones.length"/></strong> phones
                    </div>
                    <div class="page-controls">
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.currentPage || 1) &lt;= 1"
                                t-on-click="onPrevPage">
                            <i class="fa fa-chevron-left me-1"></i> Prev
                        </button>
                        <span class="page-number">
                            <t t-esc="state.currentPage || 1"/> / <t t-esc="totalPages"/>
                        </span>
                        <button type="button" class="page-btn"
                                t-att-disabled="(state.currentPage || 1) &gt;= totalPages"
                                t-on-click="onNextPage">
                            Next <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>