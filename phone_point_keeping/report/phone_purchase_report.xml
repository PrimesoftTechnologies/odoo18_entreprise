<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_phone_purchase_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">

                    <div class="page" style="font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #1e293b; padding: 10px;">

                        <!-- HEADER / COMPANY BRANDING WITH CLEAN STATUS BADGE -->
                        <div style="margin-bottom: 20px; border-bottom: 2px solid #0f172a; padding-bottom: 12px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <!-- Left: Company Info -->
                                    <td style="width: 50%; vertical-align: top;">
                                        <div style="font-size: 18px; font-weight: 900; color: #0f172a; letter-spacing: 1px; text-transform: uppercase;">
                                            PHONE POINT KEEPING
                                        </div>
                                        <div style="font-size: 9px; color: #64748b; margin-top: 2px;">
                                            Connecting Businesses with Phone Solutions
                                        </div>
                                        <div style="font-size: 9px; color: #64748b; margin-top: 2px;">
                                            Dar es Salaam, Tanzania | info@phonepoint.co.tz | +255 700 000 000
                                        </div>
                                    </td>

                                    <!-- Right: Document Title, Ref, Date & Clean Status Badge -->
                                    <td style="width: 50%; text-align: right; vertical-align: top;">
                                        <table style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="text-align: right;">
                                                    <div style="font-size: 15px; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 1px;">
                                                        <t t-if="doc.state == 'draft'">Request for Quotation</t>
                                                        <t t-elif="doc.state == 'confirmed'">Purchase Order</t>
                                                        <t t-elif="doc.state == 'partial'">Goods Received Note (Partial)</t>
                                                        <t t-elif="doc.state == 'received'">Goods Received Note</t>
                                                        <t t-elif="doc.state == 'invoiced'">Invoice</t>
                                                        <t t-elif="doc.state == 'paid'">Payment Receipt</t>
                                                        <t t-else="">Purchase Document</t>
                                                    </div>
                                                    <div style="font-size: 10px; font-weight: 700; color: #334155; margin-top: 3px;">
                                                        Ref: <span style="font-family: monospace;"><t t-esc="doc.name"/></span>
                                                    </div>
                                                    <div style="font-size: 9px; color: #64748b; margin-top: 2px; margin-bottom: 6px;">
                                                        Date: <t t-esc="doc.date_order"/>
                                                    </div>

                                                    <!-- CLEAN STATUS BADGE -->
                                                    <div>
                                                        <t t-if="doc.state == 'paid'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #d1fae5; color: #065f46; border: 1px solid #10b981;">
                                                                PAID
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'invoiced'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #dbeafe; color: #1e40af; border: 1px solid #3b82f6;">
                                                                INVOICED
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'received'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #cffafe; color: #155e75; border: 1px solid #06b6d4;">
                                                                RECEIVED
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'partial'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #fef3c7; color: #92400e; border: 1px solid #f59e0b;">
                                                                PARTIALLY RECEIVED
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'confirmed'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #e0e7ff; color: #3730a3; border: 1px solid #6366f1;">
                                                                CONFIRMED
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'draft'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #f1f5f9; color: #475569; border: 1px solid #94a3b8;">
                                                                DRAFT
                                                            </span>
                                                        </t>
                                                        <t t-elif="doc.state == 'cancelled'">
                                                            <span style="display: inline-block; padding: 4px 12px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; border-radius: 3px; background: #fee2e2; color: #991b1b; border: 1px solid #ef4444;">
                                                                CANCELLED
                                                            </span>
                                                        </t>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- COMPANY & SUPPLIER DETAILS SECTION -->
                        <div style="margin-bottom: 15px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <!-- Supplier Information -->
                                    <td style="width: 50%; vertical-align: top; padding-right: 10px;">
                                        <div style="font-size: 11px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 5px; border-bottom: 1px solid #cbd5e1; padding-bottom: 3px;">
                                            Supplier Information
                                        </div>
                                        <div style="font-size: 10px; line-height: 1.5; color: #334155; background: #f8fafc; padding: 8px; border-left: 3px solid #0f172a; border-radius: 2px;">
                                            <div style="font-weight: 700; color: #0f172a;"><t t-esc="doc.supplier_id.name or ''"/></div>
                                            <div t-if="doc.supplier_id.street"><t t-esc="doc.supplier_id.street"/></div>
                                            <div t-if="doc.supplier_id.city"><t t-esc="doc.supplier_id.city"/></div>
                                            <div t-if="doc.supplier_phone"><strong>Phone:</strong> <t t-esc="doc.supplier_phone"/></div>
                                            <div t-if="doc.supplier_id.email"><strong>Email:</strong> <t t-esc="doc.supplier_id.email"/></div>
                                            <div t-if="doc.supplier_id.vat"><strong>TIN:</strong> <t t-esc="doc.supplier_id.vat"/></div>
                                        </div>
                                    </td>
                                    <!-- Order Meta Details -->
                                    <td style="width: 50%; vertical-align: top; padding-left: 10px;">
                                        <div style="font-size: 11px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 5px; border-bottom: 1px solid #cbd5e1; padding-bottom: 3px;">
                                            Order Details
                                        </div>
                                        <table style="width: 100%; font-size: 10px; border-collapse: collapse; background: #f8fafc; padding: 8px;">
                                            <tr>
                                                <td style="padding: 4px; font-weight: 700; color: #0f172a; width: 45%;">Expected Delivery:</td>
                                                <td style="padding: 4px; color: #334155;"><t t-esc="doc.date_expected or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 4px; font-weight: 700; color: #0f172a;">Total Items:</td>
                                                <td style="padding: 4px; color: #334155;"><t t-esc="doc.line_count"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 4px; font-weight: 700; color: #0f172a;">Total Ordered:</td>
                                                <td style="padding: 4px; color: #334155; font-weight: 600;">
                                                    <t t-esc="doc.total_ordered or 0"/> phones
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 4px; font-weight: 700; color: #0f172a;">Received:</td>
                                                <td style="padding: 4px; color: #10b981; font-weight: 600;">
                                                    <t t-esc="doc.total_received or 0"/> phones
                                                </td>
                                            </tr>
                                            <tr t-if="doc.total_pending and doc.total_pending > 0">
                                                <td style="padding: 4px; font-weight: 700; color: #f59e0b;">Pending:</td>
                                                <td style="padding: 4px; color: #f59e0b; font-weight: 700;">
                                                    <t t-esc="doc.total_pending"/> phones
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 4px; font-weight: 700; color: #0f172a;">Payment Method:</td>
                                                <td style="padding: 4px; color: #334155;"><t t-esc="dict(doc._fields['payment_method'].selection).get(doc.payment_method, '')"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ITEMS TABLE -->
                        <div style="margin-bottom: 15px;">
                            <div style="font-size: 11px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 5px;">
                                Items Description
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
                                <thead>
                                    <tr style="background: #0f172a; color: #ffffff;">
                                        <th style="padding: 6px 8px; text-align: left; font-weight: 700; border: 1px solid #0f172a;">Item Description</th>
                                        <th style="padding: 6px 8px; text-align: center; font-weight: 700; border: 1px solid #0f172a; width: 8%;">Ordered</th>
                                        <th style="padding: 6px 8px; text-align: center; font-weight: 700; border: 1px solid #0f172a; width: 8%;">Received</th>
                                        <th style="padding: 6px 8px; text-align: center; font-weight: 700; border: 1px solid #0f172a; width: 8%;">Pending</th>
                                        <th style="padding: 6px 8px; text-align: right; font-weight: 700; border: 1px solid #0f172a; width: 15%;">Unit Price</th>
                                        <th style="padding: 6px 8px; text-align: right; font-weight: 700; border: 1px solid #0f172a; width: 15%;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; vertical-align: top;">
                                                <div style="font-weight: 700; color: #0f172a;">
                                                    <t t-esc="line.phone_model"/>
                                                </div>
                                                <div style="font-size: 9px; color: #64748b; margin-top: 2px;">
                                                    <t t-if="line.brand_id">Brand: <t t-esc="line.brand_id.name"/></t>
                                                    <t t-if="line.condition_id"> | Condition: <t t-esc="line.condition_id.name"/></t>
                                                    <t t-if="line.imei_1"> | IMEI: <t t-esc="line.imei_1"/></t>
                                                </div>
                                            </td>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center; vertical-align: top;">
                                                <t t-esc="line.quantity"/>
                                            </td>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center; vertical-align: top;">
                                                <t t-if="line.qty_received and line.qty_received > 0">
                                                    <span style="color: #10b981; font-weight: 700;">
                                                        <t t-esc="line.qty_received"/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #94a3b8;">0</span>
                                                </t>
                                            </td>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center; vertical-align: top;">
                                                <t t-if="line.qty_pending and line.qty_pending > 0">
                                                    <span style="color: #f59e0b; font-weight: 700;">
                                                        <t t-esc="line.qty_pending"/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #10b981;">✓</span>
                                                </t>
                                            </td>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right; vertical-align: top;">
                                                TZS <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                            </td>
                                            <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right; vertical-align: top; font-weight: 700;">
                                                TZS <t t-esc="'{:,.2f}'.format(line.subtotal)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background: #f1f5f9; font-weight: 700;">
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1;">TOTAL</td>
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">
                                            <t t-esc="doc.total_ordered or 0"/>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center; color: #10b981;">
                                            <t t-esc="doc.total_received or 0"/>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center; color: #f59e0b;">
                                            <t t-esc="doc.total_pending or 0"/>
                                        </td>
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1;"></td>
                                        <td style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right;">
                                            TZS <t t-esc="'{:,.2f}'.format(doc.total)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- TOTALS SECTION -->
                        <div style="margin-bottom: 15px; width: 100%;">
                            <table style="width: 40%; margin-left: auto; border-collapse: collapse; font-size: 10px;">
                                <tr>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #64748b; background: #f8fafc;">Subtotal</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: right; color: #334155; font-weight: 600;">
                                        TZS <t t-esc="'{:,.2f}'.format(doc.subtotal)"/>
                                    </td>
                                </tr>
                                <tr style="background: #0f172a;">
                                    <td style="padding: 6px 8px; border: 1px solid #0f172a; color: #ffffff; font-weight: 800; font-size: 11px; text-transform: uppercase;">Total</td>
                                    <td style="padding: 6px 8px; border: 1px solid #0f172a; text-align: right; color: #ffffff; font-weight: 800; font-size: 11px;">
                                        TZS <t t-esc="'{:,.2f}'.format(doc.total)"/>
                                    </td>
                                </tr>
                                <tr t-if="doc.amount_paid">
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #64748b; background: #f8fafc;">Amount Paid</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: right; color: #10b981; font-weight: 700;">
                                        TZS <t t-esc="'{:,.2f}'.format(doc.amount_paid)"/>
                                    </td>
                                </tr>
                                <tr t-if="doc.balance and doc.balance &gt; 0">
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #ef4444; font-weight: 700; background: #fef2f2;">Balance Due</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: right; color: #ef4444; font-weight: 800;">
                                        TZS <t t-esc="'{:,.2f}'.format(doc.balance)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- PENDING ALERT (kama kuna pending) -->
                        <div t-if="doc.total_pending and doc.total_pending > 0" style="margin-top: 10px; padding: 8px 12px; background: #fef3c7; border-left: 3px solid #f59e0b; border-radius: 2px;">
                            <div style="font-size: 10px; color: #92400e; font-weight: 700;">
                                ⚠ PENDING DELIVERY
                            </div>
                            <div style="font-size: 9px; color: #78350f; margin-top: 3px;">
                                Bado tunasubiri <strong><t t-esc="doc.total_pending"/> phone(s)</strong>
                                kutoka kwa supplier. Tutawasiliana nawe mara baada ya kupokea.
                            </div>
                        </div>

                        <!-- PAYMENT INFORMATION -->
                        <div style="margin-top: 15px; padding-top: 10px; border-top: 2px solid #0f172a;">
                            <div style="font-size: 11px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 4px;">
                                Payment Information
                            </div>
                            <div style="font-size: 10px; color: #334155; margin-bottom: 6px;">
                                Please send payment to the following account:
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
                                <tr>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; width: 25%; font-weight: 700; color: #0f172a; background: #f8fafc;">Payment Method</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #334155;">
                                        <t t-esc="dict(doc._fields['payment_method'].selection).get(doc.payment_method, '')"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; background: #f8fafc;">Account Number</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #334155; font-family: monospace;">
                                        015 295 398 2600 (CRDB Bank)
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; background: #f8fafc;">Reference</td>
                                    <td style="padding: 5px 8px; border: 1px solid #cbd5e1; color: #334155; font-family: monospace;">
                                        <t t-esc="doc.name"/>
                                    </td>
                                </tr>
                            </table>
                            <div style="font-size: 9px; color: #64748b; margin-top: 6px; font-style: italic; background: #f8fafc; padding: 6px 10px; border-left: 3px solid #f59e0b;">
                                <strong>Note:</strong> Please include the reference number when making payment.
                            </div>
                        </div>

                        <!-- NOTES -->
                        <div t-if="doc.notes" style="margin-top: 10px; padding-top: 8px; border-top: 1px solid #cbd5e1;">
                            <div style="font-size: 11px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 4px;">
                                Notes
                            </div>
                            <div style="font-size: 10px; color: #334155; white-space: pre-line; background: #fffbeb; padding: 6px 10px; border-left: 3px solid #f59e0b; border-radius: 2px;">
                                <t t-esc="doc.notes"/>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div style="margin-top: 20px; padding-top: 10px; border-top: 2px solid #0f172a; text-align: center;">
                            <div style="font-size: 11px; font-weight: 800; color: #0f172a; letter-spacing: 1px; text-transform: uppercase;">
                                Thank you for choosing Phone Point Keeping!
                            </div>
                            <div style="font-size: 8px; color: #94a3b8; margin-top: 3px;">
                                This is a system generated invoice. Please keep for your records.
                            </div>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

    <record id="action_report_phone_purchase" model="ir.actions.report">
        <field name="name">Phone Purchase Report</field>
        <field name="model">phone.purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">phone_point_keeping.report_phone_purchase_document</field>
        <field name="report_file">phone_point_keeping.report_phone_purchase_document</field>
        <field name="print_report_name">'Purchase - %s' % object.name</field>
        <field name="binding_model_id" ref="model_phone_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>