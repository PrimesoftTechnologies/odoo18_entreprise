<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         TRADE-IN / EXCHANGE LIST VIEW
         ============================================================ -->

    <record id="view_phone_trade_in_list" model="ir.ui.view">
        <field name="name">phone.trade.in.list</field>
        <field name="model">phone.trade.in</field>
        <field name="arch" type="xml">

            <list string="Trade-In / Exchange">

                <field name="name"/>

                <field name="customer_id"/>

                <field name="old_phone_model"/>

                <field name="old_phone_imei_1"/>

                <field name="new_phone_id"/>

                <field name="trade_in_value"/>

                <field name="new_phone_price"/>

                <field name="amount_to_pay"/>

                <field name="amount_paid"/>

                <field name="balance"/>

                <field name="state"/>

                <field name="date"/>

            </list>

        </field>
    </record>


    <!-- ============================================================
         TRADE-IN / EXCHANGE FORM VIEW
         ============================================================ -->

    <record id="view_phone_trade_in_form" model="ir.ui.view">
        <field name="name">phone.trade.in.form</field>
        <field name="model">phone.trade.in</field>
        <field name="arch" type="xml">

            <form string="Trade-In / Exchange">

                <!-- ==================================================
                     STATUS BAR / WORKFLOW
                     ================================================== -->

                <header>

                    <button
                        name="action_start_evaluation"
                        type="object"
                        string="Start Evaluation"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'evaluation'"
                    />

                    <button
                        name="action_complete"
                        type="object"
                        string="Complete Exchange"
                        class="btn-primary"
                        invisible="state != 'approved'"
                    />

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                        invisible="state in ('completed', 'cancelled')"
                    />

                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        class="btn-secondary"
                        invisible="state != 'cancelled'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,evaluation,approved,completed"
                    />

                </header>


                <sheet>

                    <!-- ==================================================
                         TITLE
                         ================================================== -->

                    <div class="oe_title">

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- ==================================================
                         CUSTOMER INFORMATION
                         ================================================== -->

                    <group string="Customer Information">

                        <group>

                            <field
                                name="customer_id"
                                placeholder="Select Customer"
                            />

                            <field
                                name="customer_phone"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field name="date"/>

                        </group>

                    </group>


                    <separator string="Customer's Old Phone"/>


                    <!-- ==================================================
                         OLD PHONE INFORMATION
                         ================================================== -->

                    <group>

                        <group string="Phone Details">

                            <field
                                name="old_phone_brand_id"
                            />

                            <field
                                name="old_phone_model"
                                placeholder="e.g. iPhone 11 Pro"
                            />

                            <field
                                name="old_phone_storage"
                                placeholder="e.g. 128GB"
                            />

                            <field
                                name="old_phone_condition_id"
                            />

                        </group>


                        <group string="IMEI and Identification">

                            <field
                                name="old_phone_imei_1"
                                placeholder="Enter IMEI 1"
                            />

                            <field
                                name="old_phone_imei_2"
                                placeholder="Enter IMEI 2 (Optional)"
                            />

                            <field
                                name="old_phone_serial_number"
                                placeholder="Serial Number (Optional)"
                            />

                        </group>

                    </group>


                    <!-- ==================================================
                         OLD PHONE CONDITION
                         ================================================== -->

                    <group string="Physical Condition">

                        <group>

                            <field
                                name="old_phone_battery_health"
                                placeholder="e.g. 85%"
                            />

                            <field
                                name="old_phone_accessories"
                                placeholder="Box, Charger, Cable..."
                            />

                        </group>

                        <group>

                            <field
                                name="old_phone_physical_condition"
                                placeholder="Describe physical condition..."
                            />

                        </group>

                    </group>


                    <group string="Notes">

                        <field
                            name="old_phone_notes"
                            placeholder="Additional information about the customer's old phone..."
                            nolabel="1"
                        />

                    </group>


                    <separator string="Phone Valuation"/>


                    <!-- ==================================================
                         VALUATION
                         ================================================== -->

                    <group>

                        <group>

                            <field name="estimated_value"/>

                            <field name="adjustment_amount"/>

                        </group>

                        <group>

                            <field
                                name="trade_in_value"
                            />

                        </group>

                    </group>


                    <separator string="New Phone"/>


                    <!-- ==================================================
                         NEW PHONE
                         ================================================== -->

                    <group string="New Phone Selection">

                        <group>

                            <field
                                name="new_phone_id"
                                domain="[('status', '=', 'in_stock')]"
                                placeholder="Select phone from stock"
                            />

                            <field
                                name="new_phone_model"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="new_phone_imei_1"
                                readonly="1"
                            />

                            <field
                                name="new_phone_imei_2"
                                readonly="1"
                            />

                            <field
                                name="new_phone_price"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <separator string="Exchange Payment"/>


                    <!-- ==================================================
                         PAYMENT
                         ================================================== -->

                    <group>

                        <group>

                            <field
                                name="trade_in_value"
                                readonly="1"
                            />

                            <field
                                name="new_phone_price"
                                readonly="1"
                            />

                            <field
                                name="amount_to_pay"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field name="amount_paid"/>

                            <field
                                name="balance"
                                readonly="1"
                            />

                            <field name="payment_method"/>

                            <field name="payment_reference"/>

                        </group>

                    </group>


                    <separator string="Additional Notes"/>

                    <group>

                        <field
                            name="notes"
                            nolabel="1"
                            placeholder="Additional notes about this trade-in / exchange..."
                        />

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ============================================================
         SEARCH VIEW
         ============================================================ -->

    <record id="view_phone_trade_in_search" model="ir.ui.view">
        <field name="name">phone.trade.in.search</field>
        <field name="model">phone.trade.in</field>
        <field name="arch" type="xml">

            <search string="Search Trade-Ins">

                <field name="name"/>

                <field name="customer_id"/>

                <field name="old_phone_model"/>

                <field name="old_phone_imei_1"/>

                <field name="new_phone_model"/>

                <field name="new_phone_imei_1"/>

                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />

                <filter
                    name="filter_evaluation"
                    string="Under Evaluation"
                    domain="[('state', '=', 'evaluation')]"
                />

                <filter
                    name="filter_approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]"
                />

                <filter
                    name="filter_completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"
                />

                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />

                <separator/>

                <filter
                    name="filter_today"
                    string="Today"
                    domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
                />

                <group expand="0" string="Group By">

                    <filter
                        name="group_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"
                    />

                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />

                    <filter
                        name="group_date"
                        string="Trade-In Date"
                        context="{'group_by': 'date'}"
                    />

                </group>

            </search>

        </field>
    </record>


    <!-- ============================================================
         ACTION
         ============================================================ -->

    <record id="action_phone_trade_in" model="ir.actions.act_window">

        <field name="name">Trade-In / Exchange</field>

        <field name="res_model">phone.trade.in</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_phone_trade_in_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first Trade-In / Exchange transaction.
            </p>

            <p>
                Record the customer's old phone, evaluate its value,
                select the replacement phone, and calculate the
                customer's top-up amount.
            </p>

        </field>

    </record>

</odoo>