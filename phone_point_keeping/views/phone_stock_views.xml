<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         PHONE STOCK - KANBAN VIEW
         ============================================================ -->

    <record id="view_phone_stock_kanban" model="ir.ui.view">
        <field name="name">phone.stock.kanban</field>
        <field name="model">phone.stock</field>
        <field name="arch" type="xml">

            <kanban class="o_kanban_mobile">

                <field name="model_name"/>
                <field name="brand_id"/>
                <field name="category_id"/>
                <field name="condition_id"/>
                <field name="imei_1"/>
                <field name="buying_price"/>
                <field name="selling_price"/>
                <field name="gross_profit"/>
                <field name="status"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <!-- =================================================
                                 HEADER
                                 ================================================= -->

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <div class="fw-bold fs-5 text-dark">
                                        <field name="model_name"/>
                                    </div>

                                    <div class="text-muted small mt-1">
                                        <field name="brand_id"/>
                                    </div>
                                </div>

                                <div>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'in_stock'"
                                           decoration-danger="status == 'sold'"
                                           decoration-warning="status == 'traded_in'"/>
                                </div>

                            </div>


                            <!-- =================================================
                                 PHONE INFORMATION
                                 ================================================= -->

                            <div class="border-top pt-3">

                                <div class="row mb-2">

                                    <div class="col-6">

                                        <div class="text-muted small">
                                            Category
                                        </div>

                                        <div class="fw-semibold">
                                            <field name="category_id"/>
                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <div class="text-muted small">
                                            Condition
                                        </div>

                                        <div class="fw-semibold">
                                            <field name="condition_id"/>
                                        </div>

                                    </div>

                                </div>


                                <!-- =================================================
                                     IMEI
                                     ================================================= -->

                                <div class="mb-3">

                                    <div class="text-muted small">
                                        IMEI 1
                                    </div>

                                    <div class="fw-semibold text-dark">
                                        <field name="imei_1"/>
                                    </div>

                                </div>


                                <!-- =================================================
                                     PRICES
                                     ================================================= -->

                                <div class="row border-top pt-3">

                                    <div class="col-4">

                                        <div class="text-muted small">
                                            Buying
                                        </div>

                                        <div class="fw-semibold">
                                            <field name="buying_price"/>
                                        </div>

                                    </div>


                                    <div class="col-4">

                                        <div class="text-muted small">
                                            Selling
                                        </div>

                                        <div class="fw-semibold">
                                            <field name="selling_price"/>
                                        </div>

                                    </div>


                                    <div class="col-4">

                                        <div class="text-muted small">
                                            Profit
                                        </div>

                                        <div class="fw-bold text-success">
                                            <field name="gross_profit"/>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


    <!-- ============================================================
         PHONE STOCK - LIST VIEW
         ============================================================ -->

    <record id="view_phone_stock_tree" model="ir.ui.view">
        <field name="name">phone.stock.tree</field>
        <field name="model">phone.stock</field>
        <field name="arch" type="xml">

            <list string="Phones &amp; Stock"
                  create="false"
                  delete="false">

                <field name="model_name"
                       string="Phone Model"/>

                <field name="brand_id"
                       string="Brand"/>

                <field name="category_id"
                       string="Category"/>

                <field name="condition_id"
                       string="Condition"/>

                <field name="imei_1"
                       string="IMEI 1"/>

                <field name="buying_price"
                       string="Buying Price"/>

                <field name="selling_price"
                       string="Selling Price"/>

                <field name="gross_profit"
                       string="Profit"
                       sum="Total Profit"/>

                <field name="status"
                       string="Status"
                       widget="badge"
                       decoration-success="status == 'in_stock'"
                       decoration-danger="status == 'sold'"
                       decoration-warning="status == 'traded_in'"/>

            </list>

        </field>
    </record>


    <!-- ============================================================
         PHONE STOCK - SEARCH VIEW
         ============================================================ -->

    <record id="view_phone_stock_search" model="ir.ui.view">
        <field name="name">phone.stock.search</field>
        <field name="model">phone.stock</field>
        <field name="arch" type="xml">

            <search string="Search Phones">

                <!-- =================================================
                     SEARCH FIELDS
                     ================================================= -->

                <field name="model_name"
                       string="Phone Model"/>

                <field name="imei_1"
                       string="IMEI 1"/>

                <field name="imei_2"
                       string="IMEI 2"/>

                <field name="brand_id"
                       string="Brand"/>

                <field name="category_id"
                       string="Category"/>

                <field name="condition_id"
                       string="Condition"/>


                <!-- =================================================
                     STATUS FILTERS
                     ================================================= -->

                <separator/>

                <filter name="filter_in_stock"
                        string="In Stock"
                        domain="[('status', '=', 'in_stock')]"/>

                <filter name="filter_sold"
                        string="Sold"
                        domain="[('status', '=', 'sold')]"/>

                <filter name="filter_traded"
                        string="Traded-In"
                        domain="[('status', '=', 'traded_in')]"/>


                <!-- =================================================
                     GROUP BY
                     ================================================= -->

                <group expand="0"
                       string="Group By">

                    <filter name="group_brand"
                            string="Brand"
                            context="{'group_by': 'brand_id'}"/>

                    <filter name="group_category"
                            string="Category"
                            context="{'group_by': 'category_id'}"/>

                    <filter name="group_condition"
                            string="Condition"
                            context="{'group_by': 'condition_id'}"/>

                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'status'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ============================================================
         PHONE STOCK - FORM VIEW
         ============================================================ -->

    <record id="view_phone_stock_form" model="ir.ui.view">
        <field name="name">phone.stock.form</field>
        <field name="model">phone.stock</field>
        <field name="arch" type="xml">

            <form string="Phone Details">

                <sheet>

                    <!-- =================================================
                         PHONE TITLE
                         ================================================= -->

                    <div class="oe_title">

                        <label for="model_name"
                               class="oe_edit_only"/>

                        <h1>

                            <field name="model_name"
                                   placeholder="e.g. iPhone 13 Pro"/>

                        </h1>

                    </div>


                    <!-- =================================================
                         PHONE INFORMATION
                         ================================================= -->

                    <group>

                        <group string="Phone Information">

                            <field name="brand_id"/>

                            <field name="category_id"
                                   domain="[('brand_id', '=', brand_id)]"
                                   placeholder="e.g. iPhone 13 Series"/>

                            <field name="condition_id"/>

                            <field name="status"/>

                        </group>


                        <!-- =================================================
                             IDENTIFICATION
                             ================================================= -->

                        <group string="Identification">

                            <field name="imei_1"/>

                            <field name="imei_2"/>

                            <field name="serial_number"/>

                        </group>

                    </group>


                    <!-- =================================================
                         FINANCIAL INFORMATION
                         ================================================= -->

                    <group>

                        <group string="Pricing">

                            <field name="buying_price"/>

                            <field name="selling_price"/>

                            <field name="gross_profit"
                                   class="fw-bold text-success fs-5"/>

                        </group>


                        <!-- =================================================
                             SUPPLIER INFORMATION
                             ================================================= -->

                        <group string="Supplier Information">

                            <field name="supplier_id"/>

                            <field name="date_received"/>

                        </group>

                    </group>


                    <!-- =================================================
                         PROFIT SUMMARY
                         ================================================= -->

                    <div class="mt-3 p-3 border rounded bg-light">

                        <div class="row">

                            <div class="col-4 text-center">

                                <div class="text-muted small">
                                    Buying Price
                                </div>

                                <div class="fw-bold fs-5">
                                    <field name="buying_price"
                                           nolabel="1"/>
                                </div>

                            </div>


                            <div class="col-4 text-center">

                                <div class="text-muted small">
                                    Selling Price
                                </div>

                                <div class="fw-bold fs-5">
                                    <field name="selling_price"
                                           nolabel="1"/>
                                </div>

                            </div>


                            <div class="col-4 text-center">

                                <div class="text-muted small">
                                    Gross Profit
                                </div>

                                <div class="fw-bold text-success fs-5">
                                    <field name="gross_profit"
                                           nolabel="1"/>
                                </div>

                            </div>

                        </div>

                    </div>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ============================================================
         PHONE STOCK - ACTION
         ============================================================ -->

    <record id="action_phone_stock" model="ir.actions.act_window">

        <field name="name">Phones &amp; Stock</field>

        <field name="res_model">phone.stock</field>

        <field name="view_mode">kanban,list,form</field>

        <field name="view_id"
               ref="view_phone_stock_kanban"/>

        <field name="search_view_id"
               ref="view_phone_stock_search"/>

        <field name="context">
            {
                'search_default_filter_in_stock': 1
            }
        </field>

    </record>

</odoo>