<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         TRADE-IN SEQUENCE
         ============================================================ -->
    <record id="seq_phone_trade_in" model="ir.sequence">
        <field name="name">Phone Trade-In</field>
        <field name="code">phone.trade.in</field>
        <field name="prefix">TRD/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>


    <!-- ============================================================
         DEBT / INSTALLMENT SEQUENCE
         ============================================================ -->
    <record id="seq_phone_debt" model="ir.sequence">
        <field name="name">Phone Debt</field>
        <field name="code">phone.debt</field>
        <field name="prefix">DEBT/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>


    <!-- ============================================================
         SALE ORDER SEQUENCE (POS)
         ============================================================ -->
    <record id="seq_phone_sale_order" model="ir.sequence">
        <field name="name">Phone Sale Order</field>
        <field name="code">phone.sale.order</field>
        <field name="prefix">SALE/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>


    <!-- ============================================================
         PURCHASE ORDER SEQUENCE (MPYA)
         ============================================================ -->
    <record id="seq_phone_purchase_order" model="ir.sequence">
        <field name="name">Phone Purchase Order</field>
        <field name="code">phone.purchase.order</field>
        <field name="prefix">PO/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

</odoo>