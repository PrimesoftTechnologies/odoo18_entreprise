<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_quantity_restrict" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.quantity.restrict</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>

        <field name="arch" type="xml">

            <!-- Quantity in List -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="attributes">
                <attribute name="readonly">
                    parent.state != 'draft'
                </attribute>
            </xpath>

            <!-- UoM in List -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom'][@string='UoM']"
                   position="attributes">
                <attribute name="readonly">
                    parent.state != 'draft' or is_downpayment
                </attribute>
            </xpath>

            <!-- UoM in Order Line Form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom']"
                   position="attributes">
                <attribute name="readonly">
                    parent.state != 'draft' or is_downpayment
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>

