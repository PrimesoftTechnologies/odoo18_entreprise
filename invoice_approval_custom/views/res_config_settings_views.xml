<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_invoice_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.invoice.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Invoice Approval">
                    <setting id="invoice_approval_setting" title="Require manager approval before confirming invoices">
                        <field name="invoice_approval_required"/>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="invoice_approval_required" class="o_form_label font-weight-bold"/>
                            </div>
                            <div class="text-muted">
                                Enables a 'Wait for Approval' workflow on invoices.
                            </div>
                            <div class="mt16" invisible="not invoice_approval_required">
                                <label for="invoice_approver_ids" class="o_form_label"/>
                                <field name="invoice_approver_ids" widget="many2many_tags" class="o_light_label" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>